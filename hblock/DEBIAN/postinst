#!/bin/sh
set -e

# Registra las unidades de systemd de hblock (hblock.service / hblock.timer).
# No se activa el timer por defecto: la app pulsaros-hblock lo gestiona.
if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi

exit 0