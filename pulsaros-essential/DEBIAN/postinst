#!/bin/bash
set -e

echo "🛠️ Configurando utilidades y red de Pulsar OS..."


# Configuración de locales si locales está instalado
if command -v locale-gen >/dev/null; then
    echo "Configurando idiomas y locales regionales..."
    if [ -f "/etc/locale.gen" ]; then
        sed -i 's/# es_ES.UTF-8 UTF-8/es_ES.UTF-8 UTF-8/' /etc/locale.gen
        sed -i 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen
    else
        echo "es_ES.UTF-8 UTF-8" >> /etc/locale.gen
        echo "en_US.UTF-8 UTF-8" >> /etc/locale.gen
    fi
    locale-gen
    echo "LANG=en_US.UTF-8" > /etc/default/locale
fi

# ==============================================================================
# CONFIGURACIÓN CRÍTICA PARA Arranque en QEMU (9pfs)
# ==============================================================================
# Asegurar que el initramfs tenga cargados los módulos necesarios para montar
# directorios compartidos del host usando 9pfs como sistema de archivos raíz.
echo "🔌 Añadiendo soporte de módulos 9p al initramfs..."
mkdir -p /etc/initramfs-tools
touch /etc/initramfs-tools/modules
for mod in 9p 9pnet 9pnet_virtio; do
    if ! grep -q "^$mod$" /etc/initramfs-tools/modules; then
        echo "$mod" >> /etc/initramfs-tools/modules
    fi
done

# ==============================================================================
# CREACIÓN DE USUARIOS DE PRUEBA Y LIVE / CREATION OF TEST AND LIVE USERS
# ==============================================================================
echo "👤 Configurando cuentas de usuario y contraseñas..."
# English: Ensure critical groups exist
# Español: Asegurar que existan los grupos críticos
groupadd -f sudo || true
groupadd -f docker || true

# Crear usuario 'live' si no existe
# Create user 'live' if it does not exist
if ! id -u live >/dev/null 2>&1; then
    echo "Creando usuario 'live'..."
    useradd -m -s /bin/bash -G sudo,docker live || true
else
    usermod -aG docker live || true
fi
echo "live:live" | chpasswd || echo "⚠️ Advertencia: No se pudo cambiar la contraseña de live"

# Contraseña de root
# Root password
echo "root:pulsar" | chpasswd || echo "⚠️ Advertencia: No se pudo cambiar la contraseña de root"

# English: Set Seafari as the default web browser and apply the Safari icon
# Español: Establecer Seafari como navegador predeterminado y aplicar el icono de Safari
echo "🌐 Configurando Seafari como navegador web predeterminado..."
update-alternatives --install /usr/bin/x-www-browser x-www-browser /usr/bin/seafari 150 || true
update-alternatives --install /usr/bin/gnome-www-browser gnome-www-browser /usr/bin/seafari 150 || true
update-alternatives --set x-www-browser /usr/bin/seafari || true
update-alternatives --set gnome-www-browser /usr/bin/seafari || true

if [ -f "/usr/share/applications/seafari.desktop" ]; then
    sed -i 's/^Icon=.*/Icon=safari/' /usr/share/applications/seafari.desktop
fi

# Home directory permissions are dynamically managed by live-config during boot
# Los permisos del directorio home son gestionados dinámicamente por live-config en el arranque

# English: Register Flathub repository globally
# Español: Registrar el repositorio de Flathub de forma global
echo "📥 Configurando repositorio de Flathub..."
if command -v flatpak >/dev/null 2>&1; then
    flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo || true
fi

# English: Configure Bluetooth to run in dual mode (Classic + BLE)
# Español: Configurar Bluetooth para ejecutarse en modo dual (Classic + BLE)
echo "📶 Configurando Bluetooth en modo dual..."
if [ -f "/etc/bluetooth/main.conf" ]; then
    if grep -q "^#ControllerMode" /etc/bluetooth/main.conf; then
        sed -i 's/^#ControllerMode.*/ControllerMode = dual/' /etc/bluetooth/main.conf
    elif grep -q "^ControllerMode" /etc/bluetooth/main.conf; then
        sed -i 's/^ControllerMode.*/ControllerMode = dual/' /etc/bluetooth/main.conf
    else
        sed -i '/^\[General\]/a ControllerMode = dual' /etc/bluetooth/main.conf
    fi
else
    mkdir -p /etc/bluetooth
    cat <<EOF > /etc/bluetooth/main.conf
[General]
ControllerMode = dual
EOF
fi

# English: Enable Bluetooth, Docker and 9pfs mount systemd services
# Español: Habilitar los servicios de systemd para Bluetooth, Docker y montaje 9pfs
echo "⚙️ Habilitando servicios de systemd (Bluetooth, Docker y montaje 9pfs)..."
if command -v systemctl >/dev/null 2>&1; then
    systemctl enable bluetooth.service || true
    systemctl enable docker-9pfs-mount.service || true
    systemctl enable docker.service || true
    systemctl enable docker.socket || true
fi

# English: Disable default Calamares desktop icon autostart in the live environment
# Español: Desactivar el autostart del icono de escritorio por defecto de Calamares en la sesión live
echo "🚫 Desactivando autostart del icono de escritorio de Calamares..."
if [ -f "/etc/xdg/autostart/calamares-desktop-icon.desktop" ]; then
    if ! grep -q "^Hidden=" /etc/xdg/autostart/calamares-desktop-icon.desktop; then
        echo "Hidden=true" >> /etc/xdg/autostart/calamares-desktop-icon.desktop
    fi
fi

# English: Reduce systemd shutdown/reboot timeouts to prevent long hangs if a service fails to stop
# Español: Reducir el tiempo de espera de apagado de systemd para evitar cuelgues eternos
echo "⚙️ Configurando límites de tiempo de espera en systemd para apagado rápido..."
if [ -f "/etc/systemd/system.conf" ]; then
    sed -i 's/#*DefaultTimeoutStopSec=.*/DefaultTimeoutStopSec=10s/' /etc/systemd/system.conf
fi
if [ -f "/etc/systemd/user.conf" ]; then
    sed -i 's/#*DefaultTimeoutStopSec=.*/DefaultTimeoutStopSec=10s/' /etc/systemd/user.conf
fi

exit 0
