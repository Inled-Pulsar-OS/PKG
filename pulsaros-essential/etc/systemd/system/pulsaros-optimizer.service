[Unit]
Description=Pulsar OS Dynamic Memory, Process & Performance Optimizer
After=multi-user.target
Before=graphical.target

[Service]
Type=simple
ExecStart=/usr/bin/pulsaros-optimizer
Restart=always
RestartSec=5
Nice=-10
# best-effort I/O (never realtime: it could stall storage and cause the very
# saturation this daemon exists to prevent)
IOSchedulingClass=best-effort
IOSchedulingPriority=4

[Install]
WantedBy=multi-user.target