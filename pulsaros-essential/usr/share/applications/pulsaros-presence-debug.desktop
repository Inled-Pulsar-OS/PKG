[Desktop Entry]
Name=Live Presence & Face ID Diagnostics
Name[es]=Diagnóstico de Presencia y Face ID en Vivo
Comment=Real-time monitor for camera face recognition, user activity, and auto-lock
Comment[es]=Monitor en tiempo real de reconocimiento facial por cámara, actividad y auto-bloqueo
Exec=pulsaros-presence-debug
Icon=security-high
Terminal=false
Type=Application
Categories=GNOME;GTK;Settings;Security;System;Utility;
Keywords=presence;faceid;debug;camera;gaze;mutter;idle;lock;diagnostics;
StartupNotify=true
