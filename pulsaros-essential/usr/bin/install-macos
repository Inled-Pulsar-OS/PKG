#!/bin/bash
# ==============================================================================
# Pulsar OS - Install macOS (ultimate-macOS-KVM Launcher)
# ==============================================================================

# If launched from GUI / Tauri with no terminal attached, spawn in a terminal emulator
if [ ! -t 0 ] || [ ! -t 1 ]; then
    if command -v gnome-terminal >/dev/null 2>&1; then
        exec gnome-terminal --title="Install macOS" -- "$0" "$@"
    elif command -v ptyxis >/dev/null 2>&1; then
        exec ptyxis --title="Install macOS" -- "$0" "$@"
    elif command -v kgx >/dev/null 2>&1; then
        exec kgx -e "$0" "$@"
    elif command -v x-terminal-emulator >/dev/null 2>&1; then
        exec x-terminal-emulator -e "$0" "$@"
    fi
fi

# NOTE: no "set -e" here: the menu loop must survive a non-zero exit of main.py.
# The upstream ultimate-macOS-KVM main.py uses a single if/elif chain where every
# sub-tool (compatibility checks, extras, updates...) runs and then the script
# simply ends, so the terminal window would close as if the tool had crashed.
# This wrapper keeps the app alive and always returns to the menu until the user
# decides to quit.

APP_DIR="/opt/.ultimate-macOS-KVM"

echo "=================================================="
echo "🍏 Pulsar OS - Install macOS (KVM Virtualization)"
echo "=================================================="
echo ""

# 1. Check and enable libvirtd daemon
echo "🔍 Checking virtualization service (libvirtd)..."
if ! systemctl is-active --quiet libvirtd.service 2>/dev/null; then
    echo "⚙️ Enabling and starting libvirtd..."
    sudo systemctl enable --now libvirtd.service 2>/dev/null || sudo systemctl start libvirtd.service 2>/dev/null || true
fi

# Check status
if systemctl is-active --quiet libvirtd.service 2>/dev/null; then
    echo "✅ libvirtd daemon is active and running."
else
    echo "⚠️ Warning: libvirtd service is not active. Attempting socket activation..."
    sudo systemctl enable --now libvirtd.socket 2>/dev/null || sudo systemctl start libvirtd.socket 2>/dev/null || true
    if systemctl is-active --quiet libvirtd.socket 2>/dev/null || systemctl is-active --quiet libvirtd.service 2>/dev/null; then
        echo "✅ libvirtd socket/service activated."
    else
        echo "❌ Could not activate libvirtd. Please check: systemctl status libvirtd"
    fi
fi

# 2. Add user to libvirt and kvm groups if needed
if [ -n "$USER" ] && [ "$USER" != "root" ]; then
    if ! id -nG "$USER" 2>/dev/null | grep -qw "libvirt"; then
        sudo usermod -aG libvirt,kvm "$USER" 2>/dev/null || true
    fi
fi

# 3. Ensure default NAT network in libvirt is active
sudo virsh net-start default 2>/dev/null || true
sudo virsh net-autostart default 2>/dev/null || true

# 4. Ensure ultimate-macOS-KVM repository exists
if [ ! -d "$APP_DIR" ] || [ ! -f "$APP_DIR/main.py" ]; then
    echo "📥 Downloading ultimate-macOS-KVM from GitHub..."
    sudo mkdir -p "$APP_DIR"
    sudo git clone --depth=1 https://github.com/Coopydood/ultimate-macOS-KVM "$APP_DIR"
    sudo chmod -R 777 "$APP_DIR"
fi

cd "$APP_DIR" || exit 1
chmod +x main.py 2>/dev/null || true

if [ -f "requirements.txt" ]; then
    pip install -q -r requirements.txt --break-system-packages 2>/dev/null || true
fi

# 5. Neutralize the upstream "relaunch ./main.py to return to the menu" calls.
# Upstream main.py never loops: tools run once and the script exits, and some
# menus try to "go back" by spawning a nested ./main.py (stacking processes).
# This wrapper is the single menu owner, so those nested relaunches become no-ops.
python3 - <<'PYEOF'
import pathlib
import re

pattern = re.compile(r"os\.system\(['\"]\.?/main\.py[^)]*\)")
patched = []
for p in pathlib.Path(".").rglob("*.py"):
    try:
        source = p.read_text(encoding="utf-8")
    except OSError:
        continue
    if "main.py" in source and pattern.search(source):
        p.write_text(pattern.sub("None", source), encoding="utf-8")
        patched.append(str(p))
if patched:
    print(f"🧹 Loop fix applied to: {', '.join(sorted(patched))}")
PYEOF

# 6. Menu loop: run the app and always return to the menu afterwards, so the
# terminal window never closes after running checks/tools. Quit with 'q'.
while true; do
    echo ""
    echo "🚀 Launching ultimate-macOS-KVM..."
    echo "=================================================="
    echo ""
    python3 ./main.py "$@"
    rc=$?
    echo ""
    echo "──────────────────────────────────────────────"
    echo "🔄 Install macOS (KVM) returned to the wrapper (exit code $rc)."
    echo -n "   Press ENTER to return to the menu, or type 'q' to quit: "
    read -r ans
    case "${ans,,}" in
        q|x|quit|exit|salir) break ;;
    esac
done

exit 0