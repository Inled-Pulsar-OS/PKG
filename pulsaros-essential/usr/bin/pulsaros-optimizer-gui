        GLib.timeout_add_seconds(2, self.refresh_all)

    def on_service_toggle(self, switch, state):
        if self.service_updating:
            return False

        action = "start" if state else "stop"
        success = run_privileged(["systemctl", action, "pulsaros-optimizer.service"])
        
        if success:
            msg = "Optimizer service active." if state else "Optimizer service stopped."
            toast = Adw.Toast.new(msg)
            self.toast_overlay.add_toast(toast)
        else:
            # Revert switch if failed
            self.service_updating = True
            switch.set_active(not state)
            self.service_updating = False
            toast = Adw.Toast.new("Authentication required to change service state.")
            self.toast_overlay.add_toast(toast)
        return False

    def refresh_all(self):
        self.update_metrics()
        self.refresh_process_list()
        return True

    def update_metrics(self):
        try:
            # Update service switch state if changed externally
            active = is_service_active()
            if self.service_switch.get_active() != active:
                self.service_updating = True
                self.service_switch.set_active(active)
                self.service_updating = False

            # CPU metrics
            cpu_pct = get_cpu_usage_stats()
            self.cpu_val_label.set_text(f"{int(cpu_pct)}%")
            set_levelbar_usage(self.cpu_levelbar, cpu_pct / 100.0)

            mem = read_meminfo()
            total_kb = mem.get("MemTotal", 1)
            avail_kb = mem.get("MemAvailable", 0)
            used_kb = total_kb - avail_kb

            total_gb = total_kb / (1024 * 1024)
            used_gb = used_kb / (1024 * 1024)
            avail_gb = avail_kb / (1024 * 1024)
            fraction = min(max(used_kb / total_kb, 0.0), 1.0)

            self.ram_val_label.set_text(f"{used_gb:.1f} / {total_gb:.1f} GB ({int(fraction * 100)}%)")
            set_levelbar_usage(self.ram_levelbar, fraction)
            self.ram_sub_label.set_text(f"{avail_gb:.1f} GB available  •  {used_gb:.1f} GB active")

            # zRAM metrics
            zstats = get_zram_stats()
            if zstats["active"]:
                self.zram_ratio_label.set_text(f"{zstats['ratio_str']}")
                zram_used_frac = (zstats["orig_data_mb"] / zstats["disksize_mb"]) if zstats["disksize_mb"] > 0 else 0.0
                set_levelbar_usage(self.zram_levelbar, min(max(zram_used_frac, 0.0), 1.0))
                self.zram_sub_label.set_text(
                    f"{zstats['orig_data_mb']:.1f} MB compressed to {zstats['compr_data_mb']:.1f} MB ({zstats['algorithm']})  •  {zstats['saved_mb']:.1f} MB RAM saved"
                )
            else:
                self.zram_ratio_label.set_text("Inactive")
                set_levelbar_usage(self.zram_levelbar, 0.0)
                self.zram_sub_label.set_text("zRAM device not initialized")

            # Kernel sysctls
            sysctls = get_kernel_sysctls()
            self.c1_val.set_text(sysctls["swappiness"])
            self.c2_val.set_text(sysctls["vfs_cache_pressure"])
            self.c3_val.set_text(sysctls["page_cluster"])
        except Exception:
            pass

    def refresh_process_list(self):
        query = self.search_entry.get_text().strip().lower()
        all_procs = get_process_list()

        if query:
            filtered = [p for p in all_procs if query in p["name"].lower() or query == str(p["pid"])]
        else:
            boosted = [p for p in all_procs if p["prio_idx"] != 2]
            top_ram = sorted([p for p in all_procs if p["prio_idx"] == 2], key=lambda x: -x["rss_mb"])[:12]
            filtered = boosted + top_ram

        current_pids = {p["pid"] for p in filtered}

        # Remove dead rows
        for pid in list(self.rows_by_pid.keys()):
            if pid not in current_pids:
                row = self.rows_by_pid.pop(pid)
                self.process_container.remove(row)

        if not filtered:
            self.empty_label.set_visible(True)
            return
        else:
            self.empty_label.set_visible(False)

        # Update existing rows or add new ones without clearing children
        for proc in filtered:
            pid = proc["pid"]
            if pid in self.rows_by_pid:
                self.rows_by_pid[pid].update_data(proc)
            else:
                row = ProcessRow(proc, on_priority_change=self.on_change_process_priority)
                self.rows_by_pid[pid] = row
                self.process_container.append(row)

    def on_change_process_priority(self, proc, selected_idx):
        pid = proc["pid"]
        name = proc["name"]
        
        # 0=Turbo(-10), 1=High(-5), 2=Normal(0), 3=Low(19)
        nice_map = [(-10, 2, 0, "Turbo (-10)"),
                    (-5,  2, 1, "High (-5)"),
                    (0,   2, 4, "Normal (0)"),
                    (19,  3, 0, "Low (+19)")]
        
        target_nice, io_class, io_prio, label = nice_map[selected_idx]
        
        run_privileged(["renice", "-n", str(target_nice), "-p", str(pid)])
        if io_class == 3:
            run_privileged(["ionice", "-c", "3", "-p", str(pid)])
        else:
            run_privileged(["ionice", "-c", str(io_class), "-n", str(io_prio), "-p", str(pid)])
        
        toast = Adw.Toast.new(f"{name} (PID {pid}) set to {label}")
        self.toast_overlay.add_toast(toast)
        self.refresh_all()

    def on_compact_memory_clicked(self, widget):
        success = run_privileged(["sh", "-c", "echo 1 > /proc/sys/vm/drop_caches && (echo 1 > /proc/sys/vm/compact_memory 2>/dev/null || true)"])
        self.update_metrics()
        if success:
            toast = Adw.Toast.new("Memory caches flushed and compacted.")
        else:
            toast = Adw.Toast.new("Notice: Authentication needed to flush system cache.")
        self.toast_overlay.add_toast(toast)

class OptimizerApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id="es.inled.PulsarOSOptimizer", flags=Gio.ApplicationFlags.FLAGS_NONE)

    def do_activate(self):
        win = self.props.active_window
        if not win:
            win = OptimizerWindow(self)
        win.present()

def main():
    app = OptimizerApp()
    return app.run(sys.argv)

if __name__ == "__main__":
    sys.exit(main())
