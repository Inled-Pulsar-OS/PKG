#!/usr/bin/env python3
"""
Pulsar OS Optimizer - Real-Time System Monitor & Process Priority Manager
Displays exact kernel metrics, allows live process scheduling adjustments, and service on/off toggle.
"""

import os
import sys
import subprocess
import gi

gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')
_last_cpu_stat = None

def get_cpu_usage_stats():
    global _last_cpu_stat
    try:
        with open("/proc/stat", "r") as f:
            line = f.readline()
        fields = [float(x) for x in line.split()[1:]]
        idle = fields[3] + fields[4]
        total = sum(fields)
        if _last_cpu_stat is not None:
            prev_idle, prev_total = _last_cpu_stat
            idle_delta = idle - prev_idle
            total_delta = total - prev_total
            _last_cpu_stat = (idle, total)
            if total_delta > 0:
                usage = max(0.0, min(100.0, (1.0 - (idle_delta / total_delta)) * 100.0))
                return usage
        _last_cpu_stat = (idle, total)
        return 0.0
    except Exception:
        return 0.0

def apply_custom_css():
    css = """
    levelbar.resource-bar trough block.filled {
        border-radius: 4px;
        transition: background-color 0.25s ease;
    }
    levelbar.resource-bar.usage-normal trough block.filled {
        background-color: #30d158;
    }
    levelbar.resource-bar.usage-warning trough block.filled {
        background-color: #ff9f0a;
    }
    levelbar.resource-bar.usage-critical trough block.filled {
        background-color: #ff453a;
    }
    """
    provider = Gtk.CssProvider()
    provider.load_from_data(css.encode())
    Gtk.StyleContext.add_provider_for_display(
        gi.repository.Gdk.Display.get_default(),
        provider,
        Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
    )

def set_levelbar_usage(levelbar, fraction):
    levelbar.set_value(fraction)
    levelbar.remove_css_class("usage-normal")
    levelbar.remove_css_class("usage-warning")
    levelbar.remove_css_class("usage-critical")
    if fraction >= 0.90:
        levelbar.add_css_class("usage-critical")
    elif fraction >= 0.70:
        levelbar.add_css_class("usage-warning")
    else:
        levelbar.add_css_class("usage-normal")

def run_privileged(cmd_list):
    """Execute a privileged system command safely handling sudo/pkexec without crashes."""
    # 1. Direct execution if already root
    if os.geteuid() == 0:
        try:
            res = subprocess.run(cmd_list, capture_output=True, text=True)
            return res.returncode == 0
        except Exception:
            return False

    # 2. Non-interactive sudo (instant for live user / nopasswd)
    try:
        res = subprocess.run(["sudo", "-n"] + cmd_list, capture_output=True, text=True)
        if res.returncode == 0:
            return True
    except Exception:
        pass

    # 3. Standard sudo
    try:
        res = subprocess.run(["sudo"] + cmd_list, capture_output=True, text=True)
        if res.returncode == 0:
            return True
    except Exception:
        pass

    # 4. Polkit pkexec fallback
    try:
        res = subprocess.run(["pkexec"] + cmd_list, capture_output=True, text=True)
        return res.returncode == 0
    except Exception:
        pass

    return False

def is_service_active():
    """Check if pulsaros-optimizer.service is active."""
    try:
        res = subprocess.run(["systemctl", "is-active", "pulsaros-optimizer.service"], capture_output=True, text=True)
        return res.stdout.strip() == "active"
    except Exception:
        return False

def read_meminfo():
    info = {}
    try:
        with open("/proc/meminfo", "r") as f:
            for line in f:
                parts = line.split(":")
                if len(parts) == 2:
                    key = parts[0].strip()
                    val = parts[1].strip().split()[0]
                    info[key] = int(val)
    except Exception:
        pass
    return info

def get_zram_stats():
    """Retrieve exact real metrics from the Linux kernel zRAM sysfs interface."""
    stats = {
        "active": False,
        "orig_data_mb": 0.0,
        "compr_data_mb": 0.0,
        "ratio_str": "1.00:1",
        "saved_mb": 0.0,
        "disksize_mb": 0.0,
        "algorithm": "ZSTD"
    }
    try:
        with open("/proc/swaps", "r") as f:
            if "zram" in f.read():
                stats["active"] = True

        if os.path.exists("/sys/block/zram0/disksize"):
            with open("/sys/block/zram0/disksize", "r") as f:
                stats["disksize_mb"] = int(f.read().strip()) / (1024 * 1024)

        if os.path.exists("/sys/block/zram0/mm_stat"):
            with open("/sys/block/zram0/mm_stat", "r") as f:
                parts = f.read().split()
                if len(parts) >= 3:
                    orig_bytes = int(parts[0])
                    compr_bytes = int(parts[1])
                    orig_mb = orig_bytes / (1024 * 1024)
                    compr_mb = compr_bytes / (1024 * 1024)
                    saved_mb = max(0.0, orig_mb - compr_mb)
                    ratio = (orig_bytes / compr_bytes) if compr_bytes > 0 else 1.0
                    
                    stats["orig_data_mb"] = orig_mb
                    stats["compr_data_mb"] = compr_mb
                    stats["saved_mb"] = saved_mb
                    stats["ratio_str"] = f"{ratio:.2f}:1"

        if os.path.exists("/sys/block/zram0/comp_algorithm"):
            with open("/sys/block/zram0/comp_algorithm", "r") as f:
                for part in f.read().split():
                    if part.startswith("[") and part.endswith("]"):
                        stats["algorithm"] = part[1:-1].upper()
                        break
    except Exception:
        pass
    return stats

def get_kernel_sysctls():
    """Read live kernel virtual memory configuration."""
    sysctls = {"swappiness": "100", "vfs_cache_pressure": "50", "page_cluster": "0"}
    try:
        if os.path.exists("/proc/sys/vm/swappiness"):
            with open("/proc/sys/vm/swappiness", "r") as f:
                sysctls["swappiness"] = f.read().strip()
        if os.path.exists("/proc/sys/vm/vfs_cache_pressure"):
            with open("/proc/sys/vm/vfs_cache_pressure", "r") as f:
                sysctls["vfs_cache_pressure"] = f.read().strip()
        if os.path.exists("/proc/sys/vm/page-cluster"):
            with open("/proc/sys/vm/page-cluster", "r") as f:
                sysctls["page_cluster"] = f.read().strip()
    except Exception:
        pass
    return sysctls

def get_process_list():
    """Retrieve running user and system processes with genuine nice and RSS memory values."""
    processes = []
    try:
        pids = [p for p in os.listdir("/proc") if p.isdigit()]
        for pid_str in pids:
            try:
                pid = int(pid_str)
                with open(f"/proc/{pid_str}/comm", "r") as f:
                    comm = f.read().strip()
                
                # Exclude kernel threads (empty cmdline)
                try:
                    with open(f"/proc/{pid_str}/cmdline", "rb") as f:
                        if not f.read():
                            continue
                except Exception:
                    continue

                with open(f"/proc/{pid_str}/stat", "r") as f:
                    stat_parts = f.read().split()
                    nice = int(stat_parts[18])
                    rss_pages = int(stat_parts[23])
                    rss_mb = (rss_pages * 4096) / (1024 * 1024)

                # Determine priority dropdown index:
                # 0 = Turbo (-10)
                # 1 = High (-5)
                # 2 = Normal (0)
                # 3 = Low (+19)
                if nice <= -8:
                    prio_idx = 0
                elif nice < 0:
                    prio_idx = 1
                elif nice > 10:
                    prio_idx = 3
                else:
                    prio_idx = 2

                processes.append({
                    "pid": pid,
                    "name": comm,
                    "nice": nice,
                    "rss_mb": rss_mb,
                    "prio_idx": prio_idx
                })
            except Exception:
                continue
    except Exception:
        pass
    
    # Sort: non-normal priorities first, then by memory consumption
    processes.sort(key=lambda x: (0 if x["prio_idx"] != 2 else 1, x["nice"], -x["rss_mb"]))
    return processes

class ProcessRow(Adw.ActionRow):
    def __init__(self, proc_data, on_priority_change):
        super().__init__()
        self.proc_data = proc_data
        self.pid = proc_data["pid"]
        self.on_priority_change = on_priority_change
        self.is_updating = True

        self.set_title(proc_data["name"])
        self.set_subtitle(f"PID {self.pid}  •  {proc_data['rss_mb']:.1f} MB RAM  •  Nice {proc_data['nice']}")

        options = ["Turbo (-10)", "High (-5)", "Normal (0)", "Low (+19)"]
        model = Gtk.StringList.new(options)
        self.dropdown = Gtk.DropDown.new(model, None)
        self.dropdown.set_selected(proc_data["prio_idx"])
        self.dropdown.set_valign(Gtk.Align.CENTER)
        self.dropdown.add_css_class("flat")
        
        self.dropdown.connect("notify::selected", self._on_selected)
        self.add_suffix(self.dropdown)
        self.is_updating = False

    def update_data(self, proc_data):
        self.proc_data = proc_data
        self.set_subtitle(f"PID {self.pid}  •  {proc_data['rss_mb']:.1f} MB RAM  •  Nice {proc_data['nice']}")
        
        if self.dropdown.get_selected() != proc_data["prio_idx"]:
            self.is_updating = True
            self.dropdown.set_selected(proc_data["prio_idx"])
            self.is_updating = False

    def _on_selected(self, dropdown, param):
        if self.is_updating:
            return
        selected_idx = dropdown.get_selected()
        self.on_priority_change(self.proc_data, selected_idx)

