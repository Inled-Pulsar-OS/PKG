# -----------------------------------------------------------------------------
# Anti-saturation: guarantees the CPU never saturates and RAM never runs out -
# even when the FOCUSED app is the one consuming everything. Two mechanisms:
#
#  PRIMARY (cgroup v2, this system): every user app is moved into a cgroup
#  (pulsaros/fg = focused app, pulsaros/bg = the rest). Tiers translate into
#  cpu.max + memory.high/max ceilings, so the focused app is *throttled*, not
#  frozen, and the desktop (pulsaros/core, uncapped, max weight) always stays
#  fluid while switching windows.
#   CPU tier 1 (>=70%):  lower background CPU ceiling to 80% of all cores
#   CPU tier 2 (>=85%):  background 60%, focused app capped at 90%
#   CPU tier 3 (>=95%):  background 40%, focused app capped at 75%
#   MEM tier 1 (<=25%):  drop page cache + compact memory
#   MEM tier 2 (<=15%):  bg/fg memory.high caps force proactive reclaim
#   MEM tier 3 (<=8%):   tighter high caps plus hard max (cgroup-local OOM)
#   MEM tier 4 (<=4%):   emergency: hard ceilings near the floor + SIGTERM of
#                        stateless indexers.
#  The ceilings auto-revert (max) once pressure drops (hysteresis).
#
#  FALLBACK (kernels without cpu/memory controllers): SIGSTOP ladder below.
#  Escalates strongest-first on the *least* important work:
#   CPU tier 1 (>=70%):  demote + freeze indexers/maintenance tasks
#   CPU tier 2 (>=85%):  + freeze every non-essential process burning CPU
#   CPU tier 3 (>=95%):  + freeze all non-essential processes; at this tier the
#                        focused app is brought down too if still pinning the
#                        CPU (stopped, never killed) - the CPU/RAM guarantee
#                        is absolute.
#   MEM tier 1 (<=25%):  drop page cache + compact memory
#   MEM tier 2 (<=15%):  freeze the biggest non-essential consumers
#   MEM tier 3 (<=8%):   freeze every non-essential consumer (incl. focused
#                        app if it is the biggest consumer)
#   MEM tier 4 (<=4%):   emergency reclaim + SIGTERM of stateless indexers
# Everything thaws by itself once pressure drops (hysteresis + min hold time).
# Core desktop infrastructure is never frozen, killed, or capped.
# -----------------------------------------------------------------------------
CPU_FREEZE_L1 = 70.0        # smoothed %  -> tier 1
CPU_FREEZE_L2 = 85.0        # smoothed %  -> tier 2
CPU_FREEZE_L3 = 95.0        # smoothed %  -> tier 3
CPU_HOG_PCT = 20.0          # per-process smoothed % that counts as a CPU hog
CPU_TIER_HYST = 5.0         # % margin before descending a CPU tier

MEM_AVAIL_T1 = 0.25         # free-RAM ratio -> tier 1
MEM_AVAIL_T2 = 0.15         #                 -> tier 2
MEM_AVAIL_T3 = 0.08         #                 -> tier 3
MEM_AVAIL_T4 = 0.04         #                 -> tier 4
MEM_KEY_RSS_MB = 150.0      # RSS floor (MB) to be a memory target at tier 2
MEM_TIER_HYST = 0.02        # ratio margin before descending a memory tier
MEM_DROP_CACHE_INTERVAL = 90.0   # min seconds between drop_caches calls
FROZEN_MIN_SEC = 25.0       # a process stays frozen at least this long
THAW_GRACE_SEC = 15.0       # sustained below-tier time before thawing
FROZEN_RELEASE_WAIT = 45.0  # don't re-freeze a recently thawed process
FROZEN_MARKER = "/run/pulsaros-frozen.json"

