#!/usr/bin/env python3
"""
Pulsar OS - Universal Dynamic Adaptive Optimizer Daemon (pulsaros-optimizer)
Engineered for ultimate desktop fluidity and zero-lag performance across any workflow:
from low-spec hardware (Intel Celeron/i3, 4GB RAM) to high-end multi-core workstations
running heavy compilation, VMs, Docker, 4K media rendering, or multitasking.

Core Engine Features:
1. Real-time Hardware-Adaptive Governor:
   - Tracks instant CPU utilization, Load Average, and Linux Kernel PSI (Pressure Stall Information)
     for CPU, Memory, and Disk I/O.
   - Dynamically shifts between 3 states: NORMAL (Fluid), ELEVATED (Balancing), CRITICAL (Zero-Lag Protection).
2. Desktop Compositor & Audio Hardening:
   - Always guarantees maximum scheduling priority and low-latency/real-time I/O to GNOME Shell,
     Mutter, Xwayland, PipeWire, WirePlumber, Spotlight, and active UI windows.
3. Adaptive Multi-Core & Heavy Workload Load Balancer:
   - Heavy background tasks (compilers: cargo/rustc/gcc/clang/ninja, VMs: qemu/vbox,
     containers: docker/podman, builders: dpkg/webpack/vite, encoders: ffmpeg/blender)
     run at full multi-core performance when system is idle.
   - Under system load or pressure spikes, instantly and gently adjusts nice levels (+5 to +14)
     and I/O priorities (IDLE/Best-Effort) so the UI and audio NEVER freeze or drop frames.
4. Universal Hardware Memory Management & zRAM:
   - Dynamically computes optimal zRAM compression size and kernel swappiness (180 for <=4GB,
     150 for <=16GB, 100 for >16GB) with priority 32767.
   - Proactive memory compaction and pagecache trim on acute memory pressure.
   - Sets zero-latency kernel VM tunings (page-cluster 0, vfs_cache_pressure 50, dirty_ratio 10,
     watermark_scale_factor 150, sched_autogroup 1).
5. Direct libc syscalls (SYS_ioprio_set) with near-zero daemon CPU footprint (< 0.05%).
"""

import ctypes
import os
import sys
import time
import subprocess
import glob
import signal
import platform

# Direct Linux syscall for I/O priority without spawning subprocesses
def _get_ioprio_syscall_nr():
    m = platform.machine().lower()
    if m in ("x86_64", "amd64"):
        return 251
    elif m in ("aarch64", "arm64"):
        return 30
    elif m.startswith("arm"):
        return 314
    elif m in ("i386", "i686", "x86"):
        return 289
    return 251

IOPRIO_SYSCALL_NR = _get_ioprio_syscall_nr()
_libc = None
try:
    _libc = ctypes.CDLL(None)
except Exception:
    pass

def set_ioprio(pid: int, io_class: int, io_prio: int):
    """Set process I/O priority directly via libc syscall with zero process spawn overhead."""
    if _libc:
        try:
            # IOPRIO_PRIO_VALUE(class, data) = ((class << 13) | data)
            # IOPRIO_WHO_PROCESS = 1
            val = (io_class << 13) | (io_prio & 0x1fff)
            res = _libc.syscall(IOPRIO_SYSCALL_NR, 1, pid, val)
            if res == 0:
                return True
        except Exception:
            pass
    try:
        if io_class == 3:
            subprocess.run(["ionice", "-c", "3", "-p", str(pid)], capture_output=True)
        else:
            subprocess.run(["ionice", "-c", str(io_class), "-n", str(io_prio), "-p", str(pid)], capture_output=True)
        return True
    except Exception:
        return False

# Cache of processed PIDs: pid -> (target_nice, io_class, io_prio, mode)
PROCESSED_PIDS = {}
CURRENT_PRESSURE_MODE = 0
PREV_CPU_TIMES = None
PREV_PID_CPU_TIMES = {}
LAST_MEMORY_TRIM_TIME = 0.0

# -----------------------------------------------------------------------------
# Process Categorization
# -----------------------------------------------------------------------------

# 1. Background Indexers & Maintenance -> Always lowest priority (Nice 19, Idle IO)
THROTTLE_PROCESS_NAMES = {
    "tracker-miner-fs-3", "tracker-miner-fs", "tracker-miner-f",
    "tracker-extract-3", "tracker-extract", "tracker-extract-",
    "tinysparql", "localsearch-3", "localsearch-extractor-3", "localsearch-3",
