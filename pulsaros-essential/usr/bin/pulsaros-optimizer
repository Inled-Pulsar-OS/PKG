#!/usr/bin/env python3
"""
Pulsar OS - Universal Dynamic Adaptive Optimizer & Real-Time Habit Learning Engine
Engineered for zero-lag desktop fluidity, instant responsiveness, and smooth multitasking.
Guarantees: the CPU never saturates and RAM never runs out. An escalation ladder
(priority demotion -> freeze indexers -> freeze all non-essential -> emergency
reclaim/kill of stateless services) reacts progressively to rising CPU/memory
pressure and thaws automatically when pressure drops.
"""

import ctypes
import os
import sys
import time
import json
import glob
import signal
import platform
import atexit
import subprocess

# -----------------------------------------------------------------------------
# Direct Linux syscall for I/O priority without spawning subprocesses
# -----------------------------------------------------------------------------
def _get_ioprio_syscall_nr():
    m = platform.machine().lower()
    if m in ("x86_64", "amd64"):
        return 251
    elif m in ("aarch64", "arm64"):
        return 30
    elif m.startswith("arm"):
        return 314
    elif m in ("i386", "i686", "x86"):
        return 289
    return 251

IOPRIO_SYSCALL_NR = _get_ioprio_syscall_nr()
_libc = None
try:
    _libc = ctypes.CDLL(None)
except Exception:
    pass

def set_ioprio(pid: int, io_class: int, io_prio: int):
    """Set process I/O priority directly via libc syscall with zero process spawn overhead."""
    # Ensure io_class is never 1 (Real-Time) to prevent system I/O deadlocks
    if io_class == 1:
        io_class = 2
        io_prio = 0
    if _libc:
        try:
            val = (io_class << 13) | (io_prio & 0x1fff)
            res = _libc.syscall(IOPRIO_SYSCALL_NR, 1, pid, val)
            if res == 0:
                return True
        except Exception:
            pass
    try:
        if io_class == 3:
            subprocess.run(["ionice", "-c", "3", "-p", str(pid)], capture_output=True, timeout=0.2)
        else:
            subprocess.run(["ionice", "-c", str(io_class), "-n", str(io_prio), "-p", str(pid)], capture_output=True, timeout=0.2)
        return True
    except Exception:
        return False

def _sys_write(path: str, value: str) -> bool:
    """Write a sysctl/sysfs file, returning success instead of raising."""
    try:
        with open(path, "w") as f:
            f.write(value)
        return True
    except Exception:
        return False

try:
    CLK_TCK = float(os.sysconf("SC_CLK_TCK"))
except Exception:
    CLK_TCK = 100.0

def log(msg):
    print(f"[pulsaros-optimizer] {msg}", flush=True)

_WARNED = set()
def warn_once(msg, limit=20):
    if msg in _WARNED or len(_WARNED) >= limit:
        return
    _WARNED.add(msg)
    log(f"WARNING: {msg}")

