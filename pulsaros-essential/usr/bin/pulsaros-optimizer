LAST_CPU_CAP = None
LAST_MEM_HIGH = None
CAP_LEVEL = 0
CAP_LEVEL_TS = 0.0
MEM_HIGH_LEVEL = 1.0
MEM_HIGH_TS = 0.0
DAEMON_RUNNING = False
RUNNING = True

def read_meminfo():
    info = {}
    try:
        with open("/proc/meminfo", "r") as f:
            for line in f:
                parts = line.split(":")
                if len(parts) == 2:
                    key = parts[0].strip()
                    val = parts[1].strip().split()[0]
                    info[key] = int(val)
    except Exception:
        pass
    return info

def get_cpu_utilization():
    """CPU usage % across all cores since the previous call (interval average)."""
    global PREV_CPU_TIMES
    try:
        with open("/proc/stat", "r") as f:
            line = f.readline().split()
            if line[0] == "cpu":
                times = [int(x) for x in line[1:]]
                idle_time = times[3] + (times[4] if len(times) > 4 else 0)
                total_time = sum(times)

                if PREV_CPU_TIMES is None:
                    PREV_CPU_TIMES = (total_time, idle_time)
                    return 0.0

                prev_total, prev_idle = PREV_CPU_TIMES
                PREV_CPU_TIMES = (total_time, idle_time)

                d_total = total_time - prev_total
                d_idle = idle_time - prev_idle

                if d_total > 0:
                    usage = 100.0 * (1.0 - (d_idle / d_total))
                    return max(0.0, min(100.0, usage))
    except Exception:
        pass
    return 0.0

def read_psi():
    """Read Linux kernel Pressure Stall Information (PSI) for CPU, I/O and Memory."""
    psi = {"cpu_some": 0.0, "io_some": 0.0, "io_full": 0.0, "mem_some": 0.0, "mem_full": 0.0}
    try:
        for path, keys in (("/proc/pressure/cpu", ("cpu_some",)),
                           ("/proc/pressure/io", ("io_some", "io_full")),
                           ("/proc/pressure/memory", ("mem_some", "mem_full"))):
            if not os.path.exists(path):
                continue
            with open(path, "r") as f:
                for line in f:
                    kind = keys[0].split("_")[0]
                    if not line.startswith(kind):
                        continue
                    for part in line.split():
                        if part.startswith("avg10="):
                            key = "io_some" if (kind == "io" and line.startswith("some")) else \
                                  "io_full" if (kind == "io") else \
                                  "mem_some" if (kind == "memory" and line.startswith("some")) else \
                                  "mem_full" if kind == "memory" else "cpu_some"
                            psi[key] = float(part.split("=")[1])
    except Exception:
        pass
    return psi

def compute_load_state():
    """Return (load_level 0..4, pressure_mode 0..2, smoothed CPU%, psi).

    Level 0-2 are the "low regime" band where the soft ceilings do the work,
    3 is elevated (balancing) and 4 is critical (zero-lag protection).
    """
    global CPU_SMOOTH
    cpu = get_cpu_utilization()
    CPU_SMOOTH = cpu if CPU_SMOOTH is None else (CPU_SMOOTH * 0.65) + (cpu * 0.35)
    psi = read_psi()

    level = 0
    if CPU_SMOOTH >= LOAD_CPU_THRESHOLDS[0]:
        level = 1
    if CPU_SMOOTH >= LOAD_CPU_THRESHOLDS[1]:
        level = 2
    if (CPU_SMOOTH >= LOAD_CPU_THRESHOLDS[2]
            or psi["cpu_some"] > PSI_ELEVATED["cpu_some"]
            or psi["io_some"] > PSI_ELEVATED["io_some"]
            or psi["io_full"] > PSI_ELEVATED["io_full"]):
        level = 3
    if (CPU_SMOOTH >= LOAD_CPU_THRESHOLDS[3]
            or psi["cpu_some"] > PSI_CRITICAL["cpu_some"]
            or psi["io_some"] > PSI_CRITICAL["io_some"]
            or psi["io_full"] > PSI_CRITICAL["io_full"]):
        level = 4

    mode = 0 if level <= 2 else (1 if level == 3 else 2)
    return level, mode, CPU_SMOOTH, psi

def get_zram_stats():
    """Retrieve zRAM compression and usage statistics."""
    stats = {
        "active": False,
        "orig_data_mb": 0.0,
        "compr_data_mb": 0.0,
        "ratio": "1.00:1",
        "saved_mb": 0.0,
        "disksize_mb": 0.0,
        "algorithm": "unknown"
    }
    try:
        with open("/proc/swaps", "r") as f:
            if "zram" in f.read():
                stats["active"] = True

        if os.path.exists("/sys/block/zram0/disksize"):
            with open("/sys/block/zram0/disksize", "r") as f:
                stats["disksize_mb"] = int(f.read().strip()) / (1024 * 1024)

        if os.path.exists("/sys/block/zram0/mm_stat"):
            with open("/sys/block/zram0/mm_stat", "r") as f:
                parts = f.read().split()
                if len(parts) >= 3:
                    orig_bytes = int(parts[0])
                    compr_bytes = int(parts[1])
                    orig_mb = orig_bytes / (1024 * 1024)
                    compr_mb = compr_bytes / (1024 * 1024)
                    saved_mb = max(0.0, orig_mb - compr_mb)
                    ratio = f"{(orig_bytes / compr_bytes):.2f}:1" if compr_bytes > 0 else "1.00:1"

                    stats["orig_data_mb"] = orig_mb
                    stats["compr_data_mb"] = compr_mb
                    stats["saved_mb"] = saved_mb
                    stats["ratio"] = ratio

        if os.path.exists("/sys/block/zram0/comp_algorithm"):
            with open("/sys/block/zram0/comp_algorithm", "r") as f:
                for part in f.read().split():
                    if part.startswith("[") and part.endswith("]"):
                        stats["algorithm"] = part[1:-1].upper()
                        break
    except Exception:
        pass
    return stats

# -----------------------------------------------------------------------------
# Focus detection (extension file first, session fallbacks second)
# -----------------------------------------------------------------------------
def _pid_alive(pid: int) -> bool:
    return pid > 0 and os.path.exists(f"/proc/{pid}")

def _session_env():
    """Environment of the graphical session (this daemon is a system service)."""
    global SESSION_ENV_CACHE, SESSION_ENV_TS
    now = time.time()
    if SESSION_ENV_CACHE and (now - SESSION_ENV_TS) < 60.0:
        return SESSION_ENV_CACHE
    SESSION_ENV_TS = now
    try:
        for pid_str in os.listdir("/proc"):
            if not pid_str.isdigit():
                continue
            try:
                with open(f"/proc/{pid_str}/comm", "r") as f:
                    if f.read().strip() != "gnome-shell":
                        continue
                with open(f"/proc/{pid_str}/environ", "rb") as f:
                    raw = f.read().split(b"\0")
                env = {}
                wanted = (b"DBUS_SESSION_BUS_ADDRESS", b"DISPLAY", b"WAYLAND_DISPLAY", b"XDG_RUNTIME_DIR")
                for item in raw:
                    if b"=" not in item:
                        continue
                    k, v = item.split(b"=", 1)
                    if k in wanted:
                        env[k.decode()] = v.decode()
                if env:
                    SESSION_ENV_CACHE = env
                    return env
            except Exception:
                continue
    except Exception:
        pass
    return SESSION_ENV_CACHE

def _x11_active_pid(env):
    if not env.get("DISPLAY"):
        return 0
    run_env = {**os.environ, **env}
    try:
        res = subprocess.run(["xprop", "-root", "_NET_ACTIVE_WINDOW"],
                             capture_output=True, text=True, timeout=0.3, env=run_env)
        if "#" in res.stdout:
            wid = res.stdout.rsplit("#", 1)[1].strip()
            res2 = subprocess.run(["xprop", "-id", wid, "_NET_WM_PID"],
                                  capture_output=True, text=True, timeout=0.3, env=run_env)
            if "_NET_WM_PID" in res2.stdout and "not found" not in res2.stdout:
                pid = int(res2.stdout.split("=")[-1].strip())
                if pid > 0:
                    return pid
    except Exception:
        pass
    return 0

def _probe_fallback_pid():
    """Throttled fallbacks for setups without the pulsaros-focus extension."""
    env = _session_env()
    if env.get("DBUS_SESSION_BUS_ADDRESS"):
        # Works on GNOME <= 44 and builds running with Eval allowed
        try:
            res = subprocess.run(
                ["gdbus", "call", "--session", "--dest", "org.gnome.Shell",
                 "--object-path", "/org/gnome/Shell",
                 "--method", "org.gnome.Shell.Eval",
                 "global.display.focus_window ? global.display.focus_window.get_pid() : 0"],
                capture_output=True, text=True, timeout=0.3,
                env={**os.environ, **env})
            out = res.stdout.strip()
            if out.startswith("(true,") and "'" in out:
                pid = int(out.split("'")[1])
                if _pid_alive(pid):
                    return pid
        except Exception:
            pass
    # X11 / Xwayland-only fallbacks
    pid = _x11_active_pid(env)
    if pid and _pid_alive(pid):
        return pid
    if os.path.exists("/usr/bin/xdotool") and env.get("DISPLAY"):
        try:
            res = subprocess.run(["xdotool", "getwindowfocus", "getwindowpid"],
                                 capture_output=True, text=True, timeout=0.3,
                                 env={**os.environ, **env})
            if res.stdout.strip().isdigit():
                pid = int(res.stdout.strip())
                if _pid_alive(pid):
                    return pid
        except Exception:
            pass
    return 0

def detect_active_window_pid() -> int:
    """Focused window PID via the pulsaros-focus extension, then fallbacks."""
    global FOCUS_SOURCE
    now = time.time()

    # 1. Extension state file: one small read, no subprocess, no session bus
    try:
        for path in glob.glob(FOCUS_STATE_GLOB):
            try:
                if (now - os.path.getmtime(path)) > FOCUS_STATE_MAX_AGE:
                    continue
                with open(path, "r") as f:
                    data = json.load(f)
                pid = int(data.get("pid", 0))
                ts = float(data.get("ts", 0.0))
                if pid > 0 and (now - ts) <= FOCUS_STATE_MAX_AGE and _pid_alive(pid):
                    FOCUS_SOURCE = "pulsaros-focus extension"
                    return pid
            except Exception:
                continue
    except Exception:
        pass

    # 2. Fallbacks, probed at most once every FALLBACK_PROBE_INTERVAL seconds
    if (now - FALLBACK_PROBE["ts"]) >= FALLBACK_PROBE_INTERVAL:
        FALLBACK_PROBE["ts"] = now
        FALLBACK_PROBE["pid"] = _probe_fallback_pid()
    if FALLBACK_PROBE["pid"] > 0 and _pid_alive(FALLBACK_PROBE["pid"]):
        FOCUS_SOURCE = "session fallback (Eval/xprop)"
        return FALLBACK_PROBE["pid"]

    FOCUS_SOURCE = "none"
    return 0

# -----------------------------------------------------------------------------
# Classification & policy
# -----------------------------------------------------------------------------
def classify(comm: str, is_focused: bool, override, cpu_ema: float, level: int):
    """Highest-priority category for a process (order = priority order)."""
    if override is not None:
        return "pin"
    if comm in CORE15:
        return "core"
    if is_focused:
        return "focused"
    if comm in SHELL15:
        return None
    if comm in THROTTLE15:
        return "idle"
    if comm in GUI15 or HABIT_ENGINE.get_habit_score(comm) >= 0.35:
        return "gui"
    if comm in DEV15:
        return "dev"
    if comm in VM15:
        return "vm"
    if comm in CONTAINER15:
        return "container"
    if comm in MEDIA15:
        return "media"
    if level >= 1 and cpu_ema >= BUSY_BACKGROUND_CPU_PCT:
        return "busy"
    return None

def policy_target(category: str, level: int, habit_boost: int = 0):
    """(nice, io_class, io_prio) for a category at this load level, or None."""
    if category == "pin":
        return None
    if category == "core":
        # Absolute top priority at every level: the desktop must stay smooth.
        if level >= 4:
            return (CORE_NICE[level], 1, 2)   # realtime I/O at critical load
        return (CORE_NICE[level], 2, 0)
    if category == "focused":
        return (FOCUS_NICE[level], 2, 0)
    if category == "idle":
        return (19, 3, 0)
    if category == "gui":
        return (max(-12, GUI_NICE[level] - habit_boost), 2, GUI_IO_PRIO[level])
    table = _CLASS_TABLES[category]
    if category == "busy" and level == 0:
        return None
    io_class, io_prio = BG_IO[level]
    return (table[level], io_class, io_prio)

# -----------------------------------------------------------------------------
# Background cgroup (soft CPU ceiling + memory.high)
# -----------------------------------------------------------------------------
def setup_bg_cgroup():
    """Create the shared cgroup that keeps background work in a low regime."""
    global CGROUP_OK, BG_MEMBERS, LAST_CPU_CAP, LAST_MEM_HIGH
    try:
        os.makedirs(CGROUP_DIR, exist_ok=True)
        if _sys_write(f"{CGROUP_DIR}/cpu.max", "max 100000"):
            LAST_CPU_CAP = "max 100000"
        if _sys_write(f"{CGROUP_DIR}/memory.high", "max"):
            LAST_MEM_HIGH = "max"
        try:
            with open(f"{CGROUP_DIR}/cgroup.procs", "r") as f:
                BG_MEMBERS = {int(x) for x in f.read().split() if x.strip()}
        except Exception:
            BG_MEMBERS = set()
        CGROUP_OK = True
        log(f"Background resource governor ready ({CGROUP_DIR}, {len(BG_MEMBERS)} members adopted)")
    except Exception as e:
        CGROUP_OK = False
        log(f"cgroup v2 governor unavailable ({e}); falling back to nice/ionice only")

def release_bg_cgroup_caps():
    if CGROUP_OK:
        _sys_write(f"{CGROUP_DIR}/cpu.max", "max 100000")
        _sys_write(f"{CGROUP_DIR}/memory.high", "max")

def _set_cpu_cap(fraction):
    global LAST_CPU_CAP
    if not CGROUP_OK:
        return
    if fraction is None:
        want = "max 100000"
    else:
        cpus = os.cpu_count() or 1
        want = f"{max(10000, int(cpus * fraction * 100000))} 100000"
    if want == LAST_CPU_CAP:
        return
    if _sys_write(f"{CGROUP_DIR}/cpu.max", want):
        LAST_CPU_CAP = want

def _set_memory_high(total_bytes: int, fraction: float):
    global LAST_MEM_HIGH
    if not CGROUP_OK:
        return
    want = "max" if fraction >= 1.0 else str(max(64 * 1024 * 1024, int(total_bytes * fraction)))
    if want == LAST_MEM_HIGH:
        return
    if _sys_write(f"{CGROUP_DIR}/memory.high", want):
        LAST_MEM_HIGH = want

def update_resource_caps(level: int, avail_ratio: float, total_bytes: int, now: float):
    """Tighten the background ceilings quickly, relax them gradually."""
    global CAP_LEVEL, CAP_LEVEL_TS, MEM_HIGH_LEVEL, MEM_HIGH_TS

    # CPU ceiling: tighten instantly, relax one step every 15s of calm
    if level > CAP_LEVEL:
        CAP_LEVEL, CAP_LEVEL_TS = level, now
    elif level < CAP_LEVEL and (now - CAP_LEVEL_TS) > 15.0:
        CAP_LEVEL, CAP_LEVEL_TS = CAP_LEVEL - 1, now
    _set_cpu_cap(BG_CPU_CAP[CAP_LEVEL])

    # Background memory ceiling: tighten instantly, relax after 30s of headroom
    if avail_ratio < MEM_HIGH_LOW_AVAIL:
        target = 0.45
    elif avail_ratio < MEM_HIGH_MID_AVAIL:
        target = 0.60
    else:
        target = 1.0
    if target < MEM_HIGH_LEVEL or (target > MEM_HIGH_LEVEL and (now - MEM_HIGH_TS) > 30.0):
        MEM_HIGH_LEVEL, MEM_HIGH_TS = target, now
        _set_memory_high(total_bytes, MEM_HIGH_LEVEL)

def _cgroup_path(pid: int) -> str:
    try:
        with open(f"/proc/{pid}/cgroup", "r") as f:
            for line in f:
                if line.startswith("0::"):
                    return line.strip().split("::", 1)[1]
    except Exception:
        pass
    return ""

def _session_owned(cgroup: str) -> bool:
    """Eligible for migration into the background cgroup.

    Only user-launched work qualifies: session scopes and app scopes launched
    from a terminal or the desktop (both live under /user.slice and end in
    .scope). System services (system.slice) and user services
    (user@...service/*.service) are never touched, so `systemctl stop` on them
    keeps working — systemd only kills processes still in the unit's cgroup.
    """
    return cgroup == "/" or (cgroup.startswith("/user.slice/") and cgroup.endswith(".scope"))

def _update_membership(pid: int, should_be_member: bool, cgroup: str):
    """Move a process in/out of the background cgroup as its role changes."""
    global BG_MEMBERS
    if not CGROUP_OK:
        return
    is_member = pid in BG_MEMBERS
    if should_be_member and not is_member:
        if not _session_owned(cgroup):
            return
        if _sys_write(f"{CGROUP_DIR}/cgroup.procs", str(pid)):
            BG_MEMBERS.add(pid)
    elif not should_be_member and is_member:
        if _sys_write("/sys/fs/cgroup/cgroup.procs", str(pid)):
            BG_MEMBERS.discard(pid)

# -----------------------------------------------------------------------------
# Main optimization pass
# -----------------------------------------------------------------------------
def optimize_process_priorities(level: int, interval: float):
    """Converge every process to the policy for this load level.

    Each loop compares the *actual* nice value with the policy target, so
    focus changes, GUI pins, load changes and external renices all converge
    without needing to re-scan everything on transitions.
    """
    global PROCESSED_PIDS, PREV_PID_STAT, PROC_CPU_EMA
    global LAST_ACTIVE_PID, LAST_ACTIVE_TS, PREV_FOCUSED_PID
    try:
        now = time.time()
        cpu_valid = interval <= 10.0          # sane after suspend/resume
        step = interval if 0.0 < interval < 15.0 else 1.0

        # ---- focused window (extension first) ----
        focused_pid = detect_active_window_pid()
        if focused_pid > 0:
            LAST_ACTIVE_PID, LAST_ACTIVE_TS = focused_pid, now
        elif LAST_ACTIVE_PID > 0 and (now - LAST_ACTIVE_TS) < FOCUS_HOLD_SEC and _pid_alive(LAST_ACTIVE_PID):
            focused_pid = LAST_ACTIVE_PID
        else:
            focused_pid = 0

        if focused_pid != PREV_FOCUSED_PID:
            if focused_pid <= 0:
                HABIT_ENGINE.end_focus()
            PREV_FOCUSED_PID = focused_pid

        active_pids = set()

        for pid_str in os.listdir("/proc"):
            if not pid_str.isdigit():
                continue
            pid = int(pid_str)
            if pid <= 2 or pid == os.getpid():
                continue
            try:
                with open(f"/proc/{pid_str}/stat", "r") as f:
                    raw = f.read()
            except Exception:
                continue

            lparen = raw.find("(")
            rparen = raw.rfind(")")
            if lparen < 0 or rparen < lparen:
                continue
            try:
                comm = raw[lparen + 1:rparen]
                rest = raw[rparen + 2:].split()
                jiffies = int(rest[11]) + int(rest[12])
                nice = int(rest[16])
            except Exception:
                continue

            # Kernel threads and zombies expose no executable: never manage them.
            try:
                os.readlink(f"/proc/{pid_str}/exe")
            except Exception:
                continue

            active_pids.add(pid)

            # ---- per-process CPU (share of the whole machine, EMA-smoothed) ----
            prev = PREV_PID_STAT.get(pid)
            cpu_pct = 0.0
            if prev is not None and cpu_valid and interval > 0:
                delta = jiffies - prev
                if delta >= 0:
                    cpu_pct = min(400.0, 100.0 * delta / (CLK_TCK * interval))
            PREV_PID_STAT[pid] = jiffies
            ema = PROC_CPU_EMA.get(pid)
            ema = cpu_pct if ema is None else (ema * 0.5) + (cpu_pct * 0.5)
            PROC_CPU_EMA[pid] = ema

            is_focused = (pid == focused_pid)
            override = HABIT_ENGINE.get_user_override(comm)

            # ---- habit learning ----
            if is_focused:
                HABIT_ENGINE.record_focus(comm, step)
            elif comm in GUI15 or comm in HABIT_ENGINE.habits:
                HABIT_ENGINE.record_background(comm, step)

            if comm in SELF_COMM:
                continue

            # ---- policy ----
            category = classify(comm, is_focused, override, ema, level)
            pinned_now = override is not None
            target = None
            if category == "pin":
                target = PRIORITY_PINS.get(override)
            elif category is not None:
                habit = HABIT_ENGINE.get_habit_score(comm)
                habit_boost = min(3, int((habit - 0.35) * 6)) if category == "gui" else 0
                target = policy_target(category, level, habit_boost)

            entry = PROCESSED_PIDS.get(pid)
            if entry is not None:
                if entry.pinned != pinned_now:
                    # Pin added/removed: re-baseline and re-engage the policy.
                    entry.orig = nice
                    entry.nice = nice
                    entry.pinned = pinned_now
                    entry.manual = False
                elif nice != entry.nice:
                    # Reniced outside this daemon (manual renice): honor it.
                    entry.orig = nice
                    entry.nice = nice
                    entry.manual = True
                if entry.manual:
                    # Explicit human intent wins until the process exits.
                    continue

            # Background cgroup membership follows the process' role
            should_be_member = (
                CGROUP_OK
                and category in BG_CATEGORIES
                and not is_focused
                and not pinned_now
            )
            if should_be_member or (entry is not None and pid in BG_MEMBERS):
                _update_membership(pid, should_be_member, _cgroup_path(pid))

            if target is None:
                # Policy stepped aside: restore the baseline once, then stop.
                if entry is not None:
                    if entry.nice != entry.orig and nice == entry.nice:
                        try:
                            os.setpriority(os.PRIO_PROCESS, pid, entry.orig)
                        except Exception:
                            pass
                        set_ioprio(pid, 2, 4)
                    del PROCESSED_PIDS[pid]
                continue

            t_nice, io_class, io_prio = target
            baseline = entry.orig if entry is not None else nice
            if t_nice < 0:
                # Boosts are applied exactly: a nice inherited from a reniced
                # parent (or a launcher) is not a human decision, and a manual
                # throttle is already covered by the `manual` flag below.
                applied = t_nice
            else:
                # Throttles never push a process below its own baseline, so a
                # workload the user niced down by hand stays niced down.
                applied = max(t_nice, baseline)

            io_wanted = (io_class, io_prio)
            changed = applied != nice
            io_changed = entry is None or entry.io != io_wanted
            if changed:
                try:
                    os.setpriority(os.PRIO_PROCESS, pid, applied)
                except Exception:
                    pass
                io_changed = True
            if io_changed:
                set_ioprio(pid, io_class, io_prio)

            if entry is None:
                PROCESSED_PIDS[pid] = _ProcState(applied, baseline, io_wanted, pinned_now)
            else:
                entry.nice = applied
                entry.io = io_wanted
                entry.pinned = pinned_now

        # Prune terminated PIDs from caches
        for dead in list(PROCESSED_PIDS.keys()):
            if dead not in active_pids:
                del PROCESSED_PIDS[dead]
                BG_MEMBERS.discard(dead)
        for dead in list(PREV_PID_STAT.keys()):
            if dead not in active_pids:
                del PREV_PID_STAT[dead]
                PROC_CPU_EMA.pop(dead, None)

    except Exception as e:
        warn_once(f"optimization pass failed: {e!r}")

# -----------------------------------------------------------------------------
# Memory pressure handling
# -----------------------------------------------------------------------------
def check_memory_pressure_and_radical_reclaim(psi_stats):
    """Never let memory reach unrecoverable saturation.

    The moderate tier only drops clean page cache and compacts; the radical
    tier (below 10% available) flushes everything. Both are rate limited so
    the reclaim itself cannot become the stall.
    """
    global LAST_MEMORY_TRIM_TIME
    try:
        now = time.time()
        mem = read_meminfo()
        total_mb = mem.get("MemTotal", 1024 * 1024) // 1024
        available_mb = mem.get("MemAvailable", 1024 * 1024) // 1024
        avail_ratio = (available_mb / total_mb) if total_mb > 0 else 1.0

        # Radical: Available < 10% or < 400MB or heavy PSI stall
        if avail_ratio < 0.10 or available_mb < 400 or psi_stats["mem_some"] > 20.0 or psi_stats["mem_full"] > 1.0:
            if (now - LAST_MEMORY_TRIM_TIME) > 15.0:
                log(f"RADICAL memory reclaim (Available: {available_mb}/{total_mb} MB [{int(avail_ratio*100)}%], "
                    f"PSI: Some {psi_stats['mem_some']:.1f}% | Full {psi_stats['mem_full']:.1f}%)...")
                LAST_MEMORY_TRIM_TIME = now
                _sys_write("/proc/sys/vm/drop_caches", "3")
                _sys_write("/proc/sys/vm/compact_memory", "1")
                _sys_write("/proc/sys/vm/swappiness", "180")

        # Moderate: Available < 20% or < 800MB or rising PSI stall
        elif avail_ratio < 0.20 or available_mb < 800 or psi_stats["mem_some"] > 10.0:
            if (now - LAST_MEMORY_TRIM_TIME) > 45.0:
                log(f"Proactive memory compaction (Available: {available_mb}/{total_mb} MB [{int(avail_ratio*100)}%], "
                    f"PSI: Some {psi_stats['mem_some']:.1f}%)...")
                LAST_MEMORY_TRIM_TIME = now
                _sys_write("/proc/sys/vm/drop_caches", "1")
                _sys_write("/proc/sys/vm/compact_memory", "1")
    except Exception:
        pass

# -----------------------------------------------------------------------------
# Status
# -----------------------------------------------------------------------------
def show_status():
    """Display real-time optimization statistics and governor status."""
    global CPU_SMOOTH
    # A standalone --status process starts with no history: prime the meter
    # with a short real sample instead of printing a fake 0.0%.
    if CPU_SMOOTH is None:
        get_cpu_utilization()
        time.sleep(0.35)
    level, mode, cpu_smooth, psi = compute_load_state()
    level_names = {
        0: "REST (idle, no ceilings)",
        1: "LIGHT (soft regime: background capped at 70%)",
        2: "MODERATE (background capped at 50%)",
        3: "ELEVATED (background capped at 35%, balancing active)",
        4: "CRITICAL (background capped at 25%, zero-lag protection)",
    }

    focused_pid = detect_active_window_pid()
    focused_comm = ""
    if focused_pid > 0:
        try:
            with open(f"/proc/{focused_pid}/comm", "r") as f:
                focused_comm = f.read().strip()
        except Exception:
            focused_comm = "?"

    print("=" * 70)
    print("PULSAR OS OPTIMIZER - FLUIDITY, HABIT LEARNING & LOW REGIME ENGINE")
    print("=" * 70)

    print(f"\nGOVERNOR:")
    print(f"  Load Level:             {level} - {level_names.get(level, 'UNKNOWN')}")
    print(f"  Smoothed CPU Load:      {cpu_smooth:.1f}%")
    print(f"  CPU Pressure Stall:     {psi['cpu_some']:.1f}%")
    print(f"  Disk I/O Pressure:      Some {psi['io_some']:.1f}% | Full {psi['io_full']:.1f}%")
    print(f"  Memory Pressure Stall:  Some {psi['mem_some']:.1f}% | Full {psi['mem_full']:.1f}%")

    print(f"\nFOCUSED WINDOW:")
    if focused_pid > 0:
        print(f"  Source:                 {FOCUS_SOURCE}")
        print(f"  PID {focused_pid} ({focused_comm}) - boosted to nice {FOCUS_NICE[level]}")
    else:
        print(f"  Source:                 {FOCUS_SOURCE}")
        print("  No focused window known (install/enable pulsaros-focus + relogin).")

    print(f"\nBACKGROUND RESOURCE CEILING (cgroup v2):")
    try:
        with open(f"{CGROUP_DIR}/cpu.max") as f:
            cpu_max = f.read().strip()
        with open(f"{CGROUP_DIR}/memory.high") as f:
            mem_high = f.read().strip()
        with open(f"{CGROUP_DIR}/cgroup.procs") as f:
            members = len([x for x in f.read().split() if x.strip()])
        print(f"  cpu.max:                {cpu_max}")
        print(f"  memory.high:            {mem_high} bytes")
        print(f"  Members in background:  {members}")
    except Exception:
        print("  Status:                 unavailable (nice/ionice tiers only)")

    # 1. Memory & zRAM
    mem = read_meminfo()
    total_mb = mem.get("MemTotal", 0) // 1024
    avail_mb = mem.get("MemAvailable", 0) // 1024
    used_mb = total_mb - avail_mb

    print(f"\nSYSTEM MEMORY:")
    print(f"  Total RAM:              {total_mb} MB ({total_mb/1024:.1f} GB)")
    print(f"  Used:                   {used_mb} MB ({used_mb/1024:.1f} GB)")
    print(f"  Available:              {avail_mb} MB ({avail_mb/1024:.1f} GB)")

    zstats = get_zram_stats()
    print(f"\nzRAM COMPRESSION:")
    if zstats["active"]:
        print(f"  Algorithm:              {zstats['algorithm']}")
        print(f"  Allocated Device Size:  {zstats['disksize_mb']:.1f} MB")
        print(f"  Uncompressed In-Use:    {zstats['orig_data_mb']:.1f} MB")
        print(f"  Compressed Stored:      {zstats['compr_data_mb']:.1f} MB")
        print(f"  Compression Ratio:      {zstats['ratio']}")
        print(f"  Net RAM Saved:          {zstats['saved_mb']:.1f} MB")
    else:
        print("  Status:                 Inactive")

    # 2. Kernel VM Sysctls
    print(f"\nKERNEL LATENCY PARAMETERS:")
    try:
        for p in [
            "/proc/sys/vm/swappiness",
            "/proc/sys/vm/vfs_cache_pressure",
            "/proc/sys/vm/page-cluster",
            "/proc/sys/kernel/sched_autogroup_enabled",
            "/proc/sys/vm/watermark_scale_factor"
        ]:
            if os.path.exists(p):
                with open(p, "r") as f:
                    print(f"  {os.path.basename(os.path.dirname(p))}.{os.path.basename(p)}: {f.read().strip()}")
    except Exception as e:
        print(f"  Error reading sysctls: {e}")

    # 3. Learned Habit Profiles
    print(f"\nLEARNED USER PROFILES & ACTIVE HABITS:")
    top_habits = sorted(HABIT_ENGINE.habits.items(), key=lambda x: -x[1].get("focus_seconds", 0))[:8]
    if top_habits:
        for comm, h in top_habits:
            mins = h.get("focus_seconds", 0) / 60.0
            print(f"  - {comm:20s}: Habit Score {h.get('habit_score', 0):.2f} "
                  f"({mins:.1f} mins focused, {h.get('focus_count', 0)} sessions)")
    else:
        print("  Model learning active. Initial profile building in progress.")
    if HABIT_ENGINE.user_overrides:
        print(f"  Manual pins: {', '.join(f'{k}=P{v}' for k, v in HABIT_ENGINE.user_overrides.items())}")

    # 4. Process priorities
    print(f"\nDYNAMIC PROCESS SCHEDULER (load level {level}):")
    boosted = []
    throttled = []
    try:
        for pid_str in [p for p in os.listdir("/proc") if p.isdigit()]:
            try:
                with open(f"/proc/{pid_str}/comm", "r") as f:
                    comm = f.read().strip()
                pid = int(pid_str)
                with open(f"/proc/{pid_str}/stat", "r") as f:
                    stat = f.read().split()
                    nice = int(stat[18])
                if (comm in CORE_DESKTOP_PROCESSES or comm in USER_GUI_APPS
                        or HABIT_ENGINE.get_habit_score(comm) > 0.4) and nice < 0:
                    boosted.append((comm, pid, nice))
                elif (comm in THROTTLE_PROCESS_NAMES or comm in DEV_BUILD_TOOLS
                      or comm in HYPERVISOR_VM_PROCESSES or comm in CONTAINER_ENGINES
                      or comm in HEAVY_MEDIA_TOOLS) and nice > 0:
                    throttled.append((comm, pid, nice))
            except Exception:
                continue
    except Exception:
        pass

    if boosted:
        print("  Boosted Responsive Desktop Apps:")
        for comm, pid, nice in sorted(set(boosted)):
            print(f"     - {comm} (PID {pid}): Nice {nice}")
    if throttled:
        print("  Balanced Heavy Background Tasks:")
        for comm, pid, nice in sorted(set(throttled)):
            print(f"     - {comm} (PID {pid}): Nice {nice}")
    if not throttled and not boosted:
        print("  No special process adjustments active.")

    print("=" * 70 + "\n")

# -----------------------------------------------------------------------------
# Setup
# -----------------------------------------------------------------------------
def setup_zram_and_sysctl():
    """Configure hardware-adaptive zRAM compression and low-latency kernel sysctls."""
    try:
        meminfo = read_meminfo()
        total_kb = meminfo.get("MemTotal", 4 * 1024 * 1024)
        total_mb = total_kb // 1024

        log(f"Detected physical RAM: {total_mb} MB ({total_mb/1024:.1f} GB)")

        # Hardware-adaptive swappiness:
        # <= 4GB RAM: 180 (Aggressively compress cold memory into zRAM, zero disk thrashing)
        # 4GB - 16GB RAM: 150 (Optimal multi-tasking balance for developer/office workloads)
        # > 16GB RAM: 100 (High performance for massive workloads)
        if total_mb <= 4096:
            target_swappiness = "180"
            zram_target_size = int(total_kb * 1024)  # 100% of RAM
        elif total_mb <= 16384:
            target_swappiness = "150"
            zram_target_size = min(int(total_kb * 1024), 8 * 1024 * 1024 * 1024)  # up to 8GB
        else:
            target_swappiness = "100"
            zram_target_size = min(int((total_kb * 1024) // 2), 16 * 1024 * 1024 * 1024)  # 50% of RAM up to 16GB

        # 1. Kernel sysctl optimizations for maximum desktop fluidity
        sysctls = {
            "/proc/sys/vm/swappiness": target_swappiness,
            "/proc/sys/vm/vfs_cache_pressure": "50",      # Retain directory/inode cache for snappy app launch
            "/proc/sys/vm/page-cluster": "0",             # 0-latency 1-page zRAM compression
            "/proc/sys/vm/dirty_ratio": "10",             # Prevent massive disk write stalls
            "/proc/sys/vm/dirty_background_ratio": "5",
            "/proc/sys/vm/dirty_writeback_centisecs": "1500",
            "/proc/sys/vm/dirty_expire_centisecs": "3000",
            "/proc/sys/vm/watermark_scale_factor": "150",  # Smooth background page reclaim before stalls
            "/proc/sys/vm/compaction_proactiveness": "20",
            "/proc/sys/kernel/sched_autogroup_enabled": "1",  # Isolate heavy terminal/build trees from GUI session
            "/proc/sys/kernel/sched_cfs_bandwidth_slice_us": "3000",  # Lower CFS slice for responsive UI frames
        }

        for path, val in sysctls.items():
            if os.path.exists(path):
                _sys_write(path, val)

        # 2. Ensure zram module is loaded
        try:
            subprocess.run(["modprobe", "zram"], capture_output=True)
        except Exception:
            pass

        # 3. Check if zRAM is already active in /proc/swaps
        zram_active = False
        try:
            with open("/proc/swaps", "r") as f:
                if "zram" in f.read():
                    zram_active = True
        except Exception:
            pass

        if not zram_active:
            if os.path.exists("/sys/block/zram0"):
                # Try preferred compression algorithms: zstd -> lz4 -> lzo-rle
                for algo in ["zstd", "lz4", "lzo-rle"]:
                    if _sys_write("/sys/block/zram0/comp_algorithm", algo):
                        break

                _sys_write("/sys/block/zram0/reset", "1")
                _sys_write("/sys/block/zram0/disksize", str(zram_target_size))
                try:
                    subprocess.run(["mkswap", "/dev/zram0"], capture_output=True)
                    # Swapon with highest possible priority 32767 so zRAM is used before any disk swap
                    subprocess.run(["swapon", "-p", "32767", "/dev/zram0"], capture_output=True)
                    log(f"Configured zRAM swap (/dev/zram0, {zram_target_size // (1024*1024)} MB, "
                        f"priority 32767, swappiness {target_swappiness})")
                except Exception as ze:
                    log(f"zRAM activation notice: {ze}")
            else:
                log("zRAM device /dev/zram0 not present.")
        else:
            log("zRAM is already active.")
    except Exception as e:
        log(f"Error in setup_zram_and_sysctl: {e}")

# -----------------------------------------------------------------------------
# CLI helpers
# -----------------------------------------------------------------------------
def launch_gui():
    gui_bin = "/usr/bin/pulsaros-optimizer-gui"
    if os.path.exists(gui_bin):
        os.execv(gui_bin, [gui_bin] + sys.argv[1:])
    else:
        script_dir = os.path.dirname(os.path.abspath(__file__))
        local_gui = os.path.join(script_dir, "pulsaros-optimizer-gui")
        if os.path.exists(local_gui):
            os.execv(sys.executable, [sys.executable, local_gui] + sys.argv[1:])

def _cli_clear_habits():
    count = len(HABIT_ENGINE.habits)
    HABIT_ENGINE.habits = {}
    HABIT_ENGINE.save()
    log(f"Cleared {count} learned habit profiles (manual pins kept).")
    sys.exit(0)

def _cli_forget_habit(comm: str):
    removed = HABIT_ENGINE.habits.pop(comm, None)
    HABIT_ENGINE.save()
    if removed is not None:
        log(f"Forgot habit profile for '{comm}'.")
    else:
        log(f"No habit profile for '{comm}'.")
    sys.exit(0)

def _on_exit():
    if not DAEMON_RUNNING:
        return
    try:
        HABIT_ENGINE.save()
    except Exception:
        pass
    try:
        release_bg_cgroup_caps()
    except Exception:
        pass

def _on_signal(signum, frame):
    global RUNNING
    RUNNING = False

def main():
    global DAEMON_RUNNING, RUNNING
    if len(sys.argv) > 1:
        arg = sys.argv[1]
        if arg in ["--status", "-s", "status"]:
            show_status()
            sys.exit(0)
        elif arg in ["--gui", "-g", "gui"]:
            launch_gui()
            sys.exit(0)
        elif arg in ["--clear-habits"]:
            _cli_clear_habits()
        elif arg in ["--forget-habit"] and len(sys.argv) > 2:
            _cli_forget_habit(sys.argv[2])
        elif arg in ["--start"]:
            subprocess.run(["systemctl", "start", "pulsaros-optimizer.service"])
            sys.exit(0)
        elif arg in ["--stop"]:
            subprocess.run(["systemctl", "stop", "pulsaros-optimizer.service"])
            sys.exit(0)
        elif arg in ["--restart"]:
            subprocess.run(["systemctl", "restart", "pulsaros-optimizer.service"])
            sys.exit(0)

    # If launched in graphical session by user without flags, open the GUI
    if os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"):
        if os.geteuid() != 0 and sys.stdin.isatty():
            launch_gui()
            sys.exit(0)

    log("Starting Pulsar OS Universal Dynamic Adaptive Optimizer & Real Habit Engine...")
    setup_zram_and_sysctl()
    setup_bg_cgroup()

    signal.signal(signal.SIGTERM, _on_signal)
    signal.signal(signal.SIGINT, _on_signal)
    atexit.register(_on_exit)
    DAEMON_RUNNING = True

    log("Governor active: priorities (shell/audio > focused app > GUI > background), "
        "soft CPU/RAM ceilings, PSI watch, habit engine (pulsaros-focus).")
    loop_count = 0
    prev_time = time.time()
    while RUNNING:
        try:
            curr_time = time.time()
            loop_interval = max(0.1, curr_time - prev_time)
            prev_time = curr_time

            level, mode, cpu_smooth, psi = compute_load_state()
            mem = read_meminfo()
            total_bytes = mem.get("MemTotal", 1024 * 1024 * 1024) * 1024
            total_mb = total_bytes // (1024 * 1024)
            avail_mb = mem.get("MemAvailable", total_mb) // 1024
            avail_ratio = (avail_mb / total_mb) if total_mb > 0 else 1.0

            optimize_process_priorities(level, loop_interval)
            update_resource_caps(level, avail_ratio, total_bytes, time.time())
            check_memory_pressure_and_radical_reclaim(psi)

            loop_count += 1
            if loop_count % 30 == 0:
                HABIT_ENGINE.refresh_overrides()
            if loop_count % 120 == 0:
                zstats = get_zram_stats()
                zram_info = (f"zRAM Saved: {zstats['saved_mb']:.1f} MB (Ratio: {zstats['ratio']})"
                             if zstats["active"] else "zRAM inactive")
                log(f"Status: Level {level} | CPU {cpu_smooth:.1f}% | PSI CPU {psi['cpu_some']:.1f}% | "
                    f"IO Full {psi['io_full']:.1f}% | RAM free {avail_mb} MB | focus: {FOCUS_SOURCE} | {zram_info}")

            # Scan faster while the machine is busy, relax when it is calm
            sleep_sec = 1.0 if level > 0 else 2.0
            time.sleep(sleep_sec)
        except KeyboardInterrupt:
            break
        except Exception as e:
            warn_once(f"governor loop failed: {e!r}")
            time.sleep(2.0)

    log("Shutting down optimizer daemon (habits saved, ceilings released).")

if __name__ == "__main__":
    main()
