# -----------------------------------------------------------------------------
# cgroup v2 isolation (primary anti-saturation mechanism).
#
# The daemon (root) creates /sys/fs/cgroup/pulsaros/{core,fg,bg}. When the
# kernel exposes the cpu+memory controllers, EVERY user app runs inside a
# capped cgroup instead of being SIGSTOPed:
#   - pulsaros/core : the desktop (gnome-shell, mutter, pipewire, ...) lives
#                     here UNCAPTED with the maximal cpu/io weight -> GNOME is
#                     always fluid, window switching never starves.
#   - pulsaros/fg   : the FOCUSED app + its whole tree. Capped per tier -> the
#                     focused app is throttled, never frozen, and can never
#                     pin the CPU or exhaust RAM on its own.
#   - pulsaros/bg   : every other session user process. Capped tighter.
# The SIGSTOP ladder below stays as an automatic fallback for kernels without
# cpu/memory controllers.
# -----------------------------------------------------------------------------
CGROUPS_OK = False
CGCORE = "/sys/fs/cgroup/pulsaros/core"
CGFG = "/sys/fs/cgroup/pulsaros/fg"
CGBG = "/sys/fs/cgroup/pulsaros/bg"
CGMAP = "/run/pulsaros-cgmap.json"   # pid -> original cgroup (restore on exit)
_NPROC = os.cpu_count() or 4
_CG_PERIOD = 100000                  # 100 ms quota period
_CG_PLACED = {}                      # pid -> cgroup we moved it to
_CG_ORIG = {}                        # pid -> original cgroup path (restore map)
_CG_LAST_FOCUSED = 0
_CG_LAST_PLACE = 0.0
# CPU caps: fraction of ALL cores allowed to the cgroup (1.0 = uncapped).
_CPU_CAP_FG = {0: 1.0, 1: 1.0, 2: 0.90, 3: 0.75}
_CPU_CAP_BG = {0: 1.0, 1: 0.80, 2: 0.60, 3: 0.40}
# Memory caps: fraction of total RAM. high = throttle via reclaim (slow the
# app, never kill); max = hard ceiling (cgroup-local OOM only at deep tiers).
_MEM_HIGH_FG = {0: None, 1: 0.85, 2: 0.70, 3: 0.55, 4: 0.40}
_MEM_MAX_FG  = {0: None, 1: None, 2: 0.85, 3: 0.70, 4: 0.55}
_MEM_HIGH_BG = {0: None, 1: 0.55, 2: 0.40, 3: 0.28, 4: 0.18}
_MEM_MAX_BG  = {0: None, 1: 0.70, 2: 0.55, 3: 0.40, 4: 0.25}

HARD_DENY = {"systemd", "dbus-daemon", "dbus-broker", "systemd-journald"}
# Stateless/restartable services that are safe to SIGTERM on a memory emergency
SAFE_KILL15 = set(THROTTLE15)

# Processes that the anti-saturation ladder must NEVER freeze, stop or kill:
# desktop core, session/DBus/input/file-access/security infra, the compositors
# (incl. the Pulsar devkit/codexbar display), gjs (GNOME Shell's JS engine),
# sandbox/runtime helpers and Pulsar's own services. User apps can still be
# frozen at the strongest tiers; the infrastructure that keeps the desktop
# alive never is.
