# -----------------------------------------------------------------------------
# Genuine Habit Learning Engine (Persistent Model)
# -----------------------------------------------------------------------------
HABIT_DB_PATHS = [
    "/var/lib/pulsaros/optimizer_habits.json",
    os.path.expanduser("~/.local/share/pulsaros/optimizer_habits.json"),
    "/tmp/pulsaros_optimizer_habits.json"
]

class HabitLearningEngine:
    def __init__(self):
        self.db_path = self._resolve_db_path()
        # Read from the first location that exists (root-owned /var/lib is
        # readable by everyone), write only where we actually have permission.
        self.read_paths = [p for p in HABIT_DB_PATHS if os.path.exists(p)]
        self.habits = {}
        self.user_overrides = {}
        self.last_save_time = time.time()
        self._focus_comm = None
        self._focus_change_ts = 0.0
        self.load()
        self.refresh_overrides()
        self._recompute_scores()
        self.prune()

    def _resolve_db_path(self):
        for p in HABIT_DB_PATHS:
            try:
                d = os.path.dirname(p)
                if not os.path.exists(d):
                    os.makedirs(d, exist_ok=True)
                # Test write capability
                if os.access(d, os.W_OK):
                    return p
            except Exception:
                continue
        return "/tmp/pulsaros_optimizer_habits.json"

    def load(self):
        for p in self.read_paths or HABIT_DB_PATHS:
            try:
                if not os.path.exists(p):
                    continue
                with open(p, "r") as f:
                    data = json.load(f)
                self.habits = data.get("habits", {})
                self.user_overrides = data.get("user_overrides", {})
                return
            except Exception:
                continue
        self.habits = {}
        self.user_overrides = {}

    def refresh_overrides(self):
        """Merge manual pins from every DB location (newest value wins).

        The GUI runs as the unprivileged user and can only write to the home
        fallback, while this root daemon owns /var/lib: without this merge the
        pins set in the GUI would silently never reach the daemon.
        """
        try:
            entries = []
            for p in HABIT_DB_PATHS:
                try:
                    if not os.path.exists(p):
                        continue
                    with open(p, "r") as f:
                        data = json.load(f)
                    entries.append((os.path.getmtime(p), data.get("user_overrides") or {}))
                except Exception:
                    continue
            entries.sort(key=lambda x: x[0])
            merged = {}
            for _, overrides in entries:
                merged.update(overrides)
            self.user_overrides = merged
        except Exception:
            pass

    @staticmethod
    def _score(entry) -> float:
        """[0.0 = never used in the foreground, 1.0 = core daily app]."""
        focus_hrs = entry.get("focus_seconds", 0.0) / 3600.0
        sessions = min(entry.get("focus_count", 0), 25)
        return round(min(1.0, (focus_hrs * 0.5) + (sessions * 0.02)), 3)

    def _recompute_scores(self):
        for entry in self.habits.values():
            entry["habit_score"] = self._score(entry)

    def prune(self):
        """Drop profiles that never saw real foreground focus (noise/junk).

        Manual pins are always kept, so nothing the user configured is lost.
        """
        pinned = set(self.user_overrides.keys())
        before = len(self.habits)
        self.habits = {
            comm: e for comm, e in self.habits.items()
            if e.get("focus_seconds", 0.0) > 0.0 or comm in pinned
        }
        dropped = before - len(self.habits)
        if dropped:
            log(f"Pruned {dropped} habit profiles without foreground focus (pinned entries kept).")
            # Only the root daemon persists this: read-only CLI runs must not
            # leave a stray copy of the database in the caller's home.
            if os.geteuid() == 0:
                self.save()

    def save(self):
        try:
            d = os.path.dirname(self.db_path)
            os.makedirs(d, exist_ok=True)
            tmp_path = f"{self.db_path}.tmp"
            data = {
                "version": 2,
                "last_updated": time.time(),
                "habits": self.habits,
                "user_overrides": self.user_overrides
            }
            with open(tmp_path, "w") as f:
                json.dump(data, f, indent=2)
            os.replace(tmp_path, self.db_path)
            self.last_save_time = time.time()
        except Exception:
            pass

    def _entry(self, comm: str):
        return self.habits.setdefault(comm, {
            "focus_seconds": 0.0,
            "focus_count": 0,
            "background_seconds": 0.0,
            "last_active": 0.0,
            "habit_score": 0.0
        })

    def record_focus(self, comm: str, duration_sec: float):
        """Accumulate foreground time; count a new session on focus *change*."""
        if not comm:
            return
        now = time.time()
        if self._focus_comm != comm:
            if (now - self._focus_change_ts) > 2.0:
                self._entry(comm)["focus_count"] += 1
            self._focus_comm = comm
            self._focus_change_ts = now
        entry = self._entry(comm)
        entry["last_active"] = now
        if 0.0 < duration_sec < 15.0:
            entry["focus_seconds"] += duration_sec
        entry["habit_score"] = self._score(entry)
        if (now - self.last_save_time) > 60.0:
            self.save()

    def record_background(self, comm: str, duration_sec: float):
        """Track background time for GUI/known apps only (keeps the DB honest)."""
        if not comm:
            return
        if comm not in self.habits and comm not in GUI15:
            return
        entry = self._entry(comm)
        entry["last_active"] = time.time()
        if 0.0 < duration_sec < 15.0:
            entry["background_seconds"] += duration_sec
        if (time.time() - self.last_save_time) > 60.0:
            self.save()

    def end_focus(self):
        """Called when no focused window is known, so sessions count correctly."""
        self._focus_comm = None

    def set_user_override(self, comm: str, prio_idx: int):
        """Save manual user preference (0=Turbo, 1=High, 2=Normal, 3=Low)."""
        self.user_overrides[comm] = prio_idx
        self.save()

    def get_user_override(self, comm: str):
        return self.user_overrides.get(comm, None)

    def get_habit_score(self, comm: str) -> float:
        if comm in self.habits:
            return self.habits[comm].get("habit_score", 0.0)
        return 0.1

HABIT_ENGINE = HabitLearningEngine()

# -----------------------------------------------------------------------------
# Runtime State & Cache
# -----------------------------------------------------------------------------
class _ProcState:
    """What we last applied to a process (and what it looked like before)."""
    __slots__ = ("nice", "orig", "io", "pinned", "manual")

    def __init__(self, nice, orig, io, pinned, manual=False):
        self.nice = nice        # last nice value written by us
        self.orig = orig        # baseline to return to when policy steps aside
        self.io = io            # last (io_class, io_prio) written by us
        self.pinned = pinned    # whether a user pin was active when written
        self.manual = manual    # True => changed outside the daemon, honor it

PROCESSED_PIDS = {}
PREV_PID_STAT = {}
PROC_CPU_EMA = {}
BG_MEMBERS = set()
CPU_SMOOTH = None
PREV_CPU_TIMES = None
LAST_ACTIVE_PID = 0
LAST_ACTIVE_TS = 0.0
PREV_FOCUSED_PID = 0
FOCUS_SOURCE = "none"
SESSION_ENV_CACHE = {}
SESSION_ENV_TS = 0.0
