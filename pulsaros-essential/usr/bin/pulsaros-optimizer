FOCUS_HOLD_SEC = 20.0        # keep the last known focus this long if reporting pauses
FALLBACK_PROBE_INTERVAL = 30.0

# -----------------------------------------------------------------------------
# Process Categorization & Sets
# (Kernel comm is capped at 15 chars, so matching is done on truncated names:
#  "org.gnome.Nautilus" and comm "org.gnome.Nautil" must still match.)
# -----------------------------------------------------------------------------
def _truncated(names):
    return {n[:15] for n in names}

