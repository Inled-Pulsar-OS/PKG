def read_meminfo():
    info = {}
    try:
        with open("/proc/meminfo", "r") as f:
            for line in f:
                parts = line.split(":")
                if len(parts) == 2:
                    info[parts[0].strip()] = int(parts[1].strip().split()[0])
    except Exception:
        pass
    return info

def get_cpu_utilization():
    global PREV_CPU_TIMES
    try:
        with open("/proc/stat", "r") as f:
            line = f.readline().split()
            if line[0] == "cpu":
                times = [int(x) for x in line[1:]]
                idle_time = times[3] + (times[4] if len(times) > 4 else 0)
                total_time = sum(times)
                if PREV_CPU_TIMES is None:
                    PREV_CPU_TIMES = (total_time, idle_time)
                    return 0.0
                prev_total, prev_idle = PREV_CPU_TIMES
                PREV_CPU_TIMES = (total_time, idle_time)
                d_total = total_time - prev_total
                d_idle = idle_time - prev_idle
                if d_total > 0:
                    usage = 100.0 * (1.0 - (d_idle / d_total))
                    return max(0.0, min(100.0, usage))
    except Exception:
        pass
    return 0.0

def read_psi():
    psi = {"cpu_some": 0.0, "io_some": 0.0, "io_full": 0.0, "mem_some": 0.0, "mem_full": 0.0}
    try:
        for path, keys in (("/proc/pressure/cpu", ("cpu_some",)),
                           ("/proc/pressure/io", ("io_some", "io_full")),
                           ("/proc/pressure/memory", ("mem_some", "mem_full"))):
            if not os.path.exists(path):
                continue
            with open(path, "r") as f:
                for line in f:
                    kind = keys[0].split("_")[0]
                    if not line.startswith(kind):
                        continue
                    for part in line.split():
                        if part.startswith("avg10="):
                            key = "io_some" if (kind == "io" and line.startswith("some")) else \
                                  "io_full" if (kind == "io") else \
                                  "mem_some" if (kind == "memory" and line.startswith("some")) else \
                                  "mem_full" if kind == "memory" else "cpu_some"
                            psi[key] = float(part.split("=")[1])
    except Exception:
        pass
    return psi

# -----------------------------------------------------------------------------
# Anti-saturation implementation
# -----------------------------------------------------------------------------
_ACTIVE_USER_UIDS = {}
_ACTIVE_USER_UIDS_TS = 0.0

def _active_user_uids():
    """UIDs of logged-in desktop sessions (from /run/user), refreshed 5 min."""
    global _ACTIVE_USER_UIDS, _ACTIVE_USER_UIDS_TS
    now = time.time()
    if _ACTIVE_USER_UIDS and (now - _ACTIVE_USER_UIDS_TS) < 300.0:
        return _ACTIVE_USER_UIDS
    _ACTIVE_USER_UIDS_TS = now
    uids = set()
    for d in glob.glob("/run/user/*"):
        try:
            uids.add(int(os.path.basename(d)))
        except Exception:
            continue
    _ACTIVE_USER_UIDS = uids
    return uids

def _pid_uid(pid: int) -> int:
    try:
        with open(f"/proc/{pid}/status", "r") as f:
            for line in f:
                if line.startswith("Uid:"):
                    return int(line.split()[1])
    except Exception:
        pass
    return -1

def read_mem_ratio():
    """Return (available_ratio, available_mb, total_mb)."""
    mem = read_meminfo()
    total_kb = mem.get("MemTotal", 4 * 1024 * 1024)
    avail_kb = mem.get("MemAvailable", 0)
    if not avail_kb:
        avail_kb = mem.get("MemFree", 0) + mem.get("Buffers", 0) + mem.get("Cached", 0)
    ratio = (avail_kb / total_kb) if total_kb > 0 else 1.0
    return ratio, avail_kb / 1024.0, total_kb / 1024.0

def _tiers(cpu_smooth: float, mem_ratio: float, psi, prev_cpu=None, prev_mem=None):
    """Compute (cpu_tier, mem_tier) with hysteresis when descending."""
    cpu_off = -CPU_TIER_HYST if (prev_cpu is not None and cpu_smooth < prev_cpu) else 0.0
    if cpu_smooth >= CPU_FREEZE_L3 + cpu_off:
        cpu_tier = 3
    elif cpu_smooth >= CPU_FREEZE_L2 + cpu_off:
        cpu_tier = 2
    elif cpu_smooth >= CPU_FREEZE_L1 + cpu_off:
        cpu_tier = 1
    else:
        cpu_tier = 0

    mem_off = -MEM_TIER_HYST if (prev_mem is not None and mem_ratio > prev_mem) else 0.0
    if mem_ratio <= MEM_AVAIL_T4 + mem_off or psi["mem_full"] > 30.0:
        mem_tier = 4
    elif mem_ratio <= MEM_AVAIL_T3 + mem_off or psi["mem_full"] > 15.0:
        mem_tier = 3
    elif mem_ratio <= MEM_AVAIL_T2 + mem_off:
        mem_tier = 2
    elif mem_ratio <= MEM_AVAIL_T1 + mem_off:
        mem_tier = 1
    else:
        mem_tier = 0
    return cpu_tier, mem_tier

def _drop_caches(tier: int):
    """Reclaim cache/compact memory at tier >= 1 (rate limited, root only)."""
    global _LAST_MEM_DROP
    now = time.time()
    if (now - _LAST_MEM_DROP) < MEM_DROP_CACHE_INTERVAL or os.geteuid() != 0:
        return
    _LAST_MEM_DROP = now
    val = "3" if tier >= 4 else "1"
    if _sys_write("/proc/sys/vm/drop_caches", val):
        _sys_write("/proc/sys/vm/compact_memory", "1")
        log(f"memory tier {tier}: dropped caches ({val}) + compacted memory")

def _thaw_all():
    """Thaw everything frozen and hand placed processes back to their original
    cgroups (used on daemon exit so nothing stays throttled)."""
    for pid in list(FROZEN_PIDS.keys()):
        try:
            os.kill(pid, signal.SIGCONT)
        except Exception:
            pass
    FROZEN_PIDS.clear()
    if CGROUPS_OK:
        _cg_reset_caps()
    _cg_restore_all()

def _cg_reset_caps():
    """Remove every cap we may have applied (daemon exit / crash recovery)."""
    if not os.path.isdir("/sys/fs/cgroup/pulsaros"):
        return
    for name in ("core", "fg", "bg"):
        p = f"/sys/fs/cgroup/pulsaros/{name}"
        _cg_write(f"{p}/cpu.max", "max")
        _cg_write(f"{p}/memory.high", "max")
        _cg_write(f"{p}/memory.max", "max")

_LAST_MARKER_SIG = None
def _save_frozen_marker():
    """Persist frozen pids so a hard daemon crash can still recover them."""
    global _LAST_MARKER_SIG
    sig = tuple(sorted(FROZEN_PIDS.keys()))
    if sig == _LAST_MARKER_SIG:
        return
    _LAST_MARKER_SIG = sig
    try:
        if not sig:
            if os.path.exists(FROZEN_MARKER):
                os.unlink(FROZEN_MARKER)
            return
        with open(FROZEN_MARKER, "w") as f:
            json.dump({"ts": time.time(), "pids": list(sig)}, f)
    except Exception:
        pass

def _recover_from_crash_freeze():
    """On startup, SIGCONT any process a previous daemon instance left frozen
    and hand back processes left inside pulsaros cgroups."""
    _cg_reset_caps()
    _cg_restore_all()
    try:
        with open(FROZEN_MARKER, "r") as f:
            data = json.load(f)
        for pid in data.get("pids", []):
            try:
                with open(f"/proc/{pid}/stat", "r") as f2:
                    raw = f2.read()
                rp = raw.rfind(")")
                state = raw[rp + 2:].split()[0] if rp >= 0 else "?"
                if state == "T":  # stopped: leftover from a crashed daemon
                    os.kill(pid, signal.SIGCONT)
                    log(f"recovered pid {pid} left frozen by a previous crash")
            except Exception:
                continue
        os.unlink(FROZEN_MARKER)
    except FileNotFoundError:
        pass
    except Exception:
        pass

def _is_fg_descendant(pid: int, focused: int) -> bool:
    """True if pid is the focused process or a descendant of it (foreground work)."""
    for _ in range(8):
        if pid <= 0:
            return False
        if pid == focused:
            return True
        try:
            with open(f"/proc/{pid}/stat", "r") as f:
                raw = f.read()
            rp = raw.rfind(")")
            pid = int(raw[rp + 2:].split()[1])  # ppid
        except Exception:
            return False
    return False

def _scan_resources():
    """One pass over /proc: (pid, comm, cpu_ema, rss_mb, uid, ppid) for live,
    non-kernel, session-owned processes."""
    focused = detect_active_window_pid()
    uids = _active_user_uids()
    entries = []
    for pid_str in os.listdir("/proc"):
        if not pid_str.isdigit():
            continue
        pid = int(pid_str)
        if pid <= 2 or pid == os.getpid():
            continue
        try:
            with open(f"/proc/{pid_str}/stat", "r") as f:
                raw = f.read()
            lp = raw.find("(")
            rp = raw.rfind(")")
            if lp < 0 or rp < lp:
                continue
            comm = raw[lp + 1:rp]
            rest = raw[rp + 2:].split()
            if len(rest) < 3:
                continue
            if rest[0] in ("Z", "I", "X") or comm.startswith("["):
                continue
            ppid = int(rest[1])
            if comm in HARD_DENY:
                continue
        except Exception:
            continue
        uid = _pid_uid(pid)
        if uid not in uids and uid != 0:
            continue
        ema = PROC_CPU_EMA.get(pid, 0.0)
        rss_mb = 0.0
        try:
            with open(f"/proc/{pid_str}/status", "r") as f:
                for line in f:
                    if line.startswith("VmRSS:"):
                        rss_mb = int(line.split()[1]) / 1024.0
                        break
        except Exception:
            pass
        entries.append((pid, comm, ema, rss_mb, uid, ppid))
    return entries, focused

def _emergency_kill():
    """Memory tier 4: SIGTERM stateless indexer services to actually free RAM."""
    killed = 0
    for pid_str in os.listdir("/proc"):
        if killed >= 2:
            break
        if not pid_str.isdigit():
            continue
        pid = int(pid_str)
        try:
            with open(f"/proc/{pid_str}/comm", "r") as f:
                comm = f.read().strip()
            rss = 0
            with open(f"/proc/{pid_str}/status", "r") as f:
                for line in f:
                    if line.startswith("VmRSS:"):
                        rss = int(line.split()[1])
                        break
        except Exception:
            continue
        if rss > 0 and comm in SAFE_KILL15 and comm not in SELF_COMM:
            try:
                os.kill(pid, signal.SIGTERM)
                log(f"EMERGENCY: SIGTERM {comm} (pid {pid}) - memory critical tier 4")
                killed += 1
            except Exception:
                continue

def _is_essential(comm: str, is_focused: bool, override) -> bool:
    """Processes that must never be frozen/killed by the anti-saturation ladder."""
    if is_focused or override is not None:
        return True
    if comm in SELF_COMM:
        return True
    if comm in PROTECTED or any(comm.startswith(p) for p in PROTECTED_PREFIXES):
        return True
    return False

# =============================================================================
# cgroup v2 helpers
# =============================================================================

def _cg_write(path: str, value: str) -> bool:
    """Write a cgroup interface file, returning success instead of raising."""
    try:
        with open(path, "w") as f:
            f.write(value)
        return True
    except Exception:
        return False

def _cg_add_pid(cg: str, pid: int) -> bool:
    """Move `pid` into cgroup `cg` (append semantics, one pid per write)."""
    try:
        with open(f"{cg}/cgroup.procs", "a") as f:
            f.write(f"{pid}\n")
            f.flush()
        return True
    except Exception:
        return False

def _cpu_quota(fraction) -> str:
    """cpu.max value capping a cgroup at `fraction` of ALL cores."""
    if fraction is None or fraction >= 1.0:
        return "max"
    quota = max(int(round(fraction * _NPROC * _CG_PERIOD)), _CG_PERIOD // 10)
    return f"{quota} {_CG_PERIOD}"

def _cg_children(pid: int) -> set:
    """All descendants of pid (multi-level /proc children walk), minus pid."""
    todo = [pid]
    seen = set()
    while todo:
        cur = todo.pop()
        if cur in seen or cur <= 0:
            continue
        seen.add(cur)
        try:
            with open(f"/proc/{cur}/task/{cur}/children") as cf:
                todo.extend(int(t) for t in cf.read().split() if t.isdigit())
        except Exception:
            continue
    return seen - {pid}

def setup_pulsar_cgroups() -> bool:
    """Create pulsaros/{core,fg,bg}, weight them and clear any leftover caps
    from a previous crashed daemon. Returns True when active (root only)."""
    global CGROUPS_OK
    CGROUPS_OK = False
    if os.geteuid() != 0 or not os.path.isdir("/sys/fs/cgroup"):
        return False
    try:
        with open("/sys/fs/cgroup/cgroup.controllers") as f:
            ctrl = f.read().split()
        if "cpu" not in ctrl or "memory" not in ctrl:
            warn_once("cgroup v2: cpu/memory controllers unavailable -> SIGSTOP ladder")
            return False
        os.makedirs("/sys/fs/cgroup/pulsaros", exist_ok=True)
        _cg_write("/sys/fs/cgroup/pulsaros/cgroup.subtree_control",
                  "+cpu +memory +io +pids")
        for name, weight, io_w in (("core", 10000, 1000),
                                   ("fg", 200, 200),
                                   ("bg", 25, 50)):
            os.makedirs(f"/sys/fs/cgroup/pulsaros/{name}", exist_ok=True)
            _cg_write(f"/sys/fs/cgroup/pulsaros/{name}/cpu.weight", str(weight))
            _cg_write(f"/sys/fs/cgroup/pulsaros/{name}/io.weight", str(io_w))
            # clear any caps a crashed previous daemon may have left behind
            _cg_write(f"/sys/fs/cgroup/pulsaros/{name}/cpu.max", "max")
            _cg_write(f"/sys/fs/cgroup/pulsaros/{name}/memory.high", "max")
            _cg_write(f"/sys/fs/cgroup/pulsaros/{name}/memory.max", "max")
        CGROUPS_OK = True
        log("cgroup v2 isolation ACTIVE: desktop uncapped (max weight), focused+background capped per tier")
    except Exception as e:
        warn_once(f"cgroup v2 setup failed -> SIGSTOP ladder: {e!r}")
    return CGROUPS_OK

def _cg_move_tree(pid: int, cg: str):
    """Move pid + all descendants into cgroup cg, remembering originals so the
    processes can be handed back on daemon exit."""
    if pid <= 0 or not CGROUPS_OK:
        return
    try:
        orig = None
        with open(f"/proc/{pid}/cgroup", "r") as f:
            orig = f.read().strip().split(":")[-1]
    except Exception:
        orig = "/"
    if orig == cg:
        return
    kids = _cg_children(pid) | {pid}
    moved = 0
    for p in kids:
        if _cg_add_pid(cg, p):
            moved += 1
    if moved:
        for p in kids:
            if _CG_ORIG.get(p) is None:
                _CG_ORIG[p] = orig
            _CG_PLACED[p] = cg
        _cg_save_map()

def _cg_save_map():
    """Persist the pid -> original-cgroup map so a crash can still restore it."""
    try:
        with open(CGMAP, "w") as f:
            json.dump(_CG_ORIG, f)
    except Exception:
        pass

def _cg_restore_all():
    """Move every process we placed back to its original cgroup."""
    if not _CG_ORIG and not os.path.exists(CGMAP):
        return
    _cg_load_map()
    for pid, orig in list(_CG_ORIG.items()):
        if pid <= 0:
            continue
        if orig in (CGCORE, CGFG, CGBG):
            continue  # already ours / unknown origin: leave in place
        _cg_add_pid(orig, pid)
    _CG_ORIG.clear()
    _CG_PLACED.clear()
    try:
        os.unlink(CGMAP)
    except Exception:
        pass

def _cg_load_map():
    if _CG_ORIG or not os.path.exists(CGMAP):
        return
    try:
        with open(CGMAP, "r") as f:
            data = json.load(f)
        if isinstance(data, dict):
            _CG_ORIG.update({int(k): v for k, v in data.items()
                             if isinstance(v, str) and v.startswith("/")})
    except Exception:
        pass

def _apply_cgroup_caps(cpu_tier: int, mem_tier: int, mem_total_mb: float):
    """Tighten/loosen fg/bg ceilings per tier. core stays fully uncapped."""
    if not CGROUPS_OK:
        return
    mb = max(int(mem_total_mb), 1)
    specs = (
        (CGFG, _CPU_CAP_FG.get(cpu_tier, 0.75),
         _MEM_HIGH_FG.get(mem_tier), _MEM_MAX_FG.get(mem_tier)),
        (CGBG, _CPU_CAP_BG.get(cpu_tier, 0.40),
         _MEM_HIGH_BG.get(mem_tier), _MEM_MAX_BG.get(mem_tier)),
    )
    for cg, cap_f, high_f, max_f in specs:
        _cg_write(f"{cg}/cpu.max", _cpu_quota(cap_f))
        _cg_write(f"{cg}/memory.high",
                  f"{int(mb * high_f) * 1024 * 1024}" if high_f else "max")
        _cg_write(f"{cg}/memory.max",
                  f"{int(mb * max_f) * 1024 * 1024}" if max_f else "max")
    # Core desktop stays uncapped no matter what (self-healing if a previous
    # daemon instance left a cap behind).
    _cg_write(f"{CGCORE}/cpu.max", "max")
    _cg_write(f"{CGCORE}/memory.high", "max")
    _cg_write(f"{CGCORE}/memory.max", "max")

def place_processes_in_cgroups():
    """Assign desktop -> core, focused tree -> fg, everything else -> bg.
    Cheap after the first pass thanks to _CG_PLACED caching."""
    global _CG_LAST_FOCUSED, _CG_LAST_PLACE
    if not CGROUPS_OK:
        return
    now = time.time()
    focused = detect_active_window_pid()
    redo = (focused != _CG_LAST_FOCUSED or CPU_TIER_NOW > 0 or MEM_TIER_NOW > 0
            or (now - _CG_LAST_PLACE) > 10.0)
    if not redo:
        return
    _CG_LAST_FOCUSED, _CG_LAST_PLACE = focused, now

    fg_set = set()
    if focused > 0:
        fg_set = _cg_children(focused) | {focused}

    uids = _active_user_uids()
    cg_cache = dict(_CG_PLACED)
    for pid_str in os.listdir("/proc"):
        if not pid_str.isdigit():
            continue
        pid = int(pid_str)
        if pid <= 2 or pid == os.getpid():
            continue
        if pid in fg_set:
            continue
        try:
            with open(f"/proc/{pid}/comm", "r") as f:
                comm = f.read().strip()
        except Exception:
            continue
        uid = _pid_uid(pid)
        if uid not in uids and uid != 0:
            continue
        # Root services (uid 0) and essential infra are uncapped -> core.
        # Only ordinary session-user processes go to the capped bg cgroup.
        if uid != 0 and not (comm in PROTECTED or any(comm.startswith(p) for p in PROTECTED_PREFIXES)
                or comm in SELF_COMM or comm in HARD_DENY):
            cg = CGBG
        else:
            cg = CGCORE
        if cg_cache.get(pid) == cg:
            continue
        if _cg_add_pid(cg, pid):
            try:
                if _CG_ORIG.get(pid) is None:
                    with open(f"/proc/{pid}/cgroup", "r") as f:
                        _CG_ORIG[pid] = f.read().strip().split(":")[-1]
            except Exception:
                _CG_ORIG[pid] = "/"
            _CG_PLACED[pid] = cg
    if focused > 0 and _CG_PLACED.get(focused) != CGFG:
        _cg_move_tree(focused, CGFG)
        for p in fg_set:
            _CG_PLACED[p] = CGFG
    _cg_save_map()

def anti_saturation(cpu_smooth: float):
    """Escalating CPU/memory saturation protection. Must be called every loop."""
    global _PREV_CPU_TIER, _PREV_MEM_TIER, _PREV_CPU_SMOOTH, _PREV_MEM_RATIO
    global _CPU_TIER_SINCE, _MEM_TIER_SINCE, CPU_TIER_NOW, MEM_TIER_NOW
    now = time.time()
    mem_ratio, mem_avail_mb, mem_total_mb = read_mem_ratio()
    psi = read_psi()

    cpu_tier, mem_tier = _tiers(cpu_smooth, mem_ratio, psi,
                                _PREV_CPU_SMOOTH, _PREV_MEM_RATIO)
    CPU_TIER_NOW, MEM_TIER_NOW = cpu_tier, mem_tier
    if cpu_tier != _PREV_CPU_TIER:
        _PREV_CPU_TIER, _CPU_TIER_SINCE = cpu_tier, now
        log(f"CPU mitigation tier -> {cpu_tier}/3 (load {cpu_smooth:.1f}%)")
    if mem_tier != _PREV_MEM_TIER:
        _PREV_MEM_TIER, _MEM_TIER_SINCE = mem_tier, now
        log(f"Memory mitigation tier -> {mem_tier}/4 (available {100*mem_ratio:.1f}% = {mem_avail_mb:.0f} MB of {mem_total_mb:.0f} MB)")
    _PREV_CPU_SMOOTH = cpu_smooth
    _PREV_MEM_RATIO = mem_ratio

    # ---- cgroup v2 path: caps + placement implement the whole ladder --------
    if CGROUPS_OK:
        _apply_cgroup_caps(cpu_tier, mem_tier, mem_total_mb)
        place_processes_in_cgroups()

    # ---- thaw first: only on sustained drop below the freezing tier -------
    for pid, info in list(FROZEN_PIDS.items()):
        if info["kind"] == "cpu":
            if cpu_tier >= info["tier"] or (now - _CPU_TIER_SINCE) < THAW_GRACE_SEC:
                continue
        else:
            if mem_tier >= info["tier"] or (now - _MEM_TIER_SINCE) < THAW_GRACE_SEC:
                continue
        if (now - info["since"]) < FROZEN_MIN_SEC:
            continue
        try:
            os.kill(pid, signal.SIGCONT)
            _RELEASED[pid] = now
        except Exception:
            pass
        del FROZEN_PIDS[pid]
        log(f"resumed {info['comm']} (pid {pid}) - {info['kind']} tier {info['tier']} dropped to {cpu_tier}/{mem_tier}")
    _save_frozen_marker()

    # ---- reclaim memory first (tier 1+), emergency kills only at tier 4 ----
    if mem_tier >= 1:
        _drop_caches(mem_tier)
    if mem_tier >= 4:
        _emergency_kill()

    if cpu_tier == 0 and mem_tier == 0:
        return
    if CGROUPS_OK:
        return  # cgroup caps already throttle background + focused apps

    # ---- freeze new targets (SIGSTOP fallback for kernels without cgroups) --
    entries, focused = _scan_resources()
    uids = _active_user_uids()
    cpu_floor = CPU_HOG_PCT if cpu_tier >= 2 else -1.0
    mem_floor = MEM_KEY_RSS_MB if mem_tier == 2 else (64.0 if mem_tier == 3 else 16.0)

    for pid, comm, ema, rss_mb, uid, ppid in entries:
        if pid in FROZEN_PIDS or comm in SELF_COMM:
            continue
        if (now - _RELEASED.get(pid, 0.0)) < FROZEN_RELEASE_WAIT:
            continue
        if _is_fg_descendant(pid, focused):
            # Foreground work normally keeps priority, but the hard guarantee
            # is "CPU/RAM never saturate": at the deepest tiers the focused
            # app is brought down too (throttled via SIGSTOP, never killed).
            if not ((cpu_tier >= 3 and ema >= CPU_HOG_PCT)
                    or (mem_tier >= 3 and rss_mb >= mem_floor)):
                continue
        ent = PROCESSED_PIDS.get(pid)
        if ent is not None and ent.manual:
            continue  # user manually adjusted this process - leave it alone
        if _is_essential(comm, False, None):
            continue

        reason = None
        # CPU ladder: session-user processes only
        if uid in uids:
            if cpu_tier >= 1 and comm in THROTTLE15:
                reason = ("cpu", 1)
            if cpu_tier >= 2 and ema >= cpu_floor:
                reason = ("cpu", 2)
            if cpu_tier >= 3:
                reason = ("cpu", 3)
            # Memory ladder
            if mem_tier >= 2 and rss_mb >= mem_floor:
                if reason is None or reason[1] <= mem_tier:
                    reason = ("mem", mem_tier)
        if reason is None:
            continue
        kind, tier = reason
        try:
            os.kill(pid, signal.SIGSTOP)
            FROZEN_PIDS[pid] = {"since": now, "tier": tier, "kind": kind, "comm": comm}
            log(f"FROZEN {comm} (pid {pid}, cpu {ema:.0f}%, rss {rss_mb:.0f} MB) [{kind} tier {tier}, {len(FROZEN_PIDS)} frozen]")
        except ProcessLookupError:
            continue
        except Exception:
            continue

    _save_frozen_marker()

def compute_load_state():
    global CPU_SMOOTH
    cpu = get_cpu_utilization()
    CPU_SMOOTH = cpu if CPU_SMOOTH is None else (CPU_SMOOTH * 0.65) + (cpu * 0.35)
    psi = read_psi()
    level = 0
    if CPU_SMOOTH >= LOAD_CPU_THRESHOLDS[0]:
        level = 1
    if CPU_SMOOTH >= LOAD_CPU_THRESHOLDS[1]:
        level = 2
    if (CPU_SMOOTH >= LOAD_CPU_THRESHOLDS[2]
            or psi["cpu_some"] > PSI_ELEVATED["cpu_some"]
            or psi["io_some"] > PSI_ELEVATED["io_some"]):
        level = 3
    if (CPU_SMOOTH >= LOAD_CPU_THRESHOLDS[3]
            or psi["cpu_some"] > PSI_CRITICAL["cpu_some"]
            or psi["io_some"] > PSI_CRITICAL["io_some"]):
        level = 4
    mode = 0 if level <= 2 else (1 if level == 3 else 2)
    return level, mode, CPU_SMOOTH, psi

def get_zram_stats():
    stats = {
        "active": False,
        "orig_data_mb": 0.0,
        "compr_data_mb": 0.0,
        "ratio": "1.00:1",
        "saved_mb": 0.0,
        "disksize_mb": 0.0,
        "algorithm": "unknown"
    }
    try:
        with open("/proc/swaps", "r") as f:
            if "zram" in f.read():
                stats["active"] = True
        if os.path.exists("/sys/block/zram0/disksize"):
            with open("/sys/block/zram0/disksize", "r") as f:
                stats["disksize_mb"] = int(f.read().strip()) / (1024 * 1024)
        if os.path.exists("/sys/block/zram0/mm_stat"):
            with open("/sys/block/zram0/mm_stat", "r") as f:
                parts = f.read().split()
                if len(parts) >= 3:
                    orig_bytes = int(parts[0])
                    compr_bytes = int(parts[1])
                    orig_mb = orig_bytes / (1024 * 1024)
                    compr_mb = compr_bytes / (1024 * 1024)
                    saved_mb = max(0.0, orig_mb - compr_mb)
                    ratio = f"{(orig_bytes / compr_bytes):.2f}:1" if compr_bytes > 0 else "1.00:1"
                    stats["orig_data_mb"] = orig_mb
                    stats["compr_data_mb"] = compr_mb
                    stats["saved_mb"] = saved_mb
                    stats["ratio"] = ratio
        if os.path.exists("/sys/block/zram0/comp_algorithm"):
            with open("/sys/block/zram0/comp_algorithm", "r") as f:
                for part in f.read().split():
                    if part.startswith("[") and part.endswith("]"):
                        stats["algorithm"] = part[1:-1].upper()
                        break
    except Exception:
        pass
    return stats

# -----------------------------------------------------------------------------
# Focus Detection
# -----------------------------------------------------------------------------
def _pid_alive(pid: int) -> bool:
    return pid > 0 and os.path.exists(f"/proc/{pid}")

def _session_env():
    global SESSION_ENV_CACHE, SESSION_ENV_TS
    now = time.time()
    if SESSION_ENV_CACHE and (now - SESSION_ENV_TS) < 60.0:
        return SESSION_ENV_CACHE
    SESSION_ENV_TS = now
    try:
        for pid_str in os.listdir("/proc"):
            if not pid_str.isdigit():
                continue
            try:
                with open(f"/proc/{pid_str}/comm", "r") as f:
                    if f.read().strip() != "gnome-shell":
                        continue
                with open(f"/proc/{pid_str}/environ", "rb") as f:
                    raw = f.read().split(b"\0")
                env = {}
                wanted = (b"DBUS_SESSION_BUS_ADDRESS", b"DISPLAY", b"WAYLAND_DISPLAY", b"XDG_RUNTIME_DIR")
                for item in raw:
                    if b"=" not in item:
                        continue
                    k, v = item.split(b"=", 1)
                    if k in wanted:
                        env[k.decode()] = v.decode()
                if env:
                    SESSION_ENV_CACHE = env
                    return env
            except Exception:
                continue
    except Exception:
        pass
    return SESSION_ENV_CACHE

def detect_active_window_pid() -> int:
    global FOCUS_SOURCE
    now = time.time()
    try:
        for path in glob.glob(FOCUS_STATE_GLOB):
            try:
                if (now - os.path.getmtime(path)) > FOCUS_STATE_MAX_AGE:
                    continue
                with open(path, "r") as f:
                    data = json.load(f)
                pid = int(data.get("pid", 0))
                ts = float(data.get("ts", 0.0))
                if pid > 0 and (now - ts) <= FOCUS_STATE_MAX_AGE and _pid_alive(pid):
                    FOCUS_SOURCE = "pulsaros-focus extension"
                    return pid
            except Exception:
                continue
    except Exception:
        pass
    FOCUS_SOURCE = "none"
    return 0

# -----------------------------------------------------------------------------
# Classification & policy
# -----------------------------------------------------------------------------
def classify(comm: str, is_focused: bool, override, cpu_ema: float, level: int):
    if override is not None:
        return "pin"
    if comm in CORE15 or _is_core_helper(comm):
        return "core"
    if is_focused:
        return "focused"
    if comm in SHELL15:
        return None
    if comm in THROTTLE15:
        return "idle"
    if comm in GUI15 or comm in HABIT_ENGINE.habits:
        return "interactive"
    if comm in DEV15:
        return "dev"
    if comm in VM15:
        return "vm"
    if comm in CONTAINER15:
        return "container"
    if comm in MEDIA15:
        return "media"
    if level >= 2 and cpu_ema >= BUSY_BACKGROUND_CPU_PCT:
        return "busy"
    return None

def policy_target(category: str, level: int):
    if category == "pin":
        return None
    if category == "core":
        return (CORE_NICE[level], 2, 0)
    if category == "focused":
        return (FOCUS_NICE[level], 2, 0)
    if category == "idle":
        return (19, 3, 0)
    if category == "interactive":
        return (INTERACTIVE_NICE[level], 2, 4)
    table = _CLASS_TABLES.get(category)
    if not table:
        return None
    if category == "busy" and level == 0:
        return None
    io_class, io_prio = BG_IO[level]
    return (table[level], io_class, io_prio)

# -----------------------------------------------------------------------------
# Main optimization pass
# -----------------------------------------------------------------------------
def optimize_process_priorities(level: int, interval: float):
    global PROCESSED_PIDS, PREV_PID_STAT, PROC_CPU_EMA
    global LAST_ACTIVE_PID, LAST_ACTIVE_TS, PREV_FOCUSED_PID
    try:
        now = time.time()
        cpu_valid = interval <= 10.0
        step = interval if 0.0 < interval < 15.0 else 1.0

        focused_pid = detect_active_window_pid()
        if focused_pid > 0:
            LAST_ACTIVE_PID, LAST_ACTIVE_TS = focused_pid, now
        elif LAST_ACTIVE_PID > 0 and (now - LAST_ACTIVE_TS) < FOCUS_HOLD_SEC and _pid_alive(LAST_ACTIVE_PID):
            focused_pid = LAST_ACTIVE_PID
        else:
            focused_pid = 0

        if focused_pid != PREV_FOCUSED_PID:
            if focused_pid <= 0:
                HABIT_ENGINE.end_focus()
            PREV_FOCUSED_PID = focused_pid

        active_pids = set()

        for pid_str in os.listdir("/proc"):
            if not pid_str.isdigit():
                continue
            pid = int(pid_str)
            if pid <= 2 or pid == os.getpid():
                continue
            try:
                with open(f"/proc/{pid_str}/stat", "r") as f:
                    raw = f.read()
            except Exception:
                continue

            lparen = raw.find("(")
            rparen = raw.rfind(")")
            if lparen < 0 or rparen < lparen:
                continue
            try:
                comm = raw[lparen + 1:rparen]
                rest = raw[rparen + 2:].split()
                jiffies = int(rest[11]) + int(rest[12])
                nice = int(rest[16])
            except Exception:
                continue

            active_pids.add(pid)

            prev = PREV_PID_STAT.get(pid)
            cpu_pct = 0.0
            if prev is not None and cpu_valid and interval > 0:
                delta = jiffies - prev
                if delta >= 0:
                    cpu_pct = min(400.0, 100.0 * delta / (CLK_TCK * interval))
            PREV_PID_STAT[pid] = jiffies
            ema = PROC_CPU_EMA.get(pid)
            ema = cpu_pct if ema is None else (ema * 0.5) + (cpu_pct * 0.5)
            PROC_CPU_EMA[pid] = ema

            is_focused = (pid == focused_pid)
            override = HABIT_ENGINE.get_user_override(comm)

            if is_focused:
                HABIT_ENGINE.record_focus(comm, step)
            elif comm in GUI15 or comm in HABIT_ENGINE.habits:
                HABIT_ENGINE.record_background(comm, step)

            if comm in SELF_COMM:
                continue

            category = classify(comm, is_focused, override, ema, level)
            pinned_now = override is not None
            target = None
            if category == "pin":
                target = PRIORITY_PINS.get(override)
            elif category is not None:
                target = policy_target(category, level)

            entry = PROCESSED_PIDS.get(pid)
            if entry is not None:
                if entry.pinned != pinned_now:
                    entry.orig = nice
                    entry.nice = nice
                    entry.pinned = pinned_now
                    entry.manual = False
                elif nice != entry.nice:
                    entry.orig = nice
                    entry.nice = nice
                    entry.manual = True
                if entry.manual:
                    continue

            baseline = entry.orig if entry is not None else nice
            if target is None:
                if entry is not None:
                    if entry.nice != entry.orig and nice == entry.nice:
                        try:
                            os.setpriority(os.PRIO_PROCESS, pid, entry.orig)
                        except Exception:
                            pass
                        set_ioprio(pid, 2, 4)
                    del PROCESSED_PIDS[pid]
                continue

            t_nice, io_class, io_prio = target
            applied = t_nice if t_nice < 0 else max(t_nice, baseline)
            io_wanted = (io_class, io_prio)
            changed = (applied != nice)
            io_changed = (entry is None or entry.io != io_wanted)

            if changed:
                try:
                    os.setpriority(os.PRIO_PROCESS, pid, applied)
                except Exception:
                    pass
            if io_changed:
                set_ioprio(pid, io_class, io_prio)

            if entry is None:
                PROCESSED_PIDS[pid] = _ProcState(applied, baseline, io_wanted, pinned_now)
            else:
                entry.nice = applied
                entry.io = io_wanted
                entry.pinned = pinned_now

        for dead in list(PROCESSED_PIDS.keys()):
            if dead not in active_pids:
                del PROCESSED_PIDS[dead]
        for dead in list(PREV_PID_STAT.keys()):
            if dead not in active_pids:
                del PREV_PID_STAT[dead]
                PROC_CPU_EMA.pop(dead, None)

    except Exception as e:
        warn_once(f"optimization pass failed: {e!r}")

def setup_zram_and_sysctl():
    """Configure hardware-adaptive zRAM compression and smooth, non-blocking kernel sysctls."""
    try:
        meminfo = read_meminfo()
        total_kb = meminfo.get("MemTotal", 4 * 1024 * 1024)
        total_mb = total_kb // 1024
        log(f"Detected physical RAM: {total_mb} MB ({total_mb/1024:.1f} GB)")

        # Smooth, stable swappiness that avoids UI latency
        target_swappiness = "60" if total_mb > 16384 else "100"
        zram_target_size = min(int(total_kb * 1024), 8 * 1024 * 1024 * 1024)

        sysctls = {
            "/proc/sys/vm/swappiness": target_swappiness,
            "/proc/sys/vm/vfs_cache_pressure": "100",
            "/proc/sys/vm/page-cluster": "0",
            "/proc/sys/vm/dirty_ratio": "20",
            "/proc/sys/vm/dirty_background_ratio": "10",
            "/proc/sys/vm/compaction_proactiveness": "0",
        }

        for path, val in sysctls.items():
            if os.path.exists(path):
                _sys_write(path, val)

        try:
            subprocess.run(["modprobe", "zram"], capture_output=True)
        except Exception:
            pass

        zram_active = False
        try:
            with open("/proc/swaps", "r") as f:
                if "zram" in f.read():
                    zram_active = True
        except Exception:
            pass

        if not zram_active and os.path.exists("/sys/block/zram0"):
            for algo in ["zstd", "lz4", "lzo-rle"]:
                if _sys_write("/sys/block/zram0/comp_algorithm", algo):
                    break
            _sys_write("/sys/block/zram0/reset", "1")
            _sys_write("/sys/block/zram0/disksize", str(zram_target_size))
            try:
                subprocess.run(["mkswap", "/dev/zram0"], capture_output=True)
                subprocess.run(["swapon", "-p", "32767", "/dev/zram0"], capture_output=True)
                log(f"Configured zRAM swap (/dev/zram0, {zram_target_size // (1024*1024)} MB)")
            except Exception as ze:
                log(f"zRAM notice: {ze}")
    except Exception as e:
        log(f"Error in setup_zram_and_sysctl: {e}")

def show_status():
    level, mode, cpu_smooth, psi = compute_load_state()
    focused_pid = detect_active_window_pid()
    focused_comm = ""
    if focused_pid > 0:
        try:
            with open(f"/proc/{focused_pid}/comm", "r") as f:
                focused_comm = f.read().strip()
        except Exception:
            focused_comm = "?"

    mem_ratio, mem_avail_mb, mem_total_mb = read_mem_ratio()
    cpu_tier, mem_tier = _tiers(cpu_smooth, mem_ratio, psi)

    print("=" * 70)
    print("PULSAR OS OPTIMIZER - FLUIDITY & ZERO-LAG RESPONSIVENESS")
    print("=" * 70)
    print(f"  Load Level:             {level}")
    print(f"  CPU Load:               {cpu_smooth:.1f}%")
    print(f"  Memory Available:       {mem_avail_mb:.0f} / {mem_total_mb:.0f} MB ({100*mem_ratio:.1f}%)")
    print(f"  Mitigation:             CPU tier {cpu_tier}/3  MEM tier {mem_tier}/4  {len(FROZEN_PIDS)} frozen")
    print(f"  Isolation:              {'cgroup v2 ACTIVE (desktop uncapped, focused+background capped)' if CGROUPS_OK else 'SIGSTOP ladder (no cgroup v2)'}")
    print(f"  Focused PID:            {focused_pid} ({focused_comm})")
    print(f"  Focus Source:           {FOCUS_SOURCE}")
    zstats = get_zram_stats()
    print(f"  zRAM Active:            {zstats['active']} (Algorithm: {zstats['algorithm']})")
    print("=" * 70)

def main():
    global DAEMON_RUNNING, RUNNING
    if len(sys.argv) > 1:
        arg = sys.argv[1]
        if arg in ["--status", "-s", "status"]:
            show_status()
            sys.exit(0)
        elif arg in ["--start"]:
            subprocess.run(["systemctl", "start", "pulsaros-optimizer.service"])
            sys.exit(0)
        elif arg in ["--stop"]:
            subprocess.run(["systemctl", "stop", "pulsaros-optimizer.service"])
            sys.exit(0)
        elif arg in ["--restart"]:
            subprocess.run(["systemctl", "restart", "pulsaros-optimizer.service"])
            sys.exit(0)
        elif arg in ["--forget-habit"] and len(sys.argv) > 2:
            comm = sys.argv[2][:15]
            HABIT_ENGINE.habits.pop(comm, None)
            HABIT_ENGINE.save()
            log(f"forgot learned habit for '{comm}'")
            sys.exit(0)
        elif arg in ["--clear-habits"]:
            HABIT_ENGINE.habits.clear()
            HABIT_ENGINE.user_overrides.clear()
            HABIT_ENGINE.save()
            log("cleared all learned habits")
            sys.exit(0)

    log("Starting Pulsar OS Zero-Lag Optimizer Daemon...")
    setup_zram_and_sysctl()
    setup_pulsar_cgroups()
    _recover_from_crash_freeze()

    signal.signal(signal.SIGTERM, lambda s, f: sys.exit(0))
    signal.signal(signal.SIGINT, lambda s, f: sys.exit(0))
    DAEMON_RUNNING = True

    prev_time = time.time()
    loop_count = 0
    while RUNNING:
        try:
            curr_time = time.time()
            loop_interval = max(0.2, curr_time - prev_time)
            prev_time = curr_time

            level, mode, cpu_smooth, psi = compute_load_state()
            optimize_process_priorities(level, loop_interval)
            anti_saturation(cpu_smooth)

            loop_count += 1
            if loop_count % 30 == 0:
                HABIT_ENGINE.refresh_overrides()
                _save_frozen_marker()

            sleep_sec = 0.5 if (CPU_TIER_NOW >= 2 or MEM_TIER_NOW >= 3) else \
                        (1.0 if level >= 2 else 2.0)
            time.sleep(sleep_sec)
        except KeyboardInterrupt:
            break
        except Exception as e:
            warn_once(f"loop error: {e!r}")
            time.sleep(2.0)

# Never leave processes frozen if this daemon exits (thaws on clean exit)
atexit.register(_thaw_all)

if __name__ == "__main__":
    main()
