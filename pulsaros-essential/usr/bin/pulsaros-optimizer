class _ProcState:
    __slots__ = ("nice", "orig", "io", "pinned", "manual")
    def __init__(self, nice, orig, io, pinned, manual=False):
        self.nice = nice
        self.orig = orig
        self.io = io
        self.pinned = pinned
        self.manual = manual

