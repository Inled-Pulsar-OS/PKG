#!/usr/bin/env python3
"""
Pulsar OS - Universal Dynamic Adaptive Optimizer & Real-Time Habit Learning Engine
Engineered for zero-lag desktop fluidity, honest habit learning, and a low
resource regime that is held *before* saturation instead of after it.

Priority model (highest first):
  0. Explicit user pins (Turbo/High/Normal/Low set from pulsaros-optimizer-gui).
  1. GNOME Shell, Mutter, Xwayland, PipeWire, WirePlumber and friends:
     absolute top scheduling priority at every load level (smoothness first).
  2. The window that currently has focus: always above regular GUI apps.
  3. Indexers & system maintenance: nice 19 + idle I/O, unconditionally.
  4. Interactive GUI apps and learned habit apps.
  5. Heavy background classes: compilers, VMs, container engines, encoders.
  6. Anything else that is actually burning CPU - only while it burns it.

Low regime (soft governor, active *before* any saturation):
  - Load level 0..4 from smoothed CPU% + PSI.
  - All heavy background jobs share one cgroup, /sys/fs/cgroup/pulsaros-optimizer,
    with a soft cpu.max ceiling that tightens with the load level
    (none -> 70% -> 50% -> 35% -> 25% of the machine). The shell, the audio
    stack and the focused app never enter that cgroup, so background work can
    never push the desktop into contention no matter how hard it tries.
  - memory.high tightens when available RAM drops, so background jobs yield
    memory through reclaim instead of forcing swap storms / OOM.
  - nice/ionice tiers escalate per load level for every heavy class.

Genuine habit learning engine (no mocks):
  - Focus is reported by the pulsaros-focus GNOME Shell extension into
    $XDG_RUNTIME_DIR/pulsaros-focused.json. This is the only reliable channel:
    GNOME >= 45 disabled org.gnome.Shell.Eval (returns (false, '')) and this
    daemon is a root *system* service, so it has no session bus and no display
    (gdbus/xdotool/xprop are kept as throttled fallbacks anyway).
  - Only windowed apps are recorded, focus *sessions* are counted on focus
    changes instead of once per loop, scores are recomputed from raw counters
    and stale profiles are pruned at startup.
  - Profiles persist in /var/lib/pulsaros/optimizer_habits.json; manual pins
    written by the GUI (which can only write to the user home) are merged in
    from every location, so user intent always reaches this root daemon.
"""

import ctypes
import os
import sys
import time
import json
import glob
import signal
import platform
import atexit
import subprocess

# -----------------------------------------------------------------------------
# Direct Linux syscall for I/O priority without spawning subprocesses
# -----------------------------------------------------------------------------
def _get_ioprio_syscall_nr():
    m = platform.machine().lower()
    if m in ("x86_64", "amd64"):
        return 251
    elif m in ("aarch64", "arm64"):
        return 30
    elif m.startswith("arm"):
        return 314
    elif m in ("i386", "i686", "x86"):
        return 289
    return 251

IOPRIO_SYSCALL_NR = _get_ioprio_syscall_nr()
_libc = None
try:
    _libc = ctypes.CDLL(None)
except Exception:
    pass

def set_ioprio(pid: int, io_class: int, io_prio: int):
    """Set process I/O priority directly via libc syscall with zero process spawn overhead."""
    if _libc:
        try:
            val = (io_class << 13) | (io_prio & 0x1fff)
            res = _libc.syscall(IOPRIO_SYSCALL_NR, 1, pid, val)
            if res == 0:
                return True
        except Exception:
            pass
    try:
        if io_class == 3:
            subprocess.run(["ionice", "-c", "3", "-p", str(pid)], capture_output=True)
        else:
            subprocess.run(["ionice", "-c", str(io_class), "-n", str(io_prio), "-p", str(pid)], capture_output=True)
        return True
    except Exception:
        return False

def _sys_write(path: str, value: str) -> bool:
    """Write a sysctl/sysfs/cgroup file, returning success instead of raising."""
    try:
        with open(path, "w") as f:
            f.write(value)
        return True
    except Exception:
        return False

try:
    CLK_TCK = float(os.sysconf("SC_CLK_TCK"))
except Exception:
    CLK_TCK = 100.0

def log(msg):
    print(f"[pulsaros-optimizer] {msg}", flush=True)

_WARNED = set()
def warn_once(msg, limit=20):
    """Rate-limited error reporting: a recurring fault is logged, not hidden."""
    if msg in _WARNED or len(_WARNED) >= limit:
        return
    _WARNED.add(msg)
    log(f"WARNING: {msg}")

# -----------------------------------------------------------------------------
# Governor tuning (the "low regime" knobs)
# -----------------------------------------------------------------------------
LOAD_CPU_THRESHOLDS = (30.0, 45.0, 60.0, 80.0)   # smoothed CPU% -> load level 1..4
PSI_ELEVATED = {"cpu_some": 10.0, "io_some": 12.0, "io_full": 0.8}
PSI_CRITICAL = {"cpu_some": 22.0, "io_some": 25.0, "io_full": 3.0}
BUSY_BACKGROUND_CPU_PCT = 8.0    # % of total machine CPU that makes an unclassified process "busy"

# Background cgroup soft ceilings, indexed by load level (None = unlimited)
BG_CPU_CAP = (None, 0.70, 0.50, 0.35, 0.25)
# memory.high fractions of total RAM by available-RAM ratio
MEM_HIGH_LOW_AVAIL = 0.15    # below this: background may hold 45% of RAM
MEM_HIGH_MID_AVAIL = 0.25    # below this: background may hold 60% of RAM
CGROUP_DIR = "/sys/fs/cgroup/pulsaros-optimizer"

# Focus channel (written by pulsaros-focus@inled.es)
FOCUS_STATE_GLOB = "/run/user/*/pulsaros-focused.json"
