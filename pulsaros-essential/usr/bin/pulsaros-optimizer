# 2. Core Desktop Compositor, Shell & Low-Latency Audio -> Maximum Priority (-14 to -16 Nice, Realtime/Low-Latency IO)
CORE_DESKTOP_PROCESSES = {
    "gnome-shell", "mutter", "mutter-x11-fram", "mutter-x11-frames",
    "Xwayland", "kwin_wayland", "kwin_x11", "sway", "wayfire", "weston",
