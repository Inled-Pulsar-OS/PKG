        )
        header.set_title_widget(title_widget)
        main_box.append(header)

        # Pause / Resume Button in Header
        self.btn_pause = Gtk.Button(icon_name="media-playback-pause-symbolic")
        self.btn_pause.set_tooltip_text(_t("Pause / Resume polling", "Pausar / Reanudar monitoreo"))
        self.btn_pause.connect("clicked", self.toggle_pause)
        header.pack_end(self.btn_pause)

        # Scrolled container for cards
        scroller = Gtk.ScrolledWindow()
        scroller.set_vexpand(True)
        main_box.append(scroller)

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        vbox.set_margin_top(16)
        vbox.set_margin_bottom(16)
        vbox.set_margin_start(20)
        vbox.set_margin_end(20)
        scroller.set_child(vbox)

        # ── 1. Top Real-Time Status Card ─────────────────────────────
        status_group = Adw.PreferencesGroup()
        status_group.set_title(_t("Current Presence Status", "Estado Actual de Presencia"))
        vbox.append(status_group)

        self.status_banner = Adw.ActionRow()
        self.status_banner.set_title(_t("Checking Hardware...", "Comprobando Hardware..."))
        self.status_banner.set_subtitle(_t("Initializing Gaze and Mutter sensors...", "Iniciando sensores de Gaze y Mutter..."))
        self.status_icon = Gtk.Image.new_from_icon_name("security-high-symbolic")
        self.status_icon.set_pixel_size(32)
        self.status_banner.add_prefix(self.status_icon)
        status_group.add(self.status_banner)

        # ── 2. Metric Details ─────────────────────────────────────────
        metrics_group = Adw.PreferencesGroup()
        metrics_group.set_title(_t("Biometric & Session Telemetry", "Telemetría Biométrica y de Sesión"))
        vbox.append(metrics_group)

        # Row A: Gaze Face Engine
        self.face_metric_row = Adw.ActionRow()
        self.face_metric_row.set_title(_t("Face Recognition (Gaze Engine)", "Reconocimiento Facial (Motor Gaze)"))
        self.face_metric_row.set_subtitle(_t("Idle", "En reposo"))
        face_img = Gtk.Image.new_from_icon_name("camera-web-symbolic")
        self.face_metric_row.add_prefix(face_img)
        self.btn_manual_probe = Gtk.Button(label=_t("Probe Now", "Escanear Ahora"))
        self.btn_manual_probe.set_valign(Gtk.Align.CENTER)
        self.btn_manual_probe.connect("clicked", lambda b: self.probe_camera_async(forced=True))
        self.face_metric_row.add_suffix(self.btn_manual_probe)
        metrics_group.add(self.face_metric_row)

        # Row B: Mutter Idle Monitor
        self.idle_metric_row = Adw.ActionRow()
        self.idle_metric_row.set_title(_t("System User Activity (Mutter)", "Actividad del Usuario (Mutter)"))
        self.idle_metric_row.set_subtitle(_t("Reading...", "Leyendo..."))
