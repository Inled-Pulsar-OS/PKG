        btn_open_diag.set_valign(Gtk.Align.CENTER)
        btn_open_diag.add_css_class("accent")
        btn_open_diag.connect("clicked", lambda b: self.open_debug_window())
        diag_row.add_suffix(btn_open_diag)
        self.presence_group.add(diag_row)

        # ── Group 4: Security & Privacy ──────────────────────────────
        info_group = Adw.PreferencesGroup()
        info_group.set_title(_t("Security & Privacy", "Seguridad y Privacidad"))
        page.add(info_group)

        info_row = Adw.ActionRow()
        info_row.set_title(_t("100% on-device local processing", "Procesamiento 100% local en el dispositivo"))
        info_row.set_subtitle(_t(
            "Your biometric data and camera stream are analyzed exclusively on your hardware. No images or telemetry are ever sent to external servers.",
            "Tus datos biométricos y la imagen de la cámara se analizan exclusivamente en tu hardware. Nunca se almacenan vídeos ni se transmiten datos a ningún servidor externo."
        ))
        icon = Gtk.Image.new_from_icon_name("security-high-symbolic")
        info_row.add_prefix(icon)
        info_group.add(info_row)

        # Refresh state from daemon
        self.refresh_status()

    def open_debug_window(self):
        diag_win = PresenceDebugWindow(parent_window=self)
        diag_win.present()

    def get_config_path(self):
        return os.path.expanduser("~/.config/pulsaros/presence.json")

    def load_presence_config(self):
        p = self.get_config_path()
        cfg = {"enabled": False, "timeout_seconds": 30}
        if os.path.exists(p):
            try:
                with open(p, "r") as f:
                    cfg.update(json.load(f))
            except Exception:
                pass
        return cfg

    def save_presence_config(self, cfg):
        p = self.get_config_path()
        os.makedirs(os.path.dirname(p), exist_ok=True)
        try:
            with open(p, "w") as f:
                json.dump(cfg, f, indent=2)
        except Exception as e:
            print("Error saving presence config:", e)

        # Notify biometrics daemon
        try:
            import urllib.request
            req = urllib.request.Request(
                "http://127.0.0.1:39281/presence",
                data=json.dumps(cfg).encode("utf-8"),
                headers={"Content-Type": "application/json"}
            )
            urllib.request.urlopen(req, timeout=1)
        except Exception:
            pass

    def refresh_status(self):
        # 0. Load biometrics config toggles
        bio_cfg = load_biometrics_config()
        self.touch_switch_row.set_active(bio_cfg.get("touch_id_enabled", True))
        self.face_switch_row.set_active(bio_cfg.get("face_id_enabled", True))

        # 1. Check Touch ID / Fingerprint Reader
        has_fp = False
        try:
            res = subprocess.run(["fprintd-list", self.username], capture_output=True, text=True, timeout=2)
            if "found 1 devices" in res.stdout or "Using device" in res.stdout:
                has_fp = True
        except Exception:
            pass

        if not has_fp:
            self.touch_switch_row.set_sensitive(False)
            self.touch_manage_row.set_sensitive(False)
            self.touch_manage_row.set_subtitle(_t("No fingerprint reader detected on this computer.", "No se detectó ningún lector de huellas en este equipo."))
            self.btn_manage_touch.set_visible(False)
        else:
            self.touch_switch_row.set_sensitive(True)
            self.touch_manage_row.set_sensitive(True)
            self.btn_manage_touch.set_visible(True)
            enrolled_fingers = get_enrolled_fingers(self.username)
            count = len(enrolled_fingers)
            if count == 0:
                self.touch_manage_row.set_subtitle(_t("Reader ready, but no fingerprints enrolled yet.", "Lector listo, pero no hay huellas registradas aún."))
                self.btn_manage_touch.set_label(_t("Set Up…", "Configurar…"))
            else:
                self.touch_manage_row.set_subtitle(_t(f"{count} fingerprint(s) registered and ready", f"{count} huella(s) registrada(s) y activa(s)"))
                self.btn_manage_touch.set_label(_t("Manage…", "Gestionar…"))

        # 2. Check Face ID
        has_cam = any(os.path.exists(f"/dev/video{i}") for i in range(4))
        face_enrolled = False
        try:
            res = subprocess.run(["gaze", "list-faces", "-u", self.username], stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=2)
            if res.returncode == 0 and res.stdout.strip() and "No faces found" not in res.stdout and "No faces enrolled" not in res.stdout:
                face_enrolled = True
        except Exception:
            pass

        if not has_cam:
            self.face_switch_row.set_sensitive(False)
            self.face_manage_row.set_sensitive(False)
            self.face_manage_row.set_subtitle(_t("No compatible webcam detected.", "No se detectó ninguna cámara web compatible."))
            self.btn_manage_face.set_visible(False)
        else:
            self.face_switch_row.set_sensitive(True)
            self.face_manage_row.set_sensitive(True)
            self.btn_manage_face.set_visible(True)
            if face_enrolled:
                self.face_manage_row.set_subtitle(_t("Face ID active with enrolled facial profile.", "Face ID activo con perfil de reconocimiento facial."))
                self.btn_manage_face.set_label(_t("Manage Faces…", "Gestionar Rostros…"))
            else:
                self.face_manage_row.set_subtitle(_t("Camera ready, but no face profile enrolled yet.", "Cámara lista, pero no has configurado tu rostro aún."))
                self.btn_manage_face.set_label(_t("Set Up Face ID…", "Configurar Face ID…"))

        # 3. Check Presence Config
        cfg = self.load_presence_config()
        self.presence_switch_row.set_active(cfg.get("enabled", False))
        t = cfg.get("timeout_seconds", 30)
        idx = 1
        if t <= 15:
            idx = 0
        elif t <= 30:
            idx = 1
        elif t <= 60:
            idx = 2
        else:
            idx = 3
        self.timeout_row.set_selected(idx)

    def on_touch_id_toggled(self, row, pspec):
        cfg = load_biometrics_config()
        cfg["touch_id_enabled"] = row.get_active()
        save_biometrics_config(cfg)

    def on_face_id_toggled(self, row, pspec):
        cfg = load_biometrics_config()
        cfg["face_id_enabled"] = row.get_active()
        save_biometrics_config(cfg)

    def open_touch_id_manager(self):
        mgr = TouchIDManagerWindow(parent_window=self, username=self.username)
        mgr.present()

    def open_face_id_manager(self):
        if shutil.which("gaze-gui"):
            subprocess.Popen(["gaze-gui"])
            GLib.timeout_add_seconds(3, self.refresh_status)
        else:
            subprocess.Popen(["gaze", "add-face", "default", "-u", self.username])
            GLib.timeout_add_seconds(3, self.refresh_status)

    def on_presence_toggled(self, row, pspec):
        cfg = self.load_presence_config()
        cfg["enabled"] = row.get_active()
        self.save_presence_config(cfg)

    def on_timeout_selected(self, row, pspec):
        idx = row.get_selected()
        mapping = {0: 15, 1: 30, 2: 60, 3: 120}
        secs = mapping.get(idx, 30)
        cfg = self.load_presence_config()
        cfg["timeout_seconds"] = secs
        self.save_presence_config(cfg)


# ==============================================================================
# Application Entry Point
# ==============================================================================
class BiometricsSettingsApp(Adw.Application):
    def __init__(self):
        super().__init__(
            application_id="es.inled.PulsarOS.BiometricsSettings",
            flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE
        )
        self.debug_mode = False

    def do_command_line(self, command_line):
        args = command_line.get_arguments()
        if "--debug-presence" in args or "-d" in args:
            self.debug_mode = True
        self.activate()
        return 0

    def do_activate(self):
        try:
            display = Gdk.Display.get_default()
            if display:
                css_provider = Gtk.CssProvider()
                css_provider.load_from_data(CSS_TOUCHID.encode("utf-8"))
                Gtk.StyleContext.add_provider_for_display(
                    display,
                    css_provider,
                    Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
                )
        except Exception as e:
            print("Error loading Touch ID CSS:", e)

        if self.debug_mode:
            win = PresenceDebugWindow()
            win.set_application(self)
            win.present()
        else:
            win = self.props.active_window
            if not win:
                win = BiometricsSettingsWindow(self)
            win.present()


if __name__ == "__main__":
    app = BiometricsSettingsApp()
    sys.exit(app.run(sys.argv))
