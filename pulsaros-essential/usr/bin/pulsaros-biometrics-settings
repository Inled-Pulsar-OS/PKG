        self.idle_metric_row.add_prefix(input_img)
        metrics_group.add(self.idle_metric_row)

        # Row C: Auto-Lock Countdown
        self.lock_metric_row = Adw.ActionRow()
        self.lock_metric_row.set_title(_t("Auto-Lock Absence Countdown", "Cuenta Atrás de Bloqueo"))
        self.lock_metric_row.set_subtitle(f"0 / {self.timeout_limit}s")
        timer_img = Gtk.Image.new_from_icon_name("alarm-symbolic")
        self.lock_metric_row.add_prefix(timer_img)

        self.btn_test_lock = Gtk.Button(label=_t("Test Lock Screen", "Probar Bloqueo"))
        self.btn_test_lock.set_valign(Gtk.Align.CENTER)
        self.btn_test_lock.add_css_class("destructive-action")
        self.btn_test_lock.connect("clicked", self.on_test_lock_clicked)
        self.lock_metric_row.add_suffix(self.btn_test_lock)
        metrics_group.add(self.lock_metric_row)

        self.lock_progress = Gtk.ProgressBar()
        self.lock_progress.set_fraction(1.0)
        self.lock_progress.set_margin_top(4)
        self.lock_progress.set_margin_bottom(6)
        metrics_group.add(self.lock_progress)

        # Simulation Switch
        self.sim_row = Adw.SwitchRow()
        self.sim_row.set_title(_t("Simulation Mode (Do not actually lock)", "Modo Simulación (No bloquear realmente)"))
        self.sim_row.set_subtitle(_t("Keeps monitoring and counting down, but logs lock action without activating screen saver", "Monitorea y descuenta tiempo, pero registra la acción sin apagar la pantalla"))
        self.sim_row.set_active(False)
        self.simulate_mode = False
        self.sim_row.connect("notify::active", self.on_sim_toggled)
        metrics_group.add(self.sim_row)

        # ── 3. Live Console Event Log ─────────────────────────────────
        log_group = Adw.PreferencesGroup()
        log_group.set_title(_t("Live Event Log Stream", "Registro de Eventos en Tiempo Real"))
        vbox.append(log_group)

        log_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        log_group.add(log_box)

        log_scroll = Gtk.ScrolledWindow()
        log_scroll.set_min_content_height(180)
        log_scroll.set_max_content_height(240)
        log_scroll.add_css_class("card")
        log_box.append(log_scroll)

        self.text_view = Gtk.TextView()
        self.text_view.set_editable(False)
        self.text_view.set_monospace(True)
        self.text_view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        self.text_view.set_left_margin(10)
        self.text_view.set_right_margin(10)
        self.text_view.set_top_margin(10)
        self.text_view.set_bottom_margin(10)
        self.text_buffer = self.text_view.get_buffer()
        log_scroll.set_child(self.text_view)

        btn_clear = Gtk.Button(label=_t("Clear Logs", "Limpiar Registro"))
        btn_clear.set_halign(Gtk.Align.END)
        btn_clear.connect("clicked", lambda b: self.text_buffer.set_text(""))
        log_box.append(btn_clear)

        # Initial log
        self.log_event(_t("Presence Diagnostics initialized. Target user: ", "Diagnóstico de Presencia iniciado. Usuario objetivo: ") + self.username)
        self.log_event(_t("Configured timeout: ", "Tiempo de espera configurado: ") + f"{self.timeout_limit}s")

        # Start timer (1000ms loop)
        GLib.timeout_add(1000, self.on_poll_tick)
        self.connect("close-request", self.on_close_window)

    def on_sim_toggled(self, row, pspec):
        self.simulate_mode = row.get_active()
        self.log_event(_t("Simulation mode: ", "Modo simulación: ") + str(self.simulate_mode))

    def toggle_pause(self, btn):
        self.is_running = not self.is_running
        if self.is_running:
            self.btn_pause.set_icon_name("media-playback-pause-symbolic")
            self.log_event(_t("Telemetry resumed.", "Monitoreo reanudado."))
        else:
            self.btn_pause.set_icon_name("media-playback-start-symbolic")
            self.log_event(_t("Telemetry paused.", "Monitoreo pausado."))

    def on_close_window(self, win):
        self.is_running = False
        return False

    def log_event(self, msg):
        timestamp = time.strftime("%H:%M:%S")
        entry = f"[{timestamp}] {msg}\n"
        end_iter = self.text_buffer.get_end_iter()
        self.text_buffer.insert(end_iter, entry)
        # Auto scroll to bottom
        adj = self.text_view.get_vadjustment()
        if adj:
            adj.set_value(adj.get_upper())

    def on_test_lock_clicked(self, btn):
        self.log_event(_t("Manually triggered lock screen session.", "Bloqueo de pantalla solicitado manualmente."))
        subprocess.run(["loginctl", "lock-session"], check=False)

    def probe_camera_async(self, forced=False):
        if self.is_probing_camera:
            return
        self.is_probing_camera = True
        self.face_metric_row.set_subtitle(_t("Scanning camera for owner...", "Escaneando cámara buscando al usuario..."))
        t0 = time.time()

        def worker():
            try:
                res = subprocess.run(
                    ["gaze", "auth", "-u", self.username, "-s"],
                    stdin=subprocess.DEVNULL,
                    capture_output=True,
                    text=True,
                    timeout=4
                )
                duration_ms = int((time.time() - t0) * 1000)
                is_match = (res.returncode == 0)
                GLib.idle_add(self.on_camera_probe_result, is_match, duration_ms, forced)
            except Exception as e:
                duration_ms = int((time.time() - t0) * 1000)
                GLib.idle_add(self.on_camera_probe_result, False, duration_ms, forced, str(e))

        t = threading.Thread(target=worker, daemon=True)
        t.start()

    def on_camera_probe_result(self, is_match, duration_ms, forced, err=None):
        self.is_probing_camera = False
        self.last_probe_time = time.time()
        if is_match:
            self.last_face_match_time = time.time()
            self.absent_seconds = 0
            self.face_metric_row.set_subtitle(
                f"<span color='#34c759'><b>✓ {_t('Face Confirmed', 'Rostro Confirmado')} ({duration_ms}ms)</b></span>"
            )
            self.log_event(
                f"Gaze Auth: {_t('Owner face VERIFIED', 'Rostro del propietario VERIFICADO')} ({self.username}) in {duration_ms}ms."
            )
        else:
            if err:
                self.face_metric_row.set_subtitle(f"<span color='#ff3b30'>{_t('Camera error:', 'Error de cámara:')} {err}</span>")
                self.log_event(f"Gaze Auth Error: {err}")
            else:
                self.face_metric_row.set_subtitle(
                    f"<span color='#ff9500'><b>✗ {_t('No face / mismatch', 'Sin rostro / no coincide')} ({duration_ms}ms)</b></span>"
                )
                self.log_event(
                    f"Gaze Auth: {_t('No owner face detected in frame', 'No se detectó rostro del propietario')} ({duration_ms}ms)."
                )

    def on_poll_tick(self):
        if not self.is_running:
            return True

        idle_ms = get_mutter_idletime()
        idle_s = idle_ms / 1000.0

        # Update Idle telemetry row
        if idle_s < 3.0:
            self.idle_metric_row.set_subtitle(
                f"<span color='#34c759'><b>{_t('Active User', 'Usuario Activo')}</b></span> ({idle_ms} ms {_t('ago', 'atrás')})"
            )
            # Reset absence counter on physical input
            if self.absent_seconds > 0:
                self.log_event(f"Mutter: {_t('Physical input detected. Absence timer reset to 0.', 'Actividad física detectada. Temporizador reiniciado a 0.')}")
            self.absent_seconds = 0
            self.last_face_match_time = time.time()
        else:
            self.idle_metric_row.set_subtitle(
                f"<span color='#ff9500'>{_t('No keyboard/mouse activity for', 'Sin actividad de teclado/ratón desde hace')} {int(idle_s)}s</span>"
            )

        # Trigger camera check if idle >= 4s and not checked in the last 4s
        now = time.time()
        if idle_s >= 4.0:
            if (now - self.last_probe_time) >= 4.0 and not self.is_probing_camera:
                self.probe_camera_async(forced=False)

        # Compute presence status & countdown
        time_since_face = now - self.last_face_match_time
        if idle_s < 3.0 or time_since_face < 4.0:
            # User present
            self.absent_seconds = 0
            self.status_banner.set_title(_t("● User Present", "● Usuario Presente"))
            self.status_banner.set_subtitle(
                _t("User activity or face confirmed within the last 4 seconds", "Actividad confirmada en los últimos 4 segundos")
            )
            self.lock_progress.set_fraction(1.0)
            self.lock_metric_row.set_subtitle(f"0 / {self.timeout_limit}s ({_t('Safe', 'Protegido')})")
        else:
            # User considered absent or inactive
            self.absent_seconds += 1
            remaining = max(0, self.timeout_limit - self.absent_seconds)
            frac = max(0.0, remaining / float(self.timeout_limit))
            self.lock_progress.set_fraction(frac)
            self.lock_metric_row.set_subtitle(
                f"<span color='#ff3b30'><b>{self.absent_seconds} / {self.timeout_limit}s ({remaining}s {_t('remaining', 'restantes')})</b></span>"
            )

            if remaining > 0:
                self.status_banner.set_title(_t("⚠ Absence Countdown Running", "⚠ Cuenta Atrás de Ausencia Activa"))
                self.status_banner.set_subtitle(
                    f"{_t('No owner face or input detected. Screen locks in', 'No se detecta rostro ni actividad. Bloqueo en')} {remaining}s"
                )
            else:
                self.status_banner.set_title(_t("🔒 Auto-Lock Triggered!", "🔒 ¡Bloqueo Automático Disparado!"))
                self.status_banner.set_subtitle(
                    _t("Absence threshold reached.", "Se alcanzó el límite de ausencia sin detectar al usuario.")
                )
                if self.simulate_mode:
                    self.log_event(_t("[SIMULATION] Threshold reached: Screen lock command dispatched (Simulated)", "[SIMULACIÓN] Límite alcanzado: Bloqueo de pantalla disparado (Simulado)"))
                    self.absent_seconds = 0 # reset simulation cycle
                else:
                    self.log_event(_t("[REAL LOCK] Threshold reached: Executing loginctl lock-session...", "[BLOQUEO REAL] Límite alcanzado: Ejecutando loginctl lock-session..."))
                    subprocess.run(["loginctl", "lock-session"], check=False)
                    self.absent_seconds = 0

        return True


