# ── Native Animated Touch ID Widget using official fingerprint-symbolic icon ──
CSS_TOUCHID = """
.touchid-circle-frame {
    background-color: rgba(255, 255, 255, 0.08);
    border: 3px solid rgba(255, 255, 255, 0.22);
    border-radius: 9999px;
    padding: 20px;
    transition: all 0.35s cubic-bezier(0.25, 1, 0.5, 1);
}
@media (prefers-color-scheme: light) {
    .touchid-circle-frame {
        background-color: rgba(0, 0, 0, 0.05);
        border: 3px solid rgba(0, 0, 0, 0.16);
    }
}
.touchid-fp-icon {
    color: #0071e3;
    transition: all 0.3s ease;
}
.touchid-circle-frame.pulse {
    border-color: #0071e3;
    background-color: rgba(0, 113, 227, 0.18);
    box-shadow: 0 0 24px rgba(0, 113, 227, 0.65);
    transform: scale(1.06);
}
.touchid-circle-frame.retry {
    border-color: #ff9f0a;
    background-color: rgba(255, 159, 10, 0.18);
    box-shadow: 0 0 24px rgba(255, 159, 10, 0.65);
}
.touchid-circle-frame.completed {
    background-color: #30d158;
    border-color: #30d158;
    box-shadow: 0 0 28px rgba(48, 209, 88, 0.7);
    transform: scale(1.08);
}
.touchid-circle-frame.completed .touchid-fp-icon {
    color: #ffffff !important;
}
"""

class NativeAnimatedFingerprint(Gtk.Box):
    def __init__(self, size=130):
        super().__init__(orientation=Gtk.Orientation.VERTICAL)
        self.set_halign(Gtk.Align.CENTER)
        self.set_valign(Gtk.Align.CENTER)

        self.circle_box = Gtk.Box()
        self.circle_box.set_size_request(size, size)
        self.circle_box.set_halign(Gtk.Align.CENTER)
        self.circle_box.set_valign(Gtk.Align.CENTER)
        self.circle_box.add_css_class("touchid-circle-frame")

        self.icon = Gtk.Image.new_from_icon_name("fingerprint-symbolic")
        self.icon.set_pixel_size(int(size * 0.58))
        self.icon.set_halign(Gtk.Align.CENTER)
        self.icon.set_valign(Gtk.Align.CENTER)
        self.icon.add_css_class("touchid-fp-icon")

        self.circle_box.append(self.icon)
        self.append(self.circle_box)
        self._pulse_timer = None

    def set_stage(self, stage, total_stages):
        self.circle_box.remove_css_class("retry")
        self.circle_box.add_css_class("pulse")
        if self._pulse_timer:
            GLib.source_remove(self._pulse_timer)
        self._pulse_timer = GLib.timeout_add(GLib.PRIORITY_DEFAULT, 350, self._clear_pulse)

    def _clear_pulse(self):
        self.circle_box.remove_css_class("pulse")
        self._pulse_timer = None
        return GLib.SOURCE_REMOVE

    def set_retry(self):
        self.circle_box.remove_css_class("pulse")
        self.circle_box.add_css_class("retry")
        GLib.timeout_add(GLib.PRIORITY_DEFAULT, 450, lambda: self.circle_box.remove_css_class("retry"))

    def set_completed(self):
        self.circle_box.remove_css_class("pulse")
        self.circle_box.remove_css_class("retry")
        self.circle_box.add_css_class("completed")
        self.icon.set_from_icon_name("emblem-ok-symbolic")

    def reset(self):
        self.circle_box.remove_css_class("pulse")
        self.circle_box.remove_css_class("retry")
        self.circle_box.remove_css_class("completed")
        self.icon.set_from_icon_name("fingerprint-symbolic")

def create_animated_fingerprint_widget(size=130):
    return NativeAnimatedFingerprint(size)

# ── Localization Helper ────────────────────────────────────────────────────────
def is_spanish():
    for k in ("LC_ALL", "LC_MESSAGES", "LANG"):
        v = os.environ.get(k, "")
        if v:
            return v.lower().startswith("es")
    return False

def _t(en_text, es_text):
    return es_text if is_spanish() else en_text

# ── Goodix & Fingerprint Hardware Detection ──────────────────────────────────
FINGER_NAMES = {
    "right-thumb": ("Right Thumb", "Pulgar derecho"),
    "right-index-finger": ("Right Index Finger", "Índice derecho"),
    "right-middle-finger": ("Right Middle Finger", "Corazón derecho"),
    "right-ring-finger": ("Right Ring Finger", "Anular derecho"),
    "right-little-finger": ("Right Little Finger", "Meñique derecho"),
    "left-thumb": ("Left Thumb", "Pulgar izquierdo"),
    "left-index-finger": ("Left Index Finger", "Índice izquierdo"),
    "left-middle-finger": ("Left Middle Finger", "Corazón izquierdo"),
    "left-ring-finger": ("Left Ring Finger", "Anular izquierdo"),
    "left-little-finger": ("Left Little Finger", "Meñique izquierdo"),
}

def get_finger_display_name(finger_id):
    pair = FINGER_NAMES.get(finger_id)
    if pair:
        return _t(pair[0], pair[1])
    return finger_id.replace("-", " ").title()

def get_num_enroll_stages():
    try:
        res = subprocess.run([
            "gdbus", "call", "--system",
            "--dest", "net.reactivated.Fprint",
            "--object-path", "/net/reactivated/Fprint/Device/0",
            "--method", "org.freedesktop.DBus.Properties.Get",
            "net.reactivated.Fprint.Device", "num-enroll-stages"
        ], capture_output=True, text=True, timeout=2)
        if res.returncode == 0:
            val = res.stdout.strip().replace("(<", "").replace(">,)", "").replace("uint32", "").replace("(", "").replace(")", "").strip()
            return max(5, int(val))
    except Exception:
        pass
    return 13

def get_enrolled_fingers(username):
    # 1. Try D-Bus ListEnrolledFingers
    try:
        res = subprocess.run([
            "gdbus", "call", "--system",
            "--dest", "net.reactivated.Fprint",
            "--object-path", "/net/reactivated/Fprint/Device/0",
            "--method", "net.reactivated.Fprint.Device.ListEnrolledFingers",
            username
        ], capture_output=True, text=True, timeout=2)
        if res.returncode == 0:
            out = res.stdout.strip()
            fingers = []
            for f_key in FINGER_NAMES.keys():
                if f_key in out and f_key not in fingers:
                    fingers.append(f_key)
            if fingers:
                return fingers
    except Exception:
        pass

    # 2. Try fprintd-list CLI
    fingers = []
    try:
        res = subprocess.run(["fprintd-list", username], stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=2)
        if res.returncode == 0:
            for line in res.stdout.splitlines():
                line_lower = line.lower().strip()
                for f_key in FINGER_NAMES.keys():
                    if f_key in line_lower and f_key not in fingers:
                        fingers.append(f_key)
    except Exception:
        pass
    return fingers

# ── Biometrics & Presence Config Helpers ─────────────────────────────────────
def get_biometrics_config_path():
    return os.path.expanduser("~/.config/pulsaros/biometrics.json")

def load_biometrics_config():
    p = get_biometrics_config_path()
    cfg = {"touch_id_enabled": True, "face_id_enabled": True}
    paths = [p, "/etc/pulsaros/biometrics.json"]
    for path in paths:
        if os.path.exists(path):
            try:
                with open(path, "r") as f:
                    cfg.update(json.load(f))
                    break
            except Exception:
                pass
    return cfg

def save_biometrics_config(cfg):
    p = get_biometrics_config_path()
    os.makedirs(os.path.dirname(p), exist_ok=True)
    try:
        with open(p, "w") as f:
            json.dump(cfg, f, indent=2)
    except Exception as e:
        print("Error saving biometrics config:", e)

    # Notify biometrics daemon
    try:
        import urllib.request
        req = urllib.request.Request(
            "http://127.0.0.1:39281/config",
            data=json.dumps(cfg).encode("utf-8"),
            headers={"Content-Type": "application/json"}
        )
        urllib.request.urlopen(req, timeout=1)
    except Exception:
        pass


# ── System Activity & Face Helpers ─────────────────────────────────────────────
def get_mutter_idletime():
    try:
        res = subprocess.run([
            "gdbus", "call", "--session",
            "--dest", "org.gnome.Mutter.IdleMonitor",
            "--object-path", "/org/gnome/Mutter/IdleMonitor/Core",
            "--method", "org.gnome.Mutter.IdleMonitor.GetIdletime"
        ], capture_output=True, text=True, timeout=1)
        if res.returncode == 0:
            val = res.stdout.strip().replace("(", "").replace(")", "").replace("uint64", "").replace(",", "").strip()
            return int(val)
    except Exception:
        pass
    return 0


# ==============================================================================
# Graphical Touch ID Enrollment Dialog (Zero-Terminal, Real-Time Hardware Events)
# ==============================================================================
class TouchIDEnrollDialog(Adw.Window):
    def __init__(self, parent_window, username, finger=None):
        super().__init__()
        self.set_transient_for(parent_window)
        self.set_modal(True)
        self.finger = finger
        finger_name = get_finger_display_name(finger) if finger else _t("Touch ID", "Touch ID")
        self.set_title(f"{_t('Touch ID Setup', 'Configurar Touch ID')} - {finger_name}")
        self.set_default_size(440, 520)
        self.set_resizable(False)

        self.username = username
        self.proc = None
        self.stage_count = 0
        self.max_stages = get_num_enroll_stages()
        self.enrolled_successfully = False

        # Main Box
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.set_content(main_box)

        # Header Bar
        header = Adw.HeaderBar()
        header.set_show_end_title_buttons(False)
        header.set_show_start_title_buttons(True)
        main_box.append(header)

        # Content Card
        content_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        content_box.set_margin_top(20)
        content_box.set_margin_bottom(28)
        content_box.set_margin_start(36)
        content_box.set_margin_end(36)
        content_box.set_valign(Gtk.Align.CENTER)
        content_box.set_halign(Gtk.Align.CENTER)
        main_box.append(content_box)

        # 1. Fingerprint Graphic (Native Animated GTK4 Widget)
        self.fp_widget = create_animated_fingerprint_widget(130)
        content_box.append(self.fp_widget)

        # 2. Title & Status
        self.title_lbl = Gtk.Label()
        self.title_lbl.set_markup(f"<span font_weight='bold' size='15000'>{finger_name}</span>")
        content_box.append(self.title_lbl)

        self.instruction_lbl = Gtk.Label(label=_t("Place your finger on the sensor to begin", "Coloca tu dedo en el sensor para comenzar"))
        self.instruction_lbl.set_wrap(True)
        self.instruction_lbl.set_justify(Gtk.Justification.CENTER)
        self.instruction_lbl.set_max_width_chars(38)
        self.instruction_lbl.add_css_class("dim-label")
        content_box.append(self.instruction_lbl)

        # 3. Progress Bar
        self.progress_bar = Gtk.ProgressBar()
        self.progress_bar.set_fraction(0.0)
        self.progress_bar.set_size_request(300, 8)
        self.progress_bar.set_halign(Gtk.Align.CENTER)
        self.progress_bar.add_css_class("suggested-action")
        content_box.append(self.progress_bar)

        self.stage_lbl = Gtk.Label(label=_t("Waiting for sensor...", "Esperando lector..."))
        self.stage_lbl.add_css_class("caption")
        content_box.append(self.stage_lbl)

        # 4. Action Buttons
        self.btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        self.btn_box.set_halign(Gtk.Align.CENTER)
        self.btn_box.set_margin_top(12)
        content_box.append(self.btn_box)

        self.btn_cancel = Gtk.Button(label=_t("Cancel", "Cancelar"))
        self.btn_cancel.connect("clicked", self.on_cancel_clicked)
        self.btn_box.append(self.btn_cancel)

        self.btn_done = Gtk.Button(label=_t("Done", "Aceptar"))
        self.btn_done.add_css_class("suggested-action")
        self.btn_done.set_visible(False)
        self.btn_done.connect("clicked", self.on_done_clicked)
        self.btn_box.append(self.btn_done)

        self.connect("close-request", self.on_close_request)

        # Start background enrollment thread
        self.start_enrollment()

    def start_enrollment(self):
        def worker():
            try:
                cmd = ["fprintd-enroll"]
                if self.finger:
                    cmd.extend(["-f", self.finger])
                cmd.append(self.username)
                self.proc = subprocess.Popen(
                    cmd,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    text=True,
                    bufsize=1
                )
                for line in self.proc.stdout:
                    line_s = line.strip()
                    if not line_s:
                        continue
                    GLib.idle_add(self.handle_enroll_line, line_s)
                self.proc.wait()
                rc = self.proc.returncode
                GLib.idle_add(self.handle_enroll_finished, rc)
            except Exception as e:
                GLib.idle_add(self.handle_enroll_error, str(e))

        t = threading.Thread(target=worker, daemon=True)
        t.start()

    def handle_enroll_line(self, line):
        if "Enrolling" in line:
            self.instruction_lbl.set_markup(f"<b>{_t('Place and hold your finger on the sensor', 'Coloca tu dedo en el sensor')}</b>")
            self.stage_lbl.set_text(_t("Sensor ready. Touch lightly.", "Sensor listo. Toca suavemente."))
        elif "enroll-stage-passed" in line:
            self.stage_count += 1
            frac = min(0.95, self.stage_count / float(self.max_stages))
            self.progress_bar.set_fraction(frac)
            self.instruction_lbl.set_markup(f"<b>{_t('Lift your finger and place it again', 'Levanta el dedo y vuelve a colocarlo')}</b>")
            self.stage_lbl.set_text(f"{_t('Stage', 'Paso')} {self.stage_count} / {self.max_stages}")
            if hasattr(self, "fp_widget") and hasattr(self.fp_widget, "set_stage"):
                self.fp_widget.set_stage(self.stage_count, self.max_stages)
        elif "enroll-retry-scan" in line:
            self.instruction_lbl.set_markup(f"<b>{_t('Could not read fingerprint. Try again firmly.', 'No se pudo leer bien. Vuelve a colocarlo firmemente.')}</b>")
            if hasattr(self, "fp_widget") and hasattr(self.fp_widget, "set_retry"):
                self.fp_widget.set_retry()
        elif "enroll-swipe-too-short" in line:
            self.instruction_lbl.set_markup(f"<b>{_t('Swipe longer and steadier.', 'Mantén el dedo más tiempo sobre el sensor.')}</b>")
            if hasattr(self, "fp_widget") and hasattr(self.fp_widget, "set_retry"):
                self.fp_widget.set_retry()
        elif "enroll-finger-not-centered" in line:
            self.instruction_lbl.set_markup(f"<b>{_t('Center your finger on the sensor.', 'Centra tu dedo en el lector.')}</b>")
            if hasattr(self, "fp_widget") and hasattr(self.fp_widget, "set_retry"):
                self.fp_widget.set_retry()
        elif "enroll-completed" in line:
            self.enrolled_successfully = True
            self.progress_bar.set_fraction(1.0)
            self.instruction_lbl.set_markup(f"<span color='#34c759'><b>✓ {_t('Touch ID setup complete!', '¡Touch ID configurado con éxito!')}</b></span>")
            self.stage_lbl.set_text(f"{_t('Stage', 'Paso')} {self.max_stages} / {self.max_stages}")
            self.btn_cancel.set_visible(False)
            self.btn_done.set_visible(True)
            if hasattr(self, "fp_widget") and hasattr(self.fp_widget, "set_completed"):
                self.fp_widget.set_completed()

    def handle_enroll_finished(self, rc):
        if rc == 0 or self.enrolled_successfully:
            self.enrolled_successfully = True
            self.progress_bar.set_fraction(1.0)
            self.instruction_lbl.set_markup(f"<span color='#34c759'><b>✓ {_t('Touch ID setup complete!', '¡Touch ID configurado con éxito!')}</b></span>")
            self.stage_lbl.set_text(f"{_t('Stage', 'Paso')} {self.max_stages} / {self.max_stages}")
            self.btn_cancel.set_visible(False)
            self.btn_done.set_visible(True)
            if hasattr(self, "fp_widget") and hasattr(self.fp_widget, "evaluate_javascript"):
                try:
                    self.fp_widget.evaluate_javascript("setCompleted();", -1, None, None, None, None, None)
                except Exception:
                    pass
        else:
            if not self.enrolled_successfully:
                self.instruction_lbl.set_markup(f"<span color='#ff3b30'><b>{_t('Enrollment was canceled or interrupted.', 'Registro cancelado o interrumpido.')}</b></span>")
                self.stage_lbl.set_text(_t("Please try again.", "Puedes volver a intentarlo."))
                self.btn_cancel.set_label(_t("Close", "Cerrar"))

    def handle_enroll_error(self, err_msg):
        self.instruction_lbl.set_markup(f"<span color='#ff3b30'><b>{_t('Sensor error:', 'Error en el lector:')} {err_msg}</b></span>")
        self.btn_cancel.set_label(_t("Close", "Cerrar"))

    def on_cancel_clicked(self, btn):
        self.stop_proc()
        self.close()

    def on_done_clicked(self, btn):
        self.stop_proc()
        self.close()

    def on_close_request(self, win):
        self.stop_proc()
        return False

    def stop_proc(self):
        if self.proc and self.proc.poll() is None:
            try:
                self.proc.terminate()
            except Exception:
                pass


# ==============================================================================
# Touch ID Fingerprints Manager Window (macOS Tahoe & Gaze-like Style)
# ==============================================================================
class TouchIDManagerWindow(Adw.Window):
    def __init__(self, parent_window, username):
        super().__init__()
        self.set_transient_for(parent_window)
        self.set_title(_t("Touch ID", "Touch ID"))
        self.set_default_size(520, 560)
        self.set_resizable(False)
        self.username = username
        self.parent_window = parent_window

        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.set_content(main_box)

        header = Adw.HeaderBar()
        header.set_show_start_title_buttons(True)
        header.set_show_end_title_buttons(True)
        main_box.append(header)

        scrolled = Gtk.ScrolledWindow()
        scrolled.set_vexpand(True)
        scrolled.set_hexpand(True)
        main_box.append(scrolled)

        content_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        content_box.set_margin_top(16)
        content_box.set_margin_bottom(24)
        content_box.set_margin_start(24)
        content_box.set_margin_end(24)
        scrolled.set_child(content_box)

        # Top Hero Card
        hero_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        hero_box.set_halign(Gtk.Align.CENTER)
        hero_box.set_margin_bottom(6)

        hero_icon = Gtk.Image.new_from_icon_name("fingerprint-symbolic")
        hero_icon.set_pixel_size(60)
        hero_box.append(hero_icon)

        hero_title = Gtk.Label()
        hero_title.set_markup(f"<span font_weight='bold' size='14000'>{_t('Configured Fingerprints', 'Huellas Registradas')}</span>")
        hero_box.append(hero_title)

        hero_subtitle = Gtk.Label(label=_t(
            "Use your registered fingerprints to log in and authorize actions without typing your password.",
            "Usa tus huellas registradas para iniciar sesión y autorizar tareas del sistema sin introducir tu contraseña."
        ))
        hero_subtitle.set_wrap(True)
        hero_subtitle.set_justify(Gtk.Justification.CENTER)
        hero_subtitle.set_max_width_chars(44)
        hero_subtitle.add_css_class("dim-label")
        hero_box.append(hero_subtitle)

        content_box.append(hero_box)

        # Fingerprints List Group
        self.finger_group = Adw.PreferencesGroup()
        self.finger_group.set_title(_t("Fingerprints", "Huellas"))
        content_box.append(self.finger_group)
        self.finger_rows = []

        # Add Button Row / Bar
        btn_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        btn_box.set_margin_top(10)
        btn_box.set_halign(Gtk.Align.CENTER)
        content_box.append(btn_box)

        self.btn_add_finger = Gtk.Button(label=_t("+ Add Fingerprint…", "+ Añadir huella…"))
        self.btn_add_finger.add_css_class("suggested-action")
        self.btn_add_finger.add_css_class("pill")
        self.btn_add_finger.set_size_request(220, 42)
        self.btn_add_finger.connect("clicked", self.on_add_finger_clicked)
        btn_box.append(self.btn_add_finger)

        self.refresh_list()

    def refresh_list(self):
        for r in self.finger_rows:
            self.finger_group.remove(r)
        self.finger_rows.clear()

        enrolled = get_enrolled_fingers(self.username)
        if not enrolled:
            empty_row = Adw.ActionRow()
            empty_row.set_title(_t("No fingerprints registered yet", "No hay huellas registradas"))
            empty_row.set_subtitle(_t("Click '+ Add Fingerprint…' below to register a finger.", "Pulsa en '+ Añadir huella…' para registrar tu primer dedo."))
            empty_icon = Gtk.Image.new_from_icon_name("fingerprint-symbolic")
            empty_icon.set_pixel_size(24)
            empty_row.add_prefix(empty_icon)
            self.finger_group.add(empty_row)
            self.finger_rows.append(empty_row)
        else:
            for f in enrolled:
                row = Adw.ActionRow()
                row.set_title(get_finger_display_name(f))
                row.set_subtitle(_t("Enrolled and active for unlock and sudo", "Registrada y activa para desbloqueo y sudo"))
                icon = Gtk.Image.new_from_icon_name("fingerprint-symbolic")
                icon.set_pixel_size(24)
                row.add_prefix(icon)

                btn_del = Gtk.Button(label=_t("Delete", "Eliminar"))
                btn_del.set_valign(Gtk.Align.CENTER)
                btn_del.add_css_class("destructive-action")
                btn_del.connect("clicked", lambda b, finger=f: self.on_delete_finger_clicked(finger))
                row.add_suffix(btn_del)

                self.finger_group.add(row)
                self.finger_rows.append(row)

        if hasattr(self.parent_window, "refresh_status"):
            self.parent_window.refresh_status()

    def on_delete_finger_clicked(self, finger):
        finger_name = get_finger_display_name(finger)
        dialog = Adw.MessageDialog(
            transient_for=self,
            heading=_t(f"Delete {finger_name}?", f"¿Eliminar {finger_name}?"),
            body=_t(
                "Are you sure you want to delete this fingerprint? You will no longer be able to use it with Touch ID.",
                "¿Seguro que deseas eliminar esta huella? Ya no podrás usarla para identificarte con Touch ID."
            )
        )
        dialog.add_response("cancel", _t("Cancel", "Cancelar"))
        dialog.add_response("delete", _t("Delete", "Eliminar"))
        dialog.set_response_appearance("delete", Adw.ResponseAppearance.DESTRUCTIVE)

        def on_response(d, resp):
            if resp == "delete":
                subprocess.run(["fprintd-delete", self.username, "-f", finger], check=False)
                self.refresh_list()

        dialog.connect("response", on_response)
        dialog.present()

    def on_add_finger_clicked(self, btn):
        all_fingers = list(FINGER_NAMES.keys())
        enrolled = get_enrolled_fingers(self.username)
        available = [f for f in all_fingers if f not in enrolled]

        if not available:
            diag = Adw.MessageDialog(
                transient_for=self,
                heading=_t("Maximum fingerprints reached", "Límite de huellas alcanzado"),
                body=_t("You have already registered all 10 fingers.", "Ya has registrado los 10 dedos.")
            )
            diag.add_response("ok", _t("OK", "Aceptar"))
            diag.present()
            return

        pref_default = "right-index-finger" if "right-index-finger" in available else available[0]

        dialog = Adw.MessageDialog(
            transient_for=self,
            heading=_t("Choose Finger to Enroll", "Elegir Dedo a Registrar"),
            body=_t("Select which finger you want to add to Touch ID:", "Selecciona qué dedo deseas añadir a Touch ID:")
        )
        dialog.add_response("cancel", _t("Cancel", "Cancelar"))
        dialog.add_response("enroll", _t("Start Setup", "Comenzar"))
        dialog.set_response_appearance("enroll", Adw.ResponseAppearance.SUGGESTED)

        drop_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        drop_box.set_margin_top(14)
        drop_box.set_margin_bottom(14)
        drop_box.set_margin_start(24)
        drop_box.set_margin_end(24)

        row_select = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        row_select.set_halign(Gtk.Align.CENTER)

        lbl_finger = Gtk.Label(label=_t("Finger:", "Dedo:"))
        lbl_finger.add_css_class("heading")
        row_select.append(lbl_finger)

        labels = [get_finger_display_name(f) for f in available]
        dropdown = Gtk.DropDown.new_from_strings(labels)
        try:
            default_idx = available.index(pref_default)
        except ValueError:
            default_idx = 0
        dropdown.set_selected(default_idx)
        dropdown.set_size_request(240, 38)
        row_select.append(dropdown)
        drop_box.append(row_select)

        dialog.set_extra_child(drop_box)

        def on_response(d, resp):
            if resp == "enroll":
                sel_idx = dropdown.get_selected()
                chosen_finger = available[sel_idx] if 0 <= sel_idx < len(available) else available[0]
                enroll_dialog = TouchIDEnrollDialog(self, self.username, finger=chosen_finger)
                enroll_dialog.connect("destroy", lambda w: self.refresh_list())
                enroll_dialog.present()

        dialog.connect("response", on_response)
        dialog.present()


# ==============================================================================
# Live Presence Detection & Face ID Diagnostics Window
# ==============================================================================
class PresenceDebugWindow(Adw.Window):
    def __init__(self, parent_window=None):
        super().__init__()
        if parent_window:
            self.set_transient_for(parent_window)
        self.set_title(_t("Live Presence & Face ID Diagnostics", "Diagnóstico en Vivo de Presencia y Face ID"))
        self.set_default_size(720, 680)

        self.username = GLib.get_user_name()
        self.is_running = True
        self.last_face_match_time = time.time()
        self.last_probe_time = 0
        self.is_probing_camera = False
        self.timeout_limit = 30
        self.absent_seconds = 0
        self.simulate_mode = False

        # Load configured timeout
        try:
            cfg_path = os.path.expanduser("~/.config/pulsaros/presence.json")
            if os.path.exists(cfg_path):
                with open(cfg_path, "r") as f:
                    cfg = json.load(f)
                    self.timeout_limit = int(cfg.get("timeout_seconds", 30))
        except Exception:
            pass

        # Main Box
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.set_content(main_box)

        # HeaderBar
        header = Adw.HeaderBar()
        title_widget = Adw.WindowTitle(
            title=_t("Presence Detection Live Monitor", "Monitor en Vivo de Presencia"),
