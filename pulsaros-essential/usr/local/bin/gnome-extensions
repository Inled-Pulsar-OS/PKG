#!/usr/bin/env python3
import sys
import subprocess
import re

cmd = ["/usr/bin/gnome-extensions"] + sys.argv[1:]
proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)

out = proc.stdout
err = proc.stderr

def get_error_for_uuid(uuid):
    try:
        res = subprocess.run(
            ["gdbus", "call", "--session", "--dest", "org.gnome.Shell.Extensions",
             "--object-path", "/org/gnome/Shell/Extensions",
             "--method", "org.gnome.Shell.Extensions.GetExtensionInfo", uuid],
            capture_output=True, text=True, timeout=2
        )
        if res.returncode == 0:
            m = re.search(r"\'error\':\s*<([^>]+)>", res.stdout)
            if m:
                val = m.group(1).strip()
                if val and val != "''" and val != '""':
                    return val.strip("'\"")
    except Exception:
        pass
    return None

if out:
    lines = out.split("\n")
    new_lines = []
    current_uuid = None
    
    if len(sys.argv) >= 3 and sys.argv[1] == "info":
        current_uuid = sys.argv[2]

    for line in lines:
        new_lines.append(line)
        clean = line.strip()
        if re.match(r"^[a-zA-Z0-9._-]+@[a-zA-Z0-9._-]+$", clean):
            current_uuid = clean
        elif "Estado: ERROR" in line or "State: ERROR" in line:
            if current_uuid:
                err_msg = get_error_for_uuid(current_uuid)
                if err_msg:
                    new_lines.append(f"  Error: \033[91m{err_msg}\033[0m" if sys.stdout.isatty() else f"  Error: {err_msg}")

    sys.stdout.write("\n".join(new_lines))
else:
    sys.stdout.write(out)

sys.stderr.write(err)
sys.exit(proc.returncode)
