#!/bin/bash
# ==============================================================================
# Pulsar OS - rEFInd Bootloader Package Post-installation Script
# ==============================================================================
# English: Ships the macOS rEFInd theme and keeps an installed rEFInd config
#          sane. It NEVER runs refind-install: that would re-write the NVRAM
#          boot order / refind_linux.conf, and during an ISO chroot build
#          (/proc + /dev bind-mounted from the host) it would modify the BUILD
#          HOST's ESP - the incident that previously corrupted a developer's
#          boot menu with an rEFInd under scanfor.
# Español: Distribuye el tema macOS de rEFInd y mantiene saneado el refind.conf.
#          NUNCA ejecuta refind-install: reescribe el orden de arranque NVRAM y
#          refind_linux.conf, y dentro de un chroot de build (/proc + /dev
#          bind-mount del host) alteraría el ESP del HOST - el incidente que
#          corrompió el menú de arranque con un rEFInd bajo scanfor.
# ==============================================================================
set -e

echo "🎨 Configurando rEFInd en Pulsar OS..."
echo "🎨 Configuring rEFInd in Pulsar OS..."

# Detect ISO/live/chroot build environments and never touch the ESP there.
# Detecta entornos live/ISO/chroot de construcción y nunca toca el ESP ahí.
is_chroot() {
    if command -v systemd-detect-virt >/dev/null 2>&1 && systemd-detect-virt --chroot >/dev/null 2>&1; then
        return 0
    fi
    if [ -d "/run/live/medium" ] || [ -d "/lib/live/mount" ] || [ -d "/run/archiso/bootmnt" ]; then
        return 0
    fi
    if [ -r /proc/1/root ] && [ -r /proc/self/root ]; then
        local host_root self_root
        host_root="$(stat -c %d:%i /proc/1/root/. 2>/dev/null || true)"
        self_root="$(stat -c %d:%i /. 2>/dev/null || true)"
        if [ -n "$host_root" ] && [ -n "$self_root" ] && [ "$host_root" != "$self_root" ]; then
            return 0
        fi
    fi
    return 1
}

if is_chroot; then
    echo "⚠️ Entorno live/chroot de construcción detectado; se omite la configuración de rEFInd."
    exit 0
fi

# Only act when /boot/efi is a real ESP mounted in this running system.
# Solo se actúa cuando /boot/efi es un ESP real montado en el sistema.
if ! command -v findmnt >/dev/null 2>&1 || ! findmnt -rn /boot/efi >/dev/null 2>&1; then
    echo "⚠️ No hay ESP montado en /boot/efi; se omite la configuración de rEFInd."
    exit 0
fi

# -----------------------------------------------------------------------------
# Normalize one refind.conf: remove every existing scanfor/dont_scan* line and
# re-emit a single coherent set (duplicate scanfor values hide OSes / break the
# menu). / Normaliza un refind.conf: quita las líneas scanfor/dont_scan* y emite
# un único conjunto coherente.
# -----------------------------------------------------------------------------
sanitize_refind_conf() {
    local rc="$1" tmp
    [ -f "$rc" ] || return 0
    tmp="$(mktemp)"
    grep -vE '^[[:space:]]*(#)?[[:space:]]*(scanfor|dont_scan_dirs|dont_scan_files|dont_scan_volumes|default_selection)([[:space:]]|$)' "$rc" > "$tmp" || true
    {
        cat "$tmp"
        printf '\nscanfor manual,internal,external\n'
        printf 'dont_scan_volumes PULSAR_OS,PULSAR_RECOVERY,PULSAR_BOOT,PULSAR_LIVE,PULSAROS_LIVE,CDROM\n'
        printf 'dont_scan_dirs EFI/recovery,recovery,EFI/BOOT/recovery,live,@,@/boot,themes,drivers_x64,EFI/PulsarOS\n'
        printf 'dont_scan_files vmlinuz*,vmlinuz*.efi,vmlinuz-recovery*,initramfs*,initrd*\n'
        printf 'default_selection "Pulsar OS,+,1"\n'
        printf 'hideui singleuser,hints\n'
    } > "$rc"
    rm -f "$tmp"
}

# Copy/install the macOS theme for rEFInd (only if rEFInd is already installed).
# Copia/instala el tema macOS de rEFInd (solo si rEFInd ya está instalado).
THEMES_DIR="/boot/efi/EFI/refind/themes"
THEME_SRC="/usr/share/refind/themes/rEFInd-Regular-Dark"
THEME_DEST="$THEMES_DIR/rEFInd-Regular-Dark"

if [ -d "/boot/efi/EFI/refind" ] || [ -d "/boot/efi/EFI/BOOT" ]; then
    echo "📥 Instalando tema macOS para rEFInd..."
    mkdir -p "$THEMES_DIR"
    rm -rf "$THEME_DEST"
    if [ -d "$THEME_SRC" ]; then
        echo "📂 Copiando archivos de tema locales..."
        cp -r "$THEME_SRC" "$THEME_DEST"
    else
        echo "⚠️ Tema rEFInd no disponible en $THEME_SRC; se continuará sin él."
    fi

    # Configure refind.conf / Configurar refind.conf
    for REFIND_CONF in /boot/efi/EFI/refind/refind.conf /boot/efi/EFI/BOOT/refind.conf; do
        if [ -f "$REFIND_CONF" ]; then
            echo "⚙️ Saneando refind.conf ($REFIND_CONF)..."
            sed -i 's/^enable_mouse.*/enable_mouse/' "$REFIND_CONF"
            grep -q "^enable_mouse" "$REFIND_CONF" || echo "enable_mouse" >> "$REFIND_CONF"
            grep -q "include themes/rEFInd-Regular-Dark/theme.conf" "$REFIND_CONF" || echo "include themes/rEFInd-Regular-Dark/theme.conf" >> "$REFIND_CONF"
            sanitize_refind_conf "$REFIND_CONF"
        fi
    done
else
    echo "⚠️ Directorios EFI de rEFInd no encontrados. No hay rEFInd instalado que configurar."
fi

exit 0