#!/bin/bash
# ==============================================================================
# Pulsar OS - Enroll the Pulsar Secure Boot MOK (Machine Owner Key)
# ==============================================================================
# English: enrolls Pulsar's public Secure Boot key as a MOK so the installed
#          system boots rEFInd and kernels signed by Pulsar with Secure Boot
#          active. Requires one reboot: MokManager will ask to confirm the key.
# Español: enrola la clave pública de Secure Boot de Pulsar como MOK para que
#          el sistema instalado arranque rEFInd y kernels firmados por Pulsar
#          con Secure Boot activo. Requiere un reinicio: MokManager pedirá
#          confirmar la clave.
# ==============================================================================
# Typical flow / Flujo típico:
#   sudo pulsar-enroll-mok
#   (escribe una contraseña temporal; reinicia; en MokManager: Enroll MOK)
# ==============================================================================
set -e

MOK_CER="/usr/share/pulsar/secureboot/pulsar-mok.cer"

if [ "$(id -u)" -ne 0 ]; then
    echo "❌ Ejecuta como root / Run as root: sudo pulsar-enroll-mok"
    exit 1
fi

if [ ! -f "$MOK_CER" ]; then
    echo "❌ No se encontró $MOK_CER. Reinstala el paquete pulsaros-refind."
    exit 1
fi

if ! command -v mokutil >/dev/null 2>&1; then
    echo "⚠️ mokutil no está instalado."
    echo "   Instálalo: sudo apt install mokutil (Debian) / sudo pacman -S mokutil (Arch)."
    read -r -p "¿Continuar con el enrolado manual por MokManager? [s/N] " yn
    [ "${yn,,}" = "s" ] || exit 1
    echo ""
    echo "1. Copia la clave a la ESP: sudo cp $MOK_CER /boot/efi/EFI/refind/refind.cer"
    echo "2. Reinicia. Shim abre MokManager (rEFInd no está firmado todavía)."
    echo "3. Elige 'Enroll key from disk', localiza refind.cer y confirma."
    echo "4. Reinicia de nuevo: rEFInd arrancará con Secure Boot activo."
    exit 0
fi

echo "Estado de Secure Boot / Secure Boot state:"
mokutil --sb-state 2>/dev/null || true

if mokutil --test-key "$MOK_CER" >/dev/null 2>&1; then
    echo "✅ La MOK de Pulsar ya está enrolada / The Pulsar MOK is already enrolled."
    exit 0
fi

echo ""
echo "🔑 Se importará la MOK de Pulsar. Necesitas una contraseña temporal"
echo "   (solo sirve para confirmar el enrolado tras el reinicio)."
read -r -s -p "Contraseña / Password: " pw1
echo ""
read -r -s -p "Repite / Repeat: " pw2
echo ""
if [ "$pw1" != "$pw2" ]; then
    echo "❌ Las contraseñas no coinciden / Passwords do not match."
    exit 1
fi
[ -n "$pw1" ] || { echo "❌ La contraseña no puede estar vacía."; exit 1; }

mokutil --import "$MOK_CER" --password "$pw1"

echo ""
echo "✅ MOK importada correctamente."
echo "   Reinicia el equipo. En MokManager elige 'Enroll MOK' -> 'Continue' y"
echo "   escribe la contraseña que acabas de usar. Después reinicia otra vez."
echo "   / Reboot. In MokManager choose 'Enroll MOK' -> 'Continue', enter the"
echo "   password you just used, then reboot again."