#!/bin/bash
# ==============================================================================
# Tube OS TV UI (Tauri / Native Webview Runner)
# ==============================================================================

STATIC_UI="file:///usr/share/tubeos-ui/index.html"
TAURI_BIN="/usr/bin/tubeos-tv"

if [ -x "$TAURI_BIN" ]; then
    exec "$TAURI_BIN" "$@"
fi

# Pure native WebKitGTK / Gtk fullscreen webview (no browser frame, no address bar)
if python3 -c "import gi; gi.require_version('Gtk', '3.0'); from gi.repository import Gtk" >/dev/null 2>&1; then
    exec python3 -c "
import sys
import gi
gi.require_version('Gtk', '3.0')
try:
    gi.require_version('WebKit2', '4.1')
except ValueError:
    try:
        gi.require_version('WebKit2', '4.0')
    except ValueError:
        pass
from gi.repository import Gtk
try:
    from gi.repository import WebKit2 as WebKit
except ImportError:
    WebKit = None

win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
win.set_title('Tube OS TV')
win.fullscreen()
win.connect('destroy', Gtk.main_quit)

if WebKit:
    settings = WebKit.Settings()
    settings.set_enable_developer_extras(False)
    settings.set_allow_file_access_from_file_urls(True)
    settings.set_allow_universal_access_from_file_urls(True)
    settings.set_enable_media_stream(True)
    view = WebKit.WebView.new_with_settings(settings)
    view.load_uri('${STATIC_UI}')
    win.add(view)
else:
    label = Gtk.Label(label='Tube OS TV')
    win.add(label)

win.show_all()
Gtk.main()
"
elif command -v python3 >/dev/null 2>&1; then
    exec python3 -c "
try:
    import webview
    webview.create_window('Tube OS TV', '${STATIC_UI}', fullscreen=True)
    webview.start()
except Exception as e:
    print(f'Webview error: {e}')
"
fi
