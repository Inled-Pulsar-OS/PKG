<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  Session-bus contract between pulsaros-airpods-daemon and the GNOME Shell extension.

  Bus name:    org.pulsaros.AirPods
  Object path: /org/pulsaros/AirPods

  Conventions
  - Battery values are percentages 0..100 in steps of 10 (the protocol reports 0..10).
    -1 means "unavailable". Never 0 for unavailable.
  - Properties other than Connected are meaningful only while Connected is true.
    While not connected: strings are empty, integers are -1, booleans are false.
  - Interface changes are additive. Breaking changes bump the interface name (AirPods2).
-->
<node>
  <interface name="org.pulsaros.AirPods">
    <!-- True while the bound AirPods are connected over classic Bluetooth (BlueZ Device1). -->
    <property name="Connected" type="b" access="read"/>
    <!-- Name from BlueZ (user-chosen, e.g. "Victor's AirPods Pro"). -->
    <property name="Name" type="s" access="read"/>
    <!-- Classic Bluetooth address of the bound device, e.g. "AA:BB:CC:DD:EE:FF". -->
    <property name="Address" type="s" access="read"/>
    <!-- Stable slug for artwork lookup: airpods_pro_2, airpods_max, ... or "unknown". -->
    <property name="ModelId" type="s" access="read"/>
    <!-- Human readable model name, e.g. "AirPods Pro 2". Empty when unknown. -->
    <property name="Model" type="s" access="read"/>
    <!-- True for over-ear headphones (no case, no per-bud data). -->
    <property name="IsHeadphones" type="b" access="read"/>
    <!-- True while a recent BLE advertisement backs the fields below. -->
    <property name="HasAdvertisement" type="b" access="read"/>
    <property name="Left" type="i" access="read"/>
    <property name="Right" type="i" access="read"/>
    <property name="Case" type="i" access="read"/>
    <property name="LeftCharging" type="b" access="read"/>
    <property name="RightCharging" type="b" access="read"/>
    <property name="CaseCharging" type="b" access="read"/>
    <property name="LeftInEar" type="b" access="read"/>
    <property name="RightInEar" type="b" access="read"/>
    <property name="BothPodsInCase" type="b" access="read"/>
    <property name="CaseLidOpened" type="b" access="read"/>
    <!-- Single combined level from BlueZ Battery1, or -1. Show it labelled as such
         when HasAdvertisement is false. -->
    <property name="FallbackBattery" type="i" access="read"/>
    <!-- Pause/play the active MPRIS player when the buds leave/enter the ears. -->
    <property name="EarDetection" type="b" access="readwrite"/>
    <!-- Show the popup when the case lid opens or the AirPods connect. -->
    <property name="LidPopup" type="b" access="readwrite"/>
    <!-- Notify when a bud, the case or the headphones fall to 20, 10 or 0-5 percent. -->
    <property name="LowBatteryAlerts" type="b" access="readwrite"/>
    <!-- Every paired AirPods as (address, name, connected), sorted by name. Valid even while
         Connected is false: this is what the quick-connect list shows. -->
    <property name="PairedDevices" type="a(ssb)" access="read"/>
    <!-- Keep the panel icon visible, as a connect menu, while a paired AirPods is idle. -->
    <property name="ShowWhenDisconnected" type="b" access="readwrite"/>
    <!-- Connect / disconnect a paired AirPods through BlueZ. Returns when BlueZ answers; fails with
         org.pulsaros.AirPods.Error.Failed and the BlueZ reason (can take up to 30 s). -->
    <method name="Connect">
      <arg type="s" name="address" direction="in"/>
    </method>
    <method name="Disconnect">
      <arg type="s" name="address" direction="in"/>
    </method>
    <!-- Weakest signal (dBm, -100..-40) at which advertisements are accepted. The panel offers
         Near (-60), Normal (-80) and Far (-90). Writes outside the range fail. -->
    <property name="RssiMin" type="i" access="readwrite"/>
    <!-- What the panel icon shows next to it: off, lowest (lowest bud) or both. -->
    <property name="PanelBattery" type="s" access="readwrite"/>
    <!-- Stop showing the current AirPods until they disconnect and connect again, and clear
         the saved binding. Harmless when nothing is connected. -->
    <method name="Forget"/>
    <!-- Emitted when the case lid goes from closed to open while connected. -->
    <signal name="LidOpened"/>
    <!-- Emitted once per threshold crossing (20 / 10 / 5 percent). which is one of
         left, right, case, headphones; level is the current percentage. Never emitted
         while charging. -->
    <signal name="LowBattery">
      <arg type="s" name="which"/>
      <arg type="i" name="level"/>
    </signal>
  </interface>
</node>
