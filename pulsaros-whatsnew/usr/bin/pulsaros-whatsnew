#!/bin/bash
# Pulsar OS - What's New viewer launcher
# Suppress autostart in live ISO / live installer environments or before initial OOTB setup is complete
is_live() {
    [ -f /etc/pulsar-need-setup ] || [ -d /run/archiso ] || mountpoint -q /run/live 2>/dev/null || mountpoint -q /live 2>/dev/null || grep -qE 'archiso|pulsar-live|boot=live' /proc/cmdline 2>/dev/null || [ "$USER" = "live" ]
}

if [[ "$*" == *"--autostart"* ]] && [[ "$*" != *"--force"* ]] && is_live; then
    exit 0
fi

exec /usr/bin/python3 /usr/lib/pulsaros-whatsnew/viewer.py "$@"
