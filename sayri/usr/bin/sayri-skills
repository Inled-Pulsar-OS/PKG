#!/usr/bin/env python3
import os
import sys

# Add package lib to python path if not installed
lib = os.path.normpath(os.path.join(os.path.dirname(__file__), "..", "share", "sayri", "lib"))
if os.path.isdir(lib) and lib not in sys.path:
    sys.path.insert(0, lib)

from sayri.skills import main

if __name__ == "__main__":
    sys.exit(main())
