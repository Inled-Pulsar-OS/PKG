#!/bin/bash
set -e

echo "🎨 Configurando Tema GRUB de Pulsar OS..."

# ── Instalación del tema SIN regenerar grub.cfg ───────────────────────────────
# IMPORTANTE: core.sh (el instalador del tema) ejecuta 'update-grub' al final.
# En un chroot (build de la ISO o instalación) grub-probe no puede resolver el
# dispositivo real y ese update-grub dejaba un grub.cfg corrupto con
# "root=/dev/sda" e "insmod /dev/sda", que impedía arrancar el sistema recién
# instalado. Neutralizamos SOLO update-grub/grub-mkconfig durante el tema: el
# grub.cfg real lo regenera recovery.py (con verificación) al instalar.
PULSAR_THEME_SHIM_DIR="$(mktemp -d)"
printf '#!/bin/sh\nexit 0\n' > "$PULSAR_THEME_SHIM_DIR/update-grub"
printf '#!/bin/sh\nexit 0\n' > "$PULSAR_THEME_SHIM_DIR/grub-mkconfig"
chmod +x "$PULSAR_THEME_SHIM_DIR/update-grub" "$PULSAR_THEME_SHIM_DIR/grub-mkconfig"

# Si una versión anterior dejó el grub-probe real en .bak, restaurarlo
if [ ! -f /usr/sbin/grub-probe ] && [ -f /usr/sbin/grub-probe.bak ]; then
    mv /usr/sbin/grub-probe.bak /usr/sbin/grub-probe
fi

# Ejecutar el script instalador del tema de grub si está presente en el tema
PULSAR_GRUB_THEME_SRC="/boot/grub/themes/grub-theme"
PULSAR_GRUB_THEME_DIR="/boot/grub/themes/Particle-circle-window"
if [ -f "$PULSAR_GRUB_THEME_SRC/install.sh" ]; then
    cd "$PULSAR_GRUB_THEME_SRC"
    PATH="$PULSAR_THEME_SHIM_DIR:$PATH" ./install.sh -b -t window -s 1080p || echo "Aviso: El instalador de GRUB reportó errores, pero continuamos..."
fi
rm -rf "$PULSAR_THEME_SHIM_DIR"

# Ensure GRUB uses a robust set of fallback resolutions to prevent black screens on virtual machines
# Asegurar que GRUB use una lista de resoluciones de respaldo robusta para evitar pantallas negras en VMs
if [ -f "/etc/default/grub" ]; then
    sed -i 's/^GRUB_GFXMODE=.*/GRUB_GFXMODE="1920x1080,1280x720,1024x768,auto"/' /etc/default/grub || true
fi

# Crear script de GRUB para cargar las fuentes del tema en el arranque
# Create GRUB custom script to load theme fonts during boot
mkdir -p /etc/grub.d
cat > /etc/grub.d/01_pulsar_theme << 'GRUBSCRIPT'
#!/bin/sh
set -e

# Load Pulsar OS GRUB theme fonts automatically
# If the theme directory exists, load all .pf2 fonts
PULSAR_THEME_DIR="/boot/grub/themes/Particle-circle-window"
if [ -d "$PULSAR_THEME_DIR" ]; then
    for font_file in "$PULSAR_THEME_DIR"/*.pf2; do
        if [ -f "$font_file" ]; then
            echo "loadfont \"$font_file\""
        fi
    done
fi
GRUBSCRIPT
chmod 755 /etc/grub.d/01_pulsar_theme

# Regenerar grub.cfg SOLO en un sistema real (no en chroots de build/instalación).
# En un chroot grub-probe puede resolver el dispositivo equivocado y dejar un
# grub.cfg que no arranca; recovery.py lo regenera y valida al final del install.
if [ -d /run/systemd/system ] && command -v update-grub >/dev/null 2>&1; then
    update-grub || true
fi

exit 0
