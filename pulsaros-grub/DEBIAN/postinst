#!/bin/bash
set -e

echo "🎨 Configurando Tema GRUB de Pulsar OS..."

# Mock de grub-probe temporal en ruta absoluta para evitar fallos si no hay dispositivo de disco real (ej. chroots)
if [ -f "/usr/sbin/grub-probe" ]; then
    mv /usr/sbin/grub-probe /usr/sbin/grub-probe.bak
fi
echo '#!/bin/sh' > /usr/sbin/grub-probe
echo 'echo "/dev/sda"' >> /usr/sbin/grub-probe
echo 'exit 0' >> /usr/sbin/grub-probe
chmod +x /usr/sbin/grub-probe

# Ejecutar el script instalador del tema de grub si está presente en el tema
if [ -f "/boot/grub/themes/grub-theme/install.sh" ]; then
    cd /boot/grub/themes/grub-theme
    ./install.sh -t window -s 1080p || echo "Aviso: El instalador de GRUB reportó errores, pero continuamos..."
fi

# Ensure GRUB uses a robust set of fallback resolutions to prevent black screens on virtual machines
# Asegurar que GRUB use una lista de resoluciones de respaldo robusta para evitar pantallas negras en VMs
if [ -f "/etc/default/grub" ]; then
    sed -i 's/^GRUB_GFXMODE=.*/GRUB_GFXMODE="1920x1080,1280x720,1024x768,auto"/' /etc/default/grub || true
fi

# Eliminar el mock temporal y restaurar el original
rm -f /usr/sbin/grub-probe
if [ -f "/usr/sbin/grub-probe.bak" ]; then
    mv /usr/sbin/grub-probe.bak /usr/sbin/grub-probe
fi

# Actualizar el gestor de arranque
if command -v update-grub >/dev/null; then
    update-grub || true
fi

exit 0
