#!/bin/sh
# Pulsar OS - Spotlight launcher (distro-agnostic)
# Debian ships spotlight-python; Arch ships spotlight-gtk.
# This wrapper resolves whichever binary is installed so GNOME shortcuts,
# extensions and autostart entries work identically on both distros.
if command -v spotlight-python >/dev/null 2>&1; then
    exec spotlight-python "$@"
fi
if command -v spotlight-gtk >/dev/null 2>&1; then
    exec spotlight-gtk "$@"
fi
echo "pulsaros-spotlight: no spotlight binary found (spotlight-python / spotlight-gtk)" >&2
exit 1
