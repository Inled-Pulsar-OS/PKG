#!/bin/bash
# Pulsar OS - diagnostic wrapper for the Spotlight shortcut.
# Logs everything when the keybinding fires, then runs the real launcher.
# Temporary: delete once the shortcut issue is diagnosed.
LOG=/tmp/pulsaros-spotlight-debug.log
log() { echo "[$(date '+%F %T')] $*" >> "$LOG"; }

log "=== pulsaros-spotlight-debug invoked: $0 $* ==="
log "UID=$(id -u) USER=$(id -un)"
log "XDG_SESSION_TYPE=${XDG_SESSION_TYPE:-unset}"
log "WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-unset} DISPLAY=${DISPLAY:-unset}"
log "DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS:-unset}"
log "GIO_LAUNCHED_DESKTOP_FILE=${GIO_LAUNCHED_DESKTOP_FILE:-unset}"
log "PATH=$PATH"

for c in pulsaros-spotlight spotlight-python spotlight-gtk; do
    if command -v "$c" >/dev/null 2>&1; then
        log "FOUND: $c -> $(command -v "$c")"
    else
        log "MISSING: $c"
    fi
done

log "--- processes before ---"
pgrep -af 'spotlight|main.py' >>"$LOG" 2>&1 || log "(none)"

log "--- launching real command ---"
/usr/bin/pulsaros-spotlight "$@" >>"$LOG" 2>&1 &
CHILD=$!
log "real launcher pid=$CHILD"

sleep 3
if kill -0 "$CHILD" 2>/dev/null; then
    log "still running after 3s (pid $CHILD) -> fresh instance kept alive"
else
    wait "$CHILD"
    log "EXITED rc=$? within 3s -> likely single-instance forwarded to existing process"
fi

log "--- processes after ---"
pgrep -af 'spotlight|main.py' >>"$LOG" 2>&1 || log "(none)"
log "=== end ==="
