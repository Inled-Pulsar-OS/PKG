#!/bin/bash
# ==============================================================================
# Pulsar OS - Post-Hibernate Display Restoration
#
# ROOT CAUSE of the "Booting OS..." freeze:
# - Plymouth runs on VT1. On hibernate resume (HibernateMode=shutdown),
#   the restored GNOME session is still on VT2 (where it was before hibernate).
# - When Plymouth quits, the display stays on VT1 (which shows the EFI/rEFInd
#   framebuffer = "Booting OS..."). Nobody switches to VT2.
# - On normal boot this doesn't happen because SDDM starts on VT1 directly.
#
# FIX: After the display manager is up, if a Wayland/X11 session exists on a
# VT that is NOT the currently active VT, switch to it.
# On a normal boot there are no pre-existing sessions → this script does nothing.
# On hibernate resume the restored session is on a different VT → we switch to it.
# ==============================================================================
set -u

log() { echo "[pulsaros-resume] $*" | tee /dev/kmsg 2>/dev/null || echo "[pulsaros-resume] $*" >&2; }

log "=== Checking for off-screen graphical sessions ==="

# Current active VT
ACTIVE_VT=$(cat /sys/class/tty/tty0/active 2>/dev/null | tr -d 'tty' || echo "1")
log "Active VT: $ACTIVE_VT"

FOUND_SESSION=""
SESSION_VT=""

for s in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}'); do
    STYPE=$(loginctl show-session "$s" -p Type --value 2>/dev/null || true)
    if [ "$STYPE" = "wayland" ] || [ "$STYPE" = "x11" ]; then
        S_VT=$(loginctl show-session "$s" -p VTNr --value 2>/dev/null || true)
        log "Found graphical session $s type=$STYPE VT=$S_VT"
        if [ -n "$S_VT" ] && [ "$S_VT" != "0" ] && [ "$S_VT" != "$ACTIVE_VT" ]; then
            FOUND_SESSION="$s"
            SESSION_VT="$S_VT"
            break
        fi
    fi
done

if [ -z "$FOUND_SESSION" ]; then
    log "No off-screen graphical session found — nothing to do (normal boot or already on correct VT)."
    exit 0
fi

log "Session $FOUND_SESSION is on VT$SESSION_VT but display is on VT$ACTIVE_VT — switching..."

# 1. Force Plymouth to quit and release DRM master
if pgrep -x plymouthd >/dev/null 2>&1; then
    log "Restarting plymouth-quit.service to release DRM master..."
    systemctl restart plymouth-quit.service 2>/dev/null || {
        plymouth --quit 2>/dev/null || true
        pkill -TERM plymouthd 2>/dev/null || true
        sleep 0.3
        pkill -KILL plymouthd 2>/dev/null || true
    }
    sleep 0.3
fi

# 2. Switch to the VT of the restored GNOME session
log "chvt $SESSION_VT"
chvt "$SESSION_VT" 2>/dev/null || true

# 3. Reactivate the logind session
log "loginctl activate-session $FOUND_SESSION"
loginctl activate-session "$FOUND_SESSION" 2>/dev/null || true

# 4. Trigger DRM udev event to help Mutter repaint
log "udevadm trigger drm"
udevadm trigger --subsystem-match=drm --action=change 2>/dev/null || true

log "=== Done ==="
exit 0
