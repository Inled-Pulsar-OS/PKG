#!/bin/bash
# ==============================================================================
# Pulsar OS - Hibernate Pre-Sleep Cleanup & Post-Resume Session Restoration
# ==============================================================================
set -u

ACTION="${1:-}"

# Map system-sleep verbs (pre/post) to internal verbs (start/end)
case "$ACTION" in
    pre)  ACTION="start" ;;
    post) ACTION="end"   ;;
esac

case "$ACTION" in
    start)
        # 1. Identify and record active graphical session and VT before dumping RAM
        ACTIVE_TTY=$(cat /sys/class/tty/tty0/active 2>/dev/null || echo "tty1")
        ACTIVE_VT="${ACTIVE_TTY#tty}"
        GRAPHICAL_SESS=""
        
        for s in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}'); do
            STYPE=$(loginctl show-session "$s" -p Type --value 2>/dev/null || true)
            SSTATE=$(loginctl show-session "$s" -p State --value 2>/dev/null || true)
            if [ "$STYPE" = "wayland" ] || [ "$STYPE" = "x11" ]; then
                GRAPHICAL_SESS="$s"
                S_VT=$(loginctl show-session "$s" -p VTNr --value 2>/dev/null || true)
                if [ -n "$S_VT" ] && [ "$S_VT" != "0" ]; then
                    ACTIVE_VT="$S_VT"
                fi
                [ "$SSTATE" = "active" ] && break
            fi
        done

        mkdir -p /run/pulsaros-hibernate
        cat << EOF > /run/pulsaros-hibernate/session.env
SAVED_VT="${ACTIVE_VT}"
SAVED_SESSION="${GRAPHICAL_SESS}"
EOF

        # 2. Blank / clear console VT1 to completely wipe any stale UEFI/rEFInd "Booting OS..." screen
        for tty_dev in /dev/tty1 /dev/tty0; do
            if [ -c "$tty_dev" ]; then
                setterm --clear all --cursor off > "$tty_dev" 2>/dev/null || true
                printf '\033[2J\033[H\033[?25l' > "$tty_dev" 2>/dev/null || true
            fi
        done
        # Zero out EFI framebuffer device if present to purge any cached UEFI pixels
        if [ -e /dev/fb0 ] && [ -w /dev/fb0 ]; then
            dd if=/dev/zero of=/dev/fb0 bs=1M count=16 status=none 2>/dev/null || true
        fi

        # 3. If plymouth is available and running, show graceful message
        if command -v plymouth >/dev/null 2>&1 && plymouth --ping 2>/dev/null; then
            plymouth message --text="Guardando la sesión en disco…" 2>/dev/null || true
        fi
        ;;

    end)
        # 1. Restore default quiet kernel printk loglevel
        echo "4 4 1 7" > /proc/sys/kernel/printk 2>/dev/null || true

        # 2. Terminate any lingering Plymouth from early-boot initramfs holding DRM master
        if command -v plymouth >/dev/null 2>&1; then
            plymouth --quit 2>/dev/null || true
        fi
        killall -9 plymouthd 2>/dev/null || true

        # 3. Read saved session parameters
        SAVED_VT="1"
        SAVED_SESSION=""
        if [ -f /run/pulsaros-hibernate/session.env ]; then
            . /run/pulsaros-hibernate/session.env
        fi

        # Fallback detection if session.env is missing
        if [ -z "$SAVED_SESSION" ]; then
            for s in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}'); do
                STYPE=$(loginctl show-session "$s" -p Type --value 2>/dev/null || true)
                if [ "$STYPE" = "wayland" ] || [ "$STYPE" = "x11" ]; then
                    SAVED_SESSION="$s"
                    S_VT=$(loginctl show-session "$s" -p VTNr --value 2>/dev/null || true)
                    [ -n "$S_VT" ] && [ "$S_VT" != "0" ] && SAVED_VT="$S_VT"
                    break
                fi
            done
        fi

        # 4. Re-activate graphical VT and logind session
        if [ -n "$SAVED_VT" ] && command -v chvt >/dev/null 2>&1; then
            chvt "$SAVED_VT" 2>/dev/null || true
        fi
        if [ -n "$SAVED_SESSION" ] && command -v loginctl >/dev/null 2>&1; then
            loginctl activate-session "$SAVED_SESSION" 2>/dev/null || true
        fi

        # 5. Trigger DRM subsystem event so Mutter/GNOME Shell repaints desktop immediately
        if command -v udevadm >/dev/null 2>&1; then
            udevadm trigger --subsystem-match=drm --action=change 2>/dev/null || true
        fi

        # 6. Clean up temporary sleep drop-ins and state files
        rm -f /run/systemd/sleep.conf.d/*pulsar*.conf 2>/dev/null || true
        rm -rf /run/pulsaros-hibernate 2>/dev/null || true
        ;;

    *)
        echo "Usage: $0 {start|end|pre|post}" >&2
        exit 1
        ;;
esac

exit 0
