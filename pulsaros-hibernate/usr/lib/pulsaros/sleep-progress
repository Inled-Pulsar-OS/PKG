#!/bin/bash
# ==============================================================================
# Pulsar OS - Hibernate Pre-Sleep Cleanup
# Simple handler: sync, drop caches, show Plymouth message.
# Post-resume session restoration is done by pulsaros-resume-session.service.
# ==============================================================================
set -u

ACTION="${1:-}"

# Map system-sleep verbs to internal verbs
case "$ACTION" in
    pre)  ACTION="start" ;;
    post) ACTION="end"   ;;
esac

case "$ACTION" in
    start)
        sync
        echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || true
        if command -v plymouth >/dev/null 2>&1 && plymouth --ping 2>/dev/null; then
            plymouth message --text="Guardando sesión en disco…" 2>/dev/null || true
        fi
        ;;
    end)
        echo "4 4 1 7" > /proc/sys/kernel/printk 2>/dev/null || true
        rm -f /run/systemd/sleep.conf.d/*pulsar*.conf 2>/dev/null || true
        ;;
    *)
        echo "Usage: $0 {start|end|pre|post}" >&2
        exit 1
        ;;
esac

exit 0
