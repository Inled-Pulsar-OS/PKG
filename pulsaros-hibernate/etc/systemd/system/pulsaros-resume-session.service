[Unit]
Description=Pulsar OS - Restore graphical session after hibernate resume
# Triggered by systemd-hibernate-clear.service.d/pulsaros-resume-session.conf
# ONLY runs when the EFI HibernateLocation variable is present = genuine hibernate resume.
# On normal boots this service never starts.
#
# ROOT CAUSE fixed: plymouth-quit.service has RemainAfterExit=yes so it never
# re-runs after resume. This service restarts plymouth-quit.service to force
# plymouthd to release DRM master, then reactivates the GNOME session.
After=systemd-hibernate-clear.service display-manager.service multi-user.target
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=no
# Wait 2s for display manager and SDDM to finish starting the restored session
ExecStartPre=/bin/sleep 2
ExecStart=/usr/lib/pulsaros/resume-session
StandardOutput=journal
StandardError=journal
User=root
