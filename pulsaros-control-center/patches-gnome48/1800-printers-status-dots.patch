+
+/* macOS look: default-printer card and status dot (overlay/css/printers.css). */
+static void
+update_pulsar_style (PpPrinterEntry *self)
+{
+  const gchar *dot = self->printer_state == PRINTER_STOPPED ? "pulsar-status-off"
+                   : self->printer_state == PRINTER_PROCESSING ? "pulsar-status-idle" : "pulsar-status-on";
+
+  gtk_widget_set_css_classes (GTK_WIDGET (self->printer_status), (const gchar *[]) { "pulsar-printer-status", dot, NULL });
+  if (self->is_default)
+    gtk_widget_add_css_class (GTK_WIDGET (self), "pulsar-default-printer");
+  else
+    gtk_widget_remove_css_class (GTK_WIDGET (self), "pulsar-default-printer");
+}
 
