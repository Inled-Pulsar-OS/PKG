+/* Colored status dot (CSS) on a row: state is "on", "off" or "idle". */
+void
+panel_set_status_dot (GtkWidget *widget, const gchar *state)
+{
+  gtk_widget_add_css_class (widget, "pulsar-status-dot");
+  gtk_widget_remove_css_class (widget, "pulsar-status-on");
+  gtk_widget_remove_css_class (widget, "pulsar-status-off");
+  gtk_widget_remove_css_class (widget, "pulsar-status-idle");
+  if (state)
+    {
+      g_autofree gchar *cls = g_strconcat ("pulsar-status-", state, NULL);
+      gtk_widget_add_css_class (widget, cls);
+    }
+}
