<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="CcBackgroundPanel" parent="CcPanel">
    <property name="child">
      <object class="AdwToastOverlay" id="toast_overlay">
        <property name="child">
          <object class="AdwPreferencesPage">
            <child>
              <object class="AdwPreferencesGroup">
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">24</property>
                    <property name="margin-top">12</property>
                    <property name="margin-bottom">24</property>
                    <property name="margin-start">12</property>
                    <property name="margin-end">12</property>

                    <!-- Style Toggle (Light / Dark) -->
                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title" translatable="yes">Style</property>
                        <child>
                          <object class="GtkBox">
                            <property name="halign">center</property>
                            <property name="homogeneous">True</property>
                            <property name="spacing">24</property>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="spacing">12</property>
                                <child>
                                  <object class="GtkGrid">
                                    <property name="column-spacing">12</property>
                                    <property name="row-spacing">12</property>
                                    <child>
                                      <object class="CcBackgroundPreview" id="default_preview">
                                        <layout>
                                          <property name="column">0</property>
                                          <property name="row">0</property>
                                        </layout>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkCheckButton" id="default_toggle">
                                        <property name="label" translatable="yes">Default</property>
                                        <property name="active">True</property>
                                        <signal name="toggled" handler="on_color_scheme_toggle_active_cb" object="CcBackgroundPanel" swapped="yes" />
                                        <layout>
                                          <property name="column">0</property>
                                          <property name="row">1</property>
                                        </layout>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="CcBackgroundPreview" id="dark_preview">
                                        <property name="is-dark">True</property>
                                        <layout>
                                          <property name="column">1</property>
                                          <property name="row">0</property>
                                        </layout>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkCheckButton" id="dark_toggle">
                                        <property name="group">default_toggle</property>
                                        <property name="label" translatable="yes">Dark</property>
                                        <layout>
                                          <property name="column">1</property>
                                          <property name="row">1</property>
                                        </layout>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>

                    <!-- macOS Layout and Keyboard Remap -->
                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title" translatable="yes">Keyboard and macOS Remap</property>
                        <property name="description" translatable="yes">Configure macOS style modifier keys (Cmd/Ctrl swap) and fullscreen spaces workflow</property>
                        <child>
                          <object class="AdwSwitchRow" id="macos_remap_switch_row">
                            <property name="title" translatable="yes">macOS Keyboard Shortcuts and Cmd Swap</property>
                            <property name="subtitle" translatable="yes">Swap Command (Super) and Control keys for native Cmd+C, Cmd+V, Cmd+W, Cmd+Space shortcuts</property>
                            <property name="active">True</property>
                            <signal name="notify::active" handler="on_macos_remap_active_changed_cb" object="CcBackgroundPanel" swapped="yes" />
                          </object>
                        </child>
                        <child>
                          <object class="AdwSwitchRow" id="macos_fullscreen_switch_row">
                            <property name="title" translatable="yes">macOS Fullscreen Spaces</property>
                            <property name="subtitle" translatable="yes">Move maximized or fullscreen applications to dedicated adjacent workspaces</property>
                            <property name="active">True</property>
                            <signal name="notify::active" handler="on_macos_fullscreen_active_changed_cb" object="CcBackgroundPanel" swapped="yes" />
                          </object>
                        </child>
                      </object>
                    </child>

                    <!-- Liquid Glass Effects -->
                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title" translatable="yes">Liquid Glass and Visual Effects</property>
                        <property name="description" translatable="yes">Translucent glass shaders and dynamic blur reflections</property>
                        <child>
                          <object class="AdwSwitchRow" id="liquid_glass_switch_row">
                            <property name="title" translatable="yes">Liquid Glass Effect</property>
                            <property name="subtitle" translatable="yes">Apply translucent blurs and reflective borders to active windows in macOS style</property>
                            <property name="active">True</property>
                            <signal name="notify::active" handler="on_liquid_glass_active_changed_cb" object="CcBackgroundPanel" swapped="yes" />
                          </object>
                        </child>
                      </object>
                    </child>

                    <!-- Accent Color Theme -->
                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title" translatable="yes">Accent Color</property>
                        <child>
                          <object class="AdwActionRow">
                            <property name="title" translatable="yes">System Accent Color</property>
                            <property name="subtitle" translatable="yes">Highlight color for buttons, toggles and selections</property>
                            <child type="suffix">
                              <object class="GtkBox" id="accent_box">
                                <property name="spacing">8</property>
                                <property name="margin-top">8</property>
                                <property name="margin-bottom">8</property>
                                <property name="halign">end</property>
                                <property name="valign">center</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>

                    <!-- Wallpaper and Live Wallpaper -->
                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title" translatable="yes">Wallpaper and Live Wallpaper</property>
                        <property name="description" translatable="yes">Static wallpapers or animated videos (.mp4, .webm, .gif, .webp) synchronized across Desktop, SDDM, and Lockscreen</property>
                        <property name="header-suffix">
                          <object class="GtkButton">
                            <child>
                              <object class="AdwButtonContent">
                                <property name="icon-name">list-add-symbolic</property>
                                <property name="label" translatable="yes">_Add Picture…</property>
                                <property name="use-underline">True</property>
                              </object>
                            </child>
                            <signal name="clicked" handler="on_add_picture_button_clicked_cb" object="CcBackgroundPanel" swapped="yes" />
                            <style>
                              <class name="flat"/>
                            </style>
                          </object>
                        </property>

                        <child>
                          <object class="AdwActionRow">
                            <property name="title" translatable="yes">Select Animated Wallpaper or Video</property>
                            <property name="subtitle" translatable="yes">Managed with native Pulsar OS Live Wallpaper engine</property>
                            <child type="suffix">
                              <object class="GtkButton">
                                <property name="valign">center</property>
                                <property name="label" translatable="yes">Choose Video…</property>
                                <signal name="clicked" handler="on_pick_live_wallpaper_clicked_cb" object="CcBackgroundPanel" swapped="yes" />
                                <style>
                                  <class name="suggested-action"/>
                                </style>
                              </object>
                            </child>
                            <child type="suffix">
                              <object class="GtkButton">
                                <property name="valign">center</property>
                                <property name="label" translatable="yes">Stop</property>
                                <signal name="clicked" handler="on_stop_live_wallpaper_clicked_cb" object="CcBackgroundPanel" swapped="yes" />
                                <style>
                                  <class name="destructive-action"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>

                        <child>
                          <object class="AdwBin">
                            <style>
                              <class name="card"/>
                            </style>
                            <child>
                              <object class="CcBackgroundChooser" id="background_chooser">
                                <property name="hexpand">True</property>
                                <property name="toast-overlay">toast_overlay</property>
                                <signal name="background-chosen" handler="on_chooser_background_chosen_cb" object="CcBackgroundPanel" swapped="yes" />
                              </object>
                            </child>
                          </object>
                        </child>

                      </object>
                    </child>

                    <!-- Spotlight and App Launcher -->
                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title" translatable="yes">Spotlight and App Launcher</property>
                        <property name="description" translatable="yes">Search and launcher experience when pressing Cmd+Space</property>
                        <child>
                          <object class="AdwActionRow">
                            <property name="title" translatable="yes">macOS Spotlight (Tahoe Search)</property>
                            <property name="subtitle" translatable="yes">Floating search bar with instant app launcher, math calc, and web shortcuts</property>
                            <child type="suffix">
                              <object class="GtkButton">
                                <property name="valign">center</property>
                                <property name="label" translatable="yes">Enable</property>
                                <signal name="clicked" handler="on_activate_spotlight_python_clicked_cb" object="CcBackgroundPanel" swapped="yes" />
                                <style>
                                  <class name="suggested-action"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow">
                            <property name="title" translatable="yes">GNOME Overview and Apps Grid</property>
                            <property name="subtitle" translatable="yes">Native GNOME activities overview and application grid</property>
                            <child type="suffix">
                              <object class="GtkButton">
                                <property name="valign">center</property>
                                <property name="label" translatable="yes">Enable</property>
                                <signal name="clicked" handler="on_activate_gnome_overview_clicked_cb" object="CcBackgroundPanel" swapped="yes" />
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>

                    <!-- Mouse and Trackpad Cursors -->
                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title" translatable="yes">Mouse and Trackpad Cursors</property>
                        <property name="description" translatable="yes">Cursor themes and visual styles</property>
                        <child>
                          <object class="AdwActionRow">
                            <property name="title" translatable="yes">macOS Tahoe / Cupertino Cursors</property>
                            <property name="subtitle" translatable="yes">Official Pulsar OS style with dynamic drop shadows</property>
                            <child type="suffix">
                              <object class="GtkButton">
                                <property name="valign">center</property>
                                <property name="label" translatable="yes">Apply Tahoe</property>
                                <signal name="clicked" handler="on_apply_cursor_tahoe_clicked_cb" object="CcBackgroundPanel" swapped="yes" />
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow">
                            <property name="title" translatable="yes">Standard Adwaita Cursors</property>
                            <property name="subtitle" translatable="yes">Classic GNOME cursor theme</property>
                            <child type="suffix">
                              <object class="GtkButton">
                                <property name="valign">center</property>
                                <property name="label" translatable="yes">Apply Adwaita</property>
                                <signal name="clicked" handler="on_apply_cursor_adwaita_clicked_cb" object="CcBackgroundPanel" swapped="yes" />
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>

                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
