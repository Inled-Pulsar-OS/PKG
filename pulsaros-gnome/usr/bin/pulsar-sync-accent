#!/bin/bash
# ==============================================================================
# Pulsar OS - GTK & Application Accent Color Synchronizer Daemon
# ==============================================================================
# English: Synchronizes GNOME Desktop Accent Color with GTK 3, GTK 4 and Browsers.
# Español: Sincroniza el color de acento de GNOME con GTK 3, GTK 4 y navegadores.
# ==============================================================================

get_accent_hex() {
    local color_name="$1"
    case "$color_name" in
        blue)   echo "#3584e4" ;;
        teal)   echo "#2190a4" ;;
        green)  echo "#3a944a" ;;
        yellow) echo "#e5a50a" ;;
        orange) echo "#e66100" ;;
        red)    echo "#e01b24" ;;
        pink)   echo "#d56199" ;;
        purple) echo "#9141ac" ;;
        slate)  echo "#6f8396" ;;
        *)      echo "#3584e4" ;;
    esac
}

sync_accent() {
    local raw_accent=$(gsettings get org.gnome.desktop.interface accent-color 2>/dev/null | tr -d "'\"")
    [ -z "$raw_accent" ] && raw_accent="blue"
    local hex=$(get_accent_hex "$raw_accent")

    local raw_scheme=$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null | tr -d "'\"")
    local raw_gtk=$(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null | tr -d "'\"")
    local is_dark=1
    local theme_name="MacTahoe-Dark"
    local icon_name="MacTahoe-blue-dark"

    if [ "$raw_scheme" = "prefer-light" ] || [ "$raw_scheme" = "default" ] || [ "$raw_gtk" = "MacTahoe-Light" ]; then
        if [ "$raw_scheme" != "prefer-dark" ]; then
            is_dark=0
            theme_name="MacTahoe-Light"
            icon_name="MacTahoe-blue-light"
        fi
    fi

    local gtk3_dir="$HOME/.config/gtk-3.0"
    local gtk4_dir="$HOME/.config/gtk-4.0"
    mkdir -p "$gtk3_dir" "$gtk4_dir"

    # 1. Sync Libadwaita / GTK4 full stylesheets
    if [ -d "/usr/share/themes/$theme_name/gtk-4.0" ]; then
        cp -rf "/usr/share/themes/$theme_name/gtk-4.0/"* "$gtk4_dir/" 2>/dev/null || true
        # If light mode, ensure gtk-dark.css reflects light styles so apps requesting dark variant don't stay black
        if [ "$is_dark" -eq 0 ] && [ -f "$gtk4_dir/gtk.css" ]; then
            cp -f "$gtk4_dir/gtk.css" "$gtk4_dir/gtk-dark.css" 2>/dev/null || true
        fi
    fi

    # 2. Sync GTK3 full stylesheets
    if [ -d "/usr/share/themes/$theme_name/gtk-3.0" ]; then
        if [ "$is_dark" -eq 1 ] && [ -f "/usr/share/themes/$theme_name/gtk-3.0/gtk-dark.css" ]; then
            cp -rf "/usr/share/themes/$theme_name/gtk-3.0/gtk-dark.css" "$gtk3_dir/gtk.css" 2>/dev/null || true
        else
            cp -rf "/usr/share/themes/$theme_name/gtk-3.0/gtk.css" "$gtk3_dir/gtk.css" 2>/dev/null || true
        fi
    fi

    # 3. Ensure windows-assets symlink exists for GTK3 and GTK4
    if [ -d "/usr/share/themes/$theme_name/gtk-3.0/windows-assets" ]; then
        ln -sfn "/usr/share/themes/$theme_name/gtk-3.0/windows-assets" "$gtk3_dir/windows-assets"
    fi
    if [ -d "/usr/share/themes/$theme_name/gtk-4.0/windows-assets" ]; then
        ln -sfn "/usr/share/themes/$theme_name/gtk-4.0/windows-assets" "$gtk4_dir/windows-assets"
    fi

    # 4. Ensure settings.ini matches current light/dark theme in both GTK 3 and GTK 4
    for ini in "$gtk3_dir/settings.ini" "$gtk4_dir/settings.ini"; do
        cat <<INI_EOF > "$ini"
[Settings]
gtk-theme-name=${theme_name}
gtk-icon-theme-name=${icon_name}
gtk-application-prefer-dark-theme=${is_dark}
gtk-decoration-layout=close,minimize,maximize:
INI_EOF
    done

    # 5. Inject dynamic accent color variables into all user stylesheets
    for css_f in "$gtk3_dir/gtk.css" "$gtk4_dir/gtk.css" "$gtk4_dir/gtk-dark.css"; do
        if [ -f "$css_f" ]; then
            sed -i '/@define-color accent_/d' "$css_f" 2>/dev/null || true
            sed -i '/@define-color theme_selected_/d' "$css_f" 2>/dev/null || true
            sed -i '/@define-color selected_/d' "$css_f" 2>/dev/null || true
            sed -i "1s|^|@define-color accent_color ${hex};\n@define-color accent_bg_color ${hex};\n@define-color accent_fg_color #ffffff;\n@define-color theme_selected_bg_color ${hex};\n@define-color theme_selected_fg_color #ffffff;\n@define-color selected_bg_color ${hex};\n@define-color selected_fg_color #ffffff;\n|" "$css_f"
        fi
    done

    # Sync Seafari profile if exists
    local seafari_profile="${SEAFARI_PROFILE:-$HOME/.mozilla/seafari-profile}"
    if [ -d "$seafari_profile/chrome" ]; then
        local user_content="$seafari_profile/chrome/userContent.css"
        if [ -f "$user_content" ]; then
            if ! grep -q "Pulsar OS Dynamic Selection Highlight" "$user_content" 2>/dev/null; then
                cat <<'SEAFARI_FIX' >> "$user_content"

/* Pulsar OS Dynamic Selection Highlight */
::selection {
    background-color: Highlight !important;
    color: HighlightText !important;
}
SEAFARI_FIX
            fi
        fi
        local custom_chrome="$seafari_profile/chrome/customChrome.css"
        if [ -f "$custom_chrome" ]; then
            if ! grep -q "Pulsar OS Context Menu Accent Highlight" "$custom_chrome" 2>/dev/null; then
                cat <<'SEAFARI_CHROME_FIX' >> "$custom_chrome"

/* Pulsar OS Context Menu Accent Highlight */
menupopup menuitem:not([disabled="true"]):is(:hover, [_moz-menuactive]),
menupopup menu:not([disabled="true"]):is(:hover, [_moz-menuactive]) {
    background-color: Highlight !important;
    color: HighlightText !important;
}
menupopup menuitem:not([disabled="true"]):is(:hover, [_moz-menuactive]) label,
menupopup menu:not([disabled="true"]):is(:hover, [_moz-menuactive]) label {
    color: HighlightText !important;
}
SEAFARI_CHROME_FIX
            fi
        fi
    fi
}

# Initial synchronization
sync_accent

if [ "$1" = "--once" ]; then
    exit 0
fi

# Lock file for daemon mode
LOCK_FILE="/tmp/pulsar-sync-accent-$UID.lock"
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    echo "Accent sync daemon already running for UID $UID. Exiting."
    exit 0
fi

# Monitor for live accent color, color-scheme, and theme changes in GNOME settings
gsettings monitor org.gnome.desktop.interface 2>/dev/null | while read -r line; do
    if echo "$line" | grep -q -E "accent-color|color-scheme|gtk-theme"; then
        sync_accent
    fi
done
