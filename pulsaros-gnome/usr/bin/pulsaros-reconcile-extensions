#!/bin/bash
# ==============================================================================
# Pulsar OS - GNOME Shell extensions reconciler
# ==============================================================================
# English:
#   Make sure the GNOME Shell extensions Pulsar ships as enabled are actually
#   enabled for existing users, also after an update.
#
#   GNOME stores `enabled-extensions` in the *user* dconf database, and the user
#   database takes precedence over the system database shipped by this package
#   (/etc/dconf/db/local.d/00-pulsaros-theme). Once anything (an older Pulsar
#   release, the Extensions app, a theme tool) has written that list into the
#   user database, the system default is shadowed forever: any extension added
#   to the default set by a later update never turns on. That is how the Control
#   Centre, Notification Centre and Notch panels silently went missing after
#   updating.
#
#   This script only *adds back* missing defaults. It never disables anything:
#   extensions the user turned off explicitly live in `disabled-extensions` and
#   are respected. The OOTB `disabled-extensions` set is left untouched too.
#
# Español:
#   Se asegura de que las extensiones de GNOME Shell que Pulsar trae activadas
#   sigan activadas para los usuarios ya existentes, también tras una
#   actualización (la base de datos dconf del usuario tapa la del sistema).
#   Solo vuelve a añadir los valores por defecto que falten; nunca desactiva
#   nada y respeta lo que el usuario haya desactivado a mano.
#
# Uso / Usage:
#   pulsaros-reconcile-extensions [--quiet] [--dry-run]
# ==============================================================================

set -u

SCHEMA="org.gnome.shell"
KEY_ENABLED="enabled-extensions"
KEY_DISABLED="disabled-extensions"

# Archivo de configuración dconf del sistema que este paquete instala.
THEME_FILE="${PULSAR_THEME_FILE:-/etc/dconf/db/local.d/00-pulsaros-theme}"

QUIET=0
DRY_RUN=0
for arg in "$@"; do
    case "$arg" in
        --quiet|-q)   QUIET=1 ;;
        --dry-run|-n) DRY_RUN=1 ;;
        -h|--help)
            echo "Uso: $0 [--quiet] [--dry-run]"
            exit 0
            ;;
    esac
done

log() { [ "$QUIET" -eq 1 ] || echo "pulsaros-reconcile-extensions: $*"; }

# ------------------------------------------------------------------------------
# Helpers de listas GVariant
# ------------------------------------------------------------------------------

# "['a', 'b']" -> una entrada por línea (sin líneas vacías)
parse_list() {
    printf '%s' "$1" \
        | sed -e 's/^@as //' -e 's/^\[//' -e 's/\]$//' \
        | tr ',' '\n' \
        | sed -e "s/^[[:space:]]*//" -e "s/[[:space:]]*$//" \
              -e "s/^'//" -e "s/'$//" -e 's/^"//' -e 's/"$//' \
        | grep -v '^$' || true
}

# elementos... -> "['a', 'b']"
build_list() {
    local out="[" first=1 e
    for e in "$@"; do
        [ -n "$e" ] || continue
        if [ "$first" -eq 1 ]; then first=0; else out="$out, "; fi
        out="$out'$e'"
    done
    echo "$out]"
}

# contiene <aguja> <lista-separada-por-saltos>
contains() {
    [ -n "$2" ] && printf '%s\n' "$2" | grep -Fxq -- "$1"
}

# ------------------------------------------------------------------------------
# Leer los valores por defecto que instala este paquete
# ------------------------------------------------------------------------------
if [ ! -r "$THEME_FILE" ]; then
    log "no se puede leer $THEME_FILE; nada que reconciliar."
    exit 0
fi

get_theme_list() {
    sed -nE "s/^${1}=(.*)$/\1/p" "$THEME_FILE" | head -n1
}

DEFAULT_ENABLED_RAW="$(get_theme_list "$KEY_ENABLED")"
if [ -z "$DEFAULT_ENABLED_RAW" ]; then
    log "no hay $KEY_ENABLED por defecto en $THEME_FILE; nada que reconciliar."
    exit 0
fi

DEFAULT_NL="$(parse_list "$DEFAULT_ENABLED_RAW")"

CUR_ENABLED_RAW="$(gsettings get "$SCHEMA" "$KEY_ENABLED" 2>/dev/null || true)"
CUR_DISABLED_RAW="$(gsettings get "$SCHEMA" "$KEY_DISABLED" 2>/dev/null || true)"
CUR_ENABLED_NL="$(parse_list "$CUR_ENABLED_RAW")"
CUR_DISABLED_NL="$(parse_list "$CUR_DISABLED_RAW")"

# ------------------------------------------------------------------------------
# Calcular la lista final (actual + los defaults que falten)
# ------------------------------------------------------------------------------
NEW_ARR=()
while IFS= read -r u; do
    [ -n "$u" ] && NEW_ARR+=("$u")
done <<< "$CUR_ENABLED_NL"

ADDED_ARR=()
while IFS= read -r uuid; do
    [ -n "$uuid" ] || continue
    contains "$uuid" "$CUR_ENABLED_NL" && continue
    if contains "$uuid" "$CUR_DISABLED_NL"; then
        log "  · $uuid está en disabled-extensions (elección del usuario); se respeta."
        continue
    fi
    NEW_ARR+=("$uuid")
    ADDED_ARR+=("$uuid")
done <<< "$DEFAULT_NL"

if [ "${#ADDED_ARR[@]}" -eq 0 ]; then
    exit 0
fi

log "reactivando ${#ADDED_ARR[@]} extensión(es) que faltaban: ${ADDED_ARR[*]}"

NEW_VARIANT="$(build_list "${NEW_ARR[@]}")"

if [ "$DRY_RUN" -eq 1 ]; then
    log "[dry-run] gsettings set $SCHEMA $KEY_ENABLED $NEW_VARIANT"
    exit 0
fi

if gsettings set "$SCHEMA" "$KEY_ENABLED" "$NEW_VARIANT" 2>/dev/null; then
    log "enabled-extensions actualizado."
else
    echo "pulsaros-reconcile-extensions: no se pudo escribir $KEY_ENABLED" >&2
    exit 1
fi
