#!/bin/bash
# ==============================================================================
# Pulsar OS - GNOME Shell extensions reconciler
# ==============================================================================
# Se asegura de que las extensiones de GNOME Shell oficiales de Pulsar OS
# estén activadas y purga extensiones obsoletas/descontinuadas.
# ==============================================================================

set -u

SCHEMA="org.gnome.shell"
KEY_ENABLED="enabled-extensions"
KEY_DISABLED="disabled-extensions"

THEME_FILE="${PULSAR_THEME_FILE:-/etc/dconf/db/local.d/00-pulsaros-theme}"

QUIET=0
DRY_RUN=0
for arg in "$@"; do
    case "$arg" in
        --quiet|-q)   QUIET=1 ;;
        --dry-run|-n) DRY_RUN=1 ;;
        -h|--help)
            echo "Uso: $0 [--quiet] [--dry-run]"
            exit 0
            ;;
    esac
done

log() { [ "$QUIET" -eq 1 ] || echo "pulsaros-reconcile-extensions: $*"; }

parse_list() {
    printf '%s' "$1" \
        | sed -e 's/^@as //' -e 's/^\[//' -e 's/\]$//' \
        | tr ',' '\n' \
        | sed -e "s/^[[:space:]]*//" -e "s/[[:space:]]*$//" \
              -e "s/^'//" -e "s/'$//" -e 's/^"//' -e 's/"$//' \
        | grep -v '^$' || true
}

build_list() {
    local out="[" first=1 e
    for e in "$@"; do
        [ -n "$e" ] || continue
        if [ "$first" -eq 1 ]; then first=0; else out="$out, "; fi
        out="$out'$e'"
    done
    echo "$out]"
}

contains() {
    [ -n "$2" ] && printf '%s\n' "$2" | grep -Fxq -- "$1"
}

DEPRECATED_EXTENSIONS=(
    "macos-control-centre@pulsar.local"
    "pulsar-island@inled.es"
    "pulsaros-control-center-button@inled.es"
    "gaze@gundulabs.com"
    "ding@rastersoft.com"
    "gsconnect@andyholmes.github.io"
    "just-perfection-desktop@just-perfection"
    "notification-position@drugo.dev"
    "gnome-ui-tune@itstime.tech"
    "apps-menu@gnome-shell-extensions.gcampax.github.com"
    "auto-move-windows@gnome-shell-extensions.gcampax.github.com"
    "drive-menu@gnome-shell-extensions.gcampax.github.com"
    "launch-new-instance@gnome-shell-extensions.gcampax.github.com"
    "light-style@gnome-shell-extensions.gcampax.github.com"
    "native-window-placement@gnome-shell-extensions.gcampax.github.com"
    "screenshot-window-sizer@gnome-shell-extensions.gcampax.github.com"
    "status-icons@gnome-shell-extensions.gcampax.github.com"
    "system-monitor@gnome-shell-extensions.gcampax.github.com"
    "windowsNavigator@gnome-shell-extensions.gcampax.github.com"
    "workspace-indicator@gnome-shell-extensions.gcampax.github.com"
    "places-menu@gnome-shell-extensions.gcampax.github.com"
    "window-list@gnome-shell-extensions.gcampax.github.com"
)

if [ ! -r "$THEME_FILE" ]; then
    log "no se puede leer $THEME_FILE; nada que reconciliar."
    exit 0
fi

get_theme_list() {
    sed -nE "s/^${1}=(.*)$/\1/p" "$THEME_FILE" | head -n1
}

DEFAULT_ENABLED_RAW="$(get_theme_list "$KEY_ENABLED")"
if [ -z "$DEFAULT_ENABLED_RAW" ]; then
    log "no hay $KEY_ENABLED por defecto en $THEME_FILE; nada que reconciliar."
    exit 0
fi

DEFAULT_NL="$(parse_list "$DEFAULT_ENABLED_RAW")"
CUR_ENABLED_RAW="$(gsettings get "$SCHEMA" "$KEY_ENABLED" 2>/dev/null || true)"
CUR_DISABLED_RAW="$(gsettings get "$SCHEMA" "$KEY_DISABLED" 2>/dev/null || true)"
CUR_ENABLED_NL="$(parse_list "$CUR_ENABLED_RAW")"
CUR_DISABLED_NL="$(parse_list "$CUR_DISABLED_RAW")"

# 1. Filter out deprecated extensions from user's current enabled list
NEW_ARR=()
CHANGED=0
while IFS= read -r u; do
    [ -n "$u" ] || continue
    is_deprecated=0
    for dep in "${DEPRECATED_EXTENSIONS[@]}"; do
        if [ "$u" = "$dep" ]; then
            is_deprecated=1
            CHANGED=1
            log "  · eliminando extensión obsoleta: $u"
            break
        fi
    done
    [ "$is_deprecated" -eq 0 ] && NEW_ARR+=("$u")
done <<< "$CUR_ENABLED_NL"

# 2. Add missing defaults
while IFS= read -r uuid; do
    [ -n "$uuid" ] || continue
    # If already in NEW_ARR, skip
    found=0
    for cur in "${NEW_ARR[@]}"; do
        if [ "$cur" = "$uuid" ]; then
            found=1
            break
        fi
    done
    if [ "$found" -eq 0 ]; then
        log "  + agregando extensión requerida: $uuid"
        NEW_ARR+=("$uuid")
        CHANGED=1
    fi
done <<< "$DEFAULT_NL"

# 3. Clean deprecated extensions from disabled-extensions too
CLEAN_DISABLED=()
while IFS= read -r u; do
    [ -n "$u" ] || continue
    is_deprecated=0
    for dep in "${DEPRECATED_EXTENSIONS[@]}"; do
        if [ "$u" = "$dep" ]; then
            is_deprecated=1
            break
        fi
    done
    [ "$is_deprecated" -eq 0 ] && CLEAN_DISABLED+=("$u")
done <<< "$CUR_DISABLED_NL"

NEW_VARIANT="$(build_list "${NEW_ARR[@]}")"
NEW_DISABLED_VARIANT="$(build_list "${CLEAN_DISABLED[@]}")"

if [ "$CHANGED" -eq 1 ]; then
    if [ "$DRY_RUN" -eq 1 ]; then
        log "[dry-run] gsettings set $SCHEMA $KEY_ENABLED $NEW_VARIANT"
    else
        gsettings set "$SCHEMA" "$KEY_ENABLED" "$NEW_VARIANT" 2>/dev/null || true
        gsettings set "$SCHEMA" "$KEY_DISABLED" "$NEW_DISABLED_VARIANT" 2>/dev/null || true
        log "enabled-extensions y disabled-extensions reconciliados."
    fi
fi

# Ensure Blur My Shell popup blur is disabled so it doesn't draw a dark card behind CC & NC
gsettings set org.gnome.shell.extensions.blur-my-shell.popup blur false 2>/dev/null || true

exit 0
