[org.gnome.shell]
disable-user-extensions=false
enabled-extensions=['user-theme@gnome-shell-extensions.gcampax.github.com', 'pulsar-dock@inled.es', 'compiz-alike-magic-lamp-effect@hermes83.github.com', 'pulsaros-ui-tweaks@inled.es', 'pulsaros-global-menu@inled.es', 'notchnux@adityasah.programs', 'pulsaros-spotlight-launcher@inled.es', 'pulsar-circle-to-search@inled.es', 'pulsaros-focus@inled.es', 'pulsaros-idle-guard@inled.es', 'appindicatorsupport@rgcjonas.gmail.com', 'wiggle@mechtifs', 'no-overview@fthx', 'macos-control-centre-lg@pulsar.local', 'macos-notification-center@pulsar.local', 'liquid-glass@thinkingcoding1231.gmail.com', 'blur-my-shell@aunetx', 'flydrop@pulsaros.org']
disabled-extensions=@as []
favorite-apps=['org.gnome.Nautilus.desktop', 'pulsaros-recovery.desktop', 'pulsaros-spotlight.desktop', 'brave-browser.desktop', 'seafari.desktop', 'org.gnome.Terminal.desktop', 'org.gnome.Geary.desktop', 'org.gnome.Calendar.desktop', 'org.gnome.Calculator.desktop', 'com.github.xournalpp.xournalpp.desktop', 'org.gnome.Loupe.desktop', 'io.bassi.Amberol.desktop', 'org.gnome.clocks.desktop', 'org.gnome.Weather.desktop', 'es.inled.PulsarStore.desktop', 'es.inled.AppInstall.desktop']
disable-extension-version-validation=true

[org.gnome.shell.extensions.pulsaros-ui-tweaks]
activities-button=false
clock-menu-position=1
clock-menu-position-offset=12
panel-size=32
panel-button-padding-size=10
panel-indicator-padding-size=10
animation=1
startup-status=0
dash-icon-size=0
osd-position=3
notification-banner-position=2
support-notifier-showed-version=36
support-notifier-type=0
position='top-right'
show-indicator=false
vertical-margin=10
always-show-thumbnails=true
hide-search=false
increase-thumbnails-size='200%'
overview-firefox-pip=true
restore-thumbnails-background=true

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/pulsar-os-tahoe.png'
picture-uri-dark='file:///usr/share/backgrounds/pulsar-os-tahoe.png'
picture-options='zoom'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/pulsar-os-tahoe.png'
picture-options='zoom'
lock-enabled=true

[org.gnome.desktop.lockdown]
disable-lock-screen=false

[org.gnome.desktop.interface]
gtk-theme='MacTahoe-Dark-solid'
cursor-theme='MacTahoe-dark'
icon-theme='MacTahoe-blue-dark'
color-scheme='prefer-dark'
enable-animations=true

[org.gnome.desktop.wm.preferences]
button-layout='close,minimize,maximize:'

[org.gnome.shell.extensions.dash-to-dock]
dock-position='BOTTOM'
extend-height=false
dash-max-icon-size=48
click-action='minimize-or-previews'
running-indicator-style='DOTS'
intellihide=true
dock-fixed=false
apply-custom-theme=false
transparency-mode='FIXED'
background-opacity=0.0
custom-theme-shrink=true
show-apps-at-top=false
show-show-apps-button=false
show-trash=true

[org.gnome.shell.extensions.kiwimenu]
activity-menu-visibility=false
icon=10

[org.gnome.shell.extensions.pulsaros-global-menu]
macos-fullscreen-spaces=true
blur-popups=true
popup-blur-sigma=28
popup-blur-brightness=0.85
popup-opacity=78

[org.gnome.shell.extensions.blur-my-shell.appfolder]
brightness=0.6
sigma=30

[org.gnome.shell.extensions.blur-my-shell.popup]
blur=false

[org.gnome.shell.extensions.blur-my-shell.applications]
blacklist=['Plank', 'Conky', 'gjs', 'Gjs', 'gjs-console', 'sayri', 'Sayri', 'es.inled.sayri', 'sayri-overlay', 'sayri-indicator', '*sayri*', '*Sayri*', 'sayri-tray', 'sayri-ui-clippy', 'sayri-companion', 'clippy', '*clippy*', 'Sayri Companion', 'flydrop', 'FlyDrop', 'es.pulsaros.FlyDrop', '*flydrop*', '*FlyDrop*', 'notchnux', 'NotchNux', '*notchnux*', '*NotchNux*', 'pulsar-notch', '*pulsar-notch*']
blur=true
blur-on-overview=false
corner-radius=18
corner-when-maximized=false
dynamic-opacity=false
enable-all=true
opacity=255
pipeline='pipeline_default_rounded'
sigma=23
static-blur=false

[org.gnome.shell.extensions.blur-my-shell.dash-to-dock]
blur=false
brightness=0.6
override-background=true
pipeline='pipeline_default_rounded'
sigma=30
static-blur=true
style-dash-to-dock=2
unblur-in-overview=true

[org.gnome.shell.extensions.blur-my-shell.panel]
blur=false
brightness=0.6
corner-radius=0
force-light-text=false
override-background=false
pipeline='pipeline_default'
sigma=30
static-blur=false

[org.gnome.shell.extensions.blur-my-shell.window-list]
brightness=0.6
sigma=30

[org.gnome.shell.extensions.liquid-glass]
application-blur-radius=4
application-content-opacity=1.0
application-corner-radius=30.0
application-glass-all-windows=true
application-saturation=2.0
application-tint-color='#000000'
application-tint-strength=0.2988505747126437
application-window-whitelist=@as []
blur-method=0
blur-my-shell-popup-blur=false
desktop-menu-corner-radius=14.0
dock-blur-radius=3
dock-brightness=1.0
dock-contrast=0.99751243781094523
dock-corner-radius=20.0
dock-glass-displacement=330.0
dock-glass-expand=0
dock-glass-ior=0.0
dock-glass-max-z=29.0
dock-glass-shape-n=11.0
dock-margin-bottom=5
dock-saturation=1.0
dock-tint-color='#241f31'
dock-tint-strength=0.10112359550561797
enable-application-glass=true
enable-desktop-menu-glass=false
enable-desktop-widgets=false
enable-dock-glass=true
enable-extra-menu-glass=true
enable-glass-clock=true
enable-launcher=true
enable-menu-glass=true
enable-notification-glass=true
enable-osd-glass=true
enable-quick-settings-glass=true
quick-settings-apply-to=1
quick-settings-blur-radius=4
quick-settings-corner-radius=35.632183908045981
quick-settings-enable-adaptive-text-color=false
quick-settings-glass-expand=0
quick-settings-tint-color='#000000'
quick-settings-tint-strength=0.10000000000000002
quick-settings-toggle-corner-radius=32.5
