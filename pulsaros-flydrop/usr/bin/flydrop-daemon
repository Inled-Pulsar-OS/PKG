#!/usr/bin/env python3
"""
FlyDrop Background Service Runner
"""

import os
import sys

pkg_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
for p in [pkg_root, "/usr/share", "/usr/share/flydrop"]:
    if os.path.exists(p) and p not in sys.path:
        sys.path.insert(0, p)

try:
    from daemon.flydrop_daemon import main
except ImportError:
    from flydrop.daemon.flydrop_daemon import main

if __name__ == "__main__":
    main()
