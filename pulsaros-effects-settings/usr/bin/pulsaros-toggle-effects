#!/bin/bash
# ==============================================================================
# Pulsar OS - Desktop Effects Toggle CLI
# ==============================================================================
# Usage:
#   pulsaros-toggle-effects glass   - Enable Liquid Glass with host presets
#   pulsaros-toggle-effects blur    - Enable Standard Blur my Shell
#   pulsaros-toggle-effects toggle  - Toggle between glass and blur
#   pulsaros-toggle-effects status  - Print current effects state ("glass"|"blur")
# ==============================================================================

exec python3 /usr/share/pulsaros-effects-settings/effects.py "$@"
