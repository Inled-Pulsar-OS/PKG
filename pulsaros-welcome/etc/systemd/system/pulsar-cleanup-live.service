[Unit]
Description=Pulsar OS - Cleanup Live User After OOTB Setup
Before=display-manager.service sddm.service gdm.service
After=local-fs.target

[Service]
Type=oneshot
ExecCondition=/bin/sh -c '[ -f /etc/pulsar-need-cleanup ] || id -u live &>/dev/null'
ExecStart=/usr/libexec/pulsar-cleanup-live.sh
RemainAfterExit=no
TimeoutSec=30

[Install]
WantedBy=multi-user.target
