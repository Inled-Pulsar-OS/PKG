[Unit]
Description=Pulsar OS OOTB - Ensure setup sentinel
DefaultDependencies=no
Before=display-manager.service graphical.target
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'touch /etc/pulsar-need-setup && echo "live ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/pulsar-ootb-live && chmod 0440 /etc/sudoers.d/pulsar-ootb-live'
RemainAfterExit=yes
TimeoutStartSec=30

[Install]
WantedBy=graphical.target
