#!/usr/bin/env python3
# -*- coding: utf-8 -*-
import sys
import os
import subprocess
import threading

CLEANUP_SENTINEL = "/etc/pulsar-need-cleanup"

if not os.path.exists(CLEANUP_SENTINEL) and "TEST_MODE" not in os.environ:
    print("No cleanup needed. Exiting.")
    sys.exit(0)

import time
import gi

gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')

from gi.repository import Gtk, Gdk, GLib, Adw, Gio


CSS = b"""
window {
    background-color: transparent;
}
.spinner-white spinner {
    color: white;
    -gtk-icon-size: 64px;
}
"""


class CleanupWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Pulsar OS")

        display = Gdk.Display.get_default()
        monitors = display.get_monitors()
        if monitors and len(monitors) > 0:
            geo = monitors[0].get_geometry()
            self.set_default_size(geo.width, geo.height)
        else:
            self.set_default_size(1920, 1080)
        self.fullscreen()
        self.set_decorated(False)

        try:
            self.set_keep_above(True)
        except AttributeError:
            pass

        # Transparent CSS class
        self.add_css_class("osd")

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        outer.set_valign(Gtk.Align.CENTER)
        outer.set_halign(Gtk.Align.CENTER)
        self.set_content(outer)

        spinner = Gtk.Spinner()
        spinner.set_size_request(64, 64)
        spinner.start()
        spinner.add_css_class("spinner-white")
        outer.append(spinner)

        label = Gtk.Label(label="Preparing your system...")
        label.set_margin_top(16)
        label.set_opacity(0.85)
        outer.append(label)

        # Schedule cleanup
        GLib.timeout_add(1500, self._start_cleanup)

    def _start_cleanup(self):
        threading.Thread(target=self._cleanup_thread, daemon=True).start()
        return False

    def _cleanup_thread(self):
        error_msg = None
        try:
            res = subprocess.run(
                ["pkexec", "/usr/libexec/pulsar-cleanup-live.sh"],
                capture_output=True, text=True
            )
            if res.returncode != 0 and "authorized" not in res.stderr.lower():
                error_msg = res.stderr.strip() or "Permission denied"
        except Exception as e:
            error_msg = str(e)

        # Always remove sentinel to prevent infinite loop
        try:
            os.remove(CLEANUP_SENTINEL)
        except FileNotFoundError:
            pass
        except PermissionError:
            subprocess.run(["pkexec", "rm", "-f", CLEANUP_SENTINEL], capture_output=True)

        time.sleep(1)

        if error_msg:
            GLib.idle_add(self._show_error, error_msg)
        else:
            GLib.idle_add(self._finish)

    def _finish(self):
        subprocess.Popen(["/usr/bin/pulsaros-welcome"], start_new_session=True)
        self.close()
        return False

    def _show_error(self, msg):
        dialog = Adw.MessageDialog(
            transient_for=self,
            heading="Cleanup failed",
            body=f"Could not remove temporary user:\n\n{msg}\n\nYou can try later by running:\nsudo userdel -r live"
        )
        dialog.add_response("continue", "Continue anyway")
        dialog.set_default_response("continue")

        def on_response(d, response_id):
            d.destroy()
            self._finish()

        dialog.connect("response", on_response)
        dialog.present()
        return False


class CleanupApp(Adw.Application):
    def __init__(self):
        super().__init__(
            application_id="es.inled.pulsaros.cleanup_user",
            flags=Gio.ApplicationFlags.FLAGS_NONE,
        )

    def do_activate(self):
        win = CleanupWindow(self)
        win.present()


if __name__ == "__main__":
    app = CleanupApp()
    sys.exit(app.run(sys.argv))
