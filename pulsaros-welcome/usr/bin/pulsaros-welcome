#!/bin/bash
# ==============================================================================
# Pulsar OS - Welcome Application (Tauri)
# ==============================================================================

BINARY="/usr/share/pulsaros-welcome/src-tauri/target/release/pulsaros-welcome"

# If live user cleanup is pending, run cleanup via the binary
if [ -f "/etc/pulsar-need-cleanup" ]; then
    exec "$BINARY" "$@"
fi

# If the done file exists and we are not forcing, exit
DONE_FILE="$HOME/.config/pulsaros-welcome.done"
FORCE=false
for arg in "$@"; do
    if [ "$arg" == "--force" ] || [ "$arg" == "-f" ]; then
        FORCE=true
    fi
done

if [ -f "$DONE_FILE" ] && ! $FORCE; then
    exit 0
fi

# Run the welcome application
exec "$BINARY" "$@"
