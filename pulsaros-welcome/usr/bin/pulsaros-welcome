#!/bin/bash
# ==============================================================================
# Pulsar OS - Welcome Application Wrapper
# Tauri binary first, Python+WebKitGTK fallback
# ==============================================================================

# 1. Do not launch in live ISO / live installer environments
if [ -d /run/archiso/bootmnt ] || [ -d /run/live ] || [ -d /live ] || grep -qE 'archiso|pulsar-live|boot=live' /proc/cmdline 2>/dev/null || [ "$USER" = "live" ]; then
    exit 0
fi

# 2. If initial OOTB setup wizard is pending, launch OOTB
if [ -f /etc/pulsar-need-setup ]; then
    if [ -x /usr/bin/pulsaros-ootb ]; then
        exec /usr/bin/pulsaros-ootb
    elif [ -f /usr/share/pulsaros/welcome_ootb.py ]; then
        if command -v xhost >/dev/null 2>&1; then
            xhost +SI:localuser:root 2>/dev/null || true
        fi
        exec sudo -E /usr/bin/python3 /usr/share/pulsaros/welcome_ootb.py
    fi
    exit 0
fi

# 3. If launched via session autostart, show once after OOTB setup when the real user logs in
if [ "$1" = "--autostart" ]; then
    CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/pulsar"
    SHOWN_FILE="$CONFIG_DIR/welcome-shown"
    mkdir -p "$CONFIG_DIR" 2>/dev/null || true

    # Only show once per user
    if [ -f "$SHOWN_FILE" ]; then
        exit 0
    fi

    touch "$SHOWN_FILE" 2>/dev/null || true
    shift
fi

TAURI_BIN="/usr/lib/pulsaros-welcome/pulsaros-welcome"
PYTHON_APP="/usr/share/pulsaros-welcome/welcome.py"

# Fix: videos appear black in WebKit on Linux due to DMA-BUF/VA-API issues.
# Disabling the DMA-BUF renderer forces WebKit to use software-based video
# decoding, which is universally compatible across all GPU configurations.
export WEBKIT_DISABLE_DMABUF_RENDERER=1
# Also disable accelerated compositing to prevent black-frame rendering bugs
# in some WebKit/GStreamer combinations on Wayland and X11.
export WEBKIT_DISABLE_COMPOSITING_MODE=1

if [ -x "$TAURI_BIN" ]; then
    exec "$TAURI_BIN" "$@"
fi

exec /usr/bin/python3 "$PYTHON_APP" "$@"
