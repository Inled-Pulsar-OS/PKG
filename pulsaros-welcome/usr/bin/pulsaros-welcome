#!/bin/bash
# ==============================================================================
# Pulsar OS - Welcome Application Wrapper
# ==============================================================================

# If we are running in the Live ISO environment, we always launch the welcome screen
if grep -q "boot=live" /proc/cmdline; then
    exec /usr/share/pulsaros-welcome/welcome.py "$@"
fi

DONE_FILE="$HOME/.config/pulsaros-welcome.done"

FORCE=false
for arg in "$@"; do
    if [ "$arg" == "--force" ] || [ "$arg" == "-f" ]; then
        FORCE=true
    fi
done

# If OOTB setup is pending, launch welcome_ootb.py with privilege escalation.
# The systemd service (pulsar-ootb.service) already granted us sudoers access
# and created the sentinel file before the display manager started.
if [ -f "/etc/pulsar-need-setup" ]; then
    if command -v xhost &>/dev/null; then
        xhost +SI:localuser:root &>/dev/null
    fi
    exec sudo -E /usr/bin/python3 /usr/share/pulsaros/welcome_ootb.py
fi

# If the done file exists and we are not forcing, exit
if [ -f "$DONE_FILE" ] && ! $FORCE; then
    exit 0
fi

# Run the post-install welcome configurator
exec /usr/share/pulsaros-welcome/welcome.py "$@"
