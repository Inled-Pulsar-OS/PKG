#!/bin/bash
# ==============================================================================
# Pulsar OS - Welcome Application Wrapper
# ==============================================================================

SCRIPT_DIR="$(dirname "$(realpath "$0")")"
if [ -f "$SCRIPT_DIR/../share/pulsaros-welcome/welcome.py" ]; then
    exec /usr/bin/python3 "$SCRIPT_DIR/../share/pulsaros-welcome/welcome.py" "$@"
fi

exec /usr/bin/python3 /usr/share/pulsaros-welcome/welcome.py "$@"
