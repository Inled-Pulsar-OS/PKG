#!/usr/bin/env python3
"""
Pulsar OS - Native Live Wallpaper Engine & Daemon
Manages animated and video wallpapers (MP4, WebM, GIF, MKV, WebP) natively on GNOME/Wayland.
Persists settings across reboots and automatically synchronizes with SDDM, LockScreen, GNOME Background Chooser and Hidamari Engine.
"""

import sys
import os
import json
import subprocess
import shutil
import time
import argparse
from pathlib import Path

CONFIG_DIR = Path.home() / ".config" / "pulsaros"
CONFIG_FILE = CONFIG_DIR / "live-wallpaper.json"
USER_BACKGROUNDS_DIR = Path.home() / ".local" / "share" / "backgrounds"
SDDM_DIR = Path("/var/lib/pulsar-sddm")
DEFAULT_WALLPAPER = "/usr/share/backgrounds/pulsar-os-tahoe.png"

HIDAMARI_PATHS = [
    Path.home() / ".var" / "app" / "io.github.jeffshee.Hidamari" / "config" / "hidamari",
    Path.home() / ".config" / "hidamari"
]

def get_config():
    if CONFIG_FILE.exists():
        try:
            with open(CONFIG_FILE, "r") as f:
                return json.load(f)
        except Exception:
            pass
    return {"enabled": False, "file": "", "type": "image"}

def save_config(cfg):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    with open(CONFIG_FILE, "w") as f:
        json.dump(cfg, f, indent=2)

def extract_poster_frame(video_path, output_png):
    try:
        cmd = [
            "ffmpeg", "-y", "-ss", "00:00:01",
            "-i", str(video_path),
            "-vframes", "1",
            "-q:v", "2",
            str(output_png)
        ]
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
        return True
    except Exception:
        return False

def sync_to_sddm_and_lockscreen(media_path, poster_path):
    # 1. Update GNOME Desktop static fallback keys & single clean poster in User Backgrounds
    if poster_path and Path(poster_path).exists():
        USER_BACKGROUNDS_DIR.mkdir(parents=True, exist_ok=True)
        
        # Clean up previous timestamped/named posters to prevent duplicate entries in Settings chooser
        for old in USER_BACKGROUNDS_DIR.glob("live-wallpaper-*.png"):
            try:
                old.unlink()
            except Exception:
                pass
        for old in USER_BACKGROUNDS_DIR.glob("poster-*.png"):
            try:
                old.unlink()
            except Exception:
                pass

        dest_poster = USER_BACKGROUNDS_DIR / "pulsar-live-wallpaper.png"
        try:
            shutil.copy2(poster_path, dest_poster)
            poster_path = dest_poster
        except Exception:
            pass

        file_uri = f"file://{Path(poster_path).resolve()}"
        subprocess.run(["gsettings", "set", "org.gnome.desktop.background", "picture-uri", file_uri], check=False)
        subprocess.run(["gsettings", "set", "org.gnome.desktop.background", "picture-uri-dark", file_uri], check=False)
        subprocess.run(["gsettings", "set", "org.gnome.desktop.screensaver", "picture-uri", file_uri], check=False)
        subprocess.run(["gsettings", "set", "org.gnome.desktop.screensaver", "picture-uri-dark", file_uri], check=False)

    # 2. Sync to SDDM shared folder if writable
    try:
        if SDDM_DIR.exists():
            ext = Path(media_path).suffix.lower()
            if ext in [".mp4", ".webm", ".mkv", ".mov", ".avi"]:
                shutil.copy2(media_path, SDDM_DIR / "pulsar-wallpaper.mp4")
                if poster_path and Path(poster_path).exists():
                    shutil.copy2(poster_path, SDDM_DIR / "pulsar-wallpaper.png")
            elif ext in [".gif", ".webp"]:
                shutil.copy2(media_path, SDDM_DIR / f"pulsar-wallpaper{ext}")
                shutil.copy2(media_path, SDDM_DIR / "pulsar-wallpaper.png")
            else:
                shutil.copy2(media_path, SDDM_DIR / "pulsar-wallpaper.png")
                # Remove residual video/animated files from previous live wallpaper
                for vext in [".mp4", ".webm", ".mkv", ".mov", ".avi", ".gif", ".webp"]:
                    old_vid = SDDM_DIR / f"pulsar-wallpaper{vext}"
                    if old_vid.exists():
                        old_vid.unlink()
            
            # Update SDDM theme.conf if accessible
            theme_conf = Path("/usr/share/sddm/themes/Apple.Tahoe/theme.conf")
            if theme_conf.exists():
                try:
                    if ext in [".mp4", ".webm", ".mkv", ".mov", ".avi"]:
                        subprocess.run(["sed", "-i", "s|^background=.*|background=file:///var/lib/pulsar-sddm/pulsar-wallpaper.mp4|", str(theme_conf)], check=False)
                        subprocess.run(["sed", "-i", "s|^type=.*|type=video|", str(theme_conf)], check=False)
                    else:
                        subprocess.run(["sed", "-i", "s|^background=.*|background=file:///var/lib/pulsar-sddm/pulsar-wallpaper.png|", str(theme_conf)], check=False)
                        subprocess.run(["sed", "-i", "s|^type=.*|type=image|", str(theme_conf)], check=False)
                except Exception:
                    pass
    except Exception as e:
        print(f"[LiveWallpaper] Warning syncing to SDDM: {e}", file=sys.stderr)

def get_connected_monitors():
    monitors = []
    try:
        for status_file in Path("/sys/class/drm").glob("*/status"):
            if status_file.is_file() and status_file.read_text().strip() == "connected":
                name = status_file.parent.name
                if "-" in name:
                    name = name.split("-", 1)[1]
                monitors.append(name)
    except Exception:
        pass
    return monitors

def play_video_engine(video_path):
    data_source = {
        "Default": str(video_path)
    }
    for mon in get_connected_monitors():
        data_source[mon] = str(video_path)
        if mon.startswith("HDMI-A-"):
            data_source[mon.replace("HDMI-A-", "HDMI-")] = str(video_path)

    # Configure Hidamari Engine
    hidamari_cfg = {
        "version": 4,
        "mode": "MODE_VIDEO",
        "data_source": data_source,
        "is_mute": True,
        "audio_volume": 0,
        "is_static_wallpaper": False,
        "static_wallpaper_blur_radius": 5,
        "is_pause_when_maximized": True,
        "is_mute_when_maximized": True,
        "fade_duration_sec": 1.5,
        "fade_interval": 0.1,
        "is_show_systray": False,
        "is_first_time": False
    }

    for h_dir in HIDAMARI_PATHS:
        h_dir.mkdir(parents=True, exist_ok=True)
        with open(h_dir / "config.json", "w") as f:
            json.dump(hidamari_cfg, f, indent=2)
        with open(h_dir / "hidamari.json", "w") as f:
            json.dump(hidamari_cfg, f, indent=2)

    # 1. Try DBus instant video switch
    try:
        res = subprocess.run([
            "gdbus", "call", "--session",
            "--dest", "io.github.jeffshee.Hidamari.server",
            "--object-path", "/io/github/jeffshee/Hidamari/server",
            "--method", "io.github.jeffshee.hidamari.server.video",
            str(video_path), ""
        ], capture_output=True, text=True, timeout=2)
        if res.returncode == 0:
            return
    except Exception:
        pass

    # 2. If DBus server was not active, kill any stale instance and start background player
    subprocess.run(["flatpak", "kill", "io.github.jeffshee.Hidamari"], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.Popen(["flatpak", "run", "io.github.jeffshee.Hidamari", "-b"],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)

def stop_video_engine():
    # 1. Try DBus quit
    try:
        subprocess.run([
            "gdbus", "call", "--session",
            "--dest", "io.github.jeffshee.Hidamari.server",
            "--object-path", "/io/github/jeffshee/Hidamari/server",
            "--method", "io.github.jeffshee.hidamari.server.quit"
        ], capture_output=True, timeout=2)
    except Exception:
        pass
    # 2. Clean kill
    subprocess.run(["flatpak", "kill", "io.github.jeffshee.Hidamari"], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def get_hidamari_video_dir():
    try:
        res = subprocess.run(["xdg-user-dir", "VIDEOS"], capture_output=True, text=True, check=True)
        v_dir = Path(res.stdout.strip())
        if v_dir.exists():
            h_dir = v_dir / "Hidamari"
            h_dir.mkdir(parents=True, exist_ok=True)
            return h_dir
    except Exception:
        pass
    h_dir = Path.home() / "Videos" / "Hidamari"
    h_dir.mkdir(parents=True, exist_ok=True)
    return h_dir

def copy_with_progress(src_path, dst_path):
    src = Path(src_path)
    dst = Path(dst_path)
    try:
        total_size = src.stat().st_size
    except Exception:
        total_size = 0

    # If small (< 5MB) or in headless environment, copy directly
    if total_size < 5 * 1024 * 1024 or not (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
        shutil.copy2(src, dst)
        return True

    try:
        import gi
        gi.require_version('Gtk', '3.0')
        from gi.repository import Gtk, GLib
        import threading

        win = Gtk.Window(title="Pulsar OS")
        win.set_default_size(360, 130)
        win.set_position(Gtk.WindowPosition.CENTER)
        win.set_resizable(False)
        win.set_border_width(16)

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        win.add(vbox)

        title_label = Gtk.Label()
        title_label.set_markup("<b>Preparando fondo animado...</b>")
        title_label.set_xalign(0.0)
        vbox.pack_start(title_label, False, False, 0)

        total_mb = total_size / (1024 * 1024)
        sub_label = Gtk.Label()
        sub_label.set_markup(f"<small>Importando <i>{src.name}</i> ({total_mb:.1f} MB)</small>")
        sub_label.set_xalign(0.0)
        sub_label.set_ellipsize(3)
        vbox.pack_start(sub_label, False, False, 0)

        pbar = Gtk.ProgressBar()
        pbar.set_show_text(True)
        pbar.set_fraction(0.0)
        vbox.pack_start(pbar, False, False, 0)

        win.show_all()

        copied_bytes = [0]
        error_occurred = [False]

        def do_copy():
            try:
                chunk_size = 1024 * 1024  # 1MB
                with open(src, "rb") as fsrc, open(dst, "wb") as fdst:
                    while True:
                        buf = fsrc.read(chunk_size)
                        if not buf:
                            break
                        fdst.write(buf)
                        copied_bytes[0] += len(buf)
                        frac = min(1.0, copied_bytes[0] / total_size) if total_size > 0 else 1.0
                        GLib.idle_add(update_ui, frac, copied_bytes[0], total_size)
                shutil.copystat(src, dst)
            except Exception as e:
                print(f"[LiveWallpaper] Copy error: {e}", file=sys.stderr)
                error_occurred[0] = True
            finally:
                GLib.idle_add(Gtk.main_quit)

        def update_ui(frac, current, total):
            pbar.set_fraction(frac)
            c_mb = current / (1024 * 1024)
            t_mb = total / (1024 * 1024)
            pbar.set_text(f"{c_mb:.1f} / {t_mb:.1f} MB ({int(frac * 100)}%)")
            return GLib.SOURCE_REMOVE

        threading.Thread(target=do_copy, daemon=True).start()
        Gtk.main()
        return not error_occurred[0]
    except Exception as e:
        print(f"[LiveWallpaper] Fallback to direct copy: {e}", file=sys.stderr)
        shutil.copy2(src, dst)
        return True

def set_wallpaper(file_path):
    path = Path(file_path).resolve()
    if not path.exists():
        print(f"Error: File '{file_path}' does not exist.", file=sys.stderr)
        sys.exit(1)

    ext = path.suffix.lower()
    is_video = ext in [".mp4", ".webm", ".mkv", ".mov", ".avi"]
    is_animated = ext in [".gif", ".webp"]

    if is_video:
        # Copy to Hidamari video directory with progress indicator
        h_dir = get_hidamari_video_dir()
        target_video = h_dir / path.name
        if target_video.resolve() != path.resolve():
            copy_with_progress(path, target_video)
            path = target_video

    poster_path = None
    if is_video:
        poster_path = CONFIG_DIR / "poster-live-wallpaper.png"
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        if not extract_poster_frame(path, poster_path):
            poster_path = Path(DEFAULT_WALLPAPER)
    elif is_animated:
        poster_path = path
    else:
        poster_path = path

    cfg = {
        "enabled": True,
        "file": str(path),
        "type": "video" if is_video else ("animated" if is_animated else "image"),
        "poster": str(poster_path) if poster_path else "",
        "updated_at": time.time()
    }
    save_config(cfg)
    sync_to_sddm_and_lockscreen(str(path), str(poster_path) if poster_path else None)

    if is_video:
        play_video_engine(str(path))
    else:
        stop_video_engine()

    print(f"✅ Live wallpaper set successfully: {path.name}")
    print(f"Type: {cfg['type']}")

def stop_wallpaper(restore_default=False):
    cfg = get_config()
    cfg["enabled"] = False
    save_config(cfg)
    stop_video_engine()
    
    # Only restore default static wallpaper if explicitly requested
    if restore_default and Path(DEFAULT_WALLPAPER).exists():
        file_uri = f"file://{DEFAULT_WALLPAPER}"
        subprocess.run(["gsettings", "set", "org.gnome.desktop.background", "picture-uri", file_uri], check=False)
        subprocess.run(["gsettings", "set", "org.gnome.desktop.background", "picture-uri-dark", file_uri], check=False)
        subprocess.run(["gsettings", "set", "org.gnome.desktop.screensaver", "picture-uri", file_uri], check=False)
        subprocess.run(["gsettings", "set", "org.gnome.desktop.screensaver", "picture-uri-dark", file_uri], check=False)
        if SDDM_DIR.exists():
            try:
                shutil.copy2(DEFAULT_WALLPAPER, SDDM_DIR / "pulsar-wallpaper.png")
            except Exception:
                pass
    print("⏹️ Live wallpaper stopped.")

def restore_wallpaper():
    cfg = get_config()
    file_path = cfg.get("file")
    if file_path and Path(file_path).exists():
        set_wallpaper(file_path)
        return

    # Fallback 1: SDDM synced wallpaper video
    sddm_video = Path("/var/lib/pulsar-sddm/pulsar-wallpaper.mp4")
    if sddm_video.exists():
        set_wallpaper(str(sddm_video))
        return

    # Fallback 2: Hidamari videos directory
    h_dir = get_hidamari_video_dir()
    if h_dir.exists():
        for v in list(h_dir.glob("*.mp4")) + list(h_dir.glob("*.webm")) + list(h_dir.glob("*.mkv")):
            if v.exists():
                set_wallpaper(str(v))
                return

    print("No saved live wallpaper found to restore.", file=sys.stderr)

def get_status():
    cfg = get_config()
    print(json.dumps(cfg, indent=2))

def run_daemon():
    print("[LiveWallpaper Daemon] Starting Pulsar OS Live Wallpaper Daemon...")
    cfg = get_config()
    if cfg.get("enabled") and cfg.get("file") and Path(cfg.get("file")).exists():
        print(f"[LiveWallpaper Daemon] Restoring saved wallpaper: {cfg.get('file')}")
        sync_to_sddm_and_lockscreen(cfg.get("file"), cfg.get("poster"))
        if cfg.get("type") == "video":
            play_video_engine(cfg.get("file"))
    
    last_mtime = CONFIG_FILE.stat().st_mtime if CONFIG_FILE.exists() else 0
    while True:
        try:
            time.sleep(3)
            if CONFIG_FILE.exists():
                curr_mtime = CONFIG_FILE.stat().st_mtime
                if curr_mtime > last_mtime:
                    last_mtime = curr_mtime
                    cfg = get_config()
                    if cfg.get("enabled") and cfg.get("file") and Path(cfg.get("file")).exists():
                        sync_to_sddm_and_lockscreen(cfg.get("file"), cfg.get("poster"))
                        if cfg.get("type") == "video":
                            play_video_engine(cfg.get("file"))
        except KeyboardInterrupt:
            break
        except Exception as e:
            print(f"[LiveWallpaper Daemon] Error: {e}", file=sys.stderr)

def open_set_dialog():
    selected_file = None

    # 1. Try zenity
    try:
        res = subprocess.run(
            ["zenity", "--file-selection", "--title=Seleccionar Vídeo o Fondo Animado - Pulsar OS",
             "--file-filter=Vídeos y Animaciones | *.mp4 *.webm *.gif *.mkv *.mov *.webp *.png *.jpg *.jpeg"],
            capture_output=True, text=True, timeout=120
        )
        if res.returncode == 0 and res.stdout.strip():
            selected_file = res.stdout.strip()
    except Exception:
        pass

    # 2. Try kdialog fallback
    if not selected_file:
        try:
            res = subprocess.run(
                ["kdialog", "--getopenfilename", str(Path.home()),
                 "*.mp4 *.webm *.gif *.mkv *.mov *.webp *.png *.jpg | Vídeos y Fondos"],
                capture_output=True, text=True, timeout=120
            )
            if res.returncode == 0 and res.stdout.strip():
                selected_file = res.stdout.strip()
        except Exception:
            pass

    # 3. Try python GTK4 Dialog fallback
    if not selected_file:
        try:
            import gi
            gi.require_version("Gtk", "4.0")
            from gi.repository import Gtk, GLib, Gio

            Gtk.init()
            loop = GLib.MainLoop()
            chosen = []

            dialog = Gtk.FileDialog.new()
            dialog.set_title("Seleccionar Vídeo o Fondo Animado - Pulsar OS")
            
            filt = Gtk.FileFilter()
            filt.set_name("Vídeos y Animaciones (*.mp4, *.webm, *.gif, *.mkv, *.webp)")
            for pat in ["*.mp4", "*.webm", "*.gif", "*.mkv", "*.mov", "*.webp", "*.png", "*.jpg"]:
                filt.add_pattern(pat)
            filters = Gio.ListStore.new(Gtk.FileFilter)
            filters.append(filt)
            dialog.set_filters(filters)

            def on_finish(d, res):
                try:
                    f = d.open_finish(res)
                    if f:
                        chosen.append(f.get_path())
                except Exception:
                    pass
                loop.quit()

            dialog.open(None, None, on_finish)
            loop.run()

            if chosen:
                selected_file = chosen[0]
        except Exception as e:
            print(f"File picker fallback error: {e}", file=sys.stderr)

    if selected_file:
        set_wallpaper(selected_file)
        subprocess.run(["notify-send", "-a", "Pulsar OS", "Live Wallpaper Activado", Path(selected_file).name], check=False)

def main():
    parser = argparse.ArgumentParser(description="Pulsar OS Live Wallpaper Manager")
    subparsers = parser.add_subparsers(dest="command")

    set_parser = subparsers.add_parser("set", help="Set video or animated wallpaper")
    set_parser.add_argument("file", help="Path to video or image file")

    subparsers.add_parser("set-dialog", help="Open GUI file picker to set wallpaper")
    subparsers.add_parser("restore", help="Restore and play previously configured live wallpaper")
    subparsers.add_parser("stop", help="Stop live wallpaper and revert to static")
    subparsers.add_parser("status", help="Get current live wallpaper status")
    subparsers.add_parser("daemon", help="Run background synchronization daemon")

    args = parser.parse_args()

    if args.command == "set":
        set_wallpaper(args.file)
    elif args.command == "set-dialog":
        open_set_dialog()
    elif args.command == "restore":
        restore_wallpaper()
    elif args.command == "stop":
        stop_wallpaper()
    elif args.command == "status":
        get_status()
    elif args.command == "daemon":
        run_daemon()
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
