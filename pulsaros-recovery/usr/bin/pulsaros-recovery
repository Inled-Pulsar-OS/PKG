#!/bin/bash
# ==============================================================================
# Pulsar OS - Recovery and Installation Launcher
# ==============================================================================
# English: Launches the Pulsar OS Recovery application with privileges.
# Español: Lanza la aplicación de recuperación de Pulsar OS con privilegios.

# Permitir conexiones X11 locales para root en Wayland
xhost +local:root > /dev/null 2>&1 || true

# Forzar a Qt/GTK a usar XWayland/X11 si fuese necesario
export QT_QPA_PLATFORM=xcb
export GDK_BACKEND="x11,wayland"
# Evitar fallo de X11 SHM con Mesa en X11/sudo ("MESA: error: Failed to attach to x11 shm")
export GSK_RENDERER="${GSK_RENDERER:-cairo}"
export QT_X11_NO_MITSHM=1
export _X11_NO_MITSHM=1

if [ "$(id -u)" -eq 0 ]; then
    exec /usr/share/pulsaros-recovery/recovery.py "$@"
fi

# 1. Si sudo funciona sin contraseña (modo Live o usuario con NOPASSWD), ejecutar directamente
#    sin pedir contraseñas ni abrir diálogos innecesarios.
#    Nota: No propagamos XDG_RUNTIME_DIR a root para evitar que intente usar el bus de sesión D-Bus del usuario normal.
if sudo -n true 2>/dev/null; then
    exec sudo -E env DISPLAY="$DISPLAY" XAUTHORITY="$XAUTHORITY" WAYLAND_DISPLAY="$WAYLAND_DISPLAY" GSK_RENDERER="$GSK_RENDERER" /usr/share/pulsaros-recovery/recovery.py "$@"
fi

# 2. Intentar ejecutar con pkexec si está disponible.
if command -v pkexec >/dev/null 2>&1; then
    if pkexec env DISPLAY="$DISPLAY" XAUTHORITY="$XAUTHORITY" WAYLAND_DISPLAY="$WAYLAND_DISPLAY" GSK_RENDERER="$GSK_RENDERER" /usr/share/pulsaros-recovery/recovery.py "$@"; then
        exit 0
    fi
fi

# 3. Fallback a sudo o finalmente como usuario normal.
sudo -E env DISPLAY="$DISPLAY" XAUTHORITY="$XAUTHORITY" WAYLAND_DISPLAY="$WAYLAND_DISPLAY" GSK_RENDERER="$GSK_RENDERER" /usr/share/pulsaros-recovery/recovery.py "$@" || exec /usr/share/pulsaros-recovery/recovery.py "$@"
