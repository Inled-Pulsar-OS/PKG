#!/bin/bash
# ==============================================================================
# Pulsar OS - Desktop Recovery Icon Installer (Indestructible version)
# ==============================================================================

# Wait for session and desktop manager to be fully loaded
# Esperar a que la sesión y el gestor de escritorio carguen por completo
sleep 6

DESKTOP_DIR="$HOME/Desktop"
mkdir -p "$DESKTOP_DIR"

TARGET_LAUNCHER="$DESKTOP_DIR/pulsaros-recovery.desktop"

# Copy Recovery Launcher
# Copiar lanzador de Recovery
if [ -f "/usr/share/applications/pulsaros-recovery.desktop" ]; then
    cp "/usr/share/applications/pulsaros-recovery.desktop" "$TARGET_LAUNCHER"
    chmod a+rwx "$TARGET_LAUNCHER"
    chown "$USER:$USER" "$TARGET_LAUNCHER" 2>/dev/null || true
    
    # Force metadata trusted using gio to avoid "Allow Launching" warning
    # Forzar metadato de confianza usando gio para evitar la advertencia "Allow Launching"
    gio set "$TARGET_LAUNCHER" metadata::trusted true 2>/dev/null || true
    
    # Try marking with dbus reload hint if available
    # Intentar marcar con dbus de recarga si está disponible
    update-desktop-database "$DESKTOP_DIR" 2>/dev/null || true
fi

# Clean up default Calamares icons if they were generated
# Limpiar iconos de Calamares por defecto si se generaron
rm -f "$DESKTOP_DIR/calamares-install-debian.desktop"
rm -f "$DESKTOP_DIR/calamares.desktop"
