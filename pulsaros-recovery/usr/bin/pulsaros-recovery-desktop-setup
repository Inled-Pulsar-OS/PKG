#!/bin/bash
# ==============================================================================
# Pulsar OS - Desktop Recovery Icon Installer (Indestructible version)
# ==============================================================================

# Wait for session and desktop manager to be fully loaded
# Esperar a que la sesión y el gestor de escritorio carguen por completo
sleep 6

DESKTOP_DIR="$HOME/Desktop"
mkdir -p "$DESKTOP_DIR"

# Place the Install Pulsar OS shortcut on desktop for live session
if [ -f "/usr/share/applications/pulsaros-recovery.desktop" ]; then
    cp -f "/usr/share/applications/pulsaros-recovery.desktop" "$DESKTOP_DIR/pulsaros-recovery.desktop"
    chmod +x "$DESKTOP_DIR/pulsaros-recovery.desktop"
    gio set "$DESKTOP_DIR/pulsaros-recovery.desktop" metadata::trusted true 2>/dev/null || true
fi

# Clean up default Calamares icons if they were generated
rm -f "$DESKTOP_DIR/calamares-install-debian.desktop"
rm -f "$DESKTOP_DIR/calamares.desktop"

