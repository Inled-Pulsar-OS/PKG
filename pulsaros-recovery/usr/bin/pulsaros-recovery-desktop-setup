#!/bin/bash
# ==============================================================================
# Pulsar OS - Desktop Recovery Icon Installer
# ==============================================================================
# English: Installs and marks the Pulsar OS Recovery launcher on the user's
#          Desktop, and disables the default Calamares installer icon.
# Español: Instala y marca el lanzador de Pulsar OS Recovery en el Escritorio
#          del usuario, y desactiva el icono del instalador de Calamares por defecto.
# ==============================================================================

# Wait for session and user folders to be fully populated by GNOME
# Esperar a que la sesión y las carpetas de usuario estén completamente pobladas por GNOME
sleep 2

DESKTOP_DIR="$HOME/Desktop"
mkdir -p "$DESKTOP_DIR"

# Copy Recovery Launcher
# Copiar lanzador de Recovery
if [ -f "/usr/share/applications/pulsaros-recovery.desktop" ]; then
    cp "/usr/share/applications/pulsaros-recovery.desktop" "$DESKTOP_DIR/"
    chmod +x "$DESKTOP_DIR/pulsaros-recovery.desktop"
    
    # Mark as trusted in GNOME to display the icon and name natively
    # Marcar como de confianza en GNOME para mostrar el icono y nombre nativamente
    gio set "$DESKTOP_DIR/pulsaros-recovery.desktop" metadata::trusted true 2>/dev/null || true
fi

# Clean up default Calamares icons if they were generated
# Limpiar iconos de Calamares por defecto si se generaron
rm -f "$DESKTOP_DIR/calamares-install-debian.desktop"
rm -f "$DESKTOP_DIR/calamares.desktop"
