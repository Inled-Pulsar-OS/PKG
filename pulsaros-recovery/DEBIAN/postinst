#!/bin/bash
# ==============================================================================
# Pulsar OS - Recovery Package Post-installation Script
# ==============================================================================
set -e

echo "⚙️ Configurando permisos del lanzador de recuperación..."
chmod +x /usr/share/applications/pulsaros-recovery.desktop || true
chmod +x /usr/bin/pulsaros-recovery-desktop-setup || true

exit 0
