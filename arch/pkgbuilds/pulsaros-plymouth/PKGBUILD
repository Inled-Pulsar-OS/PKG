# Maintainer: Jaime <info@inled.es>
pkgname=pulsaros-plymouth
pkgver=1.0.121
pkgrel=1
pkgdesc="macOS-like Plymouth boot splash theme for Pulsar OS (Arch edition)"
arch=(any)
url="https://inled.es"
license=(custom)
depends=(plymouth)
makedepends=(python python-cairo)
options=(!strip)
install=pulsaros-plymouth.install



prepare() {
    _src="$(cd "$startdir"/../../../pulsaros-plymouth && pwd)"
    cd "$_src"
    mkdir -p "$srcdir/staging"
    cp -r "$_src"/* "$srcdir/staging/" 2>/dev/null || true
    rm -rf "$srcdir/staging/DEBIAN" "$srcdir/staging/prepare-assets.sh" "$srcdir/staging/arch"
    bash prepare-assets.sh "$srcdir/staging"
}

package() {
    _src="$(cd "$startdir"/../../../pulsaros-plymouth && pwd)"
    cd "$_src"
    [ -d usr ] && cp -r usr "$pkgdir/"
    [ -d etc ] && cp -r etc "$pkgdir/"
    if [ -d "$srcdir/staging" ]; then
        cp -r "$srcdir/staging"/* "$pkgdir/"
    elif [ -d "$srcdir/usr" ]; then
        cp -r "$srcdir/usr" "$pkgdir/"
    fi
    # Remove Debian-specific files
    rm -f "$pkgdir/usr/share/plymouth/debian-logo.png"
    rm -f "$pkgdir/usr/share/pixmaps/debian-logo.png"
    # NOTE: do NOT ship /usr/share/pixmaps/archlinux-logo.png: that path is
    # owned by Arch's `filesystem` package, so claiming it creates a package
    # conflict. The file is guaranteed to exist from filesystem anyway, and
    # the mkinitcpio plymouth hook does not reference it.
}
