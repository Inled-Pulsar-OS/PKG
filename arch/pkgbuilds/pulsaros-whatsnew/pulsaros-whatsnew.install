post_install() {
    install -d -m 0755 /var/lib/pulsaros/whatsnew 2>/dev/null || true
    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database /usr/share/applications 2>/dev/null || true
    fi
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
        gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
    fi
    [ -x /usr/bin/pulsaros-whatsnew-hook ] && /usr/bin/pulsaros-whatsnew-hook install || true
}

post_upgrade() {
    post_install
}

post_remove() {
    rm -rf /var/lib/pulsaros/whatsnew 2>/dev/null || true
    rmdir /var/lib/pulsaros 2>/dev/null || true
    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database /usr/share/applications 2>/dev/null || true
    fi
}
