# Pulsar OS - MacTahoe theme for Flatpak apps
# IMPORTANTE: Flatpak >= 1.15 RECHAZA cualquier ruta bajo /usr (está «reservada»),
# así que un override --filesystem=/usr/share/themes nunca llega al sandbox: las
# apps aterrizan en el tema «Default» del runtime (Adwaita estilo GTK3).
# Tampoco sirve fijar GTK_THEME a nivel de sistema, porque además congela la
# variante clara aunque el usuario esté en modo oscuro.
#
# La provisión correcta la hace el usuario en cada login
# (/usr/bin/pulsaros-theme-daemon y /usr/bin/mactahoe-theme-apply):
#   - copia los temas MacTahoe a ~/.local/share/themes
#   - flatpak override --user --filesystem=xdg-data/themes
#     --filesystem=xdg-config/gtk-3.0:ro --filesystem=xdg-config/gtk-4.0:ro
#   - flatpak override --user --env=GTK_THEME=<variante activa>
#
# Aquí solo se limpian los overrides de sistema obsoletos, idempotente.
post_install() {
    if command -v flatpak >/dev/null 2>&1; then
        flatpak override --system \
            --nofilesystem=/usr/share/themes \
            --nofilesystem=/usr/share/icons \
            --unset-env=GTK_THEME 2>/dev/null || true
    fi
}

post_upgrade() {
    post_install
}

post_remove() {
    if command -v flatpak >/dev/null 2>&1; then
        flatpak override --system \
            --nofilesystem=/usr/share/themes \
            --nofilesystem=/usr/share/icons \
            --unset-env=GTK_THEME 2>/dev/null || true
    fi
}
