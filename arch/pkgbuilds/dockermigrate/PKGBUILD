# Maintainer: Pulsar OS Team <team@pulsaros.io>
pkgname=dockermigrate
pkgver=0.1.0
pkgrel=1
pkgdesc="Docker container migration tool with web UI"
arch=('any')
url="https://github.com/Inled-Pulsar-OS/dockermigrate"
license=('Apache-2.0')
depends=('docker')
source=()
sha256sums=()

package() {
  local _src="$(cd "$startdir"/../../../dockermigrate && pwd)"
  if [ -d "$_src/usr" ]; then
    cp -r "$_src/usr" "$pkgdir/"
  fi
  if [ -d "$_src/etc" ]; then
    cp -r "$_src/etc" "$pkgdir/"
  fi
}
