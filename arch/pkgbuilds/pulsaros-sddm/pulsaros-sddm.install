post_install() {
    systemctl enable sddm.service 2>/dev/null || true
    fc-cache -f 2>/dev/null || true

    # Initialize the dynamic wallpaper for SDDM
    mkdir -p /var/lib/pulsar-sddm
    if [ -f "/usr/share/backgrounds/pulsar-os-tahoe.png" ]; then
        cp "/usr/share/backgrounds/pulsar-os-tahoe.png" /var/lib/pulsar-sddm/pulsar-wallpaper.png
    else
        touch /var/lib/pulsar-sddm/pulsar-wallpaper.png
    fi
    chown -R sddm:sddm /var/lib/pulsar-sddm || true
    chmod 666 /var/lib/pulsar-sddm/pulsar-wallpaper.png || true
}
