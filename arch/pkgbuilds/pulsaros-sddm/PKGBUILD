# Maintainer: Jaime <info@inled.es>
pkgname=pulsaros-sddm
pkgver=1.0.118
pkgrel=1
pkgdesc="SDDM login manager with Apple Tahoe theme for Pulsar OS"
arch=(any)
url="https://inled.es"
license=(custom)
depends=(sddm curl qt6-imageformats qt6-svg qt6-declarative qt6-5compat kirigami breeze)
options=(!strip)
install=pulsaros-sddm.install



prepare() {
    _src="$(cd "$startdir"/../../../pulsaros-sddm && pwd)"
    cd "$_src"
    mkdir -p "$srcdir/staging"
    cp -r "$_src"/* "$srcdir/staging/" 2>/dev/null || true
    rm -rf "$srcdir/staging/DEBIAN" "$srcdir/staging/prepare-assets.sh" "$srcdir/staging/arch"
    bash prepare-assets.sh "$srcdir/staging"
}

package() {
    _src="$(cd "$startdir"/../../../pulsaros-sddm && pwd)"
    cd "$_src"
    [ -d usr ] && cp -r usr "$pkgdir/"
    [ -d etc ] && cp -r etc "$pkgdir/"
    if [ -d "$srcdir/staging" ]; then
        cp -r "$srcdir/staging"/* "$pkgdir/"
    elif [ -d "$srcdir/usr" ]; then
        cp -r "$srcdir/usr" "$pkgdir/"
    fi
}
