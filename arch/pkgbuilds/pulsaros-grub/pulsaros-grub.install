_install_theme() {
    # Mock de grub-probe temporal en ruta absoluta para evitar fallos si no hay dispositivo de disco real (ej. chroots)
    if [ -f "/usr/bin/grub-probe" ]; then
        mv /usr/bin/grub-probe /usr/bin/grub-probe.bak
    fi
    echo '#!/bin/sh' > /usr/bin/grub-probe
    echo 'echo "/dev/sda"' >> /usr/bin/grub-probe
    echo 'exit 0' >> /usr/bin/grub-probe
    chmod +x /usr/bin/grub-probe

    PULSAR_GRUB_THEME_SRC="/boot/grub/themes/grub-theme"
    PULSAR_GRUB_THEME_DIR="/boot/grub/themes/Particle-circle-window"
    if [ -f "$PULSAR_GRUB_THEME_SRC/install.sh" ]; then
        cd "$PULSAR_GRUB_THEME_SRC"
        ./install.sh -b -t window -s 1080p || echo "Aviso: El instalador de GRUB reportó errores, pero continuamos..."
    fi

    # Eliminar el mock temporal y restaurar el original
    rm -f /usr/bin/grub-probe
    if [ -f "/usr/bin/grub-probe.bak" ]; then
        mv /usr/bin/grub-probe.bak /usr/bin/grub-probe
    fi

    # Crear script de GRUB para cargar las fuentes del tema en el arranque
    mkdir -p /etc/grub.d
    cat > /etc/grub.d/01_pulsar_theme << 'GRUBSCRIPT'
#!/bin/sh
set -e

# Load Pulsar OS GRUB theme fonts automatically
PULSAR_THEME_DIR="/boot/grub/themes/Particle-circle-window"
if [ -d "$PULSAR_THEME_DIR" ]; then
    for font_file in "$PULSAR_THEME_DIR"/*.pf2; do
        if [ -f "$font_file" ]; then
            echo "loadfont \"$font_file\""
        fi
    done
fi
GRUBSCRIPT
    chmod 755 /etc/grub.d/01_pulsar_theme

    if [ -f /etc/default/grub ]; then
        sed -i 's/^#*GRUB_GFXMODE=.*/GRUB_GFXMODE=1920x1080x32/' /etc/default/grub
        sed -i 's/^#*GRUB_GFXPAYLOAD_LINUX=.*/GRUB_GFXPAYLOAD_LINUX=keep/' /etc/default/grub
    fi
    grub-mkconfig -o /boot/grub/grub.cfg 2>/dev/null || true
}

post_install() {
    _install_theme
}

post_upgrade() {
    _install_theme
}
