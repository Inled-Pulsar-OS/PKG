# Maintainer: Jaime <info@inled.es>
pkgname=pulsaros-calamares
pkgver=1.0.120
pkgrel=1
pkgdesc="Calamares system installer branding and configuration for Pulsar OS (Arch edition)"
arch=(any)
url="https://inled.es"
license=(custom)
depends=(calamares sudo)
options=(!strip)
install=pulsaros-calamares.install



prepare() {
    _src="$(cd "$startdir"/../../../pulsaros-calamares && pwd)"
    cd "$_src"
    mkdir -p "$srcdir/staging"
    cp -r "$_src"/* "$srcdir/staging/" 2>/dev/null || true
    rm -rf "$srcdir/staging/DEBIAN" "$srcdir/staging/prepare-assets.sh" "$srcdir/staging/arch"
    bash prepare-assets.sh "$srcdir/staging"
}

package() {
    _src="$(cd "$startdir"/../../../pulsaros-calamares && pwd)"
    cd "$_src"
    [ -d usr ] && cp -r usr "$pkgdir/"
    [ -d etc ] && cp -r etc "$pkgdir/"
    [ -d usr/local ] && cp -r usr/local "$pkgdir/"
    if [ -d "$srcdir/staging" ]; then
        cp -r "$srcdir/staging"/* "$pkgdir/"
    fi
}
