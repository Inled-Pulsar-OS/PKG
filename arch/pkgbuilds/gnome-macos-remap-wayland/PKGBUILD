# Maintainer: Jaime <info@inled.es>
pkgname=gnome-macos-remap-wayland
pkgver=1.0.96
pkgrel=1
pkgdesc="macOS keyboard remapping for GNOME on Wayland using xremap"
arch=(x86_64)
url="https://github.com/Inled-Pulsar-OS/gnome-macos-remap-wayland"
license=(custom)
depends=(xremap-gnome-bin)
options=(!strip)
install=gnome-macos-remap-wayland.install



prepare() {
    _src="$(cd "$startdir"/../../../gnome-macos-remap-wayland && pwd)"
    cd "$_src"
    mkdir -p "$srcdir"
    cp -r "$_src"/* "$srcdir/" 2>/dev/null || true
    rm -rf "$srcdir/DEBIAN" "$srcdir/prepare-assets.sh" "$srcdir/arch"
    bash prepare-assets.sh "$srcdir"
}

package() {
    _src="$(cd "$startdir"/../../../gnome-macos-remap-wayland && pwd)"
    cd "$_src"
    [ -d usr ] && cp -r usr "$pkgdir/"
    [ -d etc ] && cp -r etc "$pkgdir/"
    if [ -d "$srcdir/staging" ]; then
        cp -r "$srcdir/staging"/* "$pkgdir/"
    elif [ -d "$srcdir/usr" ]; then
        cp -r "$srcdir/usr" "$pkgdir/"
    fi
}
