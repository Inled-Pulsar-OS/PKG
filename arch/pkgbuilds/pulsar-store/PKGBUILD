# Maintainer: Jaime <info@inled.es>
pkgname=pulsar-store
pkgver=2.0.0
pkgrel=1
pkgdesc="Unified App Store and Ecosystem Center for Pulsar OS"
arch=(x86_64 aarch64)
url="https://inled.es"
license=(GPL-3.0-or-later)
depends=(gtk4 libadwaita flatpak polkit xdg-utils)
makedepends=(cargo pkgconf gettext)
optdepends=(
    'gnome-shell: GNOME Shell extensions management'
    'sayri: Sayri AI ecosystem integration'
)
install=pulsar-store.install
# ring (TLS) builds C objects that break under makepkg LTO.
options=(!debug !lto)

_src() { cd "$startdir"/../../../pulsar-store && pwd; }

prepare() {
    cd "$(_src)"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR="$srcdir/target"
    # Download crates once, up front; the build itself then needs no network.
    cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
    cd "$(_src)"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR="$srcdir/target"
    cargo build --release --frozen
}

check() {
    cd "$(_src)"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR="$srcdir/target"
    cargo test --release --frozen
}

package() {
    cd "$(_src)"

    install -Dm755 "$srcdir/target/release/pulsar-store" "$pkgdir/usr/bin/pulsar-store"
    install -Dm755 "$srcdir/target/release/pulsar-storectl" "$pkgdir/usr/bin/pulsar-storectl"
    install -Dm755 "$srcdir/target/release/pulsar-store-updated" "$pkgdir/usr/bin/pulsar-store-updated"

    install -Dm644 assets/catalog/catalog.json "$pkgdir/usr/share/pulsar-store/catalog/catalog.json"

    local _desktop
    for _desktop in assets/desktop/*.desktop; do
        install -Dm644 "$_desktop" "$pkgdir/usr/share/applications/$(basename "$_desktop")"
    done
    install -Dm644 assets/mime/pulsar-store.xml "$pkgdir/usr/share/mime/packages/pulsar-store.xml"

    local _icon
    for _icon in assets/icons/*.svg; do
        install -Dm644 "$_icon" "$pkgdir/usr/share/icons/hicolor/scalable/apps/$(basename "$_icon")"
    done

    install -Dm644 assets/systemd/pulsar-store-updated.service \
        "$pkgdir/usr/lib/systemd/user/pulsar-store-updated.service"

    local _po _lang
    for _po in assets/locale/*.po; do
        [ -e "$_po" ] || continue
        _lang="$(basename "$_po" .po)"
        install -d "$pkgdir/usr/share/locale/$_lang/LC_MESSAGES"
        msgfmt --check -o "$pkgdir/usr/share/locale/$_lang/LC_MESSAGES/pulsar-store.mo" "$_po"
    done
}
