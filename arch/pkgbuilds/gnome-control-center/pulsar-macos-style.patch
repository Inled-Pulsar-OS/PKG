+static void
+on_macos_remap_active_changed_cb (GObject *object, GParamSpec *pspec, CcKeyboardPanel *self)
+{
+  gboolean active = adw_switch_row_get_active (ADW_SWITCH_ROW (object));
+  if (active)
+    {
+      g_spawn_command_line_async ("systemctl --user start gnome-macos-remap-wayland.service", NULL);
+      g_spawn_command_line_async ("systemctl --user enable gnome-macos-remap-wayland.service", NULL);
+    }
+  else
+    {
+      g_spawn_command_line_async ("systemctl --user stop gnome-macos-remap-wayland.service", NULL);
+      g_spawn_command_line_async ("systemctl --user disable gnome-macos-remap-wayland.service", NULL);
+    }
+}
