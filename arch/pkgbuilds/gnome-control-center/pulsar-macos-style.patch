diff --git a/panels/background/cc-background-panel.c b/panels/background/cc-background-panel.c
index 201d2ab..c7dfc9f 100644
--- a/panels/background/cc-background-panel.c
+++ b/panels/background/cc-background-panel.c
@@ -506,6 +506,55 @@ cc_background_panel_finalize (GObject *object)
   G_OBJECT_CLASS (cc_background_panel_parent_class)->finalize (object);
 }
 
+static void
+on_pick_live_wallpaper_clicked_cb (GtkButton *button, CcBackgroundPanel *self)
+{
+  g_spawn_command_line_async ("pulsaros-live-wallpaper set-dialog", NULL);
+}
+
+static void
+on_stop_live_wallpaper_clicked_cb (GtkButton *button, CcBackgroundPanel *self)
+{
+  g_spawn_command_line_async ("pulsaros-live-wallpaper stop", NULL);
+}
+
+static void
+on_apply_cursor_tahoe_clicked_cb (GtkButton *button, CcBackgroundPanel *self)
+{
+  g_settings_set_string (self->interface_settings, "cursor-theme", "Tahoe");
+  g_spawn_command_line_async ("gsettings set org.gnome.desktop.interface cursor-theme 'Tahoe'", NULL);
+}
+
+static void
+on_apply_cursor_adwaita_clicked_cb (GtkButton *button, CcBackgroundPanel *self)
+{
+  g_settings_set_string (self->interface_settings, "cursor-theme", "Adwaita");
+  g_spawn_command_line_async ("gsettings set org.gnome.desktop.interface cursor-theme 'Adwaita'", NULL);
+}
+
+static void
+on_liquid_glass_active_changed_cb (GObject *object, GParamSpec *pspec, CcBackgroundPanel *self)
+{
+  gboolean active = adw_switch_row_get_active (ADW_SWITCH_ROW (object));
+  if (active)
+    g_spawn_command_line_async ("gnome-extensions enable liquid-glass@thinkingcoding1231.gmail.com", NULL);
+  else
+    g_spawn_command_line_async ("gnome-extensions disable liquid-glass@thinkingcoding1231.gmail.com", NULL);
+}
+
+static void
+on_activate_spotlight_python_clicked_cb (GtkButton *button, CcBackgroundPanel *self)
+{
+  g_spawn_command_line_async ("gsettings set org.gnome.mutter overlay-key ''", NULL);
+  g_spawn_command_line_async ("gsettings set org.gnome.shell.extensions.pulsaros-spotlight-launcher launcher-type 'python'", NULL);
+}
+
+static void
+on_activate_gnome_overview_clicked_cb (GtkButton *button, CcBackgroundPanel *self)
+{
+  g_spawn_command_line_async ("gsettings set org.gnome.mutter overlay-key 'Super'", NULL);
+}
+
