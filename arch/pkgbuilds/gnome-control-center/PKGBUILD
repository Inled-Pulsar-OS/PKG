source=(
  "git+https://gitlab.gnome.org/GNOME/gnome-control-center.git#tag=${_upstream_ver:-${pkgver/[a-z]/.&}}"
  "git+https://gitlab.gnome.org/GNOME/libgnome-volume-control.git"
  "git+https://gitlab.gnome.org/GNOME/libgxdp.git#commit=df896e3412b749947bc6f62a91a1aac8e6b6d19b"
  "pulsar-macos-style.patch"
)
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

# Shared macOS-look overlay and patches live beside the Debian package
_src() { cd "$startdir"/../../../pulsaros-control-center && pwd; }

prepare() {
  local _shared; _shared="$(_src)"
  cd "$pkgbase"

  git submodule init
  git submodule set-url subprojects/gvc "$srcdir/libgnome-volume-control"
  git -c protocol.file.allow=always -c protocol.allow=never submodule update

  echo "🎨 Applying Pulsar OS macOS style, PearOS squircle icons, and Live Wallpaper..."
  if [ -d "$_shared/overlay" ]; then
    cp -rf "$_shared/overlay/"* .
  else
    patch -Np1 -i "$srcdir/pulsar-macos-style.patch" || true
  fi

  # Pulsar stylesheet: appended, upstream rules stay untouched
  cat "$_shared/overlay/pulsar.css" >> shell/style.css
  # Per-panel stylesheets live in overlay/css/
  for c in "$_shared"/overlay/css/*.css; do
    [ -e "$c" ] || continue
    cat "$c" >> shell/style.css
  done

  # Panel patches: small hunks applied on top of the overlay
  for p in "$_shared"/patches/*.patch; do
    [ -e "$p" ] || continue
    patch -Np1 -i "$p"
  done

  if [ -f "po/pulsar-es.po" ] && [ -f "po/es.po" ]; then
    msgcat --use-first po/pulsar-es.po po/es.po > po/es.po.merged && mv po/es.po.merged po/es.po
  fi
}

build() {
  local meson_options=(
    -D documentation=false
    -D location-services=enabled
    -D malcontent=true
    -D distributor_logo=/usr/share/pixmaps/pulsaros-logo-text.svg
    -D dark_mode_distributor_logo=/usr/share/pixmaps/pulsaros-logo-text.svg
  )

  export MESON_PACKAGE_CACHE_DIR="$srcdir"

  arch-meson $pkgbase build "${meson_options[@]}"
  meson compile -C build
}

_pick() {
  local p="$1" f d; shift
  for f; do
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -p "$(dirname "$d")"
    mv "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

package_gnome-control-center() {
  provides=("gnome-control-center=$pkgver")
  conflicts=("gnome-control-center")
  depends+=(gnome-keybindings)
  groups=(gnome)

  meson install -C build --destdir "$pkgdir"

  cd "$pkgdir"
  _pick gkb usr/share/gettext/its/gnome-keybindings.*
  _pick gkb usr/share/gnome-control-center/keybindings
  _pick gkb usr/share/pkgconfig/gnome-keybindings.pc
}

package_gnome-keybindings() {
  pkgdesc="Keybindings configuration for GNOME applications"
  provides=("gnome-keybindings=$pkgver")
  conflicts=("gnome-keybindings")
  depends=()

  mv gkb/* "$pkgdir"
}
