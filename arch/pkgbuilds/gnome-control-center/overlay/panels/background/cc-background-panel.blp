using Gtk 4.0;
using Adw 1;

template $CcBackgroundPanel: $CcPanel {
  child: Adw.BreakpointBin {
    width-request: 346;
    height-request: 200;

    Adw.Breakpoint {
      condition ("max-width: 420px")

      setters {
        accent_box.spacing: 6;
        accent_box.margin-top: 6;
        accent_box.margin-bottom: 6;
      }
    }

    child: Adw.ToolbarView {
      [top]
      Adw.HeaderBar {}

      content: Adw.ToastOverlay toast_overlay {
        child: Adw.PreferencesPage {
          Adw.PreferencesGroup {
            title: _("Appearance");

            Adw.PreferencesRow {
              accessible-role: group;
              activatable: false;
              focusable: false;

              Adw.Clamp {
                maximum-size: 440;
                tightening-threshold: 320;

                Grid {
                  column-homogeneous: true;
                  column-spacing: 24;
                  row-spacing: 12;
                  margin-start: 12;
                  margin-end: 12;
                  margin-top: 18;
                  margin-bottom: 12;
                  hexpand: true;

                  ToggleButton default_toggle {
                    accessibility {
                      labelled-by: [
                        default_label,
                      ];
                    }

                    notify::active => $on_color_scheme_toggle_active_cb(template);

                    $CcBackgroundPreview default_preview {}

                    styles [
                      "background-preview-button",
                    ]

                    layout {
                      column: 0;
                      row: 0;
                    }
                  }

                  Label default_label {
                    label: _("Light");
                    mnemonic-widget: default_toggle;

                    layout {
                      column: 0;
                      row: 1;
                    }
                  }

                  ToggleButton dark_toggle {
                    group: default_toggle;

                    accessibility {
                      labelled-by: [
                        dark_label,
                      ];
                    }

                    notify::active => $on_color_scheme_toggle_active_cb(template);

                    $CcBackgroundPreview dark_preview {
                      is-dark: true;
                    }

                    styles [
                      "background-preview-button",
                    ]

                    layout {
                      column: 1;
                      row: 0;
                    }
                  }

                  Label dark_label {
                    label: _("Dark");
                    mnemonic-widget: dark_toggle;

                    layout {
                      column: 1;
                      row: 1;
                    }
                  }
                }
              }
            }
          }

          Adw.PreferencesGroup {
            title: _("Liquid Glass");
            description: _("Choose your preferred look for Liquid Glass.");

            Adw.SwitchRow liquid_glass_switch_row {
              title: _("Liquid Glass Effect");
              subtitle: _("Aplica desenfoques translúcidos y bordes reflectantes a las ventanas activas estilo macOS");
              active: true;
              notify::active => $on_liquid_glass_active_changed_cb(template);
            }
          }

          Adw.PreferencesGroup {
            title: _("Theme");

            Adw.ActionRow {
              title: _("Color");
              subtitle: _("Color de acento del sistema");

              [suffix]
              Box accent_box {
                spacing: 8;
                margin-top: 8;
                margin-bottom: 8;
                halign: end;
                valign: center;
              }
            }
          }

          Adw.PreferencesGroup {
            title: _("Wallpaper &amp; Live Wallpaper");
            description: _("Fondos estáticos o vídeos y animaciones (.mp4, .webm, .gif, .webp) sincronizados con Escritorio, SDDM y Bloqueo");

            header-suffix: Button {
              Adw.ButtonContent {
                icon-name: "list-add-symbolic";
                label: _("_Add Picture…");
                use-underline: true;
              }

              clicked => $on_add_picture_button_clicked_cb(template);

              styles [
                "flat",
              ]
            };

            Adw.ActionRow {
              title: _("Seleccionar Fondo Animado o Vídeo");
              subtitle: _("Gestionado con el motor nativo Pulsar OS Live Wallpaper");

              [suffix]
              Button {
                valign: center;
                label: _("Elegir Vídeo…");
                clicked => $on_pick_live_wallpaper_clicked_cb(template);
                styles [
                  "suggested-action",
                ]
              }

              [suffix]
              Button {
                valign: center;
                label: _("Desactivar");
                clicked => $on_stop_live_wallpaper_clicked_cb(template);
                styles [
                  "destructive-action",
                ]
              }
            }

            Adw.Bin {
              styles [
                "card",
              ]
              accessibility {
                label: _("Background");
              }
              accessible-role: group;

              $CcBackgroundChooser background_chooser {
                hexpand: true;
                toast-overlay: toast_overlay;
                background-chosen => $on_chooser_background_chosen_cb(template);
              }
            }
          }

          Adw.PreferencesGroup {
            title: _("Spotlight &amp; App Launcher");
            description: _("Experiencia de búsqueda al presionar Cmd+Espacio");

            Adw.ActionRow {
              title: _("Spotlight macOS (Python)");
              subtitle: _("Buscador flotante estilo macOS Tahoe");

              [suffix]
              Button {
                valign: center;
                label: _("Activar");
                clicked => $on_activate_spotlight_python_clicked_cb(template);
                styles [
                  "suggested-action",
                ]
              }
            }

            Adw.ActionRow {
              title: _("Vista de Actividades de GNOME (Overview &amp; Apps Grid)");
              subtitle: _("Pantalla general nativa y cuadrícula de aplicaciones");

              [suffix]
              Button {
                valign: center;
                label: _("Activar");
                clicked => $on_activate_gnome_overview_clicked_cb(template);
              }
            }
          }

          Adw.PreferencesGroup {
            title: _("Mouse &amp; Trackpad Cursors");
            description: _("Punteros del ratón y estilo visual");

            Adw.ActionRow {
              title: _("Punteros macOS Tahoe / Cupertino");
              subtitle: _("Estilo oficial de Pulsar OS con sombras dinámicas");

              [suffix]
              Button {
                valign: center;
                label: _("Aplicar Tahoe");
                clicked => $on_apply_cursor_tahoe_clicked_cb(template);
              }
            }

            Adw.ActionRow {
              title: _("Punteros Adwaita Estándar");
              subtitle: _("Cursores clásicos de GNOME");

              [suffix]
              Button {
                valign: center;
                label: _("Aplicar Adwaita");
                clicked => $on_apply_cursor_adwaita_clicked_cb(template);
              }
            }
          }
        };
      };
    };
  };
}
