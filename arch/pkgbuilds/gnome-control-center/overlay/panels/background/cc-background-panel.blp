using Gtk 4.0;
using Adw 1;

template $CcBackgroundPanel: $CcPanel {
  child: Adw.BreakpointBin {
    width-request: 346;
    height-request: 200;

    Adw.Breakpoint {
      condition ("max-width: 420px")

      setters {
        accent_box.spacing: 6;
        accent_box.margin-top: 6;
        accent_box.margin-bottom: 6;
      }
    }

    child: Adw.ToolbarView {
      [top]
      Adw.HeaderBar {}

      content: Adw.ToastOverlay toast_overlay {
        child: Adw.PreferencesPage {
          Adw.PreferencesGroup {
            title: _("Appearance");

            Adw.PreferencesRow {
              accessible-role: group;
              activatable: false;
              focusable: false;

              Adw.Clamp {
                maximum-size: 440;
                tightening-threshold: 320;

                Grid {
                  column-homogeneous: true;
                  column-spacing: 24;
                  row-spacing: 12;
                  margin-start: 12;
                  margin-end: 12;
                  margin-top: 18;
                  margin-bottom: 12;
                  hexpand: true;

                  ToggleButton default_toggle {
                    accessibility {
                      labelled-by: [
                        default_label,
                      ];
                    }

                    notify::active => $on_color_scheme_toggle_active_cb(template);

                    $CcBackgroundPreview default_preview {}

                    styles [
                      "background-preview-button",
                    ]

                    layout {
                      column: 0;
                      row: 0;
                    }
                  }

                  Label default_label {
                    label: _("Light");
                    mnemonic-widget: default_toggle;

                    layout {
                      column: 0;
                      row: 1;
                    }
                  }

                  ToggleButton dark_toggle {
                    group: default_toggle;

                    accessibility {
                      labelled-by: [
                        dark_label,
                      ];
                    }

                    notify::active => $on_color_scheme_toggle_active_cb(template);

                    $CcBackgroundPreview dark_preview {
                      is-dark: true;
                    }

                    styles [
                      "background-preview-button",
                    ]

                    layout {
                      column: 1;
                      row: 0;
                    }
                  }

                  Label dark_label {
                    label: _("Dark");
                    mnemonic-widget: dark_toggle;

                    layout {
                      column: 1;
                      row: 1;
                    }
                  }
                }
              }
            }
          }

          Adw.PreferencesGroup {
            title: _("Liquid Glass");
            description: _("Choose your preferred look for Liquid Glass.");

            Adw.SwitchRow liquid_glass_switch_row {
              title: _("Liquid Glass Effect");
              subtitle: _("Apply translucent blurs and reflective borders to active windows in macOS style");
              active: true;
              notify::active => $on_liquid_glass_active_changed_cb(template);
            }
          }

          Adw.PreferencesGroup {
            title: _("Theme");

            Adw.ActionRow {
              title: _("Accent Color");
              subtitle: _("System-wide accent color");

              [suffix]
              Box accent_box {
                spacing: 8;
                margin-top: 8;
                margin-bottom: 8;
                halign: end;
                valign: center;
              }
            }
          }

          Adw.PreferencesGroup {
            title: _("Wallpaper &amp; Live Wallpaper");
            description: _("Static wallpapers or animated videos (.mp4, .webm, .gif, .webp) synchronized across Desktop, SDDM, and Lockscreen");

            header-suffix: Button {
              Adw.ButtonContent {
                icon-name: "list-add-symbolic";
                label: _("_Add Picture…");
                use-underline: true;
              }

              clicked => $on_add_picture_button_clicked_cb(template);

              styles [
                "flat",
              ]
            };

            Adw.ActionRow {
              title: _("Select Animated Wallpaper or Video");
              subtitle: _("Managed with native Pulsar OS Live Wallpaper engine");

              [suffix]
              Button {
                valign: center;
                label: _("Choose Video…");
                clicked => $on_pick_live_wallpaper_clicked_cb(template);
                styles [
                  "suggested-action",
                ]
              }

              [suffix]
              Button {
                valign: center;
                label: _("Stop");
                clicked => $on_stop_live_wallpaper_clicked_cb(template);
                styles [
                  "destructive-action",
                ]
              }
            }

            Adw.Bin {
              styles [
                "card",
              ]
              accessibility {
                label: _("Background");
              }
              accessible-role: group;

              $CcBackgroundChooser background_chooser {
                hexpand: true;
                toast-overlay: toast_overlay;
                background-chosen => $on_chooser_background_chosen_cb(template);
              }
            }
          }

          Adw.PreferencesGroup {
            title: _("Spotlight &amp; App Launcher");
            description: _("Search and launcher experience when pressing Cmd+Space");

            Adw.ActionRow {
              title: _("macOS Spotlight (Python)");
              subtitle: _("Floating search bar with macOS Tahoe design");

              [suffix]
              Button {
                valign: center;
                label: _("Enable");
                clicked => $on_activate_spotlight_python_clicked_cb(template);
                styles [
                  "suggested-action",
                ]
              }
            }

            Adw.ActionRow {
              title: _("GNOME Overview &amp; Apps Grid");
              subtitle: _("Native GNOME activities overview and application grid");

              [suffix]
              Button {
                valign: center;
                label: _("Enable");
                clicked => $on_activate_gnome_overview_clicked_cb(template);
              }
            }
          }

          Adw.PreferencesGroup {
            title: _("macOS Layout &amp; Keyboard Remap");
            description: _("Swap physical Control and Command/Super keys for standard macOS shortcuts (Cmd+C, Cmd+V, Cmd+W)");

            Adw.SwitchRow macos_remap_switch_row {
              title: _("macOS Keyboard Remap (Cmd as Ctrl)");
              subtitle: _("Allows using the Command/Super key for standard macOS shortcuts (Cmd+C, Cmd+V, Cmd+W) system-wide");
              active: false;
              notify::active => $on_macos_remap_active_changed_cb(template);
            }
          }

          Adw.PreferencesGroup {
            title: _("macOS-style Windows & Fullscreen");
            description: _("Smart workspace and top bar behavior when maximizing windows");

            Adw.SwitchRow macos_fullscreen_switch_row {
              title: _("macOS Fullscreen Spaces");
              subtitle: _("Moving maximized apps to dedicated workspaces and auto-hiding the top bar");
              active: false;
              notify::active => $on_macos_fullscreen_active_changed_cb(template);
            }
          }

          Adw.PreferencesGroup {
            title: _("Mouse &amp; Trackpad Cursors");
            description: _("Cursor themes and visual styles");

            Adw.ActionRow {
              title: _("macOS Tahoe / Cupertino Cursors");
              subtitle: _("Official Pulsar OS style with dynamic drop shadows");

              [suffix]
              Button {
                valign: center;
                label: _("Apply Tahoe");
                clicked => $on_apply_cursor_tahoe_clicked_cb(template);
              }
            }

            Adw.ActionRow {
              title: _("Standard Adwaita Cursors");
              subtitle: _("Classic GNOME cursor theme");

              [suffix]
              Button {
                valign: center;
                label: _("Apply Adwaita");
                clicked => $on_apply_cursor_adwaita_clicked_cb(template);
              }
            }
          }
        };
      };
    };
  };
}
