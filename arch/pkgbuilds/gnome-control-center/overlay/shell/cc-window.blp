using Gtk 4.0;
using Adw 1;

template $CcWindow: Adw.ApplicationWindow {
  default-width: 980;
  default-height: 640;

  Adw.Breakpoint break_point {
    condition ("max-width: 550sp")

    setters {
      split_view.collapsed: true;
      content_header.decoration-layout: ":close";
    }
  }

  content: Adw.NavigationSplitView split_view {
    min-sidebar-width: 270;
    max-sidebar-width: 270;
    notify::collapsed => $on_split_view_collapsed_changed_cb(template);

    sidebar: Adw.NavigationPage {
      title: _("Settings");

      child: Adw.ToolbarView {
        styles [
          "cc-sidebar-pane",
        ]

        [top]
        Adw.HeaderBar {
          show-title: false;
          decoration-layout: "close,minimize,maximize:";
        }

        [top]
        SearchEntry search_entry {
          styles [
            "pulsar-search-pill",
          ]
          hexpand: true;
          margin-start: 12;
          margin-end: 12;
          margin-top: 6;
          margin-bottom: 6;
          placeholder-text: _("Search");
          activate => $search_entry_activate_cb(template);

          EventControllerKey {
            key-pressed => $search_entry_key_pressed_cb(template);
          }
        }

        [top]
        Button user_account_banner {
          styles [
            "flat",
            "pulsar-profile-row",
          ]
          margin-start: 8;
          margin-end: 8;
          margin-top: 6;
          margin-bottom: 6;
          clicked => $on_user_account_banner_clicked_cb(template);

          child: Box {
            orientation: horizontal;
            spacing: 12;
            margin-start: 6;
            margin-end: 6;
            margin-top: 4;
            margin-bottom: 4;

            Adw.Avatar user_avatar {
              size: 40;
              text: "Pulsar OS";
              show-initials: true;
            }

            Box {
              orientation: vertical;
              valign: center;
              spacing: 2;

              Label user_name_label {
                label: _("User");
                halign: start;
                styles [
                  "heading",
                ]
              }

              Label user_email_label {
                label: _("Local Account");
                halign: start;
                styles [
                  "caption",
                  "dim-label",
                ]
              }
            }
          };
        }

        content: ScrolledWindow {
          hscrollbar-policy: never;

          $CcPanelList panel_list {
            search-query: bind search_entry.text no-sync-create;
            show-panel => $show_panel_cb(template);
          }
        };
      };
    };

    content: Adw.NavigationPage {
      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar content_header {
          decoration-layout: ":";

          [start]
          Box {
            visible: bind split_view.collapsed inverted;
            valign: center;
            styles [
              "linked",
              "pulsar-nav-capsule",
            ]

            Button back_button {
              icon-name: "go-previous-symbolic";
              tooltip-text: _("Back");
              sensitive: false;
              clicked => $on_back_button_clicked_cb(template);
              styles [
                "flat",
              ]
            }

            Button forward_button {
              icon-name: "go-next-symbolic";
              tooltip-text: _("Forward");
              sensitive: false;
              clicked => $on_forward_button_clicked_cb(template);
              styles [
                "flat",
              ]
            }
          }

          [end]
          MenuButton {
            icon-name: "open-menu-symbolic";
            menu-model: primary_menu;
            primary: true;
            tooltip-text: _("Main Menu");
          }
        }

        content: Adw.NavigationView navigation {
        };
      };
    };
  };
}

menu primary_menu {
  section {
    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_Help");
      action: "app.help";
    }

    item {
      label: _("_About Settings");
      action: "app.about";
    }
  }
}
