# Maintainer: Jaime <info@inled.es>
pkgname=pulsaros-meta
pkgver=1.0.5
pkgrel=1
pkgdesc="Metapackage that pulls in every Pulsar OS package (delivers newly added packages to existing installations)"
arch=(any)
url="https://inled.es"
license=(custom)
depends=(
  gnome-keybindings
  gnome-macos-remap-wayland
  pulsar-pear-sound-theme
  pulsaros-boot-icons
  pulsaros-bootsound
  pulsaros-branding
  pulsaros-circle-to-search
  pulsaros-emoji-fonts
  pulsaros-global-menu
  pulsaros-gnome
  pulsaros-hibernate
  pulsaros-live-wallpaper
  pulsaros-plymouth
  pulsaros-recovery
  pulsaros-sddm
  pulsaros-spotlight-launcher
  pulsaros-theme
  pulsaros-timemachine
  pulsaros-update
  pulsaros-welcome
  sayri
)
optdepends=(
  'droidtux: Android integration and syncing'
  'macboat: macOS in Docker container'
  'appinstall: Application installer'
  'seafari: Safari-like web browser'
  'winboat-bin: Windows app compatibility runner'
)
options=(!strip)

package() {
    # Metapackage: no files, only dependency resolution
    mkdir -p "$pkgdir/usr/share/doc/pulsaros-meta"
    echo "Pulsar OS metapackage. Bump pkgver when adding new depends." \
        > "$pkgdir/usr/share/doc/pulsaros-meta/README"
}
