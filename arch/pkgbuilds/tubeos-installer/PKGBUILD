# Maintainer: Pulsar OS Team <team@pulsaros.io>
pkgname=tubeos-installer
pkgver=0.1.0
pkgrel=1
pkgdesc="Tube OS Web Installer - headless installation via browser"
arch=('x86_64' 'any')
url="https://github.com/Inled-Pulsar-OS"
license=('Apache-2.0')
depends=('python' 'python-fastapi' 'python-uvicorn' 'python-qrcode' 'parted' 'rsync')
source=()
sha256sums=('SKIP')

package() {
  # Package content is copied from the PKG source tree during build
  cd "$startdir"
  if [ -d "../../tubeos-installer/usr" ]; then
    cp -r "../../tubeos-installer/usr" "$pkgdir/"
  fi
  if [ -d "../../tubeos-installer/DEBIAN" ]; then
    # Convert Debian postinst to Arch .install if needed
    true
  fi
}
