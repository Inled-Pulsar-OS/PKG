# Maintainer: Jaime <info@inled.es>
pkgname=pulsaros-recovery
pkgver=1.0.138
pkgrel=1
pkgdesc="Recovery utilities UI for Pulsar OS (Arch edition, macOS-style disk selector and Btrfs recovery)"
arch=(any)
url="https://inled.es"
license=(custom)
depends=(python-gobject python-dbus gtk4 libadwaita python-xlib parted psmisc pulsaros-timemachine restic rclone cifs-utils smbclient gparted gptfdisk rsync dosfstools e2fsprogs grub btrfs-progs squashfs-tools curl)
makedepends=(cargo)
options=(!strip)
install=pulsaros-recovery.install

build() {
    _src="$(cd "$startdir"/../../../pulsaros-recovery && pwd)"
    if [ -d "$_src/rust-recovery" ]; then
        cd "$_src/rust-recovery"
        cargo build --release
    fi
}

package() {
    _src="$(cd "$startdir"/../../../pulsaros-recovery && pwd)"
    cd "$_src"
    [ -d usr ] && cp -r usr "$pkgdir/"
    [ -d etc ] && cp -r etc "$pkgdir/"
    if [ -d "$srcdir/staging" ]; then
        cp -r "$srcdir/staging"/* "$pkgdir/"
    elif [ -d "$srcdir/usr" ]; then
        cp -r "$srcdir/usr" "$pkgdir/"
    fi
    if [ -f "$_src/rust-recovery/target/release/pulsar-recovery-assistant" ]; then
        install -Dm755 "$_src/rust-recovery/target/release/pulsar-recovery-assistant" "$pkgdir/usr/bin/pulsar-recovery-assistant"
    fi
    # Remove Debian-specific __pycache__
    rm -rf "$pkgdir/usr/share/pulsaros-recovery/__pycache__"
}

