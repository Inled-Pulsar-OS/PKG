# Maintainer: Jaime <info@inled.es>
pkgname=pulsaros-recovery
pkgver=2.0.0
pkgrel=1
pkgdesc="Recovery utilities UI for Pulsar OS (MacOS-style disk selector and Btrfs recovery)"
arch=(x86_64)
url="https://inled.es"
license=(custom)
depends=(
  webkit2gtk-4.1
  gtk3
  openssl
  curl
  librsvg
  libappindicator-gtk3
  appmenu-gtk-module
  xdotool
  btrfs-progs
  squashfs-tools
  rsync
  gparted
  gptfdisk
  dosfstools
  e2fsprogs
  grub
  parted
  psmisc
  deja-dup
  timeshift
)
makedepends=(
  cargo
  rust
  nodejs
  pnpm
)
options=(!strip)
install=pulsaros-recovery.install

source=()

sha256sums=()

build() {
  _src="$(cd "$startdir"/../../../pulsaros-recovery/tauri && pwd)"
  cd "$_src"
  pnpm install --frozen-lockfile
  pnpm tauri build
}

package() {
  _src="$(cd "$startdir"/../../../pulsaros-recovery && pwd)"

  # Tauri binary
  install -Dm755 "$_src/tauri/src-tauri/target/release/pulsaros-recovery" "$pkgdir/usr/bin/pulsaros-recovery"

  # Desktop cleanup script (GNOME autostart)
  install -Dm755 "$_src/usr/bin/pulsaros-recovery-desktop-setup" "$pkgdir/usr/bin/pulsaros-recovery-desktop-setup"

  # Desktop launcher
  install -Dm644 "$_src/usr/share/applications/pulsaros-recovery.desktop" "$pkgdir/usr/share/applications/pulsaros-recovery.desktop"

  # Autostart entry
  install -Dm644 "$_src/etc/xdg/autostart/pulsaros-recovery-desktop-setup.desktop" "$pkgdir/etc/xdg/autostart/pulsaros-recovery-desktop-setup.desktop"
}
