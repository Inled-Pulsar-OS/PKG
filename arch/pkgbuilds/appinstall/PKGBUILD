# Maintainer: Jaime <info@inled.es>
pkgname=appinstall
pkgver=21.15
pkgrel=1
pkgdesc="Simple package and application installer for Linux"
arch=(any)
url="https://inled.es"
license=(GPL3)
depends=(python python-gobject gtk4 libadwaita python-requests python-packaging polkit)
options=(!strip)

build() {
    _src="$(cd "$startdir"/../../../../appinstall 2>/dev/null || cd "$startdir"/../../../appinstall 2>/dev/null && pwd)"
    cd "$_src"
    if [ -f compile_locales.py ]; then
        python3 compile_locales.py
    fi
}

package() {
    _src="$(cd "$startdir"/../../../../appinstall 2>/dev/null || cd "$startdir"/../../../appinstall 2>/dev/null && pwd)"
    cd "$_src"

    mkdir -p "$pkgdir/usr"
    cp -r appinstall/usr/* "$pkgdir/usr/"
    if [ -d appinstall/etc ]; then
        mkdir -p "$pkgdir/etc"
        cp -r appinstall/etc/* "$pkgdir/etc/"
    fi

    chmod -R a+rX "$pkgdir/usr"
    find "$pkgdir/usr" -type d -exec chmod 755 {} +
    [ -d "$pkgdir/usr/bin" ] && chmod 755 "$pkgdir"/usr/bin/* 2>/dev/null || true
}
