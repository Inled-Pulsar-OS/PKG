# Maintainer: Jaime <info@inled.es>
pkgname=appinstall
pkgver=22.20
pkgrel=1
pkgdesc="Simple package and application installer for Linux"
arch=(any)
url="https://inled.es"
license=(GPL3)
depends=(python python-gobject gtk4 libadwaita python-requests python-packaging polkit)
options=(!strip)

build() {
    _src=""
    for _cand in "${startdir:-$PWD}/../../../../appinstall" "${startdir:-$PWD}/../../../appinstall"; do
        if [ -d "$_cand" ]; then
            _src="$(cd "$_cand" && pwd)"
            break
        fi
    done
    if [ -z "$_src" ] || [ ! -d "$_src" ]; then
        if [ ! -d "$srcdir/appinstall-repo" ]; then
            git clone --depth 1 https://github.com/InledGroup/appinstall.git "$srcdir/appinstall-repo"
        fi
        _src="$srcdir/appinstall-repo"
    fi
    cd "$_src"
    if [ -f compile_locales.py ]; then
        python3 compile_locales.py
    fi
}

package() {
    _src=""
    for _cand in "${startdir:-$PWD}/../../../../appinstall" "${startdir:-$PWD}/../../../appinstall"; do
        if [ -d "$_cand" ]; then
            _src="$(cd "$_cand" && pwd)"
            break
        fi
    done
    if [ -z "$_src" ] || [ ! -d "$_src" ]; then
        _src="$srcdir/appinstall-repo"
    fi
    cd "$_src"

    mkdir -p "$pkgdir/usr"
    cp -r appinstall/usr/* "$pkgdir/usr/"
    if [ -d appinstall/etc ]; then
        mkdir -p "$pkgdir/etc"
        cp -r appinstall/etc/* "$pkgdir/etc/"
    fi

    chmod -R a+rX "$pkgdir/usr"
    find "$pkgdir/usr" -type d -exec chmod 755 {} +
    [ -d "$pkgdir/usr/bin" ] && chmod 755 "$pkgdir"/usr/bin/* 2>/dev/null || true
}
