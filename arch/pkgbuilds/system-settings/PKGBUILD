# Maintainer: Jaime <info@inled.es>
pkgname=system-settings
pkgver=0.1.0
pkgrel=7
pkgdesc="macOS-style System Settings for Pulsar OS"
arch=('x86_64')
url="https://github.com/skjsbsnq/Forma"
license=('GPL-3.0-only')
depends=('glibc' 'gcc-libs' 'sdl3' 'freetype2' 'fontconfig' 'dbus' 'hicolor-icon-theme' 'glib2' 'gdk-pixbuf2' 'gsettings-desktop-schemas')
optdepends=('vulkan-icd-loader: Vulkan renderer (OpenGL otherwise)'
            'zenity: fallback file dialogs'
            'networkmanager: network configuration'
            'bluez: Bluetooth'
            'libpulse: sound controls (pactl)'
            'upower: battery information'
            'power-profiles-daemon: power modes'
            'accountsservice: user accounts')
provides=('gnome-control-center' 'mayo-system-settings-git')
conflicts=('gnome-control-center' 'mayo-system-settings-git' 'forma-settings')
replaces=('forma-settings')
options=('!strip')

prepare() {
    _src="$(cd "$startdir"/../../../system-settings && pwd)"
    mkdir -p "$srcdir/staging"
    bash "$_src/prepare-assets.sh" "$srcdir/staging"
}

package() {
    if [ -d "$srcdir/staging" ]; then
        cp -r "$srcdir/staging"/* "$pkgdir/"
    fi
}
