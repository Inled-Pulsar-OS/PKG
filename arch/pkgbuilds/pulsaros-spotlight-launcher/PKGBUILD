# Maintainer: Jaime <info@inled.es>
pkgname=pulsaros-spotlight-launcher
pkgver=2.0.0
pkgrel=6
pkgdesc="Spotlight search for Pulsar OS"
arch=(any)
url="https://inled.es"
license=(GPL3)
depends=(gtk4 libadwaita tinysparql localsearch ydotool wl-clipboard)
makedepends=(cargo)
provides=(spotlight-gtk spotlight-python)
conflicts=(spotlight-gtk spotlight-python)
replaces=(spotlight-gtk spotlight-python)
options=(!strip)

build() {
    _src="$(cd "$startdir"/../../../pulsaros-spotlight-launcher && pwd)"
    cd "$_src"
    if [ ! -f target/release/pulsaros-spotlight ] || [ src/main.rs -nt target/release/pulsaros-spotlight ]; then
        cargo build --release
    fi
}

package() {
    _src="$(cd "$startdir"/../../../pulsaros-spotlight-launcher && pwd)"
    cd "$_src"

    # Native Rust binary as the main launcher
    install -Dm755 target/release/pulsaros-spotlight "$pkgdir/usr/bin/pulsaros-spotlight"

    # Helper CLI scripts
    install -Dm755 cli/pulsaros-toggle-remap "$pkgdir/usr/bin/pulsaros-toggle-remap"
    install -Dm755 cli/pulsaros-toggle-launcher "$pkgdir/usr/bin/pulsaros-toggle-launcher"

    # Style and icons
    install -Dm644 data/base.css "$pkgdir/usr/share/pulsaros-spotlight/base.css"
    install -Dm644 data/dark.css "$pkgdir/usr/share/pulsaros-spotlight/dark.css"
    install -Dm644 data/light.css "$pkgdir/usr/share/pulsaros-spotlight/light.css"
    install -Dm644 data/index.css "$pkgdir/usr/share/pulsaros-spotlight/index.css"
    mkdir -p "$pkgdir/usr/share/pulsaros-spotlight/icons"
    cp -r data/icons/* "$pkgdir/usr/share/pulsaros-spotlight/icons/" 2>/dev/null || true

    install -Dm644 data/icons/pulsaros-spotlight.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/pulsaros-spotlight.svg" 2>/dev/null || true
    install -Dm644 data/icons/spotlight-symbolic.svg "$pkgdir/usr/share/icons/hicolor/symbolic/apps/spotlight-symbolic.svg" 2>/dev/null || true

    # Desktop file
    install -Dm644 data/pulsaros-spotlight.desktop "$pkgdir/usr/share/applications/pulsaros-spotlight.desktop"

    # GNOME Shell extension
    mkdir -p "$pkgdir/usr/share/gnome-shell/extensions/pulsaros-spotlight-launcher@inled.es"
    cp -r gnome-shell-extension/* "$pkgdir/usr/share/gnome-shell/extensions/pulsaros-spotlight-launcher@inled.es/"
}
