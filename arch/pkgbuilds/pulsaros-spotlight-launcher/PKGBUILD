# Maintainer: Jaime <info@inled.es>
pkgname=pulsaros-spotlight-launcher
pkgver=1.0.120
pkgrel=3
pkgdesc="GNOME Shell extension: macOS Spotlight-like search launcher for Pulsar OS"
arch=(any)
url="https://inled.es"
license=(custom)
depends=(gnome-shell spotlight-gtk)
options=(!strip)
install=pulsaros-spotlight-launcher.install

package() {
    _src="$(cd "$startdir"/../../../pulsaros-spotlight-launcher && pwd)"
    cd "$_src"
    [ -d usr ] && cp -r usr "$pkgdir/"
    [ -d etc ] && cp -r etc "$pkgdir/"
    if [ -d "$srcdir/staging" ]; then
        cp -r "$srcdir/staging"/* "$pkgdir/"
    elif [ -d "$srcdir/usr" ]; then
        cp -r "$srcdir/usr" "$pkgdir/"
    fi
}
