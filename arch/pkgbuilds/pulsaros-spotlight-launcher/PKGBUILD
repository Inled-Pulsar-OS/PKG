# Maintainer: Jaime <info@inled.es>
pkgname=pulsaros-spotlight-launcher
pkgver=2.0.34
pkgrel=5
pkgdesc="Spotlight search for Pulsar OS"
arch=(x86_64 aarch64)
url="https://inled.es"
license=(GPL-3.0-or-later)
depends=(gtk4 libadwaita glib2 sqlite json-glib curl tinysparql localsearch wl-clipboard gnome-shell)
makedepends=(cargo pkgconf)
optdepends=(
    'ydotool: paste fallback when the Shell extension is unavailable'
    'poppler: PDF thumbnails (pdftoppm)'
    'ffmpeg: video thumbnails'
    'libnotify: failure notifications (notify-send)'
    'xdg-utils: open quicklinks and URLs (xdg-open)'
    'networkmanager: Wi-Fi commands (nmcli)'
    'wireplumber: volume commands (wpctl)'
    'playerctl: media commands'
)
options=(!debug)
provides=(pulsaros-spotlight spotlight-gtk spotlight-python)
conflicts=(pulsaros-spotlight spotlight-gtk spotlight-python)
replaces=(spotlight-gtk spotlight-python)

_src() { cd "$startdir"/../../../pulsaros-spotlight-launcher && pwd; }

build() {
    cd "$(_src)"
    export CARGO_TARGET_DIR="$srcdir/target"
    cargo build --release --locked
}

check() {
    cd "$(_src)"
    export CARGO_TARGET_DIR="$srcdir/target"
    # thumb_generates_scaled_from_real_image needs a wallpaper that only exists on Pulsar OS
    cargo test --release --locked -- --skip thumb_generates_scaled_from_real_image
}

package() {
    cd "$(_src)"

    install -Dm755 "$srcdir/target/release/pulsaros-spotlight" "$pkgdir/usr/bin/pulsaros-spotlight"

    install -Dm755 cli/pulsaros-toggle-remap "$pkgdir/usr/bin/pulsaros-toggle-remap"
    install -Dm755 cli/pulsaros-toggle-launcher "$pkgdir/usr/bin/pulsaros-toggle-launcher"

    local _css
    for _css in base dark light liquid-glass index; do
        install -Dm644 "data/$_css.css" "$pkgdir/usr/share/pulsaros-spotlight/$_css.css"
    done
    install -d "$pkgdir/usr/share/pulsaros-spotlight/icons"
    cp -r data/icons/. "$pkgdir/usr/share/pulsaros-spotlight/icons/"

    install -Dm644 data/icons/pulsaros-spotlight.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/pulsaros-spotlight.svg"
    install -Dm644 data/icons/spotlight-symbolic.svg \
        "$pkgdir/usr/share/icons/hicolor/symbolic/apps/spotlight-symbolic.svg"

    install -Dm644 data/pulsaros-spotlight.desktop \
        "$pkgdir/usr/share/applications/pulsaros-spotlight.desktop"

    local _ext="$pkgdir/usr/share/gnome-shell/extensions/pulsaros-spotlight-launcher@inled.es"
    install -d "$_ext"
    cp -r gnome-shell-extension/. "$_ext/"
}
