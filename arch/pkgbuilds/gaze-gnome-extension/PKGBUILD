# Maintainer: Jaime <info@inled.es>
pkgname=gaze-gnome-extension
pkgver=0.3.10
# Versión upstream real del asset publicado por GunduLabs. Se separa de
# pkgver para que el CI pueda reescribir pkgver (p.ej. 0.3.10.unstable) sin
# romper la URL de descarga (daba 404 en el deploy de unstable).
_upstream_ver=0.3.10
pkgrel=1
pkgdesc="GNOME Shell extension for Gaze face authentication"
arch=(x86_64)
url="https://gaze.gundulabs.com"
license=('GPL-3.0-or-later')
depends=('gnome-shell')
backup=('etc/dconf/db/gdm.d/00-gaze-defaults' 'etc/pam.d/gdm-face')
install=gaze-gnome-extension.install
options=(!strip !debug)
source=("https://github.com/GunduLabs/gaze/releases/download/v${_upstream_ver}/gaze-gnome-extension-${_upstream_ver}-1-x86_64.pkg.tar.zst")
sha256sums=('SKIP')

package() {
    cp -r etc usr "$pkgdir/"
}
