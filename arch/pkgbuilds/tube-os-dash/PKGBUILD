# Maintainer: Pulsar OS Team <team@pulsaros.io>
pkgname=tube-os-dash
pkgver=0.4.18
pkgrel=1
pkgdesc="Tube OS Dashboard - Web-based NAS management dashboard (CasaOS Suite)"
arch=('x86_64')
url="https://github.com/Inled-Pulsar-OS/CasaOS"
license=('Apache-2.0')
depends=('docker' 'rclone' 'smartmontools' 'parted' 'ntfs-3g' 'net-tools' 'samba' 'cifs-utils' 'unzip')
optdepends=('mergerfs: for pool storage merging support')
backup=('etc/tubeos/gateway.ini' 'etc/tubeos/message-bus.conf' 'etc/tubeos/user-service.conf' 'etc/tubeos/local-storage.conf' 'etc/tubeos/app-management.conf' 'etc/tubeos/tubeos.conf')
install=tube-os-dash.install
source=()
sha256sums=()

package() {
    cd "$startdir"
    local _src="$(cd "$startdir"/../../../tube-os-dash && pwd)"
    if [ -d "$_src/usr" ]; then
        cp -r "$_src/usr" "$pkgdir/"
    fi
    if [ -d "$_src/etc" ]; then
        cp -r "$_src/etc" "$pkgdir/"
    fi
    if [ -d "$_src/var" ]; then
        cp -r "$_src/var" "$pkgdir/"
    fi
    find "$pkgdir/usr/bin" -type f -exec chmod 755 {} +
}
