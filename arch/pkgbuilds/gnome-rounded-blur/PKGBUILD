# Maintainer: kancko <kancko>
# Maintainer: Inled Pulsar OS <dev@inled.es>

pkgname=gnome-rounded-blur
# Upstream git tag, kept separate from pkgver so the deploy script's
# `.unstable` pkgver suffix does not produce an invalid tag like v1.0.1.unstable.
_tag=1.0.1
pkgver=1.0.1
pkgrel=2
pkgdesc="GNOME Shell BlurEffect with rounded corners (patched for GNOME / Mutter 51)"
arch=('x86_64')
url="https://github.com/kancko/gnome-rounded-blur"
license=('GPL-3.0')
conflicts=("gnome-rounded-blur-gnome51")
provides=("gnome-rounded-blur" "gnome-rounded-blur-gnome51")
makedepends=(
  'git'
  'meson'
  'mutter'
  'glib2-devel'
  'gobject-introspection'
)
source=("git+https://github.com/kancko/gnome-rounded-blur.git#tag=v${_tag}"
        "gnome-51.patch")
sha256sums=('SKIP'
            'SKIP')

prepare() {
  cd gnome-rounded-blur
  patch -Np1 -i ../gnome-51.patch
}

build() {
  arch-meson gnome-rounded-blur build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}
