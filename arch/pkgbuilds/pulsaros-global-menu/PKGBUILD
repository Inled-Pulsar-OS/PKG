# Maintainer: Jaime <info@inled.es>
pkgname=pulsaros-global-menu
pkgver=1.0.151
pkgrel=1
pkgdesc="GNOME Shell extension: macOS-like global menu bar for Pulsar OS"
arch=(any)
url="https://inled.es"
license=(custom)
# gnome-rounded-blur provides the gi://Blur typelib (libblur-effect) that the
# extension imports for rounded popup-menu blur; without it the popup blur
# falls back to Shell.BlurEffect and shows square-corner spikes.
depends=(gnome-shell pamtester gnome-rounded-blur)
install=pulsaros-global-menu.install
options=(!strip)

package() {
    _src="$(cd "$startdir"/../../../pulsaros-global-menu && pwd)"
    cd "$_src"
    [ -d usr ] && cp -r usr "$pkgdir/"
    [ -d etc ] && cp -r etc "$pkgdir/"
    if [ -f "$pkgdir/etc/pam.d/pulsaros-lock" ]; then
        sed -i 's/common-auth/system-auth/g' "$pkgdir/etc/pam.d/pulsaros-lock"
        sed -i 's/common-account/system-auth/g' "$pkgdir/etc/pam.d/pulsaros-lock"
    fi
    if [ -d "$srcdir/staging" ]; then
        cp -r "$srcdir/staging"/* "$pkgdir/"
    elif [ -d "$srcdir/usr" ]; then
        cp -r "$srcdir/usr" "$pkgdir/"
    fi
}
