# Maintainer: Jaime <info@inled.es>
pkgname=spotlight-gtk
pkgver=1.0.96
pkgrel=1
pkgdesc="Apple-like Spotlight launcher with GTK4 and Libadwaita"
arch=(any)
url="https://github.com/InledGroup/spotlight-gtk"
license=(custom)
depends=(python python-gobject python-dbus gtk4 libadwaita)
options=(!strip)

prepare() {
    _src="/home/jaime/Documentos/spotlight-gtk"
    cd "$_src"
    mkdir -p "$srcdir/staging"
    cp -r "$_src"/* "$srcdir/staging/" 2>/dev/null || true
    rm -rf "$srcdir/staging/DEBIAN" "$srcdir/staging/prepare-assets.sh" "$srcdir/staging/arch"
}

package() {
    _src_dir="$srcdir/staging/spotlight-python"
    
    mkdir -p "$pkgdir/usr/bin"
    mkdir -p "$pkgdir/usr/share/spotlight-gtk"
    mkdir -p "$pkgdir/usr/share/applications"
    
    cp "$_src_dir/main.py" "$pkgdir/usr/share/spotlight-gtk/"
    cp "$_src_dir/style.css" "$pkgdir/usr/share/spotlight-gtk/"
    cp "$_src_dir/tray.py" "$pkgdir/usr/share/spotlight-gtk/"
    
    # Create the launcher script
    cat <<'EOF' > "$pkgdir/usr/bin/spotlight-gtk"
#!/bin/bash
python3 /usr/share/spotlight-gtk/main.py "$@"
EOF
    chmod +x "$pkgdir/usr/bin/spotlight-gtk"
    
    # Create the desktop entry
    cat <<'EOF' > "$pkgdir/usr/share/applications/spotlight-gtk.desktop"
[Desktop Entry]
Name=Spotlight
Exec=/usr/bin/spotlight-gtk
Icon=view-app-grid-symbolic
Type=Application
Categories=Utility;
Comment=Apple-like Spotlight launcher
Terminal=false
EOF
}
