# Maintainer: Jaime <info@inled.es>
pkgname=pulsaros-welcome
pkgver=1.0.132
pkgrel=1
pkgdesc="Welcome and onboarding app for Pulsar OS (macOS-like setup assistant)"
arch=(any)
url="https://inled.es"
license=(custom)
depends=(python-gobject python-cairo python-dbus gtk3 webkitgtk-6.0 xorg-xrandr gtk4 libadwaita driverman)
options=(!strip !debug)
install=pulsaros-welcome.install

prepare() {
    _src="$(cd "$startdir"/../../../pulsaros-welcome && pwd)"
    cd "$_src"
    mkdir -p "$srcdir/staging"
    cp -r "$_src"/* "$srcdir/staging/" 2>/dev/null || true
    rm -rf "$srcdir/staging/DEBIAN" "$srcdir/staging/prepare-assets.sh" "$srcdir/staging/arch"
    bash prepare-assets.sh "$srcdir/staging"
}

package() {
    if [ -d "$srcdir/staging" ]; then
        cp -r "$srcdir/staging"/* "$pkgdir/"
    fi
}
