# Maintainer: Jaime <info@inled.es>
pkgname=pulsaros-welcome
pkgver=2.0.2
pkgrel=2
pkgdesc="Welcome and onboarding app for Pulsar OS (Tauri + Python fallback)"
arch=(any)
url="https://inled.es"
license=(custom)
# gstreamer + gst-plugins-*: runtime decode plugins WebKitGTK needs to render
# the H.264 videos in the welcome slideshow (black-frame fix).
depends=(python-gobject python-cairo python-dbus gtk3 webkit2gtk-4.1 webkitgtk-6.0 libsoup3 xorg-xrandr gtk4 libadwaita driverman gstreamer gst-plugins-base gst-plugins-good gst-plugins-bad gst-plugins-ugly gst-libav)
makedepends=(rust npm webkit2gtk-4.1)
options=(!strip !debug)
install=pulsaros-welcome.install

prepare() {
    _src="$(cd "$startdir"/../../../pulsaros-welcome && pwd)"
    cd "$_src"
    mkdir -p "$srcdir/staging"
    cp -r "$_src"/* "$srcdir/staging/" 2>/dev/null || true
    rm -rf "$srcdir/staging/DEBIAN" "$srcdir/staging/prepare-assets.sh" "$srcdir/staging/arch"
    bash prepare-assets.sh "$srcdir/staging"
}

package() {
    if [ -d "$srcdir/staging" ]; then
        cp -r "$srcdir/staging"/* "$pkgdir/"
    fi
}
