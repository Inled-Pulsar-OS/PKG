# Maintainer: Jaime <info@inled.es>
pkgname=calculator
pkgver=0.1.0
pkgrel=1
pkgdesc="macOS-style calculator with basic and scientific keypads for Pulsar OS"
arch=('x86_64')
url="https://github.com/skjsbsnq/Forma"
license=('GPL-3.0-only')
depends=('glibc' 'gcc-libs' 'sdl3' 'freetype2' 'fontconfig' 'dbus' 'hicolor-icon-theme')
provides=('gnome-calculator' 'mayo-calculator')
conflicts=('gnome-calculator' 'mayo-calculator')
replaces=('gnome-calculator' 'mayo-calculator')
options=('!strip')

package() {
    install -Dm755 /tmp/forma/build/applications/calculator/calculator "$pkgdir/usr/bin/calculator"
    mkdir -p "$pkgdir/usr/share/applications"
    install -Dm644 /tmp/forma/applications/calculator/data/io.github.egely1337.Mayonnaise.Calculator.desktop \
        "$pkgdir/usr/share/applications/calculator.desktop"
    ln -sf calculator.desktop "$pkgdir/usr/share/applications/io.github.egely1337.Mayonnaise.Calculator.desktop"

    mkdir -p "$pkgdir/usr/share/icons/hicolor/scalable/apps"
    install -Dm644 /tmp/forma/applications/calculator/data/io.github.egely1337.Mayonnaise.Calculator.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/calculator.svg"
    install -Dm644 /tmp/forma/applications/calculator/data/io.github.egely1337.Mayonnaise.Calculator.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.egely1337.Mayonnaise.Calculator.svg"
}
