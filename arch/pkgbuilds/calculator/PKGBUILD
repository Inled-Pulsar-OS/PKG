# Maintainer: Jaime <info@inled.es>
pkgname=calculator
pkgver=0.1.0
pkgrel=1
pkgdesc="macOS-style calculator with basic and scientific keypads for Pulsar OS"
arch=('x86_64')
url="https://github.com/skjsbsnq/Forma"
license=('GPL-3.0-only')
depends=('glibc' 'gcc-libs' 'sdl3' 'freetype2' 'fontconfig' 'dbus' 'hicolor-icon-theme')
provides=('gnome-calculator' 'mayo-calculator')
conflicts=('gnome-calculator' 'mayo-calculator')
replaces=('gnome-calculator' 'mayo-calculator')
options=('!strip')

prepare() {
    _src="$(cd "$startdir"/../../../calculator && pwd)"
    mkdir -p "$srcdir/staging"
    bash "$_src/prepare-assets.sh" "$srcdir/staging"
}

package() {
    if [ -d "$srcdir/staging" ]; then
        cp -r "$srcdir/staging"/* "$pkgdir/"
    fi
}
