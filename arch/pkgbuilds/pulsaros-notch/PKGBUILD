# Maintainer: Jaime <info@inled.es>

pkgname=pulsaros-notch
pkgver=1.1.0
pkgrel=2
pkgdesc="macOS-style dynamic notch and dashboard for Pulsar OS (Pulsar Notch)"
arch=(any)
url="https://inled.es"
license=(MIT)

replaces=('pulsaros-notchnux')
conflicts=('pulsaros-notchnux')

depends=(
  gnome-shell
  gstreamer
  gst-plugins-base-libs
)

optdepends=(
  'gst-plugins-good: additional GStreamer support for the Studio tab'
)

options=(!strip)

package() {
    _src="$(cd "$startdir"/../../../pulsar-notch && pwd)"
    cd "$_src"

    local _dest="$pkgdir/usr/share/gnome-shell/extensions/pulsar-notch@inled.es"
    mkdir -p "$_dest"

    install -Dm644 metadata.json "$_dest/metadata.json"
    install -Dm644 extension.js "$_dest/extension.js"
    install -Dm644 prefs.js "$_dest/prefs.js"
    install -Dm644 stylesheet.css "$_dest/stylesheet.css"
    [ -d assets ] && cp -r assets "$_dest/"
    [ -d src ] && cp -r src "$_dest/"

    if [ -f LICENSE ]; then
        install -Dm644 LICENSE \
            "$pkgdir/usr/share/licenses/pulsaros-notch/LICENSE"
    fi

    chmod -R a+rX "$pkgdir/usr"
    find "$pkgdir/usr" -type d -exec chmod 755 {} +
    find "$pkgdir/usr/share" -type f -exec chmod 644 {} +
}
