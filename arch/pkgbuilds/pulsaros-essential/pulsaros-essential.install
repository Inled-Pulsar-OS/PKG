post_install() {
    # Locale config
    if command -v locale-gen &>/dev/null; then
        sed -i 's/#es_ES.UTF-8 UTF-8/es_ES.UTF-8 UTF-8/' /etc/locale.gen 2>/dev/null || true
        sed -i 's/#en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen 2>/dev/null || true
        locale-gen 2>/dev/null || true
    fi

    # Add 9p modules to mkinitcpio
    if [ -f /etc/mkinitcpio.conf ]; then
        if ! grep -q "9p" /etc/mkinitcpio.conf; then
            sed -i 's/^MODULES=()/MODULES=(9p 9pnet 9pnet_virtio)/' /etc/mkinitcpio.conf
            sed -i 's/^MODULES=(/MODULES=(9p 9pnet 9pnet_virtio /' /etc/mkinitcpio.conf 2>/dev/null || true
        fi
        mkinitcpio -P 2>/dev/null || true
    fi

    # Create users
    groupadd -f sudo 2>/dev/null || true
    groupadd -f docker 2>/dev/null || true
    groupadd -f input 2>/dev/null || true
    if ! id -u live &>/dev/null; then
        useradd -m -s /bin/bash -G sudo,docker,input live 2>/dev/null || true
    else
        usermod -aG docker,input live 2>/dev/null || true
    fi
    echo "live:live" | chpasswd 2>/dev/null || true
    echo "root:pulsar" | chpasswd 2>/dev/null || true

    # Set Seafari as default browser (via xdg-settings)
    if command -v xdg-settings &>/dev/null && [ -f /usr/share/applications/seafari.desktop ]; then
        xdg-settings set default-web-browser seafari.desktop 2>/dev/null || true
    fi

    # Apply Safari icon to Seafari (same as Debian postinst)
    if [ -f "/usr/share/applications/seafari.desktop" ]; then
        sed -i 's/^Icon=.*/Icon=safari/' /usr/share/applications/seafari.desktop
    fi

    # Bluetooth dual mode
    if [ -f /etc/bluetooth/main.conf ]; then
        sed -i 's/^#ControllerMode.*/ControllerMode = dual/' /etc/bluetooth/main.conf
        sed -i 's/^ControllerMode.*/ControllerMode = dual/' /etc/bluetooth/main.conf
    fi

    # Enable services
    systemctl enable NetworkManager.service 2>/dev/null || true
    systemctl enable bluetooth.service 2>/dev/null || true
    # Avahi/mDNS: GSConnect/KDE Connect phone discovery on the LAN
    systemctl enable avahi-daemon.service avahi-daemon.socket 2>/dev/null || true
    systemctl enable docker.service 2>/dev/null || true
    systemctl enable docker.socket 2>/dev/null || true
    systemctl enable vboxservice.service 2>/dev/null || true
    systemctl enable vmtoolsd.service 2>/dev/null || true
    systemctl enable pulsar-live-nopasswd.service 2>/dev/null || true
    # GNOME Shell needs org.gnome.DisplayManager to exist to allow screen
    # locking (Ctrl+L / idle lock). Pulsar OS uses SDDM, so a tiny shim owns
    # that name and reports a compatible GDM version.
    systemctl enable pulsaros-display-manager-shim.service 2>/dev/null || true
    systemctl start pulsaros-display-manager-shim.service 2>/dev/null || true
    # Performance/memory governor (cgroup v2): keeps the desktop (gnome-shell,
    # mutter and the essentials) above the focused window and stops any single
    # app from saturating CPU/RAM. Without this the service stays "disabled"
    # on a fresh install and the governor never runs. See
    # /usr/bin/pulsaros-optimizer.
    systemctl enable pulsaros-optimizer.service 2>/dev/null || true
    systemctl start pulsaros-optimizer.service 2>/dev/null || true

    # Biometrics (fprintd, gazed, pulsaros-biometrics) if installed
    if command -v fprintd-enroll >/dev/null 2>&1; then
        systemctl enable fprintd.service 2>/dev/null || true
    fi
    if command -v gazed >/dev/null 2>&1; then
        systemctl enable gazed.service 2>/dev/null || true
        systemctl start gazed.service 2>/dev/null || true
    fi
    if [ -f /usr/lib/systemd/system/pulsaros-biometrics.service ]; then
        systemctl enable pulsaros-biometrics.service 2>/dev/null || true
        systemctl start pulsaros-biometrics.service 2>/dev/null || true
    fi

    # Configure PAM for sudo and polkit-1
    for pam_file in /etc/pam.d/sudo /etc/pam.d/polkit-1; do
        if [ -f "$pam_file" ]; then
            if [ -f /usr/lib/security/pam_gaze.so ] && ! grep -q "pam_gaze.so" "$pam_file"; then
                sed -i '1s|^|auth        sufficient    pam_gaze.so\n|' "$pam_file" 2>/dev/null || true
            fi
            if [ -f /usr/lib/security/pam_fprintd.so ] && ! grep -q "pam_fprintd.so" "$pam_file"; then
                sed -i '/pam_gaze.so/a auth        sufficient    pam_fprintd.so' "$pam_file" 2>/dev/null || true
            fi
        fi
    done
    if [ -f /etc/pam.d/sddm ]; then
        if ! grep -q "pam-bio-check" /etc/pam.d/sddm; then
            sed -i '1i -auth       [success=done default=ignore] pam_exec.so quiet stdout /usr/lib/pulsaros/pam-bio-check' /etc/pam.d/sddm 2>/dev/null || true
        fi
        # Remove direct pam_gaze.so and pam_fprintd.so in sddm pam stack to prevent device claim conflicts
        sed -i '/pam_gaze\.so/d' /etc/pam.d/sddm 2>/dev/null || true
        sed -i '/pam_fprintd\.so/d' /etc/pam.d/sddm 2>/dev/null || true
    fi

    # Reduce systemd timeouts
    sed -i 's/^#*DefaultTimeoutStopSec=.*/DefaultTimeoutStopSec=10s/' /etc/systemd/system.conf 2>/dev/null || true
    sed -i 's/^#*DefaultTimeoutStopSec=.*/DefaultTimeoutStopSec=10s/' /etc/systemd/user.conf 2>/dev/null || true

    # Install Homebrew (Linuxbrew) out of the box, mirroring macOS.
    # Non-interactive; never fails the package install if the network is down.
    echo "Installing Homebrew (Linuxbrew)..."
    if [ ! -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
        mkdir -p /home/linuxbrew
        NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" \
            || echo "Warning: Homebrew could not be installed right now; users can install it later."
    fi
    if [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
        chown -R linuxbrew:linuxbrew /home/linuxbrew/.linuxbrew 2>/dev/null || true
    fi

    # Ensure pacman keyring directory permissions are readable for non-root users
    if [ -d /etc/pacman.d/gnupg ]; then
        chmod 755 /etc/pacman.d/gnupg 2>/dev/null || true
        chmod 644 /etc/pacman.d/gnupg/pubring.gpg /etc/pacman.d/gnupg/trustdb.gpg /etc/pacman.d/gnupg/tofu.db /etc/pacman.d/gnupg/gpg.conf 2>/dev/null || true
    fi

    # Mask heavy localsearch / tracker-miner-fs indexing daemons
    mkdir -p /etc/systemd/user
    for srv in localsearch-3.service localsearch-control-3.service localsearch-extractor-3.service tracker-miner-fs-3.service tracker-extract-3.service; do
        ln -sf /dev/null "/etc/systemd/user/$srv" 2>/dev/null || true
    done
    if command -v systemctl &>/dev/null; then
        systemctl --global mask localsearch-3.service localsearch-control-3.service localsearch-extractor-3.service tracker-miner-fs-3.service tracker-extract-3.service 2>/dev/null || true
    fi
    pkill -f localsearch 2>/dev/null || true
    pkill -f tracker-miner 2>/dev/null || true
    pkill -f tracker-extract 2>/dev/null || true
}

post_upgrade() {
    post_install
}
