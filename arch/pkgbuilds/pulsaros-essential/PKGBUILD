# Maintainer: Jaime <info@inled.es>
pkgname=pulsaros-essential
pkgver=1.0.118
pkgrel=2
pkgdesc="Essential configurations and system utilities for Pulsar OS (Arch edition)"
arch=(any)
url="https://inled.es"
license=(custom)
depends=(sudo polkit flatpak appmenu-gtk-module python-gobject python-dbus bamf libkeybinder3 gtk3 python-xlib docker droidtux macboat appinstall seafari freerdp winboat pulsaros-meta)
options=(!strip)
install=pulsaros-essential.install

prepare() {
    _src="$(cd "$startdir"/../../../pulsaros-essential && pwd)"
    cd "$_src"
    mkdir -p "$srcdir/staging"
    cp -r "$_src"/* "$srcdir/staging/" 2>/dev/null || true
    rm -rf "$srcdir/staging/DEBIAN" "$srcdir/staging/prepare-assets.sh" "$srcdir/staging/arch"
    bash prepare-assets.sh "$srcdir/staging"
}

package() {
    _src="$(cd "$startdir"/../../../pulsaros-essential && pwd)"
    cd "$_src"
    [ -d usr ] && cp -r usr "$pkgdir/"
    [ -d etc ] && cp -r etc "$pkgdir/"
    if [ -d "$srcdir/staging" ]; then
        cp -r "$srcdir/staging"/* "$pkgdir/"
    elif [ -d "$srcdir/usr" ]; then
        cp -r "$srcdir/usr" "$pkgdir/"
    fi
    # Remove Debian-specific initramfs-tools config
    rm -f "$pkgdir/etc/initramfs-tools/modules"
}
