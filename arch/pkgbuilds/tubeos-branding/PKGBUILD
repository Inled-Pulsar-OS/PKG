# Maintainer: Pulsar OS Team <team@pulsaros.io>
pkgname=tubeos-branding
pkgver=0.1.0
pkgrel=1
pkgdesc="Tube OS branding and identity files"
arch=('any')
url="https://github.com/Inled-Pulsar-OS"
license=('Apache-2.0')
depends=()
source=()
sha256sums=()

package() {
  local _src="$(cd "$startdir"/../../../tubeos-branding && pwd)"
  if [ -d "$_src/usr" ]; then
    cp -r "$_src/usr" "$pkgdir/"
  fi
  if [ -d "$_src/etc" ]; then
    cp -r "$_src/etc" "$pkgdir/"
  fi
}
