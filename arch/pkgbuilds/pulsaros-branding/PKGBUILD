# Maintainer: Jaime <info@inled.es>
pkgname=pulsaros-branding
pkgver=1.0.121
pkgrel=1
pkgdesc="Branding and system identity files for Pulsar OS (Arch edition)"
arch=(any)
url="https://inled.es"
license=(custom)
depends=()
install=pulsaros-branding.install

package() {
    _src="$(cd "$startdir"/../../../pulsaros-branding && pwd)"
    cd "$_src"
    [ -d usr ] && cp -r usr "$pkgdir/"
    [ -d etc ] && cp -r etc "$pkgdir/"
    if [ -d "$srcdir/staging" ]; then
        cp -r "$srcdir/staging"/* "$pkgdir/"
    elif [ -d "$srcdir/usr" ]; then
        cp -r "$srcdir/usr" "$pkgdir/"
    fi
    
    # Write Arch-specific os-release
    local os_ver="${PULSAR_VERSION:-rolling}"
    mkdir -p "$pkgdir/etc" "$pkgdir/usr/lib"
    cat <<EOF > "$pkgdir/etc/os-release"
NAME="Pulsar OS"
PRETTY_NAME="Pulsar OS Pear Edition Arch $os_ver"
VERSION_ID="$os_ver"
VERSION="Pear Edition Arch $os_ver"
ID=pulsaros
ID_LIKE=arch
HOME_URL="https://inled.es"
DOCUMENTATION_URL="https://inled.es"
SUPPORT_URL="https://inled.es"
BUG_REPORT_URL="https://github.com/InledGroup/pulsaros/issues"
PRIVACY_POLICY_URL="https://inled.es"
LOGO=pulsar-logo
ANSI_COLOR="38;2;135;206;235"
EOF
    cp "$pkgdir/etc/os-release" "$pkgdir/usr/lib/os-release"
}
