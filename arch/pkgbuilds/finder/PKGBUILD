# Maintainer: Jaime <info@inled.es>
# Built from the Mayonnaise toolkit with Pulsar OS customizations:
# spacebar Quick Look + thumbnails for videos and PDFs, sidebar Applications
# shortcut and color tags, ZIP compression, Move to, FlyDrop sharing,
# file picker mode, and Liquid Glass controls.
pkgname=finder
pkgver=0.1.0
pkgrel=1
pkgdesc="Finder file manager for Pulsar OS"
arch=('x86_64')
url="https://github.com/egely1337/mayonnaise"
license=('GPL-3.0-only' 'OFL-1.1')
depends=('glibc' 'gcc-libs' 'sdl3' 'freetype2' 'fontconfig' 'dbus' 'hicolor-icon-theme' 'xdg-utils' 'zip')
optdepends=('vulkan-icd-loader: Vulkan renderer (OpenGL otherwise)'
            'ffmpeg: video poster generation for Quick Look and thumbnails'
            'poppler: PDF thumbnail and preview rendering'
            'pulsaros-flydrop: share files over AirDrop-compatible FlyDrop')
provides=('mayo-finder')
conflicts=('mayo-finder')
replaces=('mayo-finder')
makedepends=('git' 'cmake' 'vulkan-headers' 'shaderc')
options=('!strip')
source=("mayonnaise::git+https://github.com/egely1337/mayonnaise.git#commit=9eccbfe2f4411ea8766305ef76eaa23afdd112be")
sha256sums=('SKIP')

prepare() {
    if [ -d "$startdir/overlay" ]; then
        echo "🎨 Applying Pulsar OS customizations from overlay..."
        cp -rf "$startdir/overlay/"* mayonnaise/
    fi
}

build() {
    CFLAGS+=" -ffile-prefix-map=$srcdir=."
    CXXFLAGS+=" -ffile-prefix-map=$srcdir=."
    cmake -S mayonnaise -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DMAYONNAISE_BUILD_APPS=ON \
        -DMAYONNAISE_BUILD_TESTS=OFF \
        -DMAYONNAISE_USE_SYSTEM_DEPS=ON \
        -Wno-dev
    cmake --build build --target finder -j"$(nproc)"
}

package() {
    DESTDIR="$pkgdir" cmake --install build --component finder

    mkdir -p "$pkgdir/usr/share/applications"
    if [ -f "$pkgdir/usr/share/applications/io.github.egely1337.Mayonnaise.Finder.desktop" ]; then
        mv "$pkgdir/usr/share/applications/io.github.egely1337.Mayonnaise.Finder.desktop" \
           "$pkgdir/usr/share/applications/finder.desktop"
        ln -sf finder.desktop "$pkgdir/usr/share/applications/io.github.egely1337.Mayonnaise.Finder.desktop"
    fi

    mkdir -p "$pkgdir/usr/share/icons/hicolor/scalable/apps"
    if [ -f "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.egely1337.Mayonnaise.Finder.svg" ]; then
        cp "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.egely1337.Mayonnaise.Finder.svg" \
           "$pkgdir/usr/share/icons/hicolor/scalable/apps/finder.svg"
    fi

    install -Dm644 mayonnaise/assets/fonts/Inter-LICENSE.txt \
        "$pkgdir/usr/share/licenses/$pkgname/Inter-LICENSE.txt"
}
