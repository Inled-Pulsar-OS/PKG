# Maintainer: Jaime <info@inled.es>
pkgname=pulsaros-settings
pkgver=1.0.1
pkgrel=1
pkgdesc="macOS-styled System Settings application for Pulsar OS"
arch=(any)
url="https://inled.es"
license=(custom)
depends=(gtk4 libadwaita python-gobject pulsaros-live-wallpaper)
options=(!strip)

package() {
    _src="$(cd "$startdir"/../../../pulsaros-settings && pwd)"
    cd "$_src"
    [ -d usr ] && cp -r usr "$pkgdir/"
    [ -d etc ] && cp -r etc "$pkgdir/"
    if [ -d "$srcdir/staging" ]; then
        cp -r "$srcdir/staging"/* "$pkgdir/"
    elif [ -d "$srcdir/usr" ]; then
        cp -r "$srcdir/usr" "$pkgdir/"
    fi
}
