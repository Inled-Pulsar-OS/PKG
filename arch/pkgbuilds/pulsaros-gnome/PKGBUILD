# Maintainer: Jaime <info@inled.es>
pkgname=pulsaros-gnome
pkgver=1.0.124
pkgrel=1
pkgdesc="GNOME Shell extensions and configurations for Pulsar OS (macOS-like desktop)"
arch=(any)
url="https://inled.es"
license=(custom)
depends=(gnome-shell dconf)
makedepends=(git make sassc gettext glib2 jq unzip curl)
options=(!strip)
install=pulsaros-gnome.install



prepare() {
    _src="$(cd "$startdir"/../../../pulsaros-gnome && pwd)"
    cd "$_src"
    mkdir -p "$srcdir/staging"
    cp -r "$_src"/* "$srcdir/staging/" 2>/dev/null || true
    rm -rf "$srcdir/staging/DEBIAN" "$srcdir/staging/arch"
    cp prepare-assets.sh "$srcdir/prepare-assets.sh"
    bash "$srcdir/prepare-assets.sh" "$srcdir/staging"
}

package() {
    _src="$(cd "$startdir"/../../../pulsaros-gnome && pwd)"
    cd "$_src"
    if [ -d "$srcdir/staging" ]; then
        cp -r "$srcdir/staging"/* "$pkgdir/"
    else
        [ -d usr ] && cp -r usr "$pkgdir/"
        [ -d etc ] && cp -r etc "$pkgdir/"
    fi
    if [ -f "$pkgdir/usr/share/glib-2.0/schemas/90_pulsaros.gschema.override" ]; then
        sed -i -e 's/spotlight-python.desktop/pulsaros-spotlight.desktop/g' -e 's/spotlight-gtk.desktop/pulsaros-spotlight.desktop/g' "$pkgdir/usr/share/glib-2.0/schemas/90_pulsaros.gschema.override"
    fi
    if [ -f "$pkgdir/etc/dconf/db/local.d/00-pulsaros-theme" ]; then
        sed -i -e 's/spotlight-python.desktop/pulsaros-spotlight.desktop/g' -e 's/spotlight-gtk.desktop/pulsaros-spotlight.desktop/g' "$pkgdir/etc/dconf/db/local.d/00-pulsaros-theme"
    fi
}
