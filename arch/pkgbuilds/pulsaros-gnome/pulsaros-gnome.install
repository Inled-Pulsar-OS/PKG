post_install() {
    echo "⚙️ Compilando esquemas GSchema para Pulsar OS..."
    glib-compile-schemas /usr/share/glib-2.0/schemas/ 2>/dev/null || true

    echo "🧩 Compilando esquemas locales de extensiones..."
    find /usr/share/gnome-shell/extensions -name schemas -type d -exec glib-compile-schemas {} \; 2>/dev/null || true

    echo "📊 Actualizando base de datos global Dconf..."
    dconf update 2>/dev/null || true

    echo "🛑 Desactivando servicios de indexación pesada localsearch / tracker, evolution, ibus y daemons innecesarios..."
    mkdir -p /etc/systemd/user
    for srv in localsearch-3.service localsearch-control-3.service localsearch-extractor-3.service \
               tracker-miner-fs-3.service tracker-extract-3.service \
               evolution-calendar-factory.service evolution-addressbook-factory.service \
               evolution-source-registry.service evolution-alarm-notify.service evolution-user-prompter.service \
               org.freedesktop.IBus.session.GNOME.service \
               org.gnome.SettingsDaemon.Smartcard.service org.gnome.SettingsDaemon.Wwan.service \
               org.gnome.SettingsDaemon.PrintNotifications.service \
               org.gnome.SettingsDaemon.Sharing.service org.gnome.SettingsDaemon.Sound.service \
               org.gnome.SettingsDaemon.UsbProtection.service at-spi-dbus-bus.service; do
        ln -sf /dev/null "/etc/systemd/user/$srv" 2>/dev/null || true
    done
    if command -v systemctl >/dev/null 2>&1; then
        systemctl --global mask localsearch-3.service localsearch-control-3.service localsearch-extractor-3.service \
                               tracker-miner-fs-3.service tracker-extract-3.service \
                               evolution-calendar-factory.service evolution-addressbook-factory.service \
                               evolution-source-registry.service evolution-alarm-notify.service evolution-user-prompter.service \
                               org.freedesktop.IBus.session.GNOME.service \
                               org.gnome.SettingsDaemon.Smartcard.service org.gnome.SettingsDaemon.Wwan.service \
                               org.gnome.SettingsDaemon.PrintNotifications.service \
                               org.gnome.SettingsDaemon.Sharing.service org.gnome.SettingsDaemon.Sound.service \
                               org.gnome.SettingsDaemon.UsbProtection.service at-spi-dbus-bus.service 2>/dev/null || true
        # Innecesarios de sistema: enmascarar o activar bajo demanda
        systemctl mask iio-sensor-proxy.service bolt.service gazed.service colord.service 2>/dev/null || true
        systemctl disable warp-svc.service tailscaled.service 2>/dev/null || true
        # Activar CUPS y Docker bajo demanda (socket-activation) en lugar de demonio residente
        systemctl disable cups.service docker.service containerd.service 2>/dev/null || true
        systemctl enable cups.socket docker.socket 2>/dev/null || true
    fi
    # Limpiar autostarts innecesarios o residuales
    rm -f /etc/xdg/autostart/autokey.desktop /etc/xdg/autostart/appinstall-daemon.desktop 2>/dev/null || true
    if [ -f /etc/xdg/autostart/localsearch-3.desktop ]; then
        sed -i 's/^X-GNOME-Autostart-enabled=true/X-GNOME-Autostart-enabled=false/' /etc/xdg/autostart/localsearch-3.desktop 2>/dev/null || true
        grep -q "Hidden=true" /etc/xdg/autostart/localsearch-3.desktop || echo "Hidden=true" >> /etc/xdg/autostart/localsearch-3.desktop
    fi
}

post_upgrade() {
    post_install
}

post_remove() {
    post_install
}
