# Maintainer: Jaime <info@inled.es>
pkgname=pulsaros-cloud
pkgver=1.0.0
pkgrel=1
pkgdesc="Cloud drives (Google Drive, OneDrive, Dropbox) via rclone for the Pulsar OS Finder"
url="https://inled.es"
license=(GPL-3.0-or-later)
arch=(x86_64)
depends=(
  fuse3
  rclone
)
source=(pulsar-cloud
        "pulsar-cloud@.service")
sha256sums=(SKIP SKIP)

package() {
  install -Dm755 "${srcdir}/pulsar-cloud" "${pkgdir}/usr/bin/pulsar-cloud"
  install -Dm644 "${srcdir}/pulsar-cloud@.service" \
    "${pkgdir}/usr/lib/systemd/user/pulsar-cloud@.service"
}
