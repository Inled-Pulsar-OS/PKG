#!/usr/bin/env bash
# pulsar-cloud — rclone-backed cloud drives for Pulsar OS Finder.
# Providers are mounted under ~/Cloud/<name> via a systemd user unit.

set -u

CLOUD_DIR="${HOME}/Cloud"
CONF="${HOME}/.config/rclone/rclone.conf"

usage() {
    echo "usage: pulsar-cloud <add|setup|mount|unmount|open|list> [name]"
    echo "featured providers: google-drive, onedrive, icloud; any rclone"
    echo "backend can be added interactively via 'add'."
    exit 1
}

provider_backend() {
    case "$1" in
        google-drive) echo "drive" ;;
        onedrive)     echo "onedrive" ;;
        dropbox)      echo "dropbox" ;;
        icloud)       echo "iclouddrive" ;;
        *) return 1 ;;
    esac
}

require_name() {
    [ -n "${2:-}" ] || usage
}

# NOTE: 'rclone config show <name>' succeeds even for unknown remotes
# (the name falls back to the implicit local backend), so existence
# must be checked against the config file itself.
remote_exists() {
    [ -f "$CONF" ] && grep -q "^\[${1}\]$" "$CONF"
}

has_token() {
    rclone config show "$1" 2>/dev/null | grep -q '^token *= *{'
}

# The OneDrive backend needs drive_id/drive_type which plain OAuth does not
# provide. Detect them via Microsoft Graph using the stored access token.
ensure_drive_metadata() {
    local name="$1" backend tok detected did dtype

    backend=$(provider_backend "$name") || return 0
    [ "${backend}" = "onedrive" ] || return 0

    if rclone config show "${name}" 2>/dev/null | grep -q '^drive_id *= *[[:alnum:]]'; then
        return 0
    fi

    tok=$(rclone config show "${name}" 2>/dev/null | sed -n 's/^token *= *//p')
    [ -n "${tok}" ] || return 1

    echo "Detecting your OneDrive location..."
    detected=$(T="${tok}" python3 - <<'PY' 2>/dev/null
import os, json, urllib.request
try:
    t = json.loads(os.environ["T"])["access_token"]
    req = urllib.request.Request("https://graph.microsoft.com/v1.0/me/drive",
                                 headers={"Authorization": "Bearer " + t})
    d = json.load(urllib.request.urlopen(req, timeout=20))
    print(d.get("id", ""), d.get("driveType", ""))
except Exception:
    raise SystemExit(1)
PY
) || {
        echo "Could not detect the drive (token may be expired). Run setup again."
        return 1
    }

    did=${detected%% *}
    dtype=${detected##* }
    if [ -z "${did}" ]; then
        echo "Could not detect the drive. Run setup again."
        return 1
    fi

    rclone config update "${name}" drive_id "${did}" drive_type "${dtype}" >/dev/null
}

activate_account() {
    local name="$1" i

    ensure_drive_metadata "${name}" || true

    systemctl --user enable --now "pulsar-cloud@${name}.service" >/dev/null 2>&1 \
        || systemctl --user restart "pulsar-cloud@${name}.service"

    for i in $(seq 1 20); do
        mountpoint -q "${CLOUD_DIR}/${name}" && break
        sleep 0.5
    done

    if mountpoint -q "${CLOUD_DIR}/${name}"; then
        echo "Done: '${name}' mounted at ${CLOUD_DIR}/${name}"
    else
        echo "Not mounted yet; check 'journalctl --user -u pulsar-cloud@${name}'."
    fi
}

# Interactive configuration for any rclone backend, running in the
# current terminal so rclone can ask its own questions (OAuth, keys,
# two-factor codes...).
wizard_backend() {
    local name="$1" backend="$2"

    mkdir -p "$(dirname "$CONF")" "${CLOUD_DIR}/${name}"

    if remote_exists "${name}"; then
        echo "Account '${name}' already exists."
    else
        echo
        echo "Setting up '${name}' (${backend})."
        echo "rclone will now ask you the questions for this provider."
        # '--all' forces the full interactive questionnaire; without it
        # modern rclone just takes defaults and fails on required keys.
        if ! rclone config create "${name}" "${backend}" --all; then
            echo "Setup of '${name}' failed or was cancelled."
            return 1
        fi
    fi

    activate_account "${name}"
}

choose_other_backend() {
    local -a entries=()
    mapfile -t entries < <(rclone help backends 2>/dev/null \
        | sed -n 's/^[[:space:]]\{2\}\([a-z0-9]\{1,\}\)[[:space:]]\{1,\}/\1 /p' | sort)
    local count=${#entries[@]} pick name backend default_name n

    if [ "${count}" -eq 0 ]; then
        echo "Could not list rclone backends."
        return 1
    fi

    echo
    echo "Available providers:"
    for n in $(seq "${count}"); do
        printf ' %3d) %s\n' "${n}" "${entries[$((n - 1))]}"
    done
    echo
    printf "Choose a provider [1-%d]: " "${count}"
    read -r pick
    case "${pick}" in
        ''|*[!0-9]*) echo "Invalid choice."; return 1 ;;
        *) [ "${pick}" -ge 1 ] && [ "${pick}" -le "${count}" ] || { echo "Invalid choice."; return 1; } ;;
    esac

    backend=${entries[$((pick - 1))]%% *}
    name=$(unique_remote_name "${backend}")

    wizard_backend "${name}" "${backend}"
}

unique_remote_name() {
    local base="$1" candidate="$1" n=1
    while remote_exists "${candidate}"; do
        n=$((n + 1))
        candidate="${base}-${n}"
    done
    echo "${candidate}"
}

cmd_add() {
    local choice name label answer

    echo "== Add a cloud account =="
    echo
    echo "Featured providers:"
    echo "  1) Google Drive"
    echo "  2) OneDrive"
    echo "  3) iCloud"
    echo
    echo "  o) Other provider (any backend supported by rclone)"
    echo "  q) Quit"
    printf "Choose an option: "
    read -r choice

    case "${choice}" in
        1) exec "$0" setup google-drive ;;
        2) exec "$0" setup onedrive ;;
        3)
            name="icloud"
            if rclone config show "${name}" >/dev/null 2>&1; then
                printf "An account named '%s' already exists. Use another name? [y/N] " "${name}"
                read -r answer
                case "${answer}" in
                    y|Y)
                        printf "Account name: "
                        read -r name
                        ;;
                esac
            fi
            wizard_backend "${name}" iclouddrive
            ;;
        o) choose_other_backend ;;
        *) echo "Cancelled." ;;
    esac
}

cmd="${1:-}"
case "$cmd" in
    setup)
        require_name "$@"
        name="$2"
        backend=$(provider_backend "$name") || usage
        label=$(echo "$name" | tr '-' ' ')
        mkdir -p "$(dirname "$CONF")" "${CLOUD_DIR}/${name}"

        if grep -q "^\[${name}\]$" "$CONF" 2>/dev/null && has_token "$name"; then
            echo "'${name}' is already configured; reconnecting..."
        else
            if grep -q "^\[${name}\]$" "$CONF" 2>/dev/null; then
                echo "'${name}' exists without authorization; completing sign-in..."
            else
                echo "== Setting up ${label} =="
                echo "Your browser will open to grant access. Follow any on-screen prompts."
            fi

            # Run rclone visibly so its interactive prompts (e.g. OneDrive
            # account/drive selection) are answerable, while capturing the
            # output to extract the token afterwards.
            logfile=$(mktemp)
            rclone authorize "${backend}" 2>&1 | tee "${logfile}"
            token=$(grep -oE '\{.*\}' "${logfile}" | tail -n1)
            rm -f "${logfile}"

            if [ -z "$token" ]; then
                echo "Authorization was not completed."
                exit 1
            fi

            if grep -q "^\[${name}\]$" "$CONF" 2>/dev/null; then
                rclone config update "${name}" \
                    config_refresh_token true token "${token}" >/dev/null
            else
                rclone config create "${name}" "${backend}" \
                    config_refresh_token true token "${token}" >/dev/null
            fi
            echo "Account '${name}' configured."
        fi

        activate_account "${name}"
        ;;
    add)
        cmd_add
        ;;
    mount|open)
        require_name "$@"
        name="$2"
        mkdir -p "${CLOUD_DIR}/${name}"
        ensure_drive_metadata "${name}" || true
        systemctl --user start "pulsar-cloud@${name}.service"
        [ "$cmd" = "mount" ] && exit 0
        exec xdg-open "${CLOUD_DIR}/${name}"
        ;;
    unmount)
        require_name "$@"
        name="$2"
        systemctl --user stop "pulsar-cloud@${name}.service"
        fusermount3 -uz "${CLOUD_DIR}/${name}" 2>/dev/null || true
        ;;
    list)
        [ -f "$CONF" ] && grep -E '^\[' "$CONF" | tr -d '[]'
        ;;
    *)
        usage
        ;;
esac
