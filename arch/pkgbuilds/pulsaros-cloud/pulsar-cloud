#!/usr/bin/env bash
# pulsar-cloud — rclone-backed cloud drives for Pulsar OS Finder.
# Providers are mounted under ~/Cloud/<name> via a systemd user unit.

set -u

CLOUD_DIR="${HOME}/Cloud"
CONF="${HOME}/.config/rclone/rclone.conf"

usage() {
    echo "usage: pulsar-cloud <setup|mount|unmount|open|list> [name]"
    echo "supported providers: google-drive, onedrive, dropbox"
    exit 1
}

provider_backend() {
    case "$1" in
        google-drive) echo "drive" ;;
        onedrive)     echo "onedrive" ;;
        dropbox)      echo "dropbox" ;;
        *) return 1 ;;
    esac
}

require_name() {
    [ -n "${2:-}" ] || usage
}

has_token() {
    rclone config show "$1" 2>/dev/null | grep -q '^token *= *{'
}

# The OneDrive backend needs drive_id/drive_type which plain OAuth does not
# provide. Detect them via Microsoft Graph using the stored access token.
ensure_drive_metadata() {
    local name="$1" backend tok detected did dtype

    backend=$(provider_backend "$name") || return 0
    [ "${backend}" = "onedrive" ] || return 0

    if rclone config show "${name}" 2>/dev/null | grep -q '^drive_id *= *[[:alnum:]]'; then
        return 0
    fi

    tok=$(rclone config show "${name}" 2>/dev/null | sed -n 's/^token *= *//p')
    [ -n "${tok}" ] || return 1

    echo "Detecting your OneDrive location..."
    detected=$(T="${tok}" python3 - <<'PY' 2>/dev/null
import os, json, urllib.request
try:
    t = json.loads(os.environ["T"])["access_token"]
    req = urllib.request.Request("https://graph.microsoft.com/v1.0/me/drive",
                                 headers={"Authorization": "Bearer " + t})
    d = json.load(urllib.request.urlopen(req, timeout=20))
    print(d.get("id", ""), d.get("driveType", ""))
except Exception:
    raise SystemExit(1)
PY
) || {
        echo "Could not detect the drive (token may be expired). Run setup again."
        return 1
    }

    did=${detected%% *}
    dtype=${detected##* }
    if [ -z "${did}" ]; then
        echo "Could not detect the drive. Run setup again."
        return 1
    fi

    rclone config update "${name}" drive_id "${did}" drive_type "${dtype}" >/dev/null
}

cmd="${1:-}"
case "$cmd" in
    setup)
        require_name "$@"
        name="$2"
        backend=$(provider_backend "$name") || usage
        label=$(echo "$name" | tr '-' ' ')
        mkdir -p "$(dirname "$CONF")" "${CLOUD_DIR}/${name}"

        if grep -q "^\[${name}\]$" "$CONF" 2>/dev/null && has_token "$name"; then
            echo "'${name}' is already configured; reconnecting..."
        else
            if grep -q "^\[${name}\]$" "$CONF" 2>/dev/null; then
                echo "'${name}' exists without authorization; completing sign-in..."
            else
                echo "== Setting up ${label} =="
                echo "Your browser will open to grant access. Follow any on-screen prompts."
            fi

            # Run rclone visibly so its interactive prompts (e.g. OneDrive
            # account/drive selection) are answerable, while capturing the
            # output to extract the token afterwards.
            logfile=$(mktemp)
            rclone authorize "${backend}" 2>&1 | tee "${logfile}"
            token=$(grep -oE '\{.*\}' "${logfile}" | tail -n1)
            rm -f "${logfile}"

            if [ -z "$token" ]; then
                echo "Authorization was not completed."
                exit 1
            fi

            if grep -q "^\[${name}\]$" "$CONF" 2>/dev/null; then
                rclone config update "${name}" \
                    config_refresh_token true token "${token}" >/dev/null
            else
                rclone config create "${name}" "${backend}" \
                    config_refresh_token true token "${token}" >/dev/null
            fi
            echo "Account '${name}' configured."
        fi

        ensure_drive_metadata "${name}" || true

        systemctl --user enable --now "pulsar-cloud@${name}.service" >/dev/null 2>&1 \
            || systemctl --user restart "pulsar-cloud@${name}.service"

        for i in $(seq 1 20); do
            mountpoint -q "${CLOUD_DIR}/${name}" && break
            sleep 0.5
        done

        if mountpoint -q "${CLOUD_DIR}/${name}"; then
            echo "Done: '${name}' mounted at ${CLOUD_DIR}/${name}"
        else
            echo "Not mounted yet; check 'journalctl --user -u pulsar-cloud@${name}'."
        fi
        ;;
    mount|open)
        require_name "$@"
        name="$2"
        mkdir -p "${CLOUD_DIR}/${name}"
        ensure_drive_metadata "${name}" || true
        systemctl --user start "pulsar-cloud@${name}.service"
        [ "$cmd" = "mount" ] && exit 0
        exec xdg-open "${CLOUD_DIR}/${name}"
        ;;
    unmount)
        require_name "$@"
        name="$2"
        systemctl --user stop "pulsar-cloud@${name}.service"
        fusermount3 -uz "${CLOUD_DIR}/${name}" 2>/dev/null || true
        ;;
    list)
        [ -f "$CONF" ] && grep -E '^\[' "$CONF" | tr -d '[]'
        ;;
    *)
        usage
        ;;
esac
