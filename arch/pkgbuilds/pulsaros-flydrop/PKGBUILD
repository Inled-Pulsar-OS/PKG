# Maintainer: Jaime <info@inled.es>
pkgname=pulsaros-flydrop
pkgver=1.0.0
pkgrel=7
pkgdesc="AirDrop & LocalSend v2 integration with Dynamic Island Drop Shelf for Pulsar OS"
arch=(any)
url="https://inled.es"
license=(GPL3)
depends=(python python-gobject gtk4 libadwaita python-dbus python-requests nautilus-python gnome-shell libayatana-appindicator)
optdepends=(
    'localsend: optional external LocalSend app'
)
install=pulsaros-flydrop.install
options=(!strip)

package() {
    _src="$(cd "$startdir"/../../../pulsaros-flydrop && pwd)"
    cd "$_src"

    mkdir -p "$pkgdir/usr/bin"
    install -Dm755 usr/bin/flydrop "$pkgdir/usr/bin/flydrop"
    install -Dm755 usr/bin/flydrop-daemon "$pkgdir/usr/bin/flydrop-daemon"

    mkdir -p "$pkgdir/usr/share/flydrop"
    cp -r usr/share/flydrop/* "$pkgdir/usr/share/flydrop/"

    mkdir -p "$pkgdir/usr/share/gnome-shell/extensions"
    cp -r usr/share/gnome-shell/extensions/flydrop@pulsaros.org "$pkgdir/usr/share/gnome-shell/extensions/"

    mkdir -p "$pkgdir/usr/share/nautilus-python/extensions"
    install -Dm644 usr/share/nautilus-python/extensions/flydrop_nautilus.py "$pkgdir/usr/share/nautilus-python/extensions/flydrop_nautilus.py"

    mkdir -p "$pkgdir/usr/share/applications"
    install -Dm644 usr/share/applications/es.pulsaros.FlyDrop.desktop "$pkgdir/usr/share/applications/es.pulsaros.FlyDrop.desktop"

    mkdir -p "$pkgdir/usr/share/icons/hicolor"
    cp -r usr/share/icons/hicolor/* "$pkgdir/usr/share/icons/hicolor/"

    mkdir -p "$pkgdir/usr/lib/systemd/user"
    install -Dm644 usr/lib/systemd/user/flydrop.service "$pkgdir/usr/lib/systemd/user/flydrop.service"

    mkdir -p "$pkgdir/etc/xdg/autostart"
    install -Dm644 etc/xdg/autostart/flydrop-daemon.desktop "$pkgdir/etc/xdg/autostart/flydrop-daemon.desktop"

    chmod -R a+rX "$pkgdir/usr"
    chmod 755 "$pkgdir/usr/bin/flydrop" "$pkgdir/usr/bin/flydrop-daemon"
    find "$pkgdir/usr/share/flydrop/ui" -type f -name "*.py" -exec chmod 755 {} +
}
