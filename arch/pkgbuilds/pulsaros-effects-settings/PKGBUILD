# Maintainer: Jaime <info@inled.es>
pkgname=pulsaros-effects-settings
pkgver=1.0.120
pkgrel=1
pkgdesc="Desktop effects switcher for Pulsar OS (Blur-my-Shell vs Liquid Glass)"
arch=(any)
url="https://inled.es"
license=(custom)
depends=(python-gobject gtk3)
options=(!strip)

package() {
    _src="$(cd "$startdir"/../../../pulsaros-effects-settings && pwd)"
    cd "$_src"
    [ -d usr ] && cp -r usr "$pkgdir/"
    [ -d etc ] && cp -r etc "$pkgdir/"
    if [ -d "$srcdir/staging" ]; then
        cp -r "$srcdir/staging"/* "$pkgdir/"
    elif [ -d "$srcdir/usr" ]; then
        cp -r "$srcdir/usr" "$pkgdir/"
    fi
}
