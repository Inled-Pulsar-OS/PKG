{
  "format": 1,
  "app": "iotas",
  "name": "Iotas",
  "identifiers": [
    "org.gnome.World.Iotas.desktop",
    "org.gnome.World.Iotas",
    "iotas",
    "Iotas"
  ],
  "menus": [
