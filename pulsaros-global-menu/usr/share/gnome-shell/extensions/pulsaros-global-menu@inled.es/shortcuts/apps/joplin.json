      "items": [
        {"label": "Focus Sidebar", "shortcut": "<Ctrl><Shift>S"},
        {"label": "Focus Toolbar", "shortcut": "<Ctrl><Shift>O"},
        {"label": "Toggle Sidebar", "shortcut": "F10"},
        {"label": "Toggle Menu Bar", "shortcut": "<Ctrl><Shift>M"},
        {"label": "Toggle Visible Panes", "shortcut": "<Ctrl>L"},
        {"label": "Toggle Editors", "shortcut": "<Ctrl><Alt>E"},
        {"label": "Zoom Actual Size", "shortcut": "<Ctrl>0"},
        {"label": "Toggle External Editing", "shortcut": "<Ctrl>E"},
        {"label": "Toggle Comment", "shortcut": "<Ctrl>/"},
        {"label": "Sort Selected Lines", "shortcut": "<Ctrl><Alt>S"},
        {"label": "Toggle Tab Moves Focus", "shortcut": "<Ctrl>M"}
      ]
    },
    {
      "label": "Help",
      "items": [
        {"label": "Help", "shortcut": "F1"}
      ]
