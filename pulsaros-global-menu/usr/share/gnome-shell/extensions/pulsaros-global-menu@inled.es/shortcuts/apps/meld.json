        {"label": "Next Conflict", "shortcut": "<Ctrl>K"},
        {"label": "Previous Conflict", "shortcut": "<Ctrl>J"}
      ]
    },
    {
      "label": "Tools",
      "items": [
        {"label": "Push Change Left", "shortcut": "<Alt>Left"},
        {"label": "Push Change Right", "shortcut": "<Alt>Right"},
        {"label": "Pull Change Left", "shortcut": "<Alt><Shift>Right"},
        {"label": "Pull Change Right", "shortcut": "<Alt><Shift>Left"},
        {"label": "Swap Panes", "shortcut": "<Alt>\\"},
        {"label": "Stop Action", "shortcut": "Escape"},
        {"label": "Version Control Commit", "shortcut": "<Ctrl>M"}
      ]
    },
    {
      "label": "Help",
      "items": [
        {"label": "Help", "shortcut": "F1"}
