{
  "format": 1,
  "app": "extension-manager",
  "name": "Extension Manager",
  "identifiers": [
    "com.mattjakeman.ExtensionManager.desktop",
    "extension manager",
    "Extension Manager"
  ],
  "menus": [
    {
