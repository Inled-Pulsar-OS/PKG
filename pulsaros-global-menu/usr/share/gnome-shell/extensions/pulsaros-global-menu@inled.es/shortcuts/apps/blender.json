{
  "format": 1,
  "app": "blender",
  "name": "Blender",
  "identifiers": [
    "blender.desktop",
    "org.blender.Blender.desktop",
    "blender",
    "Blender"
  ],
  "menus": [
    {
      "label": "File",
      "items": [
        {"label": "New File", "shortcut": "<Ctrl>N"},
        {"label": "Open File", "shortcut": "<Ctrl>O"},
        {"label": "Open Recent", "shortcut": "<Ctrl><Shift>O"},
        {"label": "Save File", "shortcut": "<Ctrl>S"},
        {"label": "Save File As", "shortcut": "<Ctrl><Shift>S"},
        {"label": "Quit Blender", "shortcut": "<Ctrl>Q"}
      ]
    },
    {
      "label": "Edit",
      "items": [
        {"label": "Undo", "shortcut": "<Ctrl>Z"},
        {"label": "Redo", "shortcut": "<Ctrl><Shift>Z"},
        {"label": "Undo History", "shortcut": "<Ctrl><Alt>Z"},
        {"label": "Search Menu / Operator Search", "shortcut": "F3"},
        {"label": "Preferences", "shortcut": "<Ctrl>,"},
        {"label": "Select All", "shortcut": "A"},
        {"label": "Deselect All", "shortcut": "<Alt>A"},
        {"label": "Invert Selection", "shortcut": "<Ctrl>I"},
        {"label": "Delete", "shortcut": "Delete"},
        {"label": "Duplicate Objects", "shortcut": "<Shift>D"},
        {"label": "Linked Duplicate", "shortcut": "<Alt>D"}
      ]
    },
    {
      "label": "View",
      "items": [
        {"label": "Hide Selected", "shortcut": "H"},
        {"label": "Hide Unselected", "shortcut": "<Shift>H"},
        {"label": "Toggle Fullscreen Area", "shortcut": "<Ctrl>space"},
        {"label": "Toggle Maximize Area", "shortcut": "<Ctrl><Alt>space"},
        {"label": "Toggle Sidebar", "shortcut": "N"},
        {"label": "Toggle Toolbar", "shortcut": "T"}
      ]
    },
    {
      "label": "Go",
      "items": [
        {"label": "Repeat Last Action", "shortcut": "<Shift>R"}
      ]
    },
    {
      "label": "Tools",
      "items": [
        {"label": "Quick Favorites Menu", "shortcut": "Q"},
        {"label": "Box Select", "shortcut": "B"},
        {"label": "Circle Select", "shortcut": "C"},
        {"label": "Add Object / Menu", "shortcut": "<Shift>A"},
        {"label": "Unhide All", "shortcut": "<Alt>H"},
        {"label": "Move / Grab", "shortcut": "G"},
        {"label": "Rotate", "shortcut": "R"},
        {"label": "Scale", "shortcut": "S"},
        {"label": "Switch Interaction Mode (Object/Edit)", "shortcut": "Tab"},
        {"label": "Frame Selected / View Selected", "shortcut": "KP_Decimal"},
        {"label": "Frame All / View All", "shortcut": "Home"},
        {"label": "Viewport Shading Pie Menu", "shortcut": "Z"},
        {"label": "Render Image", "shortcut": "F12"},
        {"label": "Render Animation", "shortcut": "<Ctrl>F12"},
        {"label": "Play / Pause Animation", "shortcut": "space"}
      ]
    }
  ]
}
