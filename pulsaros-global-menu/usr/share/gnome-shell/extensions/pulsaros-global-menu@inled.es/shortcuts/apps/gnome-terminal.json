{
  "format": 1,
  "app": "gnome-terminal",
  "name": "Terminal",
  "identifiers": [
    "org.gnome.Terminal.desktop",
    "gnome-terminal-server",
    "gnome-terminal"
  ],
  "menus": [
    {
      "label": "File",
      "items": [
        {"label": "New Tab", "shortcut": "<Ctrl><Shift>T"},
        {"label": "New Window", "shortcut": "<Ctrl><Shift>N"},
        {"label": "Close Tab", "shortcut": "<Ctrl><Shift>W"},
        {"label": "Close Window", "shortcut": "<Ctrl><Shift>Q"}
      ]
    },
    {
      "label": "Edit",
      "items": [
        {"label": "Copy", "shortcut": "<Ctrl><Shift>C"},
        {"label": "Paste", "shortcut": "<Ctrl><Shift>V"},
        {"label": "Select All", "shortcut": "<Ctrl><Shift>A"},
        {"label": "Find", "shortcut": "<Ctrl><Shift>F"},
        {"label": "Find Next", "shortcut": "<Ctrl><Shift>G"},
        {"label": "Find Previous", "shortcut": "<Ctrl><Shift>H"},
        {"label": "Clear Highlight", "shortcut": "<Ctrl><Shift>J"},
        {"label": "Preferences", "shortcut": "<Ctrl><Shift>P"}
      ]
    },
    {
      "label": "View",
      "items": [
        {"label": "Zoom In", "shortcut": "<Ctrl>+"},
        {"label": "Zoom Out", "shortcut": "<Ctrl>-"},
        {"label": "Normal Size", "shortcut": "<Ctrl>0"},
        {"label": "Toggle Fullscreen", "shortcut": "F11"},
        {"label": "Scroll Up One Line", "shortcut": "<Ctrl><Shift>Up"},
        {"label": "Scroll Down One Line", "shortcut": "<Ctrl><Shift>Down"},
        {"label": "Scroll Up One Page", "shortcut": "<Shift>Page_Up"},
        {"label": "Scroll Down One Page", "shortcut": "<Shift>Page_Down"},
        {"label": "Scroll to Top", "shortcut": "<Shift>Home"},
        {"label": "Scroll to Bottom", "shortcut": "<Shift>End"}
      ]
    },
    {
      "label": "Tabs",
      "items": [
        {"label": "Switch to Previous Tab", "shortcut": "<Ctrl>Page_Up"},
        {"label": "Switch to Next Tab", "shortcut": "<Ctrl>Page_Down"},
        {"label": "Move Tab Left", "shortcut": "<Ctrl><Shift>Page_Up"},
        {"label": "Move Tab Right", "shortcut": "<Ctrl><Shift>Page_Down"},
        {"separator": true},
        {"label": "Switch to Tab 10", "shortcut": "<Alt>0"},
        {"label": "Switch to Tab 1", "shortcut": "<Alt>1"},
        {"label": "Switch to Tab 2", "shortcut": "<Alt>2"},
        {"label": "Switch to Tab 3", "shortcut": "<Alt>3"},
        {"label": "Switch to Tab 4", "shortcut": "<Alt>4"},
        {"label": "Switch to Tab 5", "shortcut": "<Alt>5"},
        {"label": "Switch to Tab 6", "shortcut": "<Alt>6"},
        {"label": "Switch to Tab 7", "shortcut": "<Alt>7"},
        {"label": "Switch to Tab 8", "shortcut": "<Alt>8"},
        {"label": "Switch to Tab 9", "shortcut": "<Alt>9"}
      ]
    },
    {
      "label": "Help",
      "items": [
        {"label": "Help", "shortcut": "F1"}
      ]
    }
  ]
}
