{
  "format": 1,
  "app": "focuswriter",
  "name": "FocusWriter",
  "identifiers": [
    "focuswriter.desktop",
    "io.github.gottcode.focuswriter.desktop",
    "focuswriter",
    "FocusWriter"
  ],
  "menus": [
    {
      "label": "File",
      "items": [
        {"label": "Create New Document", "shortcut": "<Ctrl>N"},
        {"label": "Open Document", "shortcut": "<Ctrl>O"},
        {"label": "Save Document", "shortcut": "<Ctrl>S"},
        {"label": "Save Document As", "shortcut": "<Ctrl><Shift>S"},
        {"label": "Save All Documents", "shortcut": "<Ctrl><Alt>S"},
        {"label": "Close Current Document", "shortcut": "<Ctrl>W"},
        {"label": "Close All Documents", "shortcut": "<Ctrl><Shift>W"},
        {"label": "Print Document", "shortcut": "<Ctrl>P"},
        {"label": "Open Timers Dialog", "shortcut": "F6"},
        {"label": "Open Daily Progress Goal", "shortcut": "F8"},
        {"label": "Quit FocusWriter", "shortcut": "<Ctrl>Q"}
      ]
    },
    {
      "label": "Edit",
      "items": [
        {"label": "Undo", "shortcut": "<Ctrl>Z"},
        {"label": "Redo", "shortcut": "<Ctrl>Y"},
        {"label": "Cut", "shortcut": "<Ctrl>X"},
        {"label": "Copy", "shortcut": "<Ctrl>C"},
        {"label": "Paste", "shortcut": "<Ctrl>V"},
        {"label": "Select All", "shortcut": "<Ctrl>A"},
        {"label": "Find Text", "shortcut": "<Ctrl>F"},
        {"label": "Find Next Match", "shortcut": "F3"},
        {"label": "Find Previous Match", "shortcut": "<Shift>F3"},
        {"label": "Replace Text", "shortcut": "<Ctrl>R"},
        {"label": "Check Spelling", "shortcut": "F7"},
        {"label": "Insert Special Symbols", "shortcut": "<Ctrl>T"},
        {"label": "Open Preferences / Settings", "shortcut": "<Ctrl>,"}
      ]
    },
    {
      "label": "View",
      "items": [
        {"label": "Toggle Fullscreen", "shortcut": "F11"}
      ]
    },
    {
      "label": "Go",
      "items": [
        {"label": "Go to Line", "shortcut": "<Ctrl>G"}
      ]
    }
  ]
}
