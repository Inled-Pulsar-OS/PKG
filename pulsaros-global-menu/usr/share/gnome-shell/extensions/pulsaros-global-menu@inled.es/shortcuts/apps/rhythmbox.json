{
  "format": 1,
  "app": "rhythmbox",
  "name": "Rhythmbox",
  "identifiers": [
    "org.gnome.Rhythmbox3.desktop",
    "rhythmbox",
    "Rhythmbox"
  ],
  "menus": [
    {
      "label": "File",
      "items": [
        {"label": "New Playlist", "shortcut": "<Ctrl>N"},
        {"label": "Add Music to Library (Import)", "shortcut": "<Ctrl>O"},
        {"label": "Close Window", "shortcut": "<Ctrl>W"},
        {"label": "Quit Rhythmbox", "shortcut": "<Ctrl>Q"}
      ]
    },
    {
      "label": "Edit",
      "items": [
        {"label": "Cut", "shortcut": "<Ctrl>X"},
        {"label": "Copy", "shortcut": "<Ctrl>C"},
        {"label": "Paste", "shortcut": "<Ctrl>V"},
        {"label": "Select All", "shortcut": "<Ctrl>A"},
        {"label": "Deselect All", "shortcut": "<Ctrl><Shift>A"},
        {"label": "Move to Trash", "shortcut": "Delete"},
        {"label": "Search / Filter Library", "shortcut": "<Ctrl>F"},
        {"label": "Preferences", "shortcut": "<Ctrl><Shift>P"}
      ]
    },
    {
      "label": "Playback",
      "items": [
        {"label": "Play / Pause", "shortcut": "<Ctrl>P"},
        {"label": "Toggle Shuffle", "shortcut": "<Ctrl>U"},
        {"label": "Toggle Repeat", "shortcut": "<Ctrl>R"},
        {"label": "Play Queue in Side Pane", "shortcut": "<Ctrl>K"}
      ]
    },
    {
      "label": "Audio",
      "items": [
        {"label": "Next Track", "shortcut": "<Ctrl>Right"},
        {"label": "Previous Track", "shortcut": "<Ctrl>Left"},
        {"label": "Volume Up", "shortcut": "<Ctrl>Up"},
        {"label": "Volume Down", "shortcut": "<Ctrl>Down"},
        {"label": "Track Properties", "shortcut": "<Alt>Return"}
      ]
    },
    {
      "label": "View",
      "items": [
        {"label": "Toggle Side Pane", "shortcut": "F9"}
      ]
    },
    {
      "label": "Help",
      "items": [
        {"label": "Help Contents", "shortcut": "F1"}
      ]
    }
  ]
}
