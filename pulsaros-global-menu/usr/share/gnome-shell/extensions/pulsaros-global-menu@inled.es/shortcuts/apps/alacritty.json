{
  "format": 1,
  "app": "alacritty",
  "name": "Alacritty",
  "identifiers": [
    "Alacritty.desktop",
    "org.alacritty.Alacritty.desktop",
    "alacritty",
    "Alacritty"
  ],
  "menus": [
    {
      "label": "File",
