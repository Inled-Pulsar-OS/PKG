{
  "format": 1,
  "app": "darktable",
  "name": "Darktable",
  "identifiers": [
    "darktable.desktop",
    "darktable",
    "Darktable"
  ],
  "menus": [
    {
      "label": "File",
      "items": [
        {"label": "Quit Darktable", "shortcut": "<Ctrl>Q"},
        {"label": "Export Selected Images", "shortcut": "<Ctrl>E"}
      ]
    },
    {
      "label": "Edit",
      "items": [
        {"label": "Open Preferences", "shortcut": "<Ctrl>,"},
        {"label": "Select All Images", "shortcut": "<Ctrl>A"},
        {"label": "Deselect All Images", "shortcut": "<Ctrl><Shift>A"},
        {"label": "Invert Image Selection", "shortcut": "<Ctrl>!"},
        {"label": "Duplicate Image", "shortcut": "<Ctrl>D"},
        {"label": "Move Image to Trash", "shortcut": "Delete"},
        {"label": "Delete Image Permanently", "shortcut": "<Shift>Delete"},
        {"label": "Darkroom Undo", "shortcut": "<Ctrl>Z"},
        {"label": "Darkroom Redo", "shortcut": "<Ctrl><Shift>Z"}
      ]
    },
    {
      "label": "View",
      "items": [
        {"label": "Switch to Lighttable View", "shortcut": "L"},
        {"label": "Switch to Darkroom View", "shortcut": "D"},
        {"label": "Switch to Map View", "shortcut": "M"},
        {"label": "Switch to Slideshow View", "shortcut": "S"},
        {"label": "Switch to Print View", "shortcut": "P"},
        {"label": "Toggle Fullscreen", "shortcut": "F11"},
        {"label": "Toggle All Side Panels", "shortcut": "Tab"},
        {"label": "Toggle Left Panel", "shortcut": "<Ctrl><Shift>L"},
        {"label": "Toggle Right Panel", "shortcut": "<Ctrl><Shift>R"},
