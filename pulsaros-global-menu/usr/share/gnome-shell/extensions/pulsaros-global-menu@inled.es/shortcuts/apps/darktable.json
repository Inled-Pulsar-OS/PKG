    {
      "label": "Image",
      "items": [
        {"label": "Rate Image 0 Stars", "shortcut": "0"},
        {"label": "Rate Image 1 Star", "shortcut": "1"},
        {"label": "Rate Image 2 Stars", "shortcut": "2"},
        {"label": "Rate Image 3 Stars", "shortcut": "3"},
        {"label": "Rate Image 4 Stars", "shortcut": "4"},
        {"label": "Rate Image 5 Stars", "shortcut": "5"},
        {"label": "Toggle Over/Under Exposure Warning", "shortcut": "<Ctrl>O"}
      ]
    },
    {
      "label": "Tools",
      "items": [
        {"label": "Reject Image", "shortcut": "R"}
      ]
    },
    {
      "label": "Help",
      "items": [
        {"label": "Keyboard Shortcuts Help Overlay", "shortcut": "H"}
      ]
    }
