{
  "format": 1,
  "app": "brave",
  "name": "Brave",
  "identifiers": [
    "com.brave.Browser.desktop",
    "com.brave.Browser",
    "brave-browser",
    "brave",
    "Brave",
    "brave-origin.desktop",
    "com.brave.Origin.desktop",
    "brave-origin"
  ],
  "menus": [
    {
      "label": "File",
      "items": [
        {"label": "New Tab", "shortcut": "<Ctrl>T"},
        {"label": "New Window", "shortcut": "<Ctrl>N"},
        {"label": "New Private Window", "shortcut": "<Ctrl><Shift>N"},
        {"label": "New Private Window with Tor", "shortcut": "<Alt><Shift>N"},
        {"label": "Open File", "shortcut": "<Ctrl>O"},
        {"label": "Open Location", "shortcut": "<Ctrl>L"},
        {"separator": true},
        {"label": "Save Page As", "shortcut": "<Ctrl>S"},
        {"label": "Print", "shortcut": "<Ctrl>P"},
        {"separator": true},
        {"label": "Close Tab", "shortcut": "<Ctrl>W"},
        {"label": "Close Window", "shortcut": "<Ctrl><Shift>W"},
        {"separator": true},
        {"label": "Quit", "shortcut": "<Ctrl><Shift>Q"}
      ]
    },
    {
      "label": "Edit",
      "items": [
        {"label": "Undo", "shortcut": "<Ctrl>Z"},
        {"label": "Redo", "shortcut": "<Ctrl><Shift>Z"},
        {"separator": true},
        {"label": "Cut", "shortcut": "<Ctrl>X"},
        {"label": "Copy", "shortcut": "<Ctrl>C"},
        {"label": "Paste", "shortcut": "<Ctrl>V"},
        {"label": "Paste as Plain Text", "shortcut": "<Ctrl><Shift>V"},
        {"label": "Select All", "shortcut": "<Ctrl>A"},
        {"separator": true},
        {"label": "Find in Page", "shortcut": "<Ctrl>F"},
        {"label": "Find Next", "shortcut": "<Ctrl>G"},
        {"label": "Find Previous", "shortcut": "<Ctrl><Shift>G"},
        {"separator": true},
        {"label": "Clear Browsing Data", "shortcut": "<Ctrl><Shift>Delete"}
      ]
    },
    {
      "label": "View",
      "items": [
        {"label": "Zoom In", "shortcut": "<Ctrl>plus"},
        {"label": "Zoom Out", "shortcut": "<Ctrl>minus"},
        {"label": "Reset Zoom", "shortcut": "<Ctrl>0"},
        {"separator": true},
        {"label": "Toggle Fullscreen", "shortcut": "F11"},
        {"label": "Toggle Caret Browsing", "shortcut": "F7"},
        {"separator": true},
        {"label": "View Page Source", "shortcut": "<Ctrl>U"},
        {"label": "Toggle Developer Tools", "shortcut": "<Ctrl><Shift>I"},
        {"label": "Toggle JavaScript Console", "shortcut": "<Ctrl><Shift>J"},
        {"label": "Inspect Element", "shortcut": "<Ctrl><Shift>C"},
        {"separator": true},
        {"label": "Task Manager", "shortcut": "<Shift>Escape"}
      ]
    },
    {
      "label": "Go",
      "items": [
        {"label": "Back", "shortcut": "<Alt>Left"},
        {"label": "Forward", "shortcut": "<Alt>Right"},
        {"label": "Home", "shortcut": "<Alt>Home"},
        {"separator": true},
        {"label": "Reload Page", "shortcut": "<Ctrl>R"},
        {"label": "Reload Page (Skip Cache)", "shortcut": "<Ctrl><Shift>R"},
        {"label": "Stop Loading", "shortcut": "Escape"},
        {"separator": true},
        {"label": "Search with Default Engine", "shortcut": "<Ctrl>K"},
        {"separator": true},
        {"label": "Show History", "shortcut": "<Ctrl>H"},
        {"label": "Show Downloads", "shortcut": "<Ctrl>J"}
      ]
    },
    {
      "label": "Bookmarks",
      "items": [
        {"label": "Bookmark Current Tab", "shortcut": "<Ctrl>D"},
        {"label": "Bookmark All Open Tabs", "shortcut": "<Ctrl><Shift>D"},
        {"separator": true},
        {"label": "Show Bookmarks Bar", "shortcut": "<Ctrl><Shift>B"},
        {"label": "Show Bookmarks Manager", "shortcut": "<Ctrl><Shift>O"}
      ]
    },
    {
      "label": "Tabs",
      "items": [
        {"label": "Reopen Closed Tab", "shortcut": "<Ctrl><Shift>T"},
        {"separator": true},
        {"label": "Next Tab", "shortcut": "<Ctrl>Page_Down"},
        {"label": "Previous Tab", "shortcut": "<Ctrl>Page_Up"},
        {"separator": true},
        {"label": "Tab 1", "shortcut": "<Ctrl>1"},
        {"label": "Tab 2", "shortcut": "<Ctrl>2"},
        {"label": "Tab 3", "shortcut": "<Ctrl>3"},
        {"label": "Tab 4", "shortcut": "<Ctrl>4"},
        {"label": "Tab 5", "shortcut": "<Ctrl>5"},
        {"label": "Tab 6", "shortcut": "<Ctrl>6"},
        {"label": "Tab 7", "shortcut": "<Ctrl>7"},
        {"label": "Tab 8", "shortcut": "<Ctrl>8"},
        {"label": "Select Last Tab", "shortcut": "<Ctrl>9"}
      ]
    }
  ]
}
