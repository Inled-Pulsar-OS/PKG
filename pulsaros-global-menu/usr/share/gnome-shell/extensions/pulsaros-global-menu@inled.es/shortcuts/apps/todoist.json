{
  "format": 1,
  "app": "todoist",
  "name": "Todoist",
  "identifiers": [
    "todoist.desktop",
    "com.todoist.Todoist.desktop",
    "todoist",
    "Todoist"
  ],
  "menus": [
    {
      "label": "File",
      "items": [
        {"label": "Open Command Menu", "shortcut": "<Ctrl>K"},
        {"label": "Close Modal / Clear Selection", "shortcut": "Escape"},
        {"label": "Quit Todoist", "shortcut": "<Ctrl>Q"}
      ]
    },
    {
      "label": "Edit",
      "items": [
        {"label": "Quick Add Task", "shortcut": "Q"},
        {"label": "Focus Search", "shortcut": "/"},
        {"label": "Open Settings", "shortcut": "<Ctrl>,"},
        {"label": "Complete Selected Task", "shortcut": "E"},
        {"label": "Edit Selected Task", "shortcut": "Return"},
        {"label": "Change Due Date", "shortcut": "D"},
        {"label": "Set Priority", "shortcut": "P"},
        {"label": "Move Task to Project", "shortcut": "V"},
        {"label": "Undo Last Action", "shortcut": "U"}
