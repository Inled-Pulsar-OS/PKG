        {"label": "Go to Upcoming", "shortcut": "g u"},
        {"label": "Go to Filters & Labels", "shortcut": "g f"}
      ]
    },
    {
      "label": "Help",
      "items": [
        {"label": "Open Keyboard Shortcuts Cheat Sheet", "shortcut": "?"}
      ]
    }
  ]
