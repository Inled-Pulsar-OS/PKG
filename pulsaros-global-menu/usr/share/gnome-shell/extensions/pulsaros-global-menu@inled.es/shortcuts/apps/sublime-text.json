{
  "format": 1,
  "app": "sublime-text",
  "name": "Sublime Text",
  "identifiers": [
    "sublime_text.desktop",
    "sublime-text",
    "sublime_text",
    "sublime text",
    "Sublime Text"
  ],
  "menus": [
    {
      "label": "File",
      "items": [
        {"label": "New File", "shortcut": "<Ctrl>N"},
        {"label": "Open File", "shortcut": "<Ctrl>O"},
        {"label": "Save", "shortcut": "<Ctrl>S"},
        {"label": "Save As", "shortcut": "<Ctrl><Shift>S"},
        {"label": "Save All", "shortcut": "<Ctrl>k <Ctrl>s"},
        {"label": "Close File", "shortcut": "<Ctrl>W"},
        {"label": "Close Window", "shortcut": "<Ctrl><Shift>W"},
        {"label": "Close All Files", "shortcut": "<Ctrl>k <Ctrl>w"},
        {"label": "Reopen Closed File", "shortcut": "<Ctrl><Shift>T"},
        {"label": "Quit Sublime Text", "shortcut": "<Ctrl>Q"}
      ]
    },
    {
      "label": "Edit",
      "items": [
        {"label": "Undo", "shortcut": "<Ctrl>Z"},
        {"label": "Redo", "shortcut": "<Ctrl>Y"},
        {"label": "Cut", "shortcut": "<Ctrl>X"},
        {"label": "Copy", "shortcut": "<Ctrl>C"},
        {"label": "Paste", "shortcut": "<Ctrl>V"},
        {"label": "Paste and Indent", "shortcut": "<Ctrl><Shift>V"},
        {"label": "Find", "shortcut": "<Ctrl>F"},
        {"label": "Find Next", "shortcut": "F3"},
        {"label": "Find Previous", "shortcut": "<Shift>F3"},
        {"label": "Replace", "shortcut": "<Ctrl>H"},
        {"label": "Find in Files", "shortcut": "<Ctrl><Shift>F"},
        {"label": "Toggle Line Comment", "shortcut": "<Ctrl>/"},
        {"label": "Toggle Block Comment", "shortcut": "<Ctrl><Shift>/"},
        {"label": "Duplicate Line", "shortcut": "<Ctrl><Shift>D"},
        {"label": "Delete Line", "shortcut": "<Ctrl><Shift>K"},
        {"label": "Move Line Up", "shortcut": "<Ctrl><Shift>Up"},
        {"label": "Move Line Down", "shortcut": "<Ctrl><Shift>Down"},
        {"label": "Join Lines", "shortcut": "<Ctrl>J"},
        {"label": "Indent", "shortcut": "<Ctrl>]"},
        {"label": "Unindent", "shortcut": "<Ctrl>["},
        {"label": "Preferences / Settings"}
      ]
    },
    {
      "label": "Selection",
      "items": [
        {"label": "Select All", "shortcut": "<Ctrl>A"},
        {"label": "Quick Add Next (Multiple Cursors)", "shortcut": "<Ctrl>D"},
        {"label": "Select All Occurrences", "shortcut": "<Alt>F3"}
      ]
    },
    {
      "label": "View",
      "items": [
        {"label": "Command Palette", "shortcut": "<Ctrl><Shift>P"},
        {"label": "Toggle Side Bar", "shortcut": "<Ctrl>k <Ctrl>b"},
        {"label": "Toggle Full Screen", "shortcut": "F11"},
        {"label": "Toggle Distraction Free", "shortcut": "<Shift>F11"}
      ]
    },
    {
      "label": "Go",
      "items": [
        {"label": "Quick Open / Goto Anything", "shortcut": "<Ctrl>P"},
        {"label": "Goto Line", "shortcut": "<Ctrl>G"},
        {"label": "Goto Symbol", "shortcut": "<Ctrl>R"},
        {"label": "Goto Symbol in Project", "shortcut": "<Ctrl><Shift>R"},
        {"label": "Quick Skip Next", "shortcut": "<Ctrl>k <Ctrl>d"},
        {"label": "Next Tab", "shortcut": "<Ctrl>Page_Down"},
        {"label": "Previous Tab", "shortcut": "<Ctrl>Page_Up"},
        {"separator": true},
        {"label": "Switch to Tab 1", "shortcut": "<Alt>1"},
        {"label": "Switch to Tab 2", "shortcut": "<Alt>2"},
        {"label": "Switch to Tab 3", "shortcut": "<Alt>3"},
        {"label": "Switch to Tab 4", "shortcut": "<Alt>4"},
        {"label": "Switch to Tab 5", "shortcut": "<Alt>5"},
        {"label": "Switch to Tab 6", "shortcut": "<Alt>6"},
        {"label": "Switch to Tab 7", "shortcut": "<Alt>7"},
        {"label": "Switch to Tab 8", "shortcut": "<Alt>8"},
        {"label": "Switch to Tab 9", "shortcut": "<Alt>9"}
      ]
    }
  ]
}
