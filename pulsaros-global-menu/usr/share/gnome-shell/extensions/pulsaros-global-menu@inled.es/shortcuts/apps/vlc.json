{
  "format": 1,
  "app": "vlc",
  "name": "VLC",
  "identifiers": [
    "vlc.desktop",
    "org.videolan.VLC.desktop",
    "vlc",
    "VLC"
  ],
  "menus": [
    {
      "label": "File",
      "items": [
        {"label": "Open File", "shortcut": "<Ctrl>O"},
        {"label": "Open Multiple Files", "shortcut": "<Ctrl><Shift>O"},
        {"label": "Open Folder", "shortcut": "<Ctrl>F"},
        {"label": "Open Disc", "shortcut": "<Ctrl>D"},
        {"label": "Open Network Stream", "shortcut": "<Ctrl>N"},
        {"label": "Open Capture Device", "shortcut": "<Ctrl>C"},
        {"label": "Open Location from Clipboard", "shortcut": "<Ctrl>V"},
        {"label": "Save Playlist to File", "shortcut": "<Ctrl>Y"},
        {"label": "Convert / Save", "shortcut": "<Ctrl>R"},
        {"label": "Stream", "shortcut": "<Ctrl>S"},
        {"label": "Quit", "shortcut": "<Ctrl>Q"}
      ]
    },
    {
      "label": "Edit",
      "items": [
        {"label": "Preferences", "shortcut": "<Ctrl>P"}
      ]
    },
    {
      "label": "Playback",
      "items": [
        {"label": "Play / Pause", "shortcut": "space"},
        {"label": "Stop", "shortcut": "S"},
        {"label": "Faster Playback", "shortcut": "+"},
        {"label": "Slower Playback", "shortcut": "-"},
        {"label": "Normal Playback Speed", "shortcut": "="},
        {"label": "Next Frame", "shortcut": "E"},
        {"label": "Jump 3 Seconds Forward", "shortcut": "<Shift>Right"},
        {"label": "Jump 3 Seconds Backward", "shortcut": "<Shift>Left"},
        {"label": "Jump 10 Seconds Forward", "shortcut": "<Alt>Right"},
        {"label": "Jump 10 Seconds Backward", "shortcut": "<Alt>Left"},
        {"label": "Jump 1 Minute Forward", "shortcut": "<Ctrl>Right"},
        {"label": "Jump 1 Minute Backward", "shortcut": "<Ctrl>Left"},
        {"label": "Jump 5 Minutes Forward", "shortcut": "<Ctrl><Alt>Right"},
        {"label": "Jump 5 Minutes Backward", "shortcut": "<Ctrl><Alt>Left"}
      ]
    },
    {
      "label": "Audio",
      "items": [
        {"label": "Next Track", "shortcut": "N"},
        {"label": "Previous Track", "shortcut": "P"},
        {"label": "Mute Volume", "shortcut": "M"},
        {"label": "Increase Volume", "shortcut": "<Ctrl>Up"},
        {"label": "Decrease Volume", "shortcut": "<Ctrl>Down"},
        {"label": "Cycle Audio Tracks", "shortcut": "B"},
        {"label": "Audio Delay +50ms", "shortcut": "K"},
        {"label": "Audio Delay -50ms", "shortcut": "J"}
      ]
    },
    {
      "label": "Video",
      "items": [
        {"label": "Take Snapshot", "shortcut": "<Shift>S"}
      ]
    },
    {
      "label": "Subtitles",
      "items": [
        {"label": "Cycle Subtitle Tracks", "shortcut": "V"},
        {"label": "Subtitle Delay +50ms", "shortcut": "H"},
        {"label": "Subtitle Delay -50ms", "shortcut": "G"}
      ]
    },
    {
      "label": "View",
      "items": [
        {"label": "Toggle Fullscreen", "shortcut": "F"},
        {"label": "Exit Fullscreen", "shortcut": "Escape"},
        {"label": "Minimal Interface", "shortcut": "<Ctrl>H"},
        {"label": "Show / Hide Playlist", "shortcut": "<Ctrl>L"}
      ]
    },
    {
      "label": "Tools",
      "items": [
        {"label": "Effects and Filters", "shortcut": "<Ctrl>E"},
        {"label": "Track Synchronization", "shortcut": "<Ctrl><Shift>S"},
        {"label": "Media Information", "shortcut": "<Ctrl>I"},
        {"label": "Codec Information", "shortcut": "<Ctrl>J"},
        {"label": "Messages Log", "shortcut": "<Ctrl>M"}
      ]
    }
  ]
}
