        {"label": "Reload", "shortcut": "r"},
        {"label": "Reload Ignoring Cache", "shortcut": "<Shift>r"},
        {"label": "Stop Loading", "shortcut": "<Ctrl>s"},
        {"separator": true},
        {"label": "Zoom In", "shortcut": "plus"},
        {"label": "Zoom Out", "shortcut": "minus"},
        {"label": "Reset Zoom", "shortcut": "equal"},
        {"separator": true},
        {"label": "Fullscreen", "shortcut": "F11"},
        {"label": "View Source", "shortcut": "g f"},
        {"label": "Developer Tools", "shortcut": "w i"}
      ]
    },
    {
      "label": "Go",
      "items": [
        {"label": "Back", "shortcut": "<Shift>h"},
        {"label": "Forward", "shortcut": "<Shift>l"},
        {"label": "Home", "shortcut": "<Ctrl>h"},
