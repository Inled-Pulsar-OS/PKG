        {"label": "Scroll to Top", "shortcut": "g g"},
        {"label": "Scroll to Bottom", "shortcut": "<Shift>g"},
        {"label": "Page Down", "shortcut": "<Ctrl>f"},
        {"label": "Page Up", "shortcut": "<Ctrl>b"},
        {"separator": true},
        {"label": "Up One Directory", "shortcut": "g u"},
        {"label": "Next Page", "shortcut": "bracketright bracketright"},
        {"label": "Previous Page", "shortcut": "bracketleft bracketleft"}
