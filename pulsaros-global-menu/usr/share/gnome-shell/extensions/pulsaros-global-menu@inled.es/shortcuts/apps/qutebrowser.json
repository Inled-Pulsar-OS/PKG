{
  "format": 1,
  "app": "qutebrowser",
  "name": "qutebrowser",
  "identifiers": [
    "org.qutebrowser.qutebrowser.desktop",
    "qutebrowser.desktop",
    "qutebrowser",
    "org.qutebrowser.qutebrowser"
  ],
  "menus": [
    {
      "label": "File",
      "items": [
        {"label": "Open", "shortcut": "o"},
        {"label": "Open in New Tab", "shortcut": "<Shift>o"},
        {"label": "New Tab", "shortcut": "<Ctrl>t"},
        {"label": "New Window", "shortcut": "<Ctrl>n"},
        {"label": "New Private Window", "shortcut": "<Ctrl><Shift>n"},
        {"separator": true},
        {"label": "Save Page", "shortcut": "s f"},
        {"label": "Print", "shortcut": "<Ctrl><Alt>p"},
        {"separator": true},
        {"label": "Close Tab", "shortcut": "d"},
        {"label": "Close Other Tabs", "shortcut": "c o"},
        {"label": "Close Window", "shortcut": "<Ctrl><Shift>w"},
        {"label": "Quit", "shortcut": "<Ctrl>q"},
        {"label": "Save Session and Quit", "shortcut": "<Shift>z <Shift>z"}
      ]
    },
    {
      "label": "Edit",
      "items": [
        {"label": "Undo Close Tab", "shortcut": "u"},
        {"label": "Undo Close Window", "shortcut": "<Shift>u"},
        {"separator": true},
        {"label": "Yank URL", "shortcut": "y y"},
        {"label": "Yank Title", "shortcut": "y t"},
        {"label": "Yank Domain", "shortcut": "y d"},
        {"label": "Yank as Markdown Link", "shortcut": "y m"},
        {"separator": true},
        {"label": "Open Clipboard", "shortcut": "p p"},
        {"label": "Open Clipboard in New Tab", "shortcut": "<Shift>p p"},
