    },
    {
      "label": "Bookmarks",
      "items": [
        {"label": "Save Quickmark", "shortcut": "m"},
        {"label": "Load Quickmark", "shortcut": "b"},
        {"label": "Load Quickmark in New Tab", "shortcut": "<Shift>b"},
