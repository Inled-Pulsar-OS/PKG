        {"label": "Add Bookmark", "shortcut": "<Shift>m"},
        {"label": "Load Bookmark", "shortcut": "g b"},
        {"label": "List Bookmarks", "shortcut": "<Shift>s q"},
        {"separator": true},
        {"label": "History", "shortcut": "<Shift>s h"},
        {"label": "Downloads", "shortcut": "g d"},
        {"label": "Clear Downloads", "shortcut": "c d"},
        {"label": "Settings", "shortcut": "<Shift>s s"}
