        {"label": "New Database", "shortcut": "<Ctrl><Shift>N"},
        {"label": "Close Database", "shortcut": "<Ctrl>W"},
        {"label": "New Entry", "shortcut": "<Ctrl>N"},
        {"label": "Open URL", "shortcut": "<Ctrl><Shift>U"},
        {"label": "Quit", "shortcut": "<Ctrl>Q"}
      ]
    },
    {
      "label": "Edit",
      "items": [
        {"label": "Delete Entry", "shortcut": "Delete"},
        {"label": "Copy Username", "shortcut": "<Ctrl>B"},
        {"label": "Copy Password", "shortcut": "<Ctrl>C"},
        {"label": "Copy URL", "shortcut": "<Ctrl>U"},
        {"label": "Copy Title", "shortcut": "<Ctrl>I"},
        {"label": "Copy TOTP", "shortcut": "<Ctrl>T"},
        {"label": "Copy Password and TOTP", "shortcut": "<Ctrl>Y"},
        {"label": "Application Settings", "shortcut": "<Ctrl>,"},
        {"label": "Database Settings", "shortcut": "<Ctrl><Shift>,"},
        {"label": "Remove Key from SSH Agent", "shortcut": "<Ctrl><Shift>H"}
      ]
    },
    {
      "label": "View",
      "items": [
        {"label": "Show TOTP", "shortcut": "<Ctrl><Shift>T"},
