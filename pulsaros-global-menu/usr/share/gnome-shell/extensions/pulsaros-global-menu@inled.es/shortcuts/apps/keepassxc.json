        {"label": "Move Entry Down", "shortcut": "<Alt>Down"},
        {"label": "Perform Auto-Type", "shortcut": "<Ctrl><Shift>V"},
        {"label": "Lock Database", "shortcut": "<Ctrl>L"},
        {"label": "Lock All Databases", "shortcut": "<Ctrl><Shift>L"},
        {"label": "Database Reports", "shortcut": "<Ctrl><Shift>R"},
        {"label": "Download Favicon", "shortcut": "<Ctrl><Shift>D"},
        {"label": "Add Key to SSH Agent", "shortcut": "<Ctrl>H"},
        {"label": "Restore Entry", "shortcut": "<Ctrl>R"}
