        {"label": "Redo", "shortcut": "<Ctrl>Y"},
        {"label": "Find in Mailbox (Focus Search)", "shortcut": "<Ctrl>F"},
        {"label": "Open Preferences", "shortcut": "<Ctrl>,"}
      ]
    },
    {
      "label": "Format",
      "items": [
        {"label": "Format Bold", "shortcut": "<Ctrl>B"},
        {"label": "Format Italic", "shortcut": "<Ctrl>I"},
        {"label": "Format Underline", "shortcut": "<Ctrl>U"},
        {"label": "Insert Link", "shortcut": "<Ctrl>K"},
        {"label": "Numbered List", "shortcut": "<Ctrl><Shift>7"},
        {"label": "Bulleted List", "shortcut": "<Ctrl><Shift>8"},
        {"label": "Blockquote", "shortcut": "<Ctrl><Shift>9"}
