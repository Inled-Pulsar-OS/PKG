        {"label": "Select Account 3", "shortcut": "<Ctrl>3"},
        {"label": "Select Account 4", "shortcut": "<Ctrl>4"},
        {"label": "Select Account 5", "shortcut": "<Ctrl>5"},
        {"label": "Select Account 6", "shortcut": "<Ctrl>6"},
        {"label": "Select Account 7", "shortcut": "<Ctrl>7"},
        {"label": "Select Account 8", "shortcut": "<Ctrl>8"},
        {"label": "Select Account 9", "shortcut": "<Ctrl>9"},
        {"separator": true},
        {"label": "Sync Mail Now (Check Mail)", "shortcut": "F5"}
