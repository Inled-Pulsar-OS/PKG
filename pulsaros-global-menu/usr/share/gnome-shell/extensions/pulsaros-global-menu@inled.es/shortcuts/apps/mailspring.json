{
  "format": 1,
  "app": "mailspring",
  "name": "Mailspring",
  "identifiers": [
    "Mailspring.desktop",
    "mailspring",
    "Mailspring"
  ],
  "menus": [
    {
      "label": "File",
      "items": [
        {"label": "Print Thread", "shortcut": "<Ctrl>P"},
        {"label": "Close Window", "shortcut": "<Ctrl>W"},
        {"label": "Quit Mailspring", "shortcut": "<Ctrl>Q"}
      ]
    },
    {
