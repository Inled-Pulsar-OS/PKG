{
  "format": 1,
  "app": "kdenlive",
  "name": "Kdenlive",
  "identifiers": [
    "org.kde.kdenlive.desktop",
    "kdenlive",
    "Kdenlive"
  ],
  "menus": [
    {
      "label": "File",
      "items": [
        {"label": "New Project", "shortcut": "<Ctrl>N"},
        {"label": "Open Project", "shortcut": "<Ctrl>O"},
        {"label": "Save Project", "shortcut": "<Ctrl>S"},
        {"label": "Save Project As", "shortcut": "<Ctrl><Shift>S"},
        {"label": "Render / Export", "shortcut": "<Ctrl>Return"},
        {"label": "Close Project", "shortcut": "<Ctrl>W"},
        {"label": "Quit Kdenlive", "shortcut": "<Ctrl>Q"}
      ]
    },
    {
      "label": "Edit",
      "items": [
        {"label": "Undo", "shortcut": "<Ctrl>Z"},
        {"label": "Redo", "shortcut": "<Ctrl><Shift>Z"},
        {"label": "Cut", "shortcut": "<Ctrl>X"},
        {"label": "Copy", "shortcut": "<Ctrl>C"},
        {"label": "Paste", "shortcut": "<Ctrl>V"},
        {"label": "Select All", "shortcut": "<Ctrl>A"},
        {"label": "Deselect All", "shortcut": "<Ctrl><Shift>A"},
        {"label": "Cut Clip at Playhead (Razor Tool)", "shortcut": "<Shift>R"},
        {"label": "Configure Kdenlive (Preferences)", "shortcut": "<Ctrl><Shift>,"}
      ]
    },
    {
      "label": "View",
      "items": [
        {"label": "Fit Zoom to Project", "shortcut": "<Ctrl>0"},
        {"label": "Toggle Fullscreen", "shortcut": "F11"}
      ]
    },
    {
      "label": "Timeline",
      "items": [
        {"label": "Split Audio / Video", "shortcut": "<Shift>V"},
        {"label": "Group Clips", "shortcut": "<Ctrl>G"},
        {"label": "Ungroup Clips", "shortcut": "<Ctrl><Shift>G"},
        {"label": "Set In Point", "shortcut": "I"},
        {"label": "Set Out Point", "shortcut": "O"},
        {"label": "Insert Clip to Timeline", "shortcut": "V"},
        {"label": "Overwrite Clip to Timeline", "shortcut": "B"},
        {"label": "Add Track", "shortcut": "<Ctrl><Shift>T"},
        {"label": "Zoom In Timeline", "shortcut": "<Ctrl>+"},
        {"label": "Zoom Out Timeline", "shortcut": "<Ctrl>-"}
      ]
    },
    {
      "label": "Player",
      "items": [
        {"label": "Play / Pause", "shortcut": "space"},
        {"label": "Fast Forward", "shortcut": "L"},
        {"label": "Reverse / Rewind", "shortcut": "J"},
        {"label": "Stop", "shortcut": "K"}
      ]
    },
    {
      "label": "Help",
      "items": [
        {"label": "Kdenlive Handbook / Help", "shortcut": "F1"}
      ]
    }
  ]
}
