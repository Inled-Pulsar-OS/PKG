        {"label": "Save As", "shortcut": "<Ctrl><Shift>S"},
        {"label": "Print", "shortcut": "<Ctrl>P"},
        {"label": "Print Preview", "shortcut": "<Ctrl><Shift>P"},
        {"label": "File Properties", "shortcut": "<Alt>Return"},
        {"label": "Quit Gwenview", "shortcut": "<Ctrl>Q"}
      ]
    },
    {
      "label": "Edit",
      "items": [
        {"label": "Replace Location (Path Bar)", "shortcut": "<Ctrl>L"},
        {"label": "Rename File", "shortcut": "F2"},
        {"label": "Copy File To", "shortcut": "F7"},
        {"label": "Move to Trash", "shortcut": "Delete"},
        {"label": "Delete Permanently", "shortcut": "<Shift>Delete"},
        {"label": "Configure Gwenview (Preferences)", "shortcut": "<Ctrl><Shift>,"}
      ]
    },
    {
      "label": "View",
      "items": [
        {"label": "Reload / Refresh", "shortcut": "F5"},
        {"label": "Toggle Fullscreen", "shortcut": "F11"},
