      "items": [
        {"label": "Browse Mode", "shortcut": "Escape"},
        {"label": "View Mode", "shortcut": "Return"},
        {"label": "Synchronize Views", "shortcut": "<Ctrl>Y"},
        {"label": "Go Up (Parent Folder)", "shortcut": "<Alt>Up"},
        {"label": "Annotate", "shortcut": "<Shift>A"},
        {"label": "Move File To", "shortcut": "F8"},
        {"label": "Link File To", "shortcut": "F9"},
        {"label": "Edit Tags", "shortcut": "<Ctrl>T"}
