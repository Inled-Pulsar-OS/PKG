{
  "format": 1,
  "app": "inkscape",
  "name": "Inkscape",
  "identifiers": [
    "org.inkscape.Inkscape.desktop",
    "inkscape",
    "Inkscape"
  ],
  "menus": [
    {
      "label": "File",
      "items": [
        {"label": "New Document", "shortcut": "<Ctrl>N"},
        {"label": "Open Document", "shortcut": "<Ctrl>O"},
        {"label": "Save Document", "shortcut": "<Ctrl>S"},
        {"label": "Save Document As", "shortcut": "<Ctrl><Shift>S"},
        {"label": "Import", "shortcut": "<Ctrl>I"},
        {"label": "Export PNG / Image", "shortcut": "<Ctrl><Shift>E"},
        {"label": "Print", "shortcut": "<Ctrl>P"},
        {"label": "Document Properties", "shortcut": "<Ctrl><Shift>D"},
        {"label": "Close Window", "shortcut": "<Ctrl>W"},
        {"label": "Quit Inkscape", "shortcut": "<Ctrl>Q"}
      ]
    },
    {
      "label": "Edit",
      "items": [
        {"label": "Undo", "shortcut": "<Ctrl>Z"},
        {"label": "Redo", "shortcut": "<Ctrl><Shift>Z"},
        {"label": "Cut", "shortcut": "<Ctrl>X"},
        {"label": "Copy", "shortcut": "<Ctrl>C"},
        {"label": "Paste", "shortcut": "<Ctrl>V"},
        {"label": "Paste in Place", "shortcut": "<Ctrl><Alt>V"},
        {"label": "Paste Style", "shortcut": "<Ctrl><Shift>V"},
        {"label": "Invert Selection", "shortcut": "!"},
        {"label": "Deselect", "shortcut": "Escape"},
        {"label": "Find and Replace", "shortcut": "<Ctrl>F"},
        {"label": "Preferences", "shortcut": "<Ctrl><Shift>P"}
      ]
    },
    {
      "label": "Select",
      "items": [
        {"label": "Duplicate Selection", "shortcut": "<Ctrl>D"},
        {"label": "Select All", "shortcut": "<Ctrl>A"},
        {"label": "Select All in All Layers", "shortcut": "<Ctrl><Alt>A"},
        {"label": "Zoom to Selection", "shortcut": "3"}
      ]
    },
    {
      "label": "View",
      "items": [
        {"label": "Fill and Stroke Panel", "shortcut": "<Ctrl><Shift>F"},
        {"label": "Align and Distribute Panel", "shortcut": "<Ctrl><Shift>A"},
        {"label": "Transform Panel", "shortcut": "<Ctrl><Shift>M"},
        {"label": "Zoom In", "shortcut": "+"},
        {"label": "Zoom Out", "shortcut": "-"},
        {"label": "Zoom 1:1 (Actual Size)", "shortcut": "1"},
        {"label": "Zoom 1:2", "shortcut": "2"},
        {"label": "Zoom to Drawing", "shortcut": "4"},
        {"label": "Zoom to Page", "shortcut": "5"},
        {"label": "Zoom to Page Width", "shortcut": "6"},
        {"label": "Toggle Fullscreen", "shortcut": "F11"},
        {"label": "Toggle Rulers", "shortcut": "<Ctrl>R"},
        {"label": "Toggle Scrollbars", "shortcut": "<Ctrl>B"},
        {"label": "Toggle Guides", "shortcut": "<Shift>|"},
        {"label": "Toggle Snapping", "shortcut": "%"}
      ]
    },
    {
      "label": "Layer",
      "items": [
        {"label": "Group", "shortcut": "<Ctrl>G"},
        {"label": "Ungroup", "shortcut": "<Ctrl><Shift>G"},
        {"label": "Layers and Objects Panel", "shortcut": "<Ctrl><Shift>L"}
      ]
    },
    {
      "label": "Tools",
      "items": [
        {"label": "Create Clone", "shortcut": "<Alt>D"},
        {"label": "Unlink Clone", "shortcut": "<Alt><Shift>D"}
      ]
    },
    {
      "label": "Help",
      "items": [
        {"label": "Keyboard Shortcuts / Keys and Mouse Reference", "shortcut": "<Ctrl>?"},
        {"label": "Help", "shortcut": "F1"}
      ]
    }
  ]
}
