{
  "format": 1,
  "app": "pinta",
  "name": "Pinta",
  "identifiers": [
    "pinta.desktop",
    "com.github.PintaProject.Pinta.desktop",
    "pinta",
    "Pinta"
  ],
  "menus": [
    {
      "label": "File",
      "items": [
        {"label": "New Image", "shortcut": "<Ctrl>N"},
        {"label": "Open Image", "shortcut": "<Ctrl>O"},
        {"label": "Save Image", "shortcut": "<Ctrl>S"},
        {"label": "Save Image As", "shortcut": "<Ctrl><Shift>S"},
        {"label": "Save All Images", "shortcut": "<Ctrl><Alt>S"},
        {"label": "Print", "shortcut": "<Ctrl>P"},
        {"label": "Close Image", "shortcut": "<Ctrl>W"},
        {"label": "Close All Images", "shortcut": "<Ctrl><Shift>W"},
        {"label": "Exit Pinta", "shortcut": "<Ctrl>Q"}
      ]
    },
    {
      "label": "Edit",
      "items": [
        {"label": "Undo", "shortcut": "<Ctrl>Z"},
        {"label": "Redo", "shortcut": "<Ctrl>Y"},
        {"label": "Cut", "shortcut": "<Ctrl>X"},
        {"label": "Copy", "shortcut": "<Ctrl>C"},
        {"label": "Copy Merged", "shortcut": "<Ctrl><Shift>C"},
        {"label": "Paste", "shortcut": "<Ctrl>V"},
        {"label": "Paste into New Layer", "shortcut": "<Ctrl><Shift>V"},
        {"label": "Paste into New Image", "shortcut": "<Ctrl><Alt>V"},
        {"label": "Deselect", "shortcut": "<Ctrl>D"},
        {"label": "Invert Selection", "shortcut": "<Ctrl>I"}
      ]
    },
    {
      "label": "Select",
      "items": [
        {"label": "Select All", "shortcut": "<Ctrl>A"},
        {"label": "Erase Selection", "shortcut": "Delete"},
        {"label": "Fill Selection", "shortcut": "BackSpace"},
        {"label": "Crop to Selection", "shortcut": "<Ctrl><Shift>X"},
        {"label": "Rectangle Select Tool", "shortcut": "S"},
        {"label": "Move Selected Pixels", "shortcut": "M"}
      ]
    },
    {
      "label": "View",
      "items": [
        {"label": "Zoom In", "shortcut": "<Ctrl>+"},
        {"label": "Zoom Out", "shortcut": "<Ctrl>-"},
        {"label": "Actual Size (100%)", "shortcut": "<Ctrl>0"},
        {"label": "Zoom to Window (Best Fit)", "shortcut": "<Ctrl>B"},
        {"label": "Toggle Fullscreen", "shortcut": "F11"},
        {"label": "Toggle Rulers", "shortcut": "<Ctrl>R"},
        {"label": "Toggle Grid", "shortcut": "<Ctrl>G"},
        {"label": "Next Image Tab", "shortcut": "<Ctrl>Page_Down"},
