        {"label": "Auto-Level", "shortcut": "<Ctrl><Shift>L"},
        {"label": "Black and White", "shortcut": "<Ctrl><Shift>B"},
        {"label": "Brightness/Contrast", "shortcut": "<Ctrl><Shift>T"},
        {"label": "Curves", "shortcut": "<Ctrl><Shift>M"},
        {"label": "Hue/Saturation", "shortcut": "<Ctrl><Shift>U"},
        {"label": "Invert Colors", "shortcut": "<Ctrl><Shift>I"},
        {"label": "Levels", "shortcut": "<Ctrl>L"},
        {"label": "Sepia", "shortcut": "<Ctrl><Shift>E"},
        {"label": "Color Picker Tool", "shortcut": "K"}
