    },
    {
      "label": "Layer",
      "items": [
        {"label": "Add New Layer", "shortcut": "<Ctrl><Shift>N"},
        {"label": "Delete Layer", "shortcut": "<Ctrl><Shift>Delete"},
        {"label": "Duplicate Layer", "shortcut": "<Ctrl><Shift>D"},
        {"label": "Merge Layer Down", "shortcut": "<Ctrl>M"}
      ]
    },
    {
      "label": "Tools",
      "items": [
        {"label": "Paintbrush Tool", "shortcut": "B"},
        {"label": "Eraser Tool", "shortcut": "E"},
        {"label": "Pencil Tool", "shortcut": "P"},
        {"label": "Paint Bucket Tool", "shortcut": "F"},
        {"label": "Line/Curve Tool", "shortcut": "V"},
        {"label": "Text Tool", "shortcut": "T"},
        {"label": "Increase Brush Size", "shortcut": "]"},
        {"label": "Decrease Brush Size", "shortcut": "["}
