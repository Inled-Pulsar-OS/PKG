        {"label": "Canvas Size", "shortcut": "<Ctrl><Shift>R"},
        {"label": "Flip Horizontal", "shortcut": "<Ctrl><Alt>H"},
        {"label": "Flip Vertical", "shortcut": "<Ctrl><Alt>V"},
        {"label": "Rotate 90\u00b0 Clockwise", "shortcut": "<Ctrl>H"},
        {"label": "Rotate 90\u00b0 Counter-Clockwise", "shortcut": "<Ctrl>G"},
        {"label": "Rotate 180\u00b0", "shortcut": "<Ctrl>J"},
        {"label": "Flatten Image", "shortcut": "<Ctrl><Shift>F"}
