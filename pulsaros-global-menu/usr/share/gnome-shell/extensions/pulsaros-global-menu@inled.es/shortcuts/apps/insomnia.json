        {"label": "Show Request History", "shortcut": "<Ctrl><Shift>H"},
        {"label": "Generate Code", "shortcut": "<Ctrl><Shift>G"},
        {"label": "Focus Response", "shortcut": "<Ctrl>'"},
        {"label": "Beautify Active Code Editors", "shortcut": "<Ctrl><Shift>F"}
