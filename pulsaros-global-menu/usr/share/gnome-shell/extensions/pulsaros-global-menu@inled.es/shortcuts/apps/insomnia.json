        {"label": "Open Create Dropdown", "shortcut": "<Ctrl>N"},
        {"label": "Create HTTP Request", "shortcut": "<Ctrl><Alt>N"},
        {"label": "Create Folder", "shortcut": "<Ctrl><Shift>N"}
