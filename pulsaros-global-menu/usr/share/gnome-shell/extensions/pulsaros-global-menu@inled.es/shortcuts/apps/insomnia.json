    },
    {
      "label": "Edit",
      "items": [
        {"label": "Quick Search / Switcher", "shortcut": "<Ctrl>P"},
        {"label": "App Preferences", "shortcut": "<Ctrl>,"},
        {"label": "Workspace / Collection Settings", "shortcut": "<Ctrl><Shift>,"},
        {"label": "Request Settings", "shortcut": "<Ctrl><Alt><Shift>,"}
      ]
    },
    {
      "label": "View",
      "items": [
        {"label": "Show Environment Editor", "shortcut": "<Ctrl>E"},
        {"label": "Show Cookies Editor", "shortcut": "<Ctrl>K"},
