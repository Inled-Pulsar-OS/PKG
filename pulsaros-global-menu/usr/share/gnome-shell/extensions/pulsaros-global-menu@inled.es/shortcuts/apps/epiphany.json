{
  "format": 1,
  "app": "epiphany",
  "name": "Web (Epiphany)",
  "identifiers": [
    "org.gnome.Epiphany.desktop",
    "org.gnome.Epiphany",
    "epiphany",
    "Web"
  ],
  "menus": [
    {
      "label": "File",
      "items": [
        {"label": "New Window", "shortcut": "<Ctrl>N"},
        {"label": "New Incognito Window", "shortcut": "<Ctrl><Shift>N"},
        {"label": "Open File", "shortcut": "<Ctrl>O"},
        {"separator": true},
        {"label": "Save Page", "shortcut": "<Ctrl>S"},
        {"label": "Take Screenshot", "shortcut": "<Ctrl><Shift>S"},
        {"label": "Print Page", "shortcut": "<Ctrl>P"},
        {"separator": true},
        {"label": "Install Site as Web App", "shortcut": "<Ctrl><Shift>A"},
        {"separator": true},
        {"label": "Quit", "shortcut": "<Ctrl>Q"}
      ]
    },
    {
      "label": "Edit",
      "items": [
        {"label": "Cut", "shortcut": "<Ctrl>X"},
        {"label": "Copy", "shortcut": "<Ctrl>C"},
        {"label": "Paste", "shortcut": "<Ctrl>V"},
        {"label": "Undo", "shortcut": "<Ctrl>Z"},
        {"label": "Redo", "shortcut": "<Ctrl><Shift>Z"},
        {"label": "Select All", "shortcut": "<Ctrl>A"},
        {"separator": true},
        {"label": "Find", "shortcut": "<Ctrl>F"},
        {"label": "Next Find Result", "shortcut": "<Ctrl>G"},
        {"label": "Previous Find Result", "shortcut": "<Ctrl><Shift>G"},
        {"separator": true},
        {"label": "Preferences", "shortcut": "<Ctrl>,"}
      ]
    },
    {
      "label": "View",
      "items": [
        {"label": "Zoom In", "shortcut": "<Ctrl>plus"},
        {"label": "Zoom Out", "shortcut": "<Ctrl>minus"},
        {"label": "Reset Zoom", "shortcut": "<Ctrl>0"},
        {"separator": true},
        {"label": "Fullscreen", "shortcut": "F11"},
        {"label": "Toggle Caret Browsing", "shortcut": "F7"},
        {"separator": true},
        {"label": "View Page Source", "shortcut": "<Ctrl>U"},
        {"label": "Toggle Inspector", "shortcut": "<Ctrl><Shift>I"},
        {"label": "Toggle Reader Mode", "shortcut": "<Ctrl><Alt>R"}
      ]
    },
    {
      "label": "Go",
      "items": [
        {"label": "Go to Homepage", "shortcut": "<Alt>Home"},
        {"label": "Go Back to Previous Page", "shortcut": "<Alt>Left"},
        {"label": "Go Forward to Next Page", "shortcut": "<Alt>Right"},
        {"separator": true},
        {"label": "Reload Current Page", "shortcut": "<Ctrl>R"},
        {"label": "Reload Bypassing Cache", "shortcut": "<Ctrl><Shift>R"},
        {"label": "Stop Loading Current Page", "shortcut": "Escape"},
        {"separator": true},
        {"label": "Select Page URL", "shortcut": "<Ctrl>L"},
        {"label": "Search With Default Search Engine", "shortcut": "<Ctrl>K"}
      ]
    },
    {
      "label": "Tabs",
      "items": [
        {"label": "New Tab", "shortcut": "<Ctrl>T"},
        {"label": "Close Current Tab", "shortcut": "<Ctrl>W"},
        {"label": "Reopen Closed Tab", "shortcut": "<Ctrl><Shift>T"},
        {"label": "Duplicate Current Tab", "shortcut": "<Ctrl><Shift>K"},
        {"separator": true},
        {"label": "Go to Next Tab", "shortcut": "<Ctrl>Page_Down"},
        {"label": "Go to Previous Tab", "shortcut": "<Ctrl>Page_Up"},
        {"label": "Move Current Tab Left", "shortcut": "<Ctrl><Shift>Page_Up"},
        {"label": "Move Current Tab Right", "shortcut": "<Ctrl><Shift>Page_Down"},
        {"separator": true},
        {"label": "View Open Tabs", "shortcut": "<Ctrl><Shift>O"}
      ]
    },
    {
      "label": "Bookmarks",
      "items": [
        {"label": "Bookmark Current Page", "shortcut": "<Ctrl>D"},
        {"label": "Show Bookmarks List", "shortcut": "<Ctrl><Alt>D"},
        {"label": "Import Bookmarks", "shortcut": "<Ctrl><Shift>M"},
        {"label": "Export Bookmarks", "shortcut": "<Ctrl><Shift>X"}
      ]
    },
    {
      "label": "History",
      "items": [
        {"label": "History", "shortcut": "<Ctrl>H"},
        {"label": "Show Downloads List", "shortcut": "<Ctrl><Shift>Y"},
        {"label": "Clear Website Data", "shortcut": "<Ctrl><Shift>Delete"}
      ]
    },
    {
      "label": "Help",
      "items": [
        {"label": "Help", "shortcut": "F1"},
        {"label": "Open Menu", "shortcut": "F10"},
        {"label": "Keyboard Shortcuts", "shortcut": "<Ctrl>question"}
      ]
    }
  ]
}
