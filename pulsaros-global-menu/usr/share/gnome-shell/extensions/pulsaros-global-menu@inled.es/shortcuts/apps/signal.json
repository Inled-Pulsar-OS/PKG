{
  "format": 1,
  "app": "signal",
  "name": "Signal",
  "identifiers": [
    "signal-desktop.desktop",
    "org.signal.Signal.desktop",
    "signal",
    "Signal"
  ],
  "menus": [
    {
      "label": "File",
      "items": [
        {"label": "Start New Chat", "shortcut": "<Ctrl>N"},
        {"label": "Attach File / Media", "shortcut": "<Ctrl>U"},
        {"label": "Close Current Conversation", "shortcut": "<Ctrl><Shift>C"},
        {"label": "Close Window", "shortcut": "<Ctrl>W"},
        {"label": "Quit Signal", "shortcut": "<Ctrl>Q"}
      ]
    },
    {
      "label": "Edit",
      "items": [
        {"label": "Search", "shortcut": "<Ctrl>F"},
        {"label": "Preferences / Settings", "shortcut": "<Ctrl>,"}
      ]
    },
    {
      "label": "Format",
      "items": [
        {"label": "Format Bold", "shortcut": "<Ctrl>B"},
        {"label": "Format Italic", "shortcut": "<Ctrl>I"},
        {"label": "Format Strikethrough", "shortcut": "<Ctrl><Shift>X"},
        {"label": "Format Monospace", "shortcut": "<Ctrl><Shift>K"},
        {"label": "Format Spoiler", "shortcut": "<Ctrl><Shift>P"}
      ]
    },
    {
      "label": "View",
      "items": [
        {"label": "Mark as Read", "shortcut": "<Ctrl><Shift>R"},
        {"label": "Zoom In", "shortcut": "<Ctrl>+"},
