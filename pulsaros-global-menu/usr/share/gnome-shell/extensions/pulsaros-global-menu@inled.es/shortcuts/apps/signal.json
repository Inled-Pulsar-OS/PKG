    },
    {
      "label": "Call",
      "items": [
        {"label": "Record Voice Note", "shortcut": "<Ctrl><Shift>V"}
      ]
    },
    {
      "label": "Window",
      "items": [
        {"label": "Minimize", "shortcut": "<Ctrl>M"}
      ]
    },
    {
      "label": "Help",
      "items": [
        {"label": "Show Keyboard Shortcuts", "shortcut": "<Ctrl>/"}
