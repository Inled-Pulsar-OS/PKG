        {"label": "Archive Conversation", "shortcut": "<Ctrl><Shift>A"},
        {"label": "Unarchive Conversation", "shortcut": "<Ctrl><Shift>U"},
        {"label": "Next Conversation", "shortcut": "<Alt>Down"},
        {"label": "Previous Conversation", "shortcut": "<Alt>Up"},
        {"label": "Next Unread Conversation", "shortcut": "<Alt><Shift>Down"},
        {"label": "Previous Unread Conversation", "shortcut": "<Alt><Shift>Up"},
