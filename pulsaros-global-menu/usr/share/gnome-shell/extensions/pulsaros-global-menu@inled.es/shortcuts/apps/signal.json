        {"label": "Navigate to Conversation 1", "shortcut": "<Ctrl>1"},
        {"label": "Navigate to Conversation 2", "shortcut": "<Ctrl>2"},
        {"label": "Navigate to Conversation 3", "shortcut": "<Ctrl>3"},
        {"label": "Navigate to Conversation 4", "shortcut": "<Ctrl>4"},
        {"label": "Navigate to Conversation 5", "shortcut": "<Ctrl>5"},
        {"label": "Navigate to Conversation 6", "shortcut": "<Ctrl>6"},
        {"label": "Navigate to Conversation 7", "shortcut": "<Ctrl>7"},
        {"label": "Navigate to Conversation 8", "shortcut": "<Ctrl>8"},
        {"label": "Navigate to Conversation 9", "shortcut": "<Ctrl>9"}
