        {"label": "Accept Video Call", "shortcut": "<Ctrl><Shift>A"},
        {"label": "Accept Audio Call", "shortcut": "<Ctrl><Shift>S"},
        {"label": "Decline Call", "shortcut": "<Ctrl><Shift>D"}
      ]
    },
    {
      "label": "Help",
      "items": [
        {"label": "Show Keyboard Shortcuts", "shortcut": "<Ctrl>."}
      ]
