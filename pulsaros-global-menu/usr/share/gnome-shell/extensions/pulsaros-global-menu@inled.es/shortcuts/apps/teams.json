      "items": [
        {"label": "Toggle Screen Sharing", "shortcut": "<Ctrl><Shift>E"},
        {"label": "Filter Chats and Channels", "shortcut": "<Ctrl><Shift>F"},
        {"label": "Expand Compose Box", "shortcut": "<Ctrl><Shift>X"},
        {"label": "Zoom In", "shortcut": "<Ctrl>="},
        {"label": "Zoom Out", "shortcut": "<Ctrl>-"},
        {"label": "Reset Zoom", "shortcut": "<Ctrl>0"}
