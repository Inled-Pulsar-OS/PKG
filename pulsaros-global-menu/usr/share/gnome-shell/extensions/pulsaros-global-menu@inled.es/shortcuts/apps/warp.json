{
  "format": 1,
  "app": "warp",
  "name": "Warp",
  "identifiers": [
    "dev.warp.Warp.desktop",
    "warp",
    "Warp"
  ],
  "menus": [
    {
      "label": "File",
      "items": [
        {"label": "New Tab", "shortcut": "<Ctrl>T"},
        {"label": "Close Tab / Split", "shortcut": "<Ctrl>W"}
      ]
    },
    {
      "label": "Edit",
      "items": [
        {"label": "Search / Filter Blocks", "shortcut": "<Ctrl>F"},
        {"label": "Find Next Occurrence", "shortcut": "<Ctrl>G"},
        {"label": "Find Previous Occurrence", "shortcut": "<Ctrl><Shift>G"},
        {"label": "Copy", "shortcut": "<Ctrl>C"},
        {"label": "Copy Commands", "shortcut": "<Ctrl><Shift>C"},
        {"label": "Copy Outputs", "shortcut": "<Ctrl><Alt><Shift>C"},
        {"label": "Paste", "shortcut": "<Ctrl>V"},
        {"label": "Select All Blocks", "shortcut": "<Ctrl>A"},
        {"label": "Focus Input / Clear Screen", "shortcut": "<Ctrl>L"},
        {"label": "Open Settings", "shortcut": "<Ctrl>,"},
        {"label": "Toggle AI Command Search", "shortcut": "<Ctrl>`"}
      ]
    },
    {
      "label": "View",
      "items": [
        {"label": "Toggle Maximize Pane", "shortcut": "<Ctrl><Shift>Return"},
        {"label": "Toggle Command Palette", "shortcut": "<Ctrl><Shift>P"},
        {"label": "Select Previous Block", "shortcut": "<Ctrl>Up"},
        {"label": "Select Next Block", "shortcut": "<Ctrl>Down"},
        {"label": "Expand Block Selection Above", "shortcut": "<Shift>Up"},
        {"label": "Expand Block Selection Below", "shortcut": "<Shift>Down"},
        {"label": "Bookmark Selected Block", "shortcut": "<Ctrl>B"},
        {"label": "Re-input Previous Command", "shortcut": "<Ctrl>I"},
        {"label": "Re-input with Sudo", "shortcut": "<Ctrl><Shift>I"},
        {"label": "Toggle Workflows", "shortcut": "<Ctrl><Shift>R"},
        {"label": "Increase Font Size", "shortcut": "<Ctrl>+"},
        {"label": "Decrease Font Size", "shortcut": "<Ctrl>-"},
        {"label": "Reset Font Size", "shortcut": "<Ctrl>0"},
        {"label": "Theme Chooser", "shortcut": "<Ctrl><Shift>T"}
      ]
    },
    {
      "label": "Tabs",
      "items": [
        {"label": "Switch to Last Tab", "shortcut": "<Ctrl>9"},
        {"label": "Next Tab", "shortcut": "<Ctrl>Page_Down"},
        {"label": "Previous Tab", "shortcut": "<Ctrl>Page_Up"},
        {"label": "Move Tab Left", "shortcut": "<Ctrl><Shift>Left"},
        {"label": "Move Tab Right", "shortcut": "<Ctrl><Shift>Right"},
        {"separator": true},
        {"label": "Switch to Tab 1", "shortcut": "<Ctrl>1"},
        {"label": "Switch to Tab 2", "shortcut": "<Ctrl>2"},
        {"label": "Switch to Tab 3", "shortcut": "<Ctrl>3"},
        {"label": "Switch to Tab 4", "shortcut": "<Ctrl>4"},
        {"label": "Switch to Tab 5", "shortcut": "<Ctrl>5"},
        {"label": "Switch to Tab 6", "shortcut": "<Ctrl>6"},
        {"label": "Switch to Tab 7", "shortcut": "<Ctrl>7"},
        {"label": "Switch to Tab 8", "shortcut": "<Ctrl>8"}
      ]
    },
    {
      "label": "Window",
      "items": [
        {"label": "Split Pane Right", "shortcut": "<Ctrl><Shift>D"},
        {"label": "Split Pane Down", "shortcut": "<Ctrl><Alt>D"},
        {"label": "Navigate Pane Left", "shortcut": "<Alt>Left"},
        {"label": "Navigate Pane Right", "shortcut": "<Alt>Right"},
        {"label": "Navigate Pane Up", "shortcut": "<Alt>Up"},
        {"label": "Navigate Pane Down", "shortcut": "<Alt>Down"},
        {"label": "Next Pane", "shortcut": "<Ctrl>]"},
        {"label": "Previous Pane", "shortcut": "<Ctrl>["}
      ]
    }
  ]
}
