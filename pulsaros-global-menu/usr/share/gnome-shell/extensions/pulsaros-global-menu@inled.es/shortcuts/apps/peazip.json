      "items": [
        {"label": "Extract All To...", "shortcut": "<Ctrl>E"},
        {"label": "Extract All Here", "shortcut": "<Ctrl><Alt>E"},
        {"label": "Extract All to Desktop", "shortcut": "<Ctrl><Shift>E"},
        {"label": "Extract All to Documents", "shortcut": "<Ctrl><Alt><Shift>E"},
        {"label": "Extract to Previous Path", "shortcut": "<Ctrl>0"},
