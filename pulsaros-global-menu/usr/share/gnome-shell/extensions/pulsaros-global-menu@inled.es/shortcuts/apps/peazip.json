        {"label": "Extract to Bookmarked Path 1", "shortcut": "<Ctrl>1"},
        {"label": "Extract to Bookmarked Path 2", "shortcut": "<Ctrl>2"},
        {"label": "Extract to Bookmarked Path 3", "shortcut": "<Ctrl>3"},
        {"label": "Extract to Bookmarked Path 4", "shortcut": "<Ctrl>4"},
        {"label": "Extract to Bookmarked Path 5", "shortcut": "<Ctrl>5"},
        {"label": "Extract to Bookmarked Path 6", "shortcut": "<Ctrl>6"},
        {"label": "Extract to Bookmarked Path 7", "shortcut": "<Ctrl>7"},
        {"label": "Extract to Bookmarked Path 8", "shortcut": "<Ctrl>8"}
