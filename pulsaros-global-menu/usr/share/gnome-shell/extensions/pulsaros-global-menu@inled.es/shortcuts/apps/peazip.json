{
  "format": 1,
  "app": "peazip",
  "name": "PeaZip",
  "identifiers": [
    "peazip.desktop",
    "io.github.peazip.PeaZip.desktop",
    "peazip",
    "PeaZip"
  ],
  "menus": [
    {
      "label": "File",
      "items": [
        {"label": "Show Recent Archives", "shortcut": "<Ctrl><Alt>5"}
      ]
    },
    {
      "label": "Edit",
      "items": [
        {"label": "Rename File(s)", "shortcut": "F2"},
        {"label": "Copy Selected To", "shortcut": "<Ctrl>F2"},
        {"label": "Search", "shortcut": "F3"},
        {"label": "Cut", "shortcut": "<Ctrl>X"},
        {"label": "Copy", "shortcut": "<Ctrl>C"},
        {"label": "Paste", "shortcut": "<Ctrl>V"},
        {"label": "Select All", "shortcut": "<Ctrl>A"},
        {"label": "Delete", "shortcut": "Delete"}
      ]
    },
    {
      "label": "View",
      "items": [
        {"label": "Refresh", "shortcut": "F5"},
        {"label": "Toggle Status Bar", "shortcut": "<Ctrl><Alt>1"},
        {"label": "Hide Status Bar", "shortcut": "<Ctrl><Alt>0"},
        {"label": "Show Bookmarks", "shortcut": "<Ctrl><Alt>3"},
        {"label": "Show History", "shortcut": "<Ctrl><Alt>4"},
        {"label": "Show Clipboard", "shortcut": "<Ctrl><Alt>6"}
