        {"label": "Show Bookmarks Sidebar", "shortcut": "<Ctrl>B"},
        {"label": "Show Bookmarks Toolbar", "shortcut": "<Ctrl><Shift>B"},
        {"label": "Manage Bookmarks", "shortcut": "<Ctrl><Shift>O"}
      ]
    },
    {
      "label": "Tools",
      "items": [
        {"label": "Open Downloads", "shortcut": "<Ctrl><Shift>Y"},
        {"label": "Open Add-ons and Themes", "shortcut": "<Ctrl><Shift>A"},
