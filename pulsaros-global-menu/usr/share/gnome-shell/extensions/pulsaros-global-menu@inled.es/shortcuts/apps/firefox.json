        {"label": "Toggle Web Developer Tools", "shortcut": "<Ctrl><Shift>I"},
        {"label": "Toggle Web Console", "shortcut": "<Ctrl><Shift>K"},
        {"label": "Toggle Inspector", "shortcut": "<Ctrl><Shift>C"},
        {"label": "Toggle Debugger", "shortcut": "<Ctrl><Shift>Z"},
        {"label": "Toggle Network Monitor", "shortcut": "<Ctrl><Shift>E"},
        {"label": "Toggle Style Editor", "shortcut": "<Shift>F7"},
        {"label": "Toggle Performance", "shortcut": "<Shift>F5"},
        {"label": "Toggle Storage Inspector", "shortcut": "<Shift>F9"},
        {"label": "Toggle Accessibility Inspector", "shortcut": "<Shift>F12"},
        {"label": "Toggle Responsive Design Mode", "shortcut": "<Ctrl><Shift>M"},
        {"label": "Toggle Browser Console", "shortcut": "<Ctrl><Shift>J"},
        {"label": "Toggle Browser Toolbox", "shortcut": "<Alt><Ctrl><Shift>I"},
        {"separator": true},
        {"label": "Task Manager (About Processes)", "shortcut": "<Shift>Escape"}
      ]
    }
