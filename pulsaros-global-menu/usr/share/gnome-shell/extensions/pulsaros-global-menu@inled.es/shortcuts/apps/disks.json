    "org.gnome.DiskUtility.desktop",
    "org.gnome.DiskUtility",
    "gnome-disks",
    "Disks"
  ],
  "menus": [
    {
      "label": "File",
      "items": [
        {"label": "Create a New Empty Disk Image", "shortcut": "<Ctrl>N"},
