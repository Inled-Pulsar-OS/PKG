        {"label": "SMART Data", "shortcut": "<Ctrl>S"},
        {"label": "Drive Settings", "shortcut": "<Ctrl>E"}
      ]
    },
    {
      "label": "Volume",
      "items": [
        {"label": "Open the Volume Menu", "shortcut": "<Shift>F10"},
