        {"separator": true},
        {"label": "Quit", "shortcut": "<Ctrl>Q"}
      ]
    },
    {
      "label": "Drive",
      "items": [
        {"label": "Open the Drive Menu", "shortcut": "F10"},
        {"label": "Format the Drive", "shortcut": "<Ctrl>D"},
