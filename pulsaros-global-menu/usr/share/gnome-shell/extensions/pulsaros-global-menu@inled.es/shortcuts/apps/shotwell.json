      "items": [
        {"label": "Move to Trash", "shortcut": "Delete"},
        {"label": "Select All", "shortcut": "<Ctrl>A"},
        {"label": "Search / Find", "shortcut": "<Ctrl>F"},
        {"label": "Copy Color Adjustments", "shortcut": "<Ctrl><Shift>C"},
