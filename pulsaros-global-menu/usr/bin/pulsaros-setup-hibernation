#!/bin/bash
# Pulsar OS - Automated Hibernation & Swapfile Setup
# Configura automáticamente swapfile, fstab, y parámetros del kernel para hibernación y restauración de sesión.

set -e

# Evitar ejecución en Live ISO de instalación
if [ -d /run/archiso ] || [ -f /run/archiso/bootmnt ]; then
    echo "ℹ️ Entorno Live ISO detectado; posponiendo configuración de swapfile hasta instalación en disco."
    exit 0
fi

# Evitar ejecución dentro de un chroot de build (ISO builder, CI, Docker, contenedor)
# Avoid running inside a build chroot (ISO builder, CI, Docker, container)
# 1. Variable explícita que build-iso.sh inyecta en el chroot
if [ -n "$PULSAR_BUILD_CHROOT" ]; then
    echo "ℹ️ Entorno chroot de build detectado (PULSAR_BUILD_CHROOT); omitiendo configuración de swapfile."
    exit 0
fi
# 2. systemd no está corriendo como PID 1 → estamos en chroot o contenedor
if [ ! -d /run/systemd/system ]; then
    echo "ℹ️ systemd no activo como PID 1 (chroot/contenedor); omitiendo configuración de swapfile."
    exit 0
fi

# Detectar memoria RAM total en GiB
TOTAL_RAM_KB=$(grep MemTotal /proc/meminfo | awk '{print $2}')
TOTAL_RAM_GB=$(( (TOTAL_RAM_KB + 1048575) / 1048576 ))

# Determinar tamaño óptimo de swap (entre 4GB y 32GB)
SWAP_GB=$TOTAL_RAM_GB
if [ "$SWAP_GB" -lt 4 ]; then
    SWAP_GB=4
elif [ "$SWAP_GB" -gt 32 ]; then
    SWAP_GB=32
fi

# 1. Crear /swapfile si no existe o activar si ya existe
FSTYPE=$(findmnt -no FSTYPE / 2>/dev/null || echo "ext4")

# Si estamos en Btrfs y el swapfile existente no es NOCOW o está corrupto, recrearlo limpiamente
if [ "$FSTYPE" = "btrfs" ] && [ -f /swapfile ]; then
    if ! btrfs inspect-internal map-swapfile -r /swapfile >/dev/null 2>&1; then
        echo "⚠️ /swapfile existente no tiene atributos NOCOW en Btrfs. Recreándolo correctamente..."
        swapoff /swapfile 2>/dev/null || true
        rm -f /swapfile
    fi
fi

if [ ! -f /swapfile ]; then
    FREE_SPACE_GB=$(df -BG / | awk 'NR==2 {print $4}' | tr -d 'G')
    REQUIRED_SPACE=$((SWAP_GB + 4))

    if [ "$FREE_SPACE_GB" -gt "$REQUIRED_SPACE" ]; then
        echo "💾 Creando /swapfile de ${SWAP_GB}GB en sistema de archivos ${FSTYPE} para soporte de hibernación..."
        if [ "$FSTYPE" = "btrfs" ]; then
            btrfs filesystem mkswapfile --size "${SWAP_GB}g" /swapfile 2>/dev/null || {
                truncate -s 0 /swapfile
                chattr +C /swapfile 2>/dev/null || true
                btrfs property set /swapfile compression none 2>/dev/null || true
                dd if=/dev/zero of=/swapfile bs=1M count=$((SWAP_GB * 1024)) status=none
                chmod 600 /swapfile
                mkswap /swapfile
            }
        else
            fallocate -l "${SWAP_GB}G" /swapfile 2>/dev/null || dd if=/dev/zero of=/swapfile bs=1M count=$((SWAP_GB * 1024)) status=none
            chmod 600 /swapfile
            mkswap /swapfile
        fi
    else
        echo "⚠️ Espacio en disco insuficiente para crear swapfile de ${SWAP_GB}GB."
    fi
fi

if [ -f /swapfile ]; then
    chmod 600 /swapfile
    if ! swapon --show | grep -q "/swapfile"; then
        swapon /swapfile 2>/dev/null || true
    fi

    # 2. Asegurar entrada en /etc/fstab
    if [ -f /etc/fstab ] && ! grep -q "/swapfile" /etc/fstab; then
        echo "/swapfile none swap defaults 0 0" >> /etc/fstab
    fi

    # 3. Configurar parámetros de reanudación (resume) en gestores de arranque
    ROOT_UUID=$(findmnt -no UUID -T /swapfile 2>/dev/null || findmnt -no UUID / 2>/dev/null || true)
    OFFSET=""
    if [ "$FSTYPE" = "btrfs" ] && command -v btrfs >/dev/null 2>&1; then
        OFFSET=$(btrfs inspect-internal map-swapfile -r /swapfile 2>/dev/null | tail -n 1)
    fi
    if [ -z "$OFFSET" ]; then
        OFFSET=$(filefrag -v /swapfile 2>/dev/null | awk '$1=="0:" {print substr($4, 1, length($4)-2)}' || true)
    fi

    if [ -n "$ROOT_UUID" ] && [ -n "$OFFSET" ]; then
        RESUME_PARAMS="resume=UUID=${ROOT_UUID} resume_offset=${OFFSET} zswap.enabled=0"
        echo "✅ Parámetros de hibernación calculados: ${RESUME_PARAMS}"

        # rEFInd refind_linux.conf
        if [ -f /boot/refind_linux.conf ]; then
            echo "⚙️ Configurando resume y zswap en /boot/refind_linux.conf..."
            # Remove any existing resume and zswap parameters first, then append correct ones
            sed -i 's/ resume=UUID=[^ "]*//g; s/ resume_offset=[^ "]*//g; s/ zswap\.enabled=[^ "]*//g' /boot/refind_linux.conf 2>/dev/null || true
            sed -i "s|\(root=UUID=[^ \"']*\)|\1 ${RESUME_PARAMS}|g" /boot/refind_linux.conf 2>/dev/null || true
        fi
        
        # rEFInd refind.conf (todas las posibles rutas de ESP)
        for rc in \
            /boot/efi/EFI/refind/refind.conf \
            /boot/efi/EFI/BOOT/refind.conf \
            /efi/EFI/refind/refind.conf \
            /efi/EFI/BOOT/refind.conf \
            /boot/EFI/refind/refind.conf \
            /boot/EFI/BOOT/refind.conf; do
            if [ -f "$rc" ]; then
                echo "⚙️ Configurando resume y zswap en $rc..."
                sed -i 's/ resume=UUID=[^ "]*//g; s/ resume_offset=[^ "]*//g; s/ zswap\.enabled=[^ "]*//g' "$rc" 2>/dev/null || true
                sed -i "s|\(root=UUID=[^ \"']*\)|\1 ${RESUME_PARAMS}|g" "$rc" 2>/dev/null || true
            fi
        done

        # GRUB
        if [ -f /etc/default/grub ]; then
            echo "⚙️ Configurando resume y zswap en /etc/default/grub..."
            # Remove any existing resume and zswap parameters first, then append correct ones
            sed -i 's/ resume=UUID=[^ "]*//g; s/ resume_offset=[^ "]*//g; s/ zswap\.enabled=[^ "]*//g' /etc/default/grub 2>/dev/null || true
            sed -i "s|GRUB_CMDLINE_LINUX_DEFAULT=\"\(.*\)\"|GRUB_CMDLINE_LINUX_DEFAULT=\"\1 ${RESUME_PARAMS}\"|" /etc/default/grub 2>/dev/null || true
            if command -v grub-mkconfig >/dev/null 2>&1; then
                grub-mkconfig -o /boot/grub/grub.cfg 2>/dev/null || true
            elif command -v update-grub >/dev/null 2>&1; then
                update-grub 2>/dev/null || true
            fi
        fi
    fi
fi

# 4. Asegurar HibernateMode=shutdown para evitar bloqueos ACPI S4 de la BIOS
mkdir -p /etc/systemd/sleep.conf.d
cat << 'DROPEOF' > /etc/systemd/sleep.conf.d/pulsaros-hibernate.conf
[Sleep]
HibernateMode=shutdown
DROPEOF

# 5. Asegurar hook de resume en initramfs para que el kernel detecte la imagen de hibernación
# The 'resume' hook (mkinitcpio ≥ 32) handles both busybox and systemd initramfs.
# CRITICAL: 'resume' MUST come after 'block' and 'filesystems' so that block devices
# are discovered and ext4 is loaded before the kernel tries to read the swapfile.
INITRAMFS_CHANGED=0

if [ -f /etc/mkinitcpio.conf ]; then
    # Arch Linux — mkinitcpio
    if grep -q "^HOOKS=" /etc/mkinitcpio.conf; then
        if grep "^HOOKS=" /etc/mkinitcpio.conf | grep -q "\bsystemd\b"; then
            # En initramfs basado en systemd, systemd incluye de forma nativa el generador
            # systemd-hibernate-resume. El hook legacy 'resume' entra en conflicto directo y cuelga el arranque.
            if grep "^HOOKS=" /etc/mkinitcpio.conf | grep -q "\bresume\b"; then
                echo "⚙️ Eliminando hook conflictivo 'resume' de initramfs systemd..."
                sed -i 's/\bresume\b//g; s/  */ /g; s/( /(/' /etc/mkinitcpio.conf
                INITRAMFS_CHANGED=1
            fi
        else
            # Initramfs basado en busybox/udev: el hook 'resume' sí es requerido después de 'block'
            if ! grep "^HOOKS=" /etc/mkinitcpio.conf | grep -q "\bresume\b"; then
                echo "⚙️ Añadiendo hook resume a /etc/mkinitcpio.conf..."
                sed -i 's/\bblock\b/block resume/' /etc/mkinitcpio.conf
                INITRAMFS_CHANGED=1
            fi
        fi
    fi
elif [ -f /etc/initramfs-tools/conf.d/resume ]; then
    # Debian — initramfs-tools already configured
    true
elif [ -f /etc/initramfs-tools/conf.d/ ] && command -v update-initramfs >/dev/null 2>&1; then
    # Debian — write resume config
    if [ -n "$ROOT_UUID" ] && [ -n "$OFFSET" ]; then
        echo "BOOTUUID=${ROOT_UUID}" > /etc/initramfs-tools/conf.d/resume 2>/dev/null || true
        INITRAMFS_CHANGED=1
    fi
fi

# Regenerar initramfs si se modificó la configuración de resume
if [ "$INITRAMFS_CHANGED" -eq 1 ]; then
    echo "🔄 Regenerando initramfs para incluir hook de resume..."
    if command -v mkinitcpio >/dev/null 2>&1; then
        mkinitcpio -P 2>/dev/null || true
    elif command -v update-initramfs >/dev/null 2>&1; then
        update-initramfs -u 2>/dev/null || true
    elif command -v dracut >/dev/null 2>&1; then
        dracut --force 2>/dev/null || true
    fi
fi

# 6. Fixes específicos por GPU — solo se aplican si el hardware está presente
# NVIDIA: en portátiles AMD+NVIDIA, los notificadores PM de NVIDIA abortan el hibernate.
# Deshabilitarlos permite al kernel volcar la RAM sin interferencias.
NVIDIA_MODPROBE_FILE=/etc/modprobe.d/pulsaros-nvidia-hibernate.conf
if lsmod | grep -q "^nvidia "; then
    echo "🎮 NVIDIA detectada — aplicando fixes de hibernación..."
    NVIDIA_CONF_NEW="# Pulsar OS - NVIDIA hibernate fixes (auto-generado por pulsaros-setup-hibernation)
# Solo se aplica en sistemas con NVIDIA. Seguro ignorar en sistemas sin NVIDIA.
# PreserveVideoMemoryAllocations: preserva VRAM para restaurar estado tras hibernate.
# UseKernelSuspendNotifiers=0: evita que NVIDIA aborte la hibernación cuando la GPU está en uso.
options nvidia NVreg_PreserveVideoMemoryAllocations=1 NVreg_TemporaryFilePath=/var/tmp NVreg_UseKernelSuspendNotifiers=0"
    NVIDIA_CHANGED=1
    if [ -f "$NVIDIA_MODPROBE_FILE" ] && [ "$(cat "$NVIDIA_MODPROBE_FILE" 2>/dev/null)" = "$NVIDIA_CONF_NEW" ]; then
        NVIDIA_CHANGED=0
    else
        printf '%s\n' "$NVIDIA_CONF_NEW" > "$NVIDIA_MODPROBE_FILE"
    fi

    # Habilitar servicios NVIDIA de hibernate si están disponibles
    if command -v systemctl >/dev/null 2>&1; then
        systemctl enable nvidia-hibernate.service nvidia-resume.service nvidia-suspend.service 2>/dev/null || true
    fi

    # Regenerar initramfs SOLO si la configuración del módulo cambió (regenerar
    # en cada hibernación añade 30-60s de retraso al apagado).
    if [ "$NVIDIA_CHANGED" -eq 1 ]; then
        echo "🔄 Regenerando initramfs con configuración NVIDIA..."
        if command -v update-initramfs >/dev/null 2>&1; then
            update-initramfs -u 2>/dev/null || true
        elif command -v mkinitcpio >/dev/null 2>&1; then
            mkinitcpio -P 2>/dev/null || true
        elif command -v dracut >/dev/null 2>&1; then
            dracut --force 2>/dev/null || true
        fi
    fi
elif [ -f "$NVIDIA_MODPROBE_FILE" ]; then
    # Limpiar si se había instalado antes y ahora no hay NVIDIA
    rm -f "$NVIDIA_MODPROBE_FILE"
fi

# 7. Compilar esquemas GSettings
if [ -d /usr/share/glib-2.0/schemas ]; then
    glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null || true
fi
if [ -d /usr/share/gnome-shell/extensions/pulsaros-global-menu@inled.es/schemas ]; then
    glib-compile-schemas /usr/share/gnome-shell/extensions/pulsaros-global-menu@inled.es/schemas 2>/dev/null || true
fi

echo "✅ Configuración de hibernación y restauración de sesión completada con éxito."
