#!/bin/bash
# Pulsar OS - Power Action Handler with Session State Persistence

ACTION="$1"     # "shutdown" | "restart"
RESTORE="$2"    # "restore" | "normal"

# Sincronizar todos los buffers a disco inmediatamente
sync

if [ "$RESTORE" = "restore" ]; then
    if [ "$ACTION" = "restart" ]; then
        echo reboot > /sys/power/disk 2>/dev/null || true
    else
        echo shutdown > /sys/power/disk 2>/dev/null || true
    fi

    sync

    # Hibernación forzada inmediata (-i ignora inhibidores, --force fuerza ejecución directa de bajo nivel)
    systemctl hibernate -i --force --no-wall 2>/dev/null || (echo disk > /sys/power/state)
else
    if [ "$ACTION" = "restart" ]; then
        gnome-session-quit --reboot --force --no-prompt 2>/dev/null || systemctl reboot -i --force
    else
        gnome-session-quit --power-off --force --no-prompt 2>/dev/null || systemctl poweroff -i --force
    fi
fi
