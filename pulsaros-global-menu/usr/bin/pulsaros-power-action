#!/bin/bash
# Pulsar OS - Power Action Handler with Session State Persistence
# Ejecuta apagado o reinicio gestionado por systemd con soporte de hibernación / restauración de sesión.

ACTION="$1"     # "shutdown" | "restart"
RESTORE="$2"    # "restore" | "normal"

# Sincronizar buffers de disco
sync

# Limpiar cualquier drop-in previo de reboot en tmpfs
rm -f /run/systemd/sleep.conf.d/00-pulsar-reboot.conf 2>/dev/null || true

if [ "$RESTORE" = "restore" ]; then
    if [ "$ACTION" = "restart" ]; then
        # Configurar systemd-sleep para reiniciar tras volcar la memoria
        mkdir -p /run/systemd/sleep.conf.d
        cat << 'DROPIN' > /run/systemd/sleep.conf.d/00-pulsar-reboot.conf
[Sleep]
HibernateMode=reboot
DROPIN
        # Ejecutar hibernación gestionada por systemd (con fallback a reboot normal)
        systemctl hibernate 2>/dev/null || systemctl reboot
    else
        # Hibernación estándar gestionada por systemd (con fallback a apagado normal)
        systemctl hibernate 2>/dev/null || systemctl poweroff
    fi
else
    if [ "$ACTION" = "restart" ]; then
        systemctl reboot 2>/dev/null || gnome-session-quit --reboot
    else
        systemctl poweroff 2>/dev/null || gnome-session-quit --power-off
    fi
fi
