#!/bin/bash
# Pulsar OS - Power Action Handler with Session State Persistence

ACTION="$1"     # "shutdown" | "restart"
RESTORE="$2"    # "restore" | "normal"

# Sincronizar buffers a disco
sync

if [ "$RESTORE" = "restore" ]; then
    if [ "$ACTION" = "restart" ]; then
        echo reboot > /sys/power/disk 2>/dev/null || true
    else
        echo shutdown > /sys/power/disk 2>/dev/null || true
    fi

    # Sincronizar antes de hibernar
    sync

    # Hibernar directamente ignorando inhibidores
    systemctl hibernate -i --no-wall 2>/dev/null || (echo disk > /sys/power/state)
else
    if [ "$ACTION" = "restart" ]; then
        gnome-session-quit --reboot --force --no-prompt 2>/dev/null || systemctl reboot -i
    else
        gnome-session-quit --power-off --force --no-prompt 2>/dev/null || systemctl poweroff -i
    fi
fi
