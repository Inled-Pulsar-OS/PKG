#!/bin/bash
# Pulsar OS - Power Action Handler with Session State Persistence

ACTION="$1"     # "shutdown" | "restart"
RESTORE="$2"    # "restore" | "normal"

sync

rm -f /run/systemd/sleep.conf.d/00-pulsar-reboot.conf 2>/dev/null || true

if [ "$RESTORE" = "restore" ]; then
    if [ "$ACTION" = "restart" ]; then
        mkdir -p /run/systemd/sleep.conf.d
        printf '[Sleep]\nHibernateMode=reboot\n' > /run/systemd/sleep.conf.d/00-pulsar-reboot.conf
    fi

    # Crear un servicio de sistema que hará el hibernate DESPUÉS de que la sesión
    # gráfica se cierre completamente (y con ella gnome-shell, liberando /dev/nvidia*)
    systemd-run --no-block --unit=pulsaros-hibernate \
        --description="Pulsar OS Session Restore Hibernate" \
        /bin/sh -c '
            # Terminar la sesión gráfica del usuario para liberar /dev/nvidia*
            # gdm/sddm/lightdm detendrá la sesión y gnome-shell morirá
            systemctl stop display-manager.service 2>/dev/null || true
            # Esperar a que gnome-shell libere el dispositivo
            sleep 3
            # Descargar NVIDIA (ahora sí funciona porque gnome-shell está muerto)
            modprobe -r nvidia_drm nvidia_modeset nvidia_uvm nvidia 2>/dev/null || true
            sleep 1
            sync
            # Hibernar
            systemctl hibernate 2>/dev/null || (echo disk > /sys/power/state)
        '
else
    if [ "$ACTION" = "restart" ]; then
        systemctl reboot 2>/dev/null || gnome-session-quit --reboot
    else
        systemctl poweroff 2>/dev/null || gnome-session-quit --power-off
    fi
fi
