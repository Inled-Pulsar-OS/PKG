#!/bin/bash
# Pulsar OS - Power Action Handler with Session State Persistence

ACTION="$1"     # "shutdown" | "restart"
RESTORE="$2"    # "restore" | "normal"

sync

# Limpiar drop-ins temporales previos
rm -f /run/systemd/sleep.conf.d/00-pulsar-reboot.conf 2>/dev/null || true

if [ "$RESTORE" = "restore" ]; then
    if [ "$ACTION" = "restart" ]; then
        mkdir -p /run/systemd/sleep.conf.d
        printf '[Sleep]\nHibernateMode=reboot\n' > /run/systemd/sleep.conf.d/00-pulsar-reboot.conf
    fi

    # Descargar módulo NVIDIA antes de hibernar (laptop AMD+NVIDIA: NVIDIA no gestiona pantalla)
    # Sin esto, NVIDIA activa su HDA controller durante el volcado y aborta la hibernación
    modprobe -r nvidia_drm nvidia_modeset nvidia_uvm nvidia 2>/dev/null || true

    # Lanzar la hibernación fuera del scope de sesión de usuario
    systemd-run --no-block --unit=pulsaros-hibernate \
        --description="Pulsar OS Session Restore Hibernate" \
        /bin/sh -c 'sync; sleep 1; systemctl hibernate'
else
    if [ "$ACTION" = "restart" ]; then
        systemd-run --no-block --unit=pulsaros-reboot \
            /bin/sh -c 'sleep 1; systemctl reboot'
    else
        systemd-run --no-block --unit=pulsaros-poweroff \
            /bin/sh -c 'sleep 1; systemctl poweroff'
    fi
fi
