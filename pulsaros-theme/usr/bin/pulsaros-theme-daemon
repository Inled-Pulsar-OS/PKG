#!/bin/bash
# ==============================================================================
# Pulsar OS - Theme & Color Scheme Synchronization Daemon
# ==============================================================================
# Sincroniza dinámicamente el tema GTK, GNOME Shell, Libadwaita y Flatpak
# (MacTahoe-Light / MacTahoe-Dark) en tiempo real al cambiar Modo Claro / Oscuro.
# ==============================================================================

# Configurar permisos de sistema de archivos limpios para Flatpak sin ensuciar env vars
if command -v flatpak >/dev/null 2>&1; then
    flatpak override --user --filesystem=xdg-config/gtk-4.0:ro --filesystem=xdg-config/gtk-3.0:ro --filesystem=/usr/share/themes:ro --filesystem=/usr/share/icons:ro --filesystem=~/.themes:ro --filesystem=~/.icons:ro 2>/dev/null || true
    flatpak override --user --unset-env=GTK_THEME --unset-env=ICON_THEME 2>/dev/null || true
fi

sync_theme() {
    local show_prompt="${1:-false}"
    local scheme
    scheme=$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null | tr -d "'")
    mkdir -p "$HOME/.config/gtk-4.0" "$HOME/.config/gtk-3.0"

    GTK_NOW=$(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null | tr -d "'")
    CUR_NOW=$(gsettings get org.gnome.desktop.interface cursor-theme 2>/dev/null | tr -d "'")
    ICON_NOW=$(gsettings get org.gnome.desktop.interface icon-theme 2>/dev/null | tr -d "'")

    if [ "$scheme" = "prefer-dark" ]; then
        if [[ "$GTK_NOW" == MacTahoe* ]]; then
            GTK_TGT="MacTahoe-Dark-solid"
        else
            GTK_TGT="$GTK_NOW"
        fi
        gsettings set org.gnome.desktop.interface gtk-theme "$GTK_TGT" 2>/dev/null || true
        gsettings set org.gnome.desktop.interface icon-theme "$ICON_NOW" 2>/dev/null || true
        if [[ "$CUR_NOW" == MacTahoe* ]]; then
            CUR_TGT="MacTahoe-dark"
        else
            CUR_TGT="$CUR_NOW"
        fi
        gsettings set org.gnome.desktop.interface cursor-theme "$CUR_TGT" 2>/dev/null || true
        # gsettings set org.gnome.shell.extensions.user-theme name "MacTahoe-Dark" 2>/dev/null || true

        if [ -d "/usr/share/themes/${GTK_TGT}/gtk-4.0" ] && [[ "$GTK_NOW" == MacTahoe* ]]; then
            cp -rf "/usr/share/themes/${GTK_TGT}/gtk-4.0"/* "$HOME/.config/gtk-4.0/" 2>/dev/null || true
        fi
        if [ -d "/usr/share/themes/${GTK_TGT}/gtk-3.0" ] && [[ "$GTK_NOW" == MacTahoe* ]]; then
            cp -rf "/usr/share/themes/${GTK_TGT}/gtk-3.0/gtk-dark.css" "$HOME/.config/gtk-3.0/gtk.css" 2>/dev/null || true
        fi

        cat <<EOF > "$HOME/.config/gtk-3.0/settings.ini"
[Settings]
gtk-theme-name=$GTK_TGT
gtk-icon-theme-name=$ICON_NOW
gtk-application-prefer-dark-theme=1
gtk-cursor-theme-name=$CUR_TGT
EOF

        cat <<EOF > "$HOME/.config/gtk-4.0/settings.ini"
[Settings]
gtk-theme-name=$GTK_TGT
gtk-icon-theme-name=$ICON_NOW
gtk-application-prefer-dark-theme=1
gtk-cursor-theme-name=$CUR_TGT
EOF

    else
        if [[ "$GTK_NOW" == MacTahoe* ]]; then
            GTK_TGT="MacTahoe-Light-solid"
        else
            GTK_TGT="$GTK_NOW"
        fi
        gsettings set org.gnome.desktop.interface gtk-theme "$GTK_TGT" 2>/dev/null || true
        gsettings set org.gnome.desktop.interface icon-theme "$ICON_NOW" 2>/dev/null || true
        if [[ "$CUR_NOW" == MacTahoe* ]]; then
            CUR_TGT="MacTahoe"
        else
            CUR_TGT="$CUR_NOW"
        fi
        gsettings set org.gnome.desktop.interface cursor-theme "$CUR_TGT" 2>/dev/null || true
        # gsettings set org.gnome.shell.extensions.user-theme name "MacTahoe-Light" 2>/dev/null || true

        if [ -d "/usr/share/themes/${GTK_TGT}/gtk-4.0" ] && [[ "$GTK_NOW" == MacTahoe* ]]; then
            cp -rf "/usr/share/themes/${GTK_TGT}/gtk-4.0"/* "$HOME/.config/gtk-4.0/" 2>/dev/null || true
        fi
        if [ -d "/usr/share/themes/${GTK_TGT}/gtk-3.0" ] && [[ "$GTK_NOW" == MacTahoe* ]]; then
            cp -rf "/usr/share/themes/${GTK_TGT}/gtk-3.0/gtk.css" "$HOME/.config/gtk-3.0/gtk.css" 2>/dev/null || true
        fi

        cat <<EOF > "$HOME/.config/gtk-3.0/settings.ini"
[Settings]
gtk-theme-name=$GTK_TGT
gtk-icon-theme-name=$ICON_NOW
gtk-application-prefer-dark-theme=0
gtk-cursor-theme-name=$CUR_TGT
EOF

        cat <<EOF > "$HOME/.config/gtk-4.0/settings.ini"
[Settings]
gtk-theme-name=$GTK_TGT
gtk-icon-theme-name=$ICON_NOW
gtk-application-prefer-dark-theme=0
gtk-cursor-theme-name=$CUR_TGT
EOF

    fi

    if command -v /usr/bin/pulsar-sync-accent >/dev/null 2>&1; then
        /usr/bin/pulsar-sync-accent --once >/dev/null 2>&1 || true
    fi

    if [ "$show_prompt" = "true" ]; then
        fi
    fi
}


# Ejecución inicial silenciosa
LAST_SCHEME=$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null | tr -d "'")
sync_theme false

# Monitor en tiempo real de cambios en org.gnome.desktop.interface color-scheme
gsettings monitor org.gnome.desktop.interface color-scheme 2>/dev/null | while read -r _; do
    CURRENT_SCHEME=$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null | tr -d "'")
    if [ "$CURRENT_SCHEME" != "$LAST_SCHEME" ]; then
        LAST_SCHEME="$CURRENT_SCHEME"
        sync_theme false
    fi
done
