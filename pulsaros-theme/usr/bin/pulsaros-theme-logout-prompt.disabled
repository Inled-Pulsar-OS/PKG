#!/usr/bin/env python3
# ==============================================================================
# Pulsar OS - Theme Logout Countdown Prompt
# ==============================================================================
# Muestra un aviso de cierre de sesión con cuenta atrás cancelable al alternar
# entre Modo Claro y Oscuro para aplicar todos los cambios visuales por completo.
# ==============================================================================

import sys
import subprocess
import gi

gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')
from gi.repository import Gtk, Adw, GLib, Gio

class LogoutPromptWindow(Adw.Window):
    def __init__(self, app):
        super().__init__(application=app, title="Cambio de aspecto")
        self.set_default_size(420, 240)
        self.set_resizable(False)
        self.set_modal(True)

        self.countdown = 6

        # Layout
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        main_box.set_margin_top(24)
        main_box.set_margin_bottom(24)
        main_box.set_margin_start(28)
        main_box.set_margin_end(28)
        self.set_content(main_box)

        # Icon
        icon = Gtk.Image.new_from_icon_name("preferences-desktop-theme-symbolic")
        icon.set_pixel_size(48)
        main_box.append(icon)

        # Title
        title_lbl = Gtk.Label()
        title_lbl.set_markup("<span size='large' weight='bold'>Cambio de aspecto aplicado</span>")
        main_box.append(title_lbl)

        # Message with countdown
        self.msg_lbl = Gtk.Label()
        self.msg_lbl.set_wrap(True)
        self.msg_lbl.set_justify(Gtk.Justification.CENTER)
        self._update_label()
        main_box.append(self.msg_lbl)

        # Button Box
        btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        btn_box.set_halign(Gtk.Align.CENTER)
        btn_box.set_margin_top(8)
        main_box.append(btn_box)

        # Cancel button
        cancel_btn = Gtk.Button(label="Cancelar")
        cancel_btn.set_size_request(130, 36)
        cancel_btn.connect("clicked", self.on_cancel)
        btn_box.append(cancel_btn)

        # Logout Now button
        logout_btn = Gtk.Button(label="Cerrar sesión ahora")
        logout_btn.set_size_request(150, 36)
        logout_btn.add_css_class("suggested-action")
        logout_btn.connect("clicked", self.on_logout_now)
        btn_box.append(logout_btn)

        # Timer
        self.timer_id = GLib.timeout_add_seconds(1, self.on_tick)

    def _update_label(self):
        self.msg_lbl.set_markup(
            f"Se cerrará la sesión en <b>{self.countdown}</b> segundos para aplicar el modo visual por completo."
        )

    def on_tick(self):
        self.countdown -= 1
        if self.countdown <= 0:
            self.execute_logout()
            return GLib.SOURCE_REMOVE
        self._update_label()
        return GLib.SOURCE_CONTINUE

    def on_cancel(self, _btn):
        if self.timer_id:
            GLib.source_remove(self.timer_id)
            self.timer_id = 0
        self.close()
        sys.exit(0)

    def on_logout_now(self, _btn):
        if self.timer_id:
            GLib.source_remove(self.timer_id)
            self.timer_id = 0
        self.execute_logout()

    def execute_logout(self):
        self.close()
        try:
            subprocess.run(["gnome-session-quit", "--logout", "--no-prompt"], check=False)
        except Exception as e:
            print(f"Error logging out: {e}")
        sys.exit(0)

def main():
    app = Adw.Application(application_id="es.inled.pulsaros.ThemeLogoutPrompt", flags=Gio.ApplicationFlags.FLAGS_NONE)

    def on_activate(app):
        win = LogoutPromptWindow(app)
        win.present()

    app.connect("activate", on_activate)
    return app.run(sys.argv)

if __name__ == "__main__":
    sys.exit(main())
