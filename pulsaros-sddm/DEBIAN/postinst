#!/bin/bash
set -e

echo "⚙️ Configurando SDDM como el gestor de pantalla predeterminado..."
mkdir -p /etc/X11
echo "/usr/sbin/sddm" > /etc/X11/default-display-manager

echo "🎨 Habilitando servicio SDDM y auto-login dinámico del live..."
systemctl enable sddm.service || true
systemctl enable pulsaros-live-autologin.service || true

# Actualizar fc-cache si se instalaron fuentes del tema
if [ -d "/usr/share/fonts/truetype/tahoe-sddm" ]; then
    echo "⚙️  Actualizando caché de tipografías del sistema..."
    fc-cache -f || true
fi

# Inicializar el fondo de pantalla dinámico para SDDM
# Initialize the dynamic wallpaper for SDDM
echo "🎨 Inicializando el archivo de fondo de pantalla compartido para SDDM..."
mkdir -p /var/lib/pulsar-sddm
chmod 777 /var/lib/pulsar-sddm || true
if [ -f "/usr/share/backgrounds/pulsar-os-tahoe.png" ]; then
    cp "/usr/share/backgrounds/pulsar-os-tahoe.png" /var/lib/pulsar-sddm/pulsar-wallpaper.png
else
    touch /var/lib/pulsar-sddm/pulsar-wallpaper.png
fi
chmod 666 /var/lib/pulsar-sddm/* 2>/dev/null || true

exit 0
