[Unit]
Description=Configure SDDM Autologin for Pulsar OS Live Session
DefaultDependencies=no
After=local-fs.target
Before=sddm.service

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'if grep -q "boot=live" /proc/cmdline; then mkdir -p /etc/sddm.conf.d && echo -e "[Autologin]\nUser=live\nSession=gnome-xorg" > /etc/sddm.conf.d/autologin.conf; fi'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
