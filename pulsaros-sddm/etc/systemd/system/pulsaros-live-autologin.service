[Unit]
Description=Clean SDDM Autologin on Installed System
DefaultDependencies=no
After=local-fs.target pulsar-ootb.service
Before=sddm.service

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'if ! grep -q -E "boot=live|rootfstype=9p" /proc/cmdline; then if [ -f /etc/sddm.conf.d/autologin.conf ] && grep -q "User=live" /etc/sddm.conf.d/autologin.conf && [ ! -f /etc/pulsar-need-setup ]; then rm -f /etc/sddm.conf.d/autologin.conf; fi; else systemctl mask plymouth-quit.service plymouth-quit-wait.service || true; fi'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
