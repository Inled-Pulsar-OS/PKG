[Unit]
Description=Clean SDDM Autologin on Installed System
DefaultDependencies=no
After=local-fs.target
Before=sddm.service

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'if ! grep -q -E "boot=live|rootfstype=9p" /proc/cmdline; then rm -f /etc/sddm.conf.d/autologin.conf; fi'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
