[Unit]
Description=Clean SDDM Autologin on Installed System
DefaultDependencies=no
After=local-fs.target pulsar-ootb.service
Before=display-manager.service sddm.service

[Service]
Type=oneshot
# On the installed system decide by real state instead of by the sentinel
# file alone, so the OOTB auto-login no longer depends on sibling-service
# ordering: while no real (non-live) user exists we KEEP/ensure the live
# autologin so the first boot lands directly on the OOTB Setup Assistant;
# once a real user exists we drop any leftover live autologin. On the live
# session we mask plymouth so the splash lasts the whole boot.
# En el sistema instalado se decide por el estado real (¿existe ya un usuario
# real?) en lugar de depender solo del sentinel: mientras no exista un usuario
# real se mantiene/garantiza el autologin de 'live' para que el primer arranque
# entre directo al Setup Assistant OOTB; cuando ya existe un usuario real se
# elimina el autologin de 'live' residual. En el live se enmascara plymouth.
ExecStart=/bin/bash -c 'if ! grep -q -E "boot=live|rootfstype=9p|archisobasedir|archisolabel|img_dev|live-media" /proc/cmdline && [ ! -d /run/archiso ] && [ ! -d /run/live ] && [ ! -d /lib/live ]; then real_u=$(awk -F: '\''$3 >= 1000 && $3 != 65534 && $1 != "live" {print $1; exit}'\'' /etc/passwd); if [ -z "$real_u" ] || [ -f /etc/pulsar-need-setup ]; then mkdir -p /etc/sddm.conf.d && (grep -q "^User=live" /etc/sddm.conf.d/autologin.conf 2>/dev/null || printf "[Autologin]\nUser=live\nSession=gnome\nRelogin=false\n" > /etc/sddm.conf.d/autologin.conf); else mkdir -p /etc/sddm.conf.d /var/lib/sddm && printf "[Autologin]\nUser=%s\nSession=gnome\nRelogin=false\n" "$real_u" > /etc/sddm.conf.d/autologin.conf && printf "[Last]\nSession=/usr/share/wayland-sessions/gnome.desktop\nUser=%s\n" "$real_u" > /var/lib/sddm/state.conf && chown -R sddm:sddm /var/lib/sddm 2>/dev/null || true; fi; else systemctl mask plymouth-quit.service plymouth-quit-wait.service 2>/dev/null || true; fi'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
