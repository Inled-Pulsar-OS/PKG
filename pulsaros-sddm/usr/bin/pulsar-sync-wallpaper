#!/bin/bash
# ==============================================================================
# Pulsar OS - SDDM & Lockscreen Wallpaper Sync Daemon (XML-Aware Version)
# ==============================================================================
# English: This script runs on user session start. It copies the current
#          desktop wallpaper to a shared location read by SDDM and synchronizes
#          GNOME screensaver keys to ensure parity with Lockscreen.
# Español: Este script se ejecuta al iniciar la sesión de usuario. Copia el
#          fondo de pantalla actual a una ubicación compartida leída por SDDM y
#          sincroniza las claves del protector de pantalla de GNOME.
# ==============================================================================

# Redirect stdout and stderr to a temp log file for easy diagnosis
# Redirigir stdout y stderr a un archivo de registro temporal para un fácil diagnóstico
exec > /tmp/pulsar-sync-wallpaper.log 2>&1

echo "=== PULSAR WALLPAPER SYNC DAEMON LOG ==="
date
echo "User: $USER (UID: $UID)"
echo "DISPLAY: $DISPLAY"
echo "XDG_RUNTIME_DIR: $XDG_RUNTIME_DIR"

# Prevent concurrent execution of the sync loop
# Evitar ejecuciones simultáneas del bucle de sincronización
LOCK_FILE="/tmp/pulsar-sync-wallpaper.lock"
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    echo "Sync daemon already running. Exiting."
    exit 0
fi

sync_wallpaper() {
    echo "----------------------------------------"
    echo "Sync Triggered: $(date)"
    
    BG_PATH=""
    
    # 1. Check if Hidamari animated/video wallpaper is configured
    HIDAMARI_PATHS=(
        "$HOME/.var/app/io.github.jeffshee.Hidamari/config/hidamari/hidamari.json"
        "$HOME/.config/hidamari/hidamari.json"
    )
    for cfg in "${HIDAMARI_PATHS[@]}"; do
        if [ -f "$cfg" ]; then
            H_FILE=$(jq -r '.file // empty' "$cfg" 2>/dev/null || grep -o '"file": "[^"]*"' "$cfg" | cut -d'"' -f4)
            if [ -n "$H_FILE" ] && [ -f "$H_FILE" ]; then
                BG_PATH="$H_FILE"
                echo "Detected active Hidamari wallpaper: $BG_PATH"
                break
            fi
        fi
    done

    # 2. If no Hidamari wallpaper, read from GNOME Desktop settings
    if [ -z "$BG_PATH" ]; then
        SCHEME=$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null | tr -d "'")
        echo "Detected GNOME Theme Color Scheme: $SCHEME"
        
        if [ "$SCHEME" = "prefer-dark" ]; then
            BG_URI=$(gsettings get org.gnome.desktop.background picture-uri-dark 2>/dev/null | tr -d "'")
        else
            BG_URI=$(gsettings get org.gnome.desktop.background picture-uri 2>/dev/null | tr -d "'")
        fi
        
        if [ -z "$BG_URI" ] || [ "$BG_URI" = "none" ]; then
            BG_URI=$(gsettings get org.gnome.desktop.background picture-uri 2>/dev/null | tr -d "'")
        fi
        if [ -z "$BG_URI" ] || [ "$BG_URI" = "none" ]; then
            BG_URI=$(gsettings get org.gnome.desktop.background picture-uri-dark 2>/dev/null | tr -d "'")
        fi
        if [ -z "$BG_URI" ] || [ "$BG_URI" = "none" ]; then
            BG_URI="file:///usr/share/backgrounds/pulsar-os-tahoe.png"
        fi
        
        echo "Active GNOME BG_URI: $BG_URI"
        
        # Sincronizar claves de protector de pantalla / lockscreen
        gsettings set org.gnome.desktop.screensaver picture-uri "$BG_URI" 2>/dev/null || true
        
        if [[ "$BG_URI" == file://* ]]; then
            BG_PATH="${BG_URI#file://}"
        else
            BG_PATH="$BG_URI"
        fi
        
        # If XML slideshow, extract real image
        if [[ "$BG_PATH" == *.xml ]] && [ -f "$BG_PATH" ]; then
            REAL_IMG=$(grep '<file>' "$BG_PATH" | head -n 1 | sed -e 's/^[ \t]*<file>//' -e 's/<\/file>.*//')
            if [ -n "$REAL_IMG" ] && [ -f "$REAL_IMG" ]; then
                BG_PATH="$REAL_IMG"
            fi
        fi
    fi

    # Fallback to system default if still invalid
    if [ ! -f "$BG_PATH" ]; then
        BG_PATH="/usr/share/backgrounds/pulsar-os-tahoe.png"
    fi
    echo "Resolved final wallpaper path: $BG_PATH"

    # 3. Synchronize to SDDM shared path
    mkdir -p /var/lib/pulsar-sddm 2>/dev/null || true
    chmod 777 /var/lib/pulsar-sddm 2>/dev/null || true
    
    EXT="${BG_PATH##*.}"
    EXT_LOWER=$(echo "$EXT" | tr '[:upper:]' '[:lower:]')
    
    case "$EXT_LOWER" in
        mp4|webm|mkv|mov|avi)
            echo "Processing video wallpaper for SDDM..."
            cp -f "$BG_PATH" /var/lib/pulsar-sddm/pulsar-wallpaper.mp4 2>/dev/null || true
            chmod 666 /var/lib/pulsar-sddm/pulsar-wallpaper.mp4 2>/dev/null || true
            
            # Generate poster image frame for static fallback in SDDM
            if command -v ffmpeg >/dev/null 2>&1; then
                ffmpeg -y -ss 00:00:01 -i "$BG_PATH" -vframes 1 -q:v 2 /var/lib/pulsar-sddm/pulsar-wallpaper.png 2>/dev/null || cp -f "/usr/share/backgrounds/pulsar-os-tahoe.png" /var/lib/pulsar-sddm/pulsar-wallpaper.png 2>/dev/null || true
            else
                cp -f "/usr/share/backgrounds/pulsar-os-tahoe.png" /var/lib/pulsar-sddm/pulsar-wallpaper.png 2>/dev/null || true
            fi
            chmod 666 /var/lib/pulsar-sddm/pulsar-wallpaper.png 2>/dev/null || true
            ;;
        gif|webp)
            echo "Processing animated GIF/WebP wallpaper for SDDM..."
            cp -f "$BG_PATH" "/var/lib/pulsar-sddm/pulsar-wallpaper.$EXT_LOWER" 2>/dev/null || true
            cp -f "$BG_PATH" /var/lib/pulsar-sddm/pulsar-wallpaper.png 2>/dev/null || true
            chmod 666 "/var/lib/pulsar-sddm/pulsar-wallpaper.$EXT_LOWER" /var/lib/pulsar-sddm/pulsar-wallpaper.png 2>/dev/null || true
            ;;
        *)
            echo "Processing static image wallpaper for SDDM..."
            cp -f "$BG_PATH" /var/lib/pulsar-sddm/pulsar-wallpaper.png 2>/dev/null || true
            chmod 666 /var/lib/pulsar-sddm/pulsar-wallpaper.png 2>/dev/null || true
            ;;
    esac

    echo "SDDM wallpaper updated successfully."
}

# Initial sync on startup
echo "Running initial sync..."
sync_wallpaper

# Monitor changes from GNOME settings and Hidamari config
echo "Entering monitor loop..."
(
    stdbuf -oL gsettings monitor org.gnome.desktop.background 2>/dev/null &
    stdbuf -oL gsettings monitor org.gnome.desktop.interface color-scheme 2>/dev/null &
    while true; do
        sleep 3
    done
) | while read -r line; do
    echo "Monitor event: $line"
    sync_wallpaper
done
