#!/bin/bash
# ==============================================================================
# Pulsar OS - SDDM & Lockscreen Wallpaper Sync Daemon
# ==============================================================================
# English: Synchronizes current wallpaper/video with SDDM and GNOME Lockscreen.
# Español: Sincroniza el fondo de escritorio/vídeo con SDDM y Bloqueo de pantalla.
# ==============================================================================

exec > /tmp/pulsar-sync-wallpaper.log 2>&1

echo "=== PULSAR WALLPAPER SYNC DAEMON LOG ==="
date
echo "User: $USER (UID: $UID)"
echo "DISPLAY: $DISPLAY"
echo "XDG_RUNTIME_DIR: $XDG_RUNTIME_DIR"

LOCK_FILE="/tmp/pulsar-sync-wallpaper.lock"
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    echo "Sync daemon already running. Exiting."
    exit 0
fi

sync_wallpaper() {
    echo "----------------------------------------"
    echo "Sync Triggered: $(date)"
    
    BG_PATH=""
    POSTER_PATH=""
    
    # 1. Check if Pulsar OS Native Live Wallpaper is configured and enabled
    PULSAR_LIVE_CFG="$HOME/.config/pulsaros/live-wallpaper.json"
    if [ -f "$PULSAR_LIVE_CFG" ]; then
        P_ENABLED=$(jq -r '.enabled // false' "$PULSAR_LIVE_CFG" 2>/dev/null || grep -o '"enabled": [^,]*' "$PULSAR_LIVE_CFG" | cut -d':' -f2 | tr -d ' ')
        if [ "$P_ENABLED" = "true" ]; then
            P_FILE=$(jq -r '.file // empty' "$PULSAR_LIVE_CFG" 2>/dev/null || grep -o '"file": "[^"]*"' "$PULSAR_LIVE_CFG" | cut -d'"' -f4)
            if [ -n "$P_FILE" ] && [ -f "$P_FILE" ]; then
                BG_PATH="$P_FILE"
                POSTER_PATH=$(jq -r '.poster // empty' "$PULSAR_LIVE_CFG" 2>/dev/null || grep -o '"poster": "[^"]*"' "$PULSAR_LIVE_CFG" | cut -d'"' -f4)
                echo "Detected active Pulsar OS Live Wallpaper: $BG_PATH"
            fi
        fi
    fi

    # 2. Check if Hidamari animated/video wallpaper is configured
    if [ -z "$BG_PATH" ]; then
        HIDAMARI_PATHS=(
            "$HOME/.var/app/io.github.jeffshee.Hidamari/config/hidamari/hidamari.json"
            "$HOME/.config/hidamari/hidamari.json"
        )
        for cfg in "${HIDAMARI_PATHS[@]}"; do
            if [ -f "$cfg" ]; then
                H_FILE=$(jq -r '.file // empty' "$cfg" 2>/dev/null || grep -o '"file": "[^"]*"' "$cfg" | cut -d'"' -f4)
                if [ -n "$H_FILE" ] && [ -f "$H_FILE" ]; then
                    BG_PATH="$H_FILE"
                    echo "Detected active Hidamari wallpaper: $BG_PATH"
                    break
                fi
            fi
        done
    fi

    # 3. If no Live Wallpaper, read from GNOME Desktop settings
    if [ -z "$BG_PATH" ]; then
        SCHEME=$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null | tr -d "'")
        if [ "$SCHEME" = "prefer-dark" ]; then
            BG_URI=$(gsettings get org.gnome.desktop.background picture-uri-dark 2>/dev/null | tr -d "'")
        else
            BG_URI=$(gsettings get org.gnome.desktop.background picture-uri 2>/dev/null | tr -d "'")
        fi
        
        if [ -z "$BG_URI" ] || [ "$BG_URI" = "none" ]; then
            BG_URI=$(gsettings get org.gnome.desktop.background picture-uri 2>/dev/null | tr -d "'")
        fi
        if [ -z "$BG_URI" ] || [ "$BG_URI" = "none" ]; then
            BG_URI=$(gsettings get org.gnome.desktop.background picture-uri-dark 2>/dev/null | tr -d "'")
        fi
        if [ -z "$BG_URI" ] || [ "$BG_URI" = "none" ]; then
            BG_URI="file:///usr/share/backgrounds/pulsar-os-tahoe.png"
        fi
        
        if [[ "$BG_URI" == file://* ]]; then
            BG_PATH="${BG_URI#file://}"
        else
            BG_PATH="$BG_URI"
        fi
        
        # If XML slideshow, extract real image
        if [[ "$BG_PATH" == *.xml ]] && [ -f "$BG_PATH" ]; then
            REAL_IMG=$(grep '<file>' "$BG_PATH" | head -n 1 | sed -e 's/^[ \t]*<file>//' -e 's/<\/file>.*//')
            if [ -n "$REAL_IMG" ] && [ -f "$REAL_IMG" ]; then
                BG_PATH="$REAL_IMG"
            fi
        fi
    fi

    if [ ! -f "$BG_PATH" ]; then
        BG_PATH="/usr/share/backgrounds/pulsar-os-tahoe.png"
    fi
    echo "Resolved wallpaper path: $BG_PATH"

    EXT="${BG_PATH##*.}"
    EXT_LOWER=$(echo "$EXT" | tr '[:upper:]' '[:lower:]')
    
    mkdir -p /var/lib/pulsar-sddm 2>/dev/null || true
    chmod 777 /var/lib/pulsar-sddm 2>/dev/null || true

    case "$EXT_LOWER" in
        mp4|webm|mkv|mov|avi)
            echo "Syncing video wallpaper to SDDM & Lockscreen poster..."
            cp -f "$BG_PATH" /var/lib/pulsar-sddm/pulsar-wallpaper.mp4 2>/dev/null || true
            chmod 666 /var/lib/pulsar-sddm/pulsar-wallpaper.mp4 2>/dev/null || true
            
            # Generate or copy poster image frame for Lockscreen & SDDM static fallback
            if [ -n "$POSTER_PATH" ] && [ -f "$POSTER_PATH" ]; then
                cp -f "$POSTER_PATH" /var/lib/pulsar-sddm/pulsar-wallpaper.png 2>/dev/null || true
            elif command -v ffmpeg >/dev/null 2>&1; then
                ffmpeg -y -ss 00:00:01 -i "$BG_PATH" -vframes 1 -q:v 2 /var/lib/pulsar-sddm/pulsar-wallpaper.png 2>/dev/null || cp -f "/usr/share/backgrounds/pulsar-os-tahoe.png" /var/lib/pulsar-sddm/pulsar-wallpaper.png 2>/dev/null || true
            else
                cp -f "/usr/share/backgrounds/pulsar-os-tahoe.png" /var/lib/pulsar-sddm/pulsar-wallpaper.png 2>/dev/null || true
            fi
            chmod 666 /var/lib/pulsar-sddm/pulsar-wallpaper.png 2>/dev/null || true
            
            # Set lockscreen to poster PNG
            gsettings set org.gnome.desktop.screensaver picture-uri "file:///var/lib/pulsar-sddm/pulsar-wallpaper.png" 2>/dev/null || true
            gsettings set org.gnome.desktop.screensaver picture-uri-dark "file:///var/lib/pulsar-sddm/pulsar-wallpaper.png" 2>/dev/null || true
            ;;
        gif|webp)
            echo "Syncing animated GIF/WebP wallpaper..."
            cp -f "$BG_PATH" "/var/lib/pulsar-sddm/pulsar-wallpaper.$EXT_LOWER" 2>/dev/null || true
            cp -f "$BG_PATH" /var/lib/pulsar-sddm/pulsar-wallpaper.png 2>/dev/null || true
            chmod 666 "/var/lib/pulsar-sddm/pulsar-wallpaper.$EXT_LOWER" /var/lib/pulsar-sddm/pulsar-wallpaper.png 2>/dev/null || true
            
            gsettings set org.gnome.desktop.screensaver picture-uri "file://$BG_PATH" 2>/dev/null || true
            gsettings set org.gnome.desktop.screensaver picture-uri-dark "file://$BG_PATH" 2>/dev/null || true
            ;;
        *)
            echo "Syncing static image wallpaper..."
            cp -f "$BG_PATH" /var/lib/pulsar-sddm/pulsar-wallpaper.png 2>/dev/null || true
            chmod 666 /var/lib/pulsar-sddm/pulsar-wallpaper.png 2>/dev/null || true
            
            gsettings set org.gnome.desktop.screensaver picture-uri "file://$BG_PATH" 2>/dev/null || true
            gsettings set org.gnome.desktop.screensaver picture-uri-dark "file://$BG_PATH" 2>/dev/null || true
            ;;
    esac

    echo "SDDM & Lockscreen updated successfully."
}

# Initial sync on startup
echo "Running initial sync..."
sync_wallpaper

# Event monitor with 1-second debounce
LAST_SYNC=0
gsettings monitor org.gnome.desktop.background 2>/dev/null | while read -r line; do
    NOW=$(date +%s)
    if [ $((NOW - LAST_SYNC)) -ge 1 ]; then
        LAST_SYNC=$NOW
        sleep 0.5
        sync_wallpaper
    fi
done
